#!/usr/bin/env bash
# CI: install libvips (image processing, ADR 0008) from .deb files cached between runs
# (~/.cache/debs, restored by actions/cache), falling back to the Ubuntu mirror.
#
# Why: the runner's mirror is often slow. The same 9.5 MB download takes 10 s on a good run
# and 2–3 minutes on a bad one, which made CI runs several times longer than the tests. A cache
# hit installs in seconds with no apt-get update.
#
# When it downloads (no cache yet, or the cached files didn't install), it writes
# refreshed=true to $GITHUB_OUTPUT so the workflow saves the new files: a bad cache costs one
# slow run, never a red one. Cached files are trusted as they are (apt doesn't check signatures
# on local .debs); only this repository's own runs can write the cache, and downloads come
# through apt's signed index.
set -euo pipefail

cache="${DEB_CACHE:-$HOME/.cache/debs}"
mkdir -p "$cache/partial"
shopt -s nullglob

if ldconfig -p | grep 'libvips\.so\.42' > /dev/null; then # (not grep -q: with pipefail, an early exit fails the pipe)
  echo "libvips is already installed"
  exit 0
fi

cached=("$cache"/*.deb)
if (( ${#cached[@]} )); then
  if output=$(sudo apt-get install -y -qq --no-install-recommends "${cached[@]}" 2>&1); then
    echo "libvips installed from the cache (${#cached[@]} packages)"
    exit 0
  fi
  echo "::warning::The cached libvips packages didn't install, so they're being downloaded again"
  echo "::group::apt-get output"; echo "$output"; echo "::endgroup::"
  rm -f "${cached[@]}"
fi

# Download straight into the cache folder, so only these packages are cached.
sudo apt-get update -qq -o Acquire::Retries=3
sudo apt-get install -y -qq --no-install-recommends -o Acquire::Retries=3 -o Dir::Cache::Archives="$cache" libvips42
sudo chown -R "$(id -u):$(id -g)" "$cache"
rm -rf "$cache/partial" "$cache/lock"
echo "libvips installed from the mirror; $(ls "$cache"/*.deb | wc -l) packages cached for next time"
[[ -n "${GITHUB_OUTPUT:-}" ]] && echo "refreshed=true" >> "$GITHUB_OUTPUT"
exit 0

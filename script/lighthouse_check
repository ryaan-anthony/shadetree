#!/usr/bin/env bash
# MKT-04: mobile Lighthouse scores for the marketing pages. Fails when any category of any page
# is under the minimum (default 90). Needs Node and Chrome.
#
#   script/lighthouse_check https://getshadetree.com
#   MIN_SCORE=85 script/lighthouse_check http://localhost:3000
set -euo pipefail
base="${1:?usage: script/lighthouse_check BASE_URL}"
min="${MIN_SCORE:-90}"
pages=(/ /features /pricing /about /contact)
failed=0
for page in "${pages[@]}"; do
  out="$(mktemp)"
  npx --yes lighthouse@12 "${base%/}${page}" --quiet --form-factor=mobile --output=json --output-path="$out" \
    --chrome-flags="--headless=new --no-sandbox" >/dev/null
  scores="$(node -e 'const r=require(process.argv[1]);console.log(Object.entries(r.categories).map(([k,v])=>`${k}=${Math.round(v.score*100)}`).join(" "))' "$out")"
  echo "${page}: ${scores}"
  for score in $(echo "$scores" | tr ' ' '\n' | cut -d= -f2); do
    if [ "$score" -lt "$min" ]; then failed=1; fi
  done
  rm -f "$out"
done
if [ "$failed" -ne 0 ]; then echo "Some scores are under ${min}."; exit 1; fi

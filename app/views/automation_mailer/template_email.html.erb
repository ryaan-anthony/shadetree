<%= render "client_mailer/intro", text: @intro %>
<% if @link && @button %>
  <table role="presentation" cellpadding="0" cellspacing="0"><tr><td style="border-radius:8px;background:<%= @branding.button_color %>;">
    <a href="<%= client_link_url(@link.token) %>" style="display:inline-block;padding:12px 20px;font-weight:600;font-size:15px;color:<%= @branding.button_ink %>;text-decoration:none;"><%= @button %></a>
  </td></tr></table>
<% end %>

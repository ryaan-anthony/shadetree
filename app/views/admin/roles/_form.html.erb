<%# locals: (role:, editable: true) -%>
<%= form_with model: [ :admin, role ], class: "form-split" do |f| %>
  <%= card do %>
    <% if role.errors[:base].any? %><div class="banner banner-warning mb-4" role="alert"><%= icon "alert-circle" %><p><%= role.errors[:base].to_sentence %></p></div><% end %>
    <fieldset class="space-y-5" <%= "disabled" unless editable %>>
      <%= f.field :name, maxlength: 40, placeholder: "Dispatcher", help: "Shown on the team page and in invitations." %>
      <fieldset>
        <legend class="label">What people with this role can do</legend>
        <% if role.errors[:permissions].any? %><p class="error-text mb-2"><%= icon "alert-circle" %>Permissions <%= role.errors[:permissions].to_sentence %></p><% end %>
        <%= hidden_field_tag "role[permissions][]", "", id: nil %>
        <% Permissions::GROUPS.each do |area, permissions| %>
          <p class="mt-3 text-sm2 font-semibold text-muted"><%= area %></p>
          <div class="mt-1 space-y-2">
            <% permissions.each do |key, words| %>
              <label class="check">
                <%= check_box_tag "role[permissions][]", key, role.permissions.include?(key.to_s), id: "permission_#{key}" %>
                <span class="text-ink"><%= words %></span>
              </label>
            <% end %>
          </div>
        <% end %>
        <p class="help mt-3">Billing and the plan, deleting the business, the payment account and who's an Owner stay with Owners.</p>
      </fieldset>
    </fieldset>
  <% end %>
  <% if editable %>
    <div class="mt-4 flex gap-2">
      <%= f.submit_button(role.persisted? ? "Save role" : "Create role") %>
      <%= link_to "Cancel", admin_roles_path, class: button_classes(:tertiary) %>
    </div>
  <% end %>
<% end %>

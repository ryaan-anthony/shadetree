<%# JOB-03: the team calendar. Desktop: a time grid; phones: an agenda grouped by day. %>
<% s = @schedule %>
<% show_locations = current_business.multiple_locations? && location_filter.nil? %><%# CAT-07: which location each visit is for, when showing them all %>
<% own = !can?(:office) %><%# JOB-08: follow-ups shown in full to someone who can't see requests are their own, opened on My day %>
<% content_for :title, "Schedule" %>
<%# PLT-15 (owner, 2026-11-22; supersedes #274's heading): the H1 is "Schedule"; the lede starts with the range, year included, then the view and the clock. %>
<%= page_header "Schedule", lede: safe_join([ "#{s.title} · #{s.view == "day" ? "Day" : "Week"} view · Times in #{s.zone_name} ", learn_more(:schedule) ]) do %>
  <%= render "admin/shared/location_filter", path: admin_schedule_path, keep: schedule_link_params(s) %>
  <div class="flex items-center gap-1" role="group" aria-label="Period">
    <%= link_to admin_schedule_path(schedule_link_params(s, date: s.previous_date.iso8601)), class: button_classes(:secondary, :icon), "aria-label": "Previous #{s.view}" do %><%= icon "chevron-left" %><% end %>
    <%= link_to "Today", admin_schedule_path(schedule_link_params(s, date: nil)), class: button_classes(:secondary), "aria-current": ("date" if s.today?) %>
    <%= link_to admin_schedule_path(schedule_link_params(s, date: s.next_date.iso8601)), class: button_classes(:secondary, :icon), "aria-label": "Next #{s.view}" do %><%= icon "chevron-right" %><% end %>
  </div>
  <%# QA #274: a keyboard's (and a phone's) way to book a visit without a slot on the grid. %>
  <%= link_to admin_schedule_new_visit_path({ on: s.date.iso8601, view: s.view, member: s.member }.compact_blank), class: button_classes(:primary), data: { turbo_frame: "schedule_visit" } do %><%= icon "plus" %> New visit<% end %>
  <%# PLT-19: the kit's segmented control (phones show the agenda, so no Day/Week there). %>
  <%= segmented_control({ "day" => "Day", "week" => "Week" }, selected: s.view, label: "View", class: "hidden self-center md:inline-flex",
                        href: ->(view) { admin_schedule_path(schedule_link_params(s, view:)) }) %>
<% end %>
<%# PLT-21: every empty period says so, on every screen, with the next visit when there is one. %>
<% if s.items.empty? %>
  <p class="-mt-2 mb-4 text-sm2 text-muted" id="next-visit">Nothing booked <%= s.view == "day" ? "this day" : "this week" %>. <%= render "next_visit", s: %></p>
<% end %>

<div class="grid grid-cols-[minmax(0,1fr)] items-start gap-4 lg:grid-cols-[16rem_minmax(0,1fr)]" data-controller="schedule-focus">
  <aside class="order-2 min-w-0 space-y-4 lg:order-none">
    <%= turbo_frame_tag "schedule_visit", data: { controller: "schedule-panel", action: "turbo:frame-load->schedule-panel#show" } %>

    <%= card title: "Crew", flush: true do %>
      <ul class="list" id="schedule-members">
        <li class="p-0"><%= link_to admin_schedule_path(schedule_link_params(s, member: nil)), class: "flex flex-1 items-center gap-2 px-4 py-2.5 #{"font-semibold" if s.member.nil?}", "aria-current": ("true" if s.member.nil?) do %>Everyone<% end %></li>
        <% s.members.each do |user| %>
          <li class="p-0"><%= link_to admin_schedule_path(schedule_link_params(s, member: user.id)), class: "flex flex-1 items-center gap-2 px-4 py-2.5 #{"font-semibold" if s.member == user.id}", "aria-current": ("true" if s.member == user.id) do %>
            <span class="cal-dot cal-<%= s.color_for(user) %>" aria-hidden="true"></span>
            <%= user_avatar user %><%# ACC-09 %>
            <span class="min-w-0 flex-1 truncate text-ink"><%= user.full_name %></span>
            <span class="tabular text-sm2 text-muted"><%= booked_hours_label(s.booked_hours[user.id]) %></span>
          <% end %></li>
        <% end %>
        <li class="p-0"><%= link_to admin_schedule_path(schedule_link_params(s, member: "unassigned")), class: "flex flex-1 items-center gap-2 px-4 py-2.5 #{"font-semibold" if s.member == "unassigned"}", "aria-current": ("true" if s.member == "unassigned") do %>
          <span class="cal-dot cal-none" aria-hidden="true"></span><span class="flex-1 text-ink">Not assigned</span><span class="tabular text-sm2 text-muted"><%= pluralize(s.unassigned_count, "visit") %></span>
        <% end %></li>
      </ul>
      <%# QA #274: a toggle, so pressed buttons (a GET form: it works without JavaScript too). %>
      <%= form_with url: admin_schedule_path, method: :get, id: "schedule-color", class: "flex items-center gap-2 border-t border-line px-4 py-2 text-sm2", data: { turbo_action: "advance" } do %>
        <% schedule_link_params(s, color: nil).each do |name, value| %><%= hidden_field_tag name, value, id: nil %><% end %>
        <%= hidden_field_tag :focus, "color", id: nil %>
        <span id="schedule-color-label" class="text-muted">Color by</span>
        <%= segmented_control({ "member" => "Person", "status" => "Status" }.to_h { |value, label| [ value, [ label, { data: ({ schedule_focus: "color" } if s.color_by == value) } ] ] },
                              selected: s.color_by, label: "Color by", label_id: "schedule-color-label", name: "color") %>
      <% end %>
      <% if s.color_by == "status" %>
        <ul class="flex flex-wrap gap-x-3 gap-y-1 px-4 pb-2.5 text-sm2 text-muted" aria-label="Status colors">
          <% StatusHelper::MAP[:visit].except("cancelled").each do |key, (_tone, label)| %><%# PLT-17: the map's words %>
            <li class="flex items-center gap-1.5"><span class="cal-dot cal-status-<%= key.dasherize %>" aria-hidden="true"></span><%= label %></li>
          <% end %>
          <% if own %><li class="flex items-center gap-1.5"><span class="cal-dot cal-neutral" aria-hidden="true"></span>Busy</li><% end %><%# JOB-08 %>
        </ul>
      <% end %>
    <% end %>

    <% jobs = s.unscheduled_jobs.to_a %>
    <%= card title: "Needs scheduling", flush: true, id: "needs-scheduling" do %>
      <% if jobs.empty? %>
        <p class="px-4 py-3 text-sm2 text-muted" id="nothing-to-book">No jobs are waiting for a visit.</p>
      <% else %>
        <ul class="list">
          <% jobs.each do |job| %>
            <li class="items-start">
              <div class="min-w-0 flex-1">
                <p class="truncate font-medium text-ink"><%= link_to_if can?(:office), job.title, admin_job_path(job), class: "hover:underline" %></p>
                <p class="truncate text-sm2 text-muted"><%= job.client.display_name %><%= ", #{job.property.one_line}" if job.property %></p>
              </div>
              <%= link_to "Schedule", new_admin_job_visit_path(job, on: s.date.iso8601), class: button_classes(:secondary, :sm), "aria-label": "Schedule #{job.number}" %>
            </li>
          <% end %>
        </ul>
        <% if s.unscheduled_count > jobs.size && can?(:office) %>
          <p class="border-t border-line px-4 py-2 text-sm2"><%= link_to "See all #{s.unscheduled_count}", admin_jobs_path(filter: "unscheduled"), class: "underline-offset-2 hover:underline" %></p>
        <% end %>
      <% end %>
    <% end %>
  </aside>

  <div class="order-1 min-w-0 lg:order-none">
    <%# Phones: an agenda list grouped by day, first on the page; this week's past days are folded away. %>
    <div class="md:hidden space-y-3" id="schedule-agenda">
      <% past, coming = s.dates.partition { _1 < s.business.today } %>
      <% past = [] if coming.empty? %>
      <% if past.any? { s.visits_on(_1).any? } %>
        <details class="card px-4 py-2.5 text-sm2" id="schedule-earlier">
          <% earlier = past.flat_map { s.visits_on(_1) }.group_by(&:class) %><%# JOB-07: visits, and follow-ups apart; JOB-08: and Busy %>
          <% counts = [ pluralize(earlier.fetch(Visit, []).size, "visit"), (pluralize(earlier[RequestFollowUp].size, "follow-up") if earlier[RequestFollowUp]), ("#{earlier[ScheduleView::Busy].size} busy" if earlier[ScheduleView::Busy]) ] %>
          <summary class="cursor-pointer font-medium text-ink">Earlier this week (<%= counts.compact.join(", ") %>)</summary>
          <ul class="mt-2 space-y-1.5">
            <% past.each do |date| %><% s.visits_on(date).each do |visit| %>
              <% if visit.is_a?(ScheduleView::Busy) %><%# JOB-08: not a link %>
                <li class="text-body"><%= date.strftime("%a") %> <%= visit.time_label.delete_prefix("Arrive ") %> · Busy · <%= visit.user.first_name.presence || visit.user.full_name %></li>
                <% next %>
              <% end %>
              <% if visit.is_a?(RequestFollowUp) %><%# JOB-07 %>
                <li><%= link_to "#{date.strftime("%a")} #{visit.time_label.delete_prefix("Arrive ")} · #{visit.service_request.client.display_name} (#{visit.kind_label.downcase} for a request)", own ? admin_my_request_path(visit.service_request) : admin_schedule_follow_up_path(visit.service_request), class: "text-body hover:underline", data: { schedule_focus: visit.service_request.uid } %></li>
                <% next %>
              <% end %>
              <li><%= link_to "#{date.strftime("%a")} #{visit.time_label.delete_prefix("Arrive ")} · #{visit.job.client.display_name}", admin_schedule_visit_path(visit, s.member ? { member: s.member } : {}), class: "text-body hover:underline", data: { schedule_focus: visit.uid } %></li>
            <% end %><% end %>
          </ul>
        </details>
      <% end %>
      <% shown = (coming.any? ? coming : s.dates).select { s.visits_on(_1).any? || _1 == s.business.today } %>
      <% shown.each do |date| %>
        <% day = s.visits_on(date) %>
        <% next if day.empty? && date != s.business.today %>
        <%= card flush: true do %>
          <h2 class="section-title border-b border-line px-4 py-2"><%= date.strftime("%A, %b %-d") %>
            <% s.closures_on(date).each do |closure| %><span class="ml-1 text-sm2 font-normal text-muted">· Closed: <%= closure.reason %></span><% end %></h2>
          <% if day.empty? %>
            <p class="px-4 py-3 text-sm2 text-muted">Nothing booked.</p>
          <% else %>
            <ul class="list">
              <% day.each do |visit| %>
                <% next concat(render("admin/schedule/busy", busy: visit, schedule: s, as: :row)) if visit.is_a?(ScheduleView::Busy) %><%# JOB-08 %>
                <% next concat(render("admin/schedule/follow_up", follow_up: visit, column: ScheduleView::Column.new(date, nil), schedule: s, as: :row, own:)) if visit.is_a?(RequestFollowUp) %><%# JOB-07 %>
                <li class="p-0"><%= link_to admin_schedule_visit_path(visit, s.member ? { member: s.member } : {}), class: "flex min-w-0 flex-1 items-start gap-3 px-4 py-3", data: { schedule_focus: visit.uid } do %>
                  <span class="w-16 shrink-0 text-sm font-semibold text-ink"><%= visit.time_label.delete_prefix("Arrive ") %></span>
                  <span class="min-w-0 flex-1"><span class="block truncate font-medium text-ink"><%= visit.job.client.display_name %></span>
                    <span class="block truncate text-sm2 text-muted"><%= visit.job.title %> · <%= crew_first_names(visit) %><%= " · #{visit.job.location.name}" if show_locations %><%= schedule_status_words(visit) %></span>
                    <% if (label = on_the_way_label(visit)) %><span class="block truncate text-sm2 font-semibold text-ink"><%= label %></span><% end %></span>
                  <span class="cal-dot cal-<%= s.visit_color(visit) %> mt-1.5" aria-hidden="true"></span>
                <% end %></li>
              <% end %>
            </ul>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <%# Desktop: the time grid, "anytime" visits in a row above it. A day for everyone has a column
        per person. Visits can be dragged to another day, time or person (schedule_drag_controller);
        on the keyboard, a visit opens with Enter or Space and has Move. Each empty hour is a link to
        a new visit there, one tab stop (at its column's place) moved with the arrow keys (schedule_slots_controller). %>
    <% params_now = { view: s.view, member: s.member }.compact_blank %>
    <div class="card hidden overflow-x-auto md:block <%= inline_style("--cal-days: #{s.columns.size}") %>" id="schedule-grid"
         data-turbo-prefetch="false" data-controller="schedule-drag schedule-slots" data-action="keydown->schedule-slots#keydown focusin->schedule-slots#focused click->schedule-slots#focused" data-schedule-drag-first-hour-value="<%= s.hours.first %>" data-schedule-drag-hour-px-value="<%= ScheduleView::HOUR_PX %>"
         data-schedule-drag-url-value="<%= admin_schedule_move_path("ID") %>" data-schedule-drag-context-value="<%= params_now.merge(grid_zone: s.place.time_zone.tzinfo.identifier).to_json %>">
      <div class="cal-grid border-b border-line <%= "cal-wide" if s.columns.size > 7 %>">
        <div></div>
        <% s.columns.each do |column| %>
          <% date = column.date %>
          <% today = date == s.business.today && !s.by_person? %>
          <div class="min-w-0 border-l border-line-2 px-2 py-2 text-sm2 <%= today ? "font-semibold text-ink" : "text-muted" %>" <%= 'aria-current="date"'.html_safe if today %>>
            <% if column.member == :none %>
              <%= link_to "Not assigned", admin_schedule_path(schedule_link_params(s, member: "unassigned")), class: "block truncate font-medium text-ink hover:underline" %>
            <% elsif column.member %>
              <%= link_to admin_schedule_path(schedule_link_params(s, member: column.member.id)), class: "flex items-center gap-1.5 font-medium text-ink hover:underline" do %>
                <span class="cal-dot cal-<%= s.color_for(column.member) %>" aria-hidden="true"></span><span class="truncate"><%= column.member.full_name %></span>
              <% end %>
            <% else %>
              <%= link_to admin_schedule_path(schedule_link_params(s, view: "day", date: date.iso8601)), class: "hover:underline" do %><%= date.strftime("%a") %> <span class="figure text-ink"><%= date.day %></span><% end %>
              <% s.closures_on(date).each do |closure| %><span class="block truncate text-sm2 text-muted" title="<%= closure.reason %>">Closed: <%= closure.reason %></span><% end %>
            <% end %>
          </div>
        <% end %>
      </div>
      <div class="cal-grid border-b border-line bg-sunken/40 <%= "cal-wide" if s.columns.size > 7 %>">
        <div class="py-1.5 pr-2 text-right text-sm2 text-muted">Anytime</div><%# QA #274: muted, 4.58:1 on this row (faint was 2.47:1) %>
        <% s.columns.each do |column| %>
          <% date = column.date %>
          <div class="min-h-9 min-w-0 space-y-1 border-l border-line-2 p-1" role="group" aria-label="Anytime, <%= schedule_column_label(column) %>"
               data-schedule-drag-target="column" data-kind="anytime" data-date="<%= date.iso8601 %>" data-member="<%= column.member_key %>">
            <% s.anytime_in(column).each do |visit| %>
              <% next concat(render("admin/schedule/busy", busy: visit, schedule: s, as: :chip)) if visit.is_a?(ScheduleView::Busy) %><%# JOB-08 %>
              <% next concat(render("admin/schedule/follow_up", follow_up: visit, column:, schedule: s, as: :chip, own:)) if visit.is_a?(RequestFollowUp) %><%# JOB-07 %>
              <%= link_to admin_schedule_visit_path(visit, params_now), class: "cal-chip cal-#{s.visit_color(visit)}", id: schedule_visit_id(visit, column, s),
                          data: { turbo_frame: "schedule_visit", schedule_focus: visit.uid, **schedule_drag_data(visit, column) } do %>
                <span class="block truncate font-semibold"><%= visit.job.client.display_name %> <span class="sr-only">, anytime <%= date.strftime("%A, %B %-d") %></span></span>
                <span class="block truncate"><%= visit.job.title %><%= ", #{visit.job.property.city}" if visit.job.property&.city.present? %> · <%= crew_first_names(visit) %><%= " · #{visit.job.location.name}" if show_locations %><%= schedule_status_words(visit) %></span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
      <div class="max-h-[42rem] overflow-y-auto pt-2">
        <div class="cal-grid <%= "cal-wide" if s.columns.size > 7 %> <%= inline_style("height: #{s.grid_height}px") %>">
          <div><% s.hours.each do |hour| %><div class="cal-hour"><%= hour_label(hour) %></div><% end %></div>
          <% start_col = s.columns.index { _1.date == s.place.today } || s.columns.index { s.bookable?(_1.date) } %>
          <% start_row = s.hours.to_a.index(9) || 0 %>
          <% s.columns.each_with_index do |column, col| %>
            <% date = column.date %>
            <div class="cal-day" role="group" aria-label="<%= schedule_column_label(column) %>"
                 data-schedule-drag-target="column" data-kind="timed" data-date="<%= date.iso8601 %>" data-member="<%= column.member_key %>">
              <% s.shades_on(date).each do |shade| %><div class="cal-shade <%= inline_style("top: #{shade.top}px; height: #{shade.height}px") %>"></div><% end %>
              <% if s.bookable?(date) %><% s.hours.each_with_index do |hour, row| %>
                <%= link_to admin_schedule_new_visit_path(schedule_slot_params(column, hour, s)), class: "cal-slot #{inline_style("top: #{row * ScheduleView::HOUR_PX}px")}",
                            data: { turbo_frame: "schedule_visit", schedule_slots_target: "slot", schedule_focus: schedule_slot_key(column, hour), col:, row:, start: (col == start_col && row == start_row) } do %>
                  <span class="sr-only"><%= schedule_slot_label(column, hour, busy: s.busy_during(column, hour)) %></span><span class="cal-slot-hint" aria-hidden="true">+ New visit</span>
                <% end %>
              <% end %><% end %>
              <% s.placed_in(column).each do |placed| %>
                <% visit = placed.visit %>
                <% width = 100.0 / placed.columns %>
                <% place = inline_style("top: #{placed.top}px; height: #{placed.height}px; left: calc(#{(width * placed.column).round(3)}% + 2px); width: calc(#{width.round(3)}% - 4px)") %>
                <% next concat(render("admin/schedule/busy", busy: visit, schedule: s, as: :block, style: place)) if visit.is_a?(ScheduleView::Busy) %><%# JOB-08 %>
                <% next concat(render("admin/schedule/follow_up", follow_up: visit, column:, schedule: s, as: :block, style: place, own:)) if visit.is_a?(RequestFollowUp) %><%# JOB-07 %>
                <%= link_to admin_schedule_visit_path(visit, params_now), class: "cal-visit cal-#{s.visit_color(visit)} #{inline_style("top: #{placed.top}px; height: #{placed.height}px; left: calc(#{(width * placed.column).round(3)}% + 2px); width: calc(#{width.round(3)}% - 4px)")}", id: schedule_visit_id(visit, column, s),
                            data: { turbo_frame: "schedule_visit", schedule_focus: visit.uid, **schedule_drag_data(visit, column) } do %>
                  <span class="block font-semibold"><%= schedule_time_label(visit, s) %> <%= visit.job.client.display_name %><span class="sr-only">, <%= date.strftime("%A, %B %-d") %></span></span>
                  <span class="block truncate"><%= visit.job.title %><%= ", #{visit.job.property.city}" if visit.job.property&.city.present? %></span>
                  <span class="block truncate opacity-80"><%= crew_first_names(visit) %><%= " · #{visit.job.location.name}" if show_locations %><%= schedule_status_words(visit) %></span>
                  <% if visit.on_the_way? %><span class="block truncate font-semibold">On the way</span><% end %><%# JOB-12 %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
      <%# Described by from schedule_slots_controller, so it's only announced when the keys work. %>
      <p class="sr-only" id="schedule-slots-help">Arrow keys move between hours and <%= s.by_person? ? "people" : "days" %>; Home and End go to the first and last hour. Enter or Space starts a new visit at that time.</p>
      <p class="sr-only" role="status" data-schedule-drag-target="status"></p>
      <%= inline_styles_tag %>
    </div>
  </div>
</div>

<%# locals: (follow_up:) -%>
<%# JOB-07: a request follow-up opened from the calendar: the request in brief, and Open request,
    Move, Reassign and Unassign (people who can manage requests are the only ones who get here). %>
<%= turbo_frame_tag "schedule_visit" do %>
  <% request_record = follow_up.service_request %>
  <%= card title: request_record.client.display_name, subtitle: "#{follow_up.kind_label} for a request · #{follow_up.when_label}" do %>
    <dl class="space-y-2 text-sm">
      <div><dt class="text-sm2 text-muted">Asked for</dt><dd class="text-ink"><%= request_record.service_names.join(", ").presence || truncate(request_record.description.to_s, length: 120) %></dd></div>
      <% if current_business.multiple_locations? %><div><dt class="text-sm2 text-muted">Location</dt><dd class="text-ink"><%= request_record.location.name %></dd></div><% end %>
      <% if (where = request_record.property&.one_line || request_record.address_line) %><div><dt class="text-sm2 text-muted">Where</dt><dd class="text-ink"><%= where %></dd></div><% end %>
      <div><dt class="text-sm2 text-muted">Who</dt><dd class="text-ink"><%= follow_up.user.full_name %></dd></div>
      <div><dt class="text-sm2 text-muted">How long</dt><dd class="text-ink">About <%= follow_up.duration_label %><%= " · Done" if follow_up.done? %></dd></div>
      <% if follow_up.instructions %><div><dt class="text-sm2 text-muted">Instructions</dt><dd class="whitespace-pre-line text-ink"><%= follow_up.instructions %></dd></div><% end %>
    </dl>
    <div class="mt-4 flex flex-wrap gap-2">
      <%= link_to "Open request", admin_service_request_path(request_record), class: button_classes(:secondary, :sm), data: { turbo_frame: "_top" } %>
      <%= render "admin/schedule/follow_up_move", follow_up:, warnings: (@warnings if follow_up == @follow_up), proposed: (@proposed if follow_up == @follow_up) %>
      <%= link_to "Reassign", edit_admin_service_request_follow_up_path(request_record), class: button_classes(:ghost, :sm), data: { turbo_frame: "_top" } %>
      <%= button_to "Unassign", admin_service_request_follow_up_path(request_record), method: :delete, params: { lock_version: follow_up.lock_version, from: "schedule" },
                    class: button_classes(:ghost, :sm), form: { class: "contents", data: { turbo_frame: "_top", turbo_confirm: "Take this off #{follow_up.user.full_name}? Nobody will be following it up.", turbo_confirm_button: "Unassign" } } %>
      <button type="button" class="<%= button_classes(:ghost, :sm) %>" data-action="schedule-panel#close" data-schedule-panel-target="close" hidden>Close</button>
    </div>
  <% end %>
<% end %>

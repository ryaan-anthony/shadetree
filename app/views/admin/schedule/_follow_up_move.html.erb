<%# locals: (follow_up:, warnings: nil, proposed: nil) -%>
<%# JOB-07: moving a follow-up from the calendar, as a visit's quick edit (JOB-03): its day, start
    and person, in a sheet on phones; the keyboard's way to do what dragging does. %>
<% proposed ||= { on: follow_up.scheduled_on, at: follow_up.start_time, user_id: follow_up.user_id } %>
<% members = current_business.business_users.active.includes(:user).select { RequestFollowUp.assignable?(_1) }.map(&:user).sort_by { _1.full_name.downcase } %>
<% key = follow_up.service_request.uid %>
<div class="contents" data-controller="modal" data-modal-open-value="<%= warnings.present? %>">
  <button type="button" class="<%= button_classes(:secondary, :sm) %>" data-action="modal#open" data-modal-target="return" aria-haspopup="dialog">Move</button>
  <%= modal id: "move-request-#{key}", title: "Move #{follow_up.service_request.client.display_name}", description: "#{follow_up.kind_label} for a request", sheet: true do %>
    <%= form_with url: admin_schedule_follow_up_move_path(follow_up.service_request), method: :patch, class: "space-y-4", data: { turbo_frame: "_top" } do %>
      <%= hidden_field_tag :lock_version, follow_up.lock_version, id: nil %>
      <%= hidden_field_tag :view, params[:view], id: nil if params[:view].present? %>
      <%= hidden_field_tag :member, params[:member], id: nil if params[:member].present? %>
      <% if warnings.present? %>
        <div class="banner banner-warning" role="alert"><%= icon "alert-triangle" %>
          <div><p class="font-semibold">Before you move this</p>
            <ul class="mt-1 list-disc pl-5"><% warnings.each do |warning| %><li><%= warning %></li><% end %></ul>
            <p class="mt-1">You can still move it, or change it below.</p></div>
        </div>
        <%= hidden_field_tag :confirm, Admin::VisitsController.digest(warnings), id: nil %>
      <% end %>
      <div class="grid grid-cols-2 gap-3">
        <div class="field">
          <label class="label" for="move-request-<%= key %>-on">Day</label>
          <%= date_field_tag :on, proposed[:on]&.iso8601, class: "input", id: "move-request-#{key}-on", required: true %>
        </div>
        <% unless follow_up.anytime? %>
          <div class="field">
            <label class="label" for="move-request-<%= key %>-at"><%= follow_up.window? ? "Window starts" : "Starts" %></label>
            <%= time_field_tag :at, proposed[:at], class: "input", id: "move-request-#{key}-at", step: 900, required: true %>
          </div>
        <% end %>
      </div>
      <div class="field">
        <label class="label" for="move-request-<%= key %>-to">Who</label>
        <%= select_tag :to, options_for_select(members.map { [ _1.full_name, _1.id ] }, proposed[:user_id]), class: "select", id: "move-request-#{key}-to" %>
      </div>
      <div class="flex justify-end gap-2">
        <button type="button" class="<%= button_classes(:secondary) %>" data-action="modal#close">Keep as is</button>
        <%= submit_tag warnings.present? ? "Move anyway" : "Move follow-up", class: button_classes(:primary), name: nil %>
      </div>
    <% end %>
  <% end %>
</div>

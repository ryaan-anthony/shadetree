<%# NTF-02: this member's notifications in the current business, newest first. %>
<% content_for :title, "Notifications" %>
<%= page_header "Notifications", lede: "What's happened in #{current_business.name} that needs you." do %>
  <%= link_to settings_admin_notifications_path, class: button_classes(:secondary) do %><%= icon "settings" %> Email settings<% end %>
  <% if @notifications.any? { !_1.read? } %>
    <%= button_to "Mark all as read", read_all_admin_notifications_path, method: :patch, class: button_classes(:secondary), form: { class: "contents" } %>
  <% end %>
<% end %>

<div class="max-w-3xl">
  <% if @notifications.empty? %>
    <div class="card"><%= empty_state title: "Nothing yet", text: "New requests, clients opening and answering quotes, and teammates joining show up here.", icon: "bell" %></div>
  <% else %>
    <%= card flush: true do %>
      <ul class="list" id="notifications">
        <% @notifications.each do |notification| %>
          <li id="notification-<%= notification.uid %>" class="<%= "bg-info-50/40" unless notification.read? %>">
            <%= icon notification.type.icon, class: "size-4 shrink-0 #{notification.read? ? "text-faint" : "text-info-ink"}" %>
            <%= link_to open_admin_notification_path(notification), class: "min-w-0 flex-1", data: { turbo_prefetch: false } do %>
              <span class="block <%= notification.read? ? "text-ink" : "font-semibold text-ink" %>"><%= notification.title %><%= tag.span(", unread", class: "sr-only") unless notification.read? %></span>
              <% if notification.body %><span class="block truncate text-sm2 text-muted"><%= notification.body %></span><% end %>
              <span class="block text-sm2 text-subtle"><%= local_time_ago(notification.created_at) %></span>
            <% end %>
            <% unless notification.read? %>
              <%= button_to read_admin_notification_path(notification), method: :patch, class: button_classes(:ghost, :sm, :icon), form: { class: "contents" },
                            "aria-label": "Mark “#{notification.title}” as read" do %><%= icon "check" %><% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <p class="mt-3 text-sm2 text-muted">Notifications are kept for <%= Notification::RETENTION.in_days.to_i %> days.</p>
  <% end %>
</div>

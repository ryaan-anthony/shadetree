<%# locals: (closure:) -%>
<% closure_name = closure.reason.presence || closure.dates_label %>
<li id="closure-<%= closure.uid %>">
  <div class="min-w-0 flex-1">
    <p class="font-semibold text-ink"><%= link_to closure.reason, edit_admin_closure_path(closure), class: "hover:underline" %>
      <% if closure.repeats_yearly %><%= badge "Every year", tone: :info, dot: false %><% end %></p>
    <p class="text-sm2 text-muted"><%= closure.dates_label %><%= " · all day" if closure.all_day? %></p>
  </div>
  <%= menu label: "More actions for #{closure.reason}", size: :sm do %>
    <%= link_to edit_admin_closure_path(closure), class: "menu-item", "aria-label": "Edit #{closure_name}" do %><%= icon "edit-2" %> Edit<% end %>
    <%= button_to admin_closure_path(closure), method: :delete, class: "menu-item text-danger", "aria-label": "Remove #{closure_name}", form: { class: "contents", data: { turbo_confirm: "Remove #{closure.reason}?", turbo_confirm_button: "Remove", turbo_confirm_variant: "destructive" } } do %><%= icon "trash-2" %> Remove<% end %>
  <% end %>
</li>

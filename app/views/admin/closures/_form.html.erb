<%= form_with model: @closure, url: (@closure.persisted? ? admin_closure_path(@closure) : admin_closures_path(location: @closure.location)), class: "max-w-xl space-y-4" do |f| %>
  <% if @closure.errors[:base].any? %>
    <div class="banner banner-danger" role="alert"><%= icon "alert-circle" %><p><%= @closure.errors[:base].to_sentence %></p></div>
  <% end %>
  <% if @closure.location %><p class="text-sm2 text-muted">For <strong class="text-ink"><%= @closure.location.name %></strong>.</p><% end %>
  <%= card do %>
    <%= f.field :reason, autofocus: @closure.new_record?, maxlength: 60, placeholder: "Thanksgiving", help: "Your team sees this on the schedule." %>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <%= f.field :starts_on, as: :date %>
      <%= f.field :ends_on, as: :date, optional: true, required: false, help: "For more than one day." %>
    </div>
    <div class="group mt-4">
      <%= f.check :part_of_day, label: "Only part of the day", hint: "For example, closing at noon on Christmas Eve. The same times apply to each day." %>
      <div class="mt-3 hidden gap-4 group-has-checked:grid sm:grid-cols-2">
        <%= f.field :start_time, as: :time, required: false, value: @closure.start_time || "12:00", step: 300 %>
        <%= f.field :end_time, as: :time, required: false, optional: true, value: @closure.end_time, step: 300, help: "Leave empty to close for the rest of the day." %>
      </div>
    </div>
    <div class="mt-4">
      <%= f.check :repeats_yearly, label: "Every year", hint: "On the same dates each year, like Christmas Day. Not for holidays that move, like Thanksgiving." %>
      <% if (error = @closure.errors.full_messages_for(:repeats_yearly).first) %><p class="error-text"><%= icon "alert-circle" %><%= error %></p><% end %>
    </div>
  <% end %>
  <div class="flex items-center justify-end gap-2">
    <%= link_to "Cancel", hours_path, class: button_classes(:ghost) %>
    <%= f.submit_button @closure.persisted? ? "Save closure" : "Add closure" %>
  </div>
<% end %>

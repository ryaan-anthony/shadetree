<!-- Step 1: Basic Business Information -->
<div data-step-content class="max-w-4xl mx-auto">
    <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-3">Tell us about your business</h2>
        <p class="text-lg text-gray-600">
            Help us understand your business so we can tailor Shadetree to your needs
        </p>
    </div>

    <%= form_with(model: [@business], url: admin_business_onboarding_index_path, local: true,
                  html: { class: "space-y-8", "data-step-form": true }) do |form| %>
        <%= hidden_field_tag :step, 'basics' %>

        <!-- Display errors with enhanced styling -->
        <% if @business.errors.any? %>
            <div class="rounded-xl bg-red-50 border border-red-200 p-6">
                <div class="flex items-start">
                    <div class="flex-shrink-0">
                        <i data-feather="alert-triangle" class="h-6 w-6 text-red-500"></i>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-semibold text-red-800 mb-2">Please fix the following errors:</h3>
                        <ul class="list-disc list-inside space-y-1 text-red-700">
                            <% @business.errors.full_messages.each do |message| %>
                                <li><%= message %></li>
                            <% end %>
                        </ul>
                    </div>
                </div>
            </div>
        <% end %>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Left Column -->
            <div class="space-y-6">
                <!-- Business Name -->
                <div class="form-group">
                    <%= form.label :name, class: "block text-sm font-semibold text-gray-700 mb-3" do %>
                        Business Name <span class="text-red-500">*</span>
                    <% end %>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i data-feather="briefcase" class="h-5 w-5 text-gray-400 group-focus-within:text-shadetree-blue transition-colors"></i>
                        </div>
                        <%= form.text_field :name, autofocus: true, required: true,
                            class: "block w-full pl-12 pr-4 py-4 text-lg border border-gray-300 rounded-xl shadow-sm transition-all duration-200 focus:ring-2 focus:ring-shadetree-blue focus:border-shadetree-blue hover:border-gray-400",
                            placeholder: "Enter your business name" %>
                    </div>
                </div>

                <!-- Industry Selection -->
                <div class="form-group">
                    <%= form.label :industry, "Industry", class: "block text-sm font-semibold text-gray-700 mb-3" %>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i data-feather="tag" class="h-5 w-5 text-gray-400 group-focus-within:text-shadetree-blue transition-colors"></i>
                        </div>
                        <%= form.select :industry,
                            options_for_select([
                                ['Select your industry', ''],
                                ['Landscaping & Lawn Care', 'landscaping'],
                                ['Home Maintenance & Repair', 'maintenance'],
                                ['Cleaning Services', 'cleaning'],
                                ['HVAC Services', 'hvac'],
                                ['Plumbing Services', 'plumbing'],
                                ['Electrical Services', 'electrical'],
                                ['Roofing Services', 'roofing'],
                                ['Painting Services', 'painting'],
                                ['Pool & Spa Services', 'pool'],
                                ['Pest Control', 'pest'],
                                ['Other Service Business', 'other']
                            ], @business.industry),
                            {},
                            { class: "block w-full pl-12 pr-10 py-4 text-lg border border-gray-300 rounded-xl shadow-sm transition-all duration-200 focus:ring-2 focus:ring-shadetree-blue focus:border-shadetree-blue hover:border-gray-400" } %>
                    </div>
                </div>

                <!-- Business Email -->
                <div class="form-group">
                    <%= form.label :email, class: "block text-sm font-semibold text-gray-700 mb-3" do %>
                        Business Email <span class="text-red-500">*</span>
                    <% end %>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i data-feather="mail" class="h-5 w-5 text-gray-400 group-focus-within:text-shadetree-blue transition-colors"></i>
                        </div>
                        <%= form.email_field :email, required: true,
                            class: "block w-full pl-12 pr-4 py-4 text-lg border border-gray-300 rounded-xl shadow-sm transition-all duration-200 focus:ring-2 focus:ring-shadetree-blue focus:border-shadetree-blue hover:border-gray-400",
                            placeholder: "your.business@example.com" %>
                    </div>
                </div>

                <!-- Business Phone -->
                <div class="form-group">
                    <%= form.label :phone, "Business Phone", class: "block text-sm font-semibold text-gray-700 mb-3" %>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i data-feather="phone" class="h-5 w-5 text-gray-400 group-focus-within:text-shadetree-blue transition-colors"></i>
                        </div>
                        <%= form.telephone_field :phone,
                            class: "block w-full pl-12 pr-4 py-4 text-lg border border-gray-300 rounded-xl shadow-sm transition-all duration-200 focus:ring-2 focus:ring-shadetree-blue focus:border-shadetree-blue hover:border-gray-400",
                            placeholder: "(555) 123-4567" %>
                    </div>
                </div>
            </div>

            <!-- Right Column -->
            <div class="space-y-6">
                <!-- Business Description -->
                <div class="form-group">
                    <%= form.label :description, "Business Description", class: "block text-sm font-semibold text-gray-700 mb-3" %>
                    <div class="relative group">
                        <div class="absolute top-4 left-0 pl-4 flex items-start pointer-events-none">
                            <i data-feather="edit-3" class="h-5 w-5 text-gray-400 group-focus-within:text-shadetree-blue transition-colors"></i>
                        </div>
                        <%= form.text_area :description, rows: 4,
                            class: "block w-full pl-12 pr-4 py-4 text-lg border border-gray-300 rounded-xl shadow-sm transition-all duration-200 focus:ring-2 focus:ring-shadetree-blue focus:border-shadetree-blue hover:border-gray-400 resize-none",
                            placeholder: "Briefly describe what your business does and what makes you unique..." %>
                    </div>
                    <p class="mt-2 text-sm text-gray-500">This helps customers understand your services</p>
                </div>

                <!-- Website -->
                <div class="form-group">
                    <%= form.label :website, "Website", class: "block text-sm font-semibold text-gray-700 mb-3" %>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i data-feather="globe" class="h-5 w-5 text-gray-400 group-focus-within:text-shadetree-blue transition-colors"></i>
                        </div>
                        <%= form.url_field :website,
                            class: "block w-full pl-12 pr-4 py-4 text-lg border border-gray-300 rounded-xl shadow-sm transition-all duration-200 focus:ring-2 focus:ring-shadetree-blue focus:border-shadetree-blue hover:border-gray-400",
                            placeholder: "https://your-website.com" %>
                    </div>
                </div>

                <!-- Business Address -->
                <div class="form-group">
                    <%= form.label :address, "Business Address", class: "block text-sm font-semibold text-gray-700 mb-3" %>
                    <div class="relative group">
                        <div class="absolute top-4 left-0 pl-4 flex items-start pointer-events-none">
                            <i data-feather="map-pin" class="h-5 w-5 text-gray-400 group-focus-within:text-shadetree-blue transition-colors"></i>
                        </div>
                        <%= form.text_area :address, rows: 3,
                            class: "block w-full pl-12 pr-4 py-4 text-lg border border-gray-300 rounded-xl shadow-sm transition-all duration-200 focus:ring-2 focus:ring-shadetree-blue focus:border-shadetree-blue hover:border-gray-400 resize-none",
                            placeholder: "123 Main Street&#10;Suite 100&#10;City, State 12345".html_safe %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pro Tips Section -->
        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-xl p-6">
            <div class="flex items-start">
                <div class="flex-shrink-0">
                    <i data-feather="lightbulb" class="h-6 w-6 text-blue-600"></i>
                </div>
                <div class="ml-4">
                    <h3 class="text-lg font-semibold text-blue-900 mb-2">Pro Tips</h3>
                    <ul class="text-blue-800 space-y-1 text-sm">
                        <li>• Choose a business name that's easy for customers to remember and spell</li>
                        <li>• Your business description appears on quotes and helps customers understand your services</li>
                        <li>• A professional email address builds trust with customers</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Navigation -->
        <div class="flex justify-between items-center pt-8 border-t border-gray-200">
            <div class="text-sm text-gray-500">
                Step 1 of 4 • Basic Information
            </div>

            <button type="submit"
                    class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-shadetree-blue to-indigo-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-shadetree-blue">
                Continue to Hours
                <i data-feather="arrow-right" class="ml-2 h-5 w-5"></i>
            </button>
        </div>
    <% end %>
</div>

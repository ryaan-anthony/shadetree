<!-- Step 2: Operating Hours -->
<div data-step-content class="max-w-4xl mx-auto">
    <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-12 h-12 bg-gradient-to-r from-green-500 to-emerald-600 rounded-xl mb-4">
            <i data-feather="clock" class="h-6 w-6 text-white"></i>
        </div>
        <h2 class="text-3xl font-bold text-gray-900 mb-3">Set your operating hours</h2>
        <p class="text-lg text-gray-600">
            Let customers know when you're available to serve them
        </p>
    </div>

    <%= form_with(url: admin_business_onboarding_index_path, method: :post, local: true,
                  html: { class: "space-y-8", "data-step-form": true }) do |form| %>
        <%= hidden_field_tag :step, 'hours' %>


        <!-- Custom Hours Configuration -->
        <div id="custom-hours-section" class="space-y-6">
            <div class="flex items-center justify-between">
                <h3 class="text-xl font-semibold text-gray-900">Weekly Schedule</h3>
                <div class="flex items-center space-x-2 text-sm text-gray-600">
                    <i data-feather="info" class="h-4 w-4"></i>
                    <span>Toggle days on/off and set specific hours</span>
                </div>
            </div>

            <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
                <% %w[Monday Tuesday Wednesday Thursday Friday Saturday Sunday].each_with_index do |day, index| %>
                    <div class="flex items-center p-6 <%= index < 6 ? 'border-b border-gray-100' : '' %> hover:bg-gray-50 transition-colors">
                        <!-- Day Toggle -->
                        <div class="flex items-center min-w-[140px]">
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" name="<%= day.downcase %>_enabled" value="1"
                                       class="sr-only peer day-toggle" <%= 'checked' if index < 5 %>>
                                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
                                <span class="ml-3 font-medium text-gray-900"><%= day %></span>
                            </label>
                        </div>

                        <!-- Time Selection -->
                        <div class="flex items-center space-x-4 ml-auto">
                            <div class="flex items-center space-x-2">
                                <select name="<%= day.downcase %>_start"
                                        class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 time-select">
                                    <% (6..11).each do |hour| %>
                                        <option value="<%= hour %>:00" <%= 'selected' if hour == 9 %>><%= hour %>:00 AM</option>
                                        <option value="<%= hour %>:30"><%= hour %>:30 AM</option>
                                    <% end %>
                                    <option value="12:00">12:00 PM</option>
                                    <option value="12:30">12:30 PM</option>
                                </select>

                                <span class="text-gray-500 font-medium">to</span>

                                <select name="<%= day.downcase %>_end"
                                        class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 time-select">
                                    <% (1..11).each do |hour| %>
                                        <option value="<%= hour + 12 %>:00" <%= 'selected' if hour == 5 %>><%= hour %>:00 PM</option>
                                        <option value="<%= hour + 12 %>:30"><%= hour %>:30 PM</option>
                                    <% end %>
                                </select>
                            </div>
                        </div>
                    </div>
                <% end %>
            </div>
        </div>

        <!-- Time Zone Selection -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="form-group">
                <label class="block text-sm font-semibold text-gray-700 mb-3">Time Zone</label>
                <div class="relative group">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <i data-feather="globe" class="h-5 w-5 text-gray-400 group-focus-within:text-emerald-500 transition-colors"></i>
                    </div>
                    <select name="timezone" class="block w-full pl-12 pr-10 py-4 text-lg border border-gray-300 rounded-xl shadow-sm transition-all duration-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 hover:border-gray-400">
                        <option value="America/New_York">Eastern Time (UTC-5)</option>
                        <option value="America/Chicago">Central Time (UTC-6)</option>
                        <option value="America/Denver">Mountain Time (UTC-7)</option>
                        <option value="America/Los_Angeles">Pacific Time (UTC-8)</option>
                    </select>
                </div>
            </div>

            <!-- Schedule Summary -->
            <div class="bg-gray-50 border border-gray-200 rounded-xl p-6">
                <h4 class="font-semibold text-gray-900 mb-4">Schedule Summary</h4>
                <div id="schedule-summary" class="space-y-2 text-sm">
                    <div class="flex justify-between">
                        <span class="text-gray-600">Monday:</span>
                        <span class="font-medium">9:00 AM - 5:00 PM</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Tuesday:</span>
                        <span class="font-medium">9:00 AM - 5:00 PM</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Wednesday:</span>
                        <span class="font-medium">9:00 AM - 5:00 PM</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Thursday:</span>
                        <span class="font-medium">9:00 AM - 5:00 PM</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Friday:</span>
                        <span class="font-medium">9:00 AM - 5:00 PM</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Saturday:</span>
                        <span class="text-gray-500">Closed</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Sunday:</span>
                        <span class="text-gray-500">Closed</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pro Tips -->
        <div class="bg-gradient-to-r from-emerald-50 to-green-50 border border-emerald-200 rounded-xl p-6">
            <div class="flex items-start">
                <div class="flex-shrink-0">
                    <i data-feather="lightbulb" class="h-6 w-6 text-emerald-600"></i>
                </div>
                <div class="ml-4">
                    <h3 class="text-lg font-semibold text-emerald-900 mb-2">Scheduling Tips</h3>
                    <ul class="text-emerald-800 space-y-1 text-sm">
                        <li>• Your hours appear on quotes and help customers know when to expect service</li>
                        <li>• You can always adjust these later and set holiday hours in your settings</li>
                        <li>• Consider your target customers' schedules when setting availability</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Navigation -->
        <div class="flex justify-between items-center pt-8 border-t border-gray-200">
            <button type="button" onclick="window.history.back()"
                    class="inline-flex items-center px-6 py-3 text-gray-600 hover:text-gray-900 font-medium transition-colors">
                <i data-feather="arrow-left" class="mr-2 h-5 w-5"></i>
                Back to Basics
            </button>

            <div class="flex items-center space-x-4">
                <div class="text-sm text-gray-500">
                    Step 2 of 4 • Operating Hours
                </div>
                <button type="submit"
                        class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-emerald-500 to-green-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500">
                    Continue to Location
                    <i data-feather="arrow-right" class="ml-2 h-5 w-5"></i>
                </button>
            </div>
        </div>
    <% end %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    setupHoursPresets();
    updateScheduleSummary();
});

function setupHoursPresets() {
    // Listen for manual changes to checkboxes and time selects
    document.querySelectorAll('.day-toggle, .time-select').forEach(input => {
        input.addEventListener('change', updateScheduleSummary);
    });
}

function updateScheduleSummary() {
    const summary = document.getElementById('schedule-summary');
    if (!summary) return;

    const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
    const dayNames = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];

    let summaryHTML = '';

    days.forEach((day, index) => {
        const checkbox = document.querySelector(`input[name="${day}_enabled"]`);
        const startSelect = document.querySelector(`select[name="${day}_start"]`);
        const endSelect = document.querySelector(`select[name="${day}_end"]`);

        if (checkbox && checkbox.checked) {
            const startTime = formatTime(startSelect.value);
            const endTime = formatTime(endSelect.value);
            summaryHTML += `
                <div class="flex justify-between">
                    <span class="text-gray-600">${dayNames[index]}:</span>
                    <span class="font-medium">${startTime} - ${endTime}</span>
                </div>
            `;
        } else {
            // Show "Closed" for any unchecked day
            summaryHTML += `
                <div class="flex justify-between">
                    <span class="text-gray-600">${dayNames[index]}:</span>
                    <span class="text-gray-500">Closed</span>
                </div>
            `;
        }
    });

    summary.innerHTML = summaryHTML;
}

function formatTime(time24) {
    const [hours, minutes] = time24.split(':');
    const hour = parseInt(hours);
    const ampm = hour >= 12 ? 'PM' : 'AM';
    const displayHour = hour > 12 ? hour - 12 : (hour === 0 ? 12 : hour);
    return `${displayHour}:${minutes} ${ampm}`;
}
</script>

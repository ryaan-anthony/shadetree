<!-- Step 3: Location & Service Areas -->
<div class="space-y-6">
    <div class="text-center mb-6">
        <h3 class="text-2xl font-bold text-enterprise-navy">Location & Service Areas</h3>
        <p class="text-sm text-enterprise-gray mt-2">
            Define where your business is located and which areas you serve
        </p>
    </div>

    <%= form_with(model: [@business], url: admin_business_onboarding_index_path, local: true, html: { class: "space-y-6" }) do |form| %>
        <%= hidden_field_tag :step, 'location' %>

        <!-- Business Location Type -->
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
            <h4 class="text-sm font-medium text-blue-900 mb-3">Business Location Type</h4>
            <div class="space-y-2">
                <label class="flex items-center">
                    <input type="radio" name="location_type" value="fixed" class="text-shadetree-blue focus:ring-shadetree-blue" checked>
                    <span class="ml-2 text-sm text-gray-700">Fixed Location (customers come to you)</span>
                </label>
                <label class="flex items-center">
                    <input type="radio" name="location_type" value="mobile" class="text-shadetree-blue focus:ring-shadetree-blue">
                    <span class="ml-2 text-sm text-gray-700">Mobile Service (you travel to customers)</span>
                </label>
                <label class="flex items-center">
                    <input type="radio" name="location_type" value="both" class="text-shadetree-blue focus:ring-shadetree-blue">
                    <span class="ml-2 text-sm text-gray-700">Both (fixed location + mobile service)</span>
                </label>
            </div>
        </div>

        <!-- Business Address (already filled from step 1, but can be refined) -->
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">
                Business Address
                <span class="text-xs text-gray-500">(from step 1)</span>
            </label>
            <div class="relative">
                <div class="absolute top-3 left-0 pl-3 flex items-start pointer-events-none">
                    <i data-feather="map-pin" class="h-5 w-5 text-gray-400"></i>
                </div>
                <%= form.text_area :address, rows: 2,
                    class: "border pl-10 shadow-sm focus:ring-shadetree-blue focus:border-shadetree-blue block w-full sm:text-sm border-gray-300 rounded-md py-3 resize-none bg-gray-50",
                    readonly: true %>
            </div>
            <p class="mt-1 text-xs text-gray-500">
                <button type="button" class="text-shadetree-blue hover:text-blue-800" onclick="enableAddressEdit()">
                    Update address
                </button>
            </p>
        </div>

        <!-- Service Area Radius (for mobile services) -->
        <div id="service-area-section">
            <label class="block text-sm font-medium text-gray-700 mb-2">Service Area Radius</label>
            <div class="space-y-4">
                <div class="flex items-center space-x-4">
                    <div class="relative flex-1">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i data-feather="target" class="h-5 w-5 text-gray-400"></i>
                        </div>
                        <%= form.number_field :service_area_radius, step: 0.1, min: 0, max: 100,
                            class: "border pl-10 pr-16 shadow-sm focus:ring-shadetree-blue focus:border-shadetree-blue block w-full sm:text-sm border-gray-300 rounded-md py-3",
                            placeholder: "25" %>
                        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                            <span class="text-gray-500 text-sm">miles</span>
                        </div>
                    </div>
                </div>

                <!-- Quick Distance Buttons -->
                <div class="flex flex-wrap gap-2">
                    <button type="button" onclick="setRadius(5)" class="px-3 py-1 text-xs border border-gray-300 rounded-full hover:bg-gray-50">5 miles</button>
                    <button type="button" onclick="setRadius(10)" class="px-3 py-1 text-xs border border-gray-300 rounded-full hover:bg-gray-50">10 miles</button>
                    <button type="button" onclick="setRadius(25)" class="px-3 py-1 text-xs border border-gray-300 rounded-full hover:bg-gray-50 bg-blue-50 border-blue-300">25 miles</button>
                    <button type="button" onclick="setRadius(50)" class="px-3 py-1 text-xs border border-gray-300 rounded-full hover:bg-gray-50">50 miles</button>
                </div>
            </div>
        </div>

        <!-- Specific Service Areas -->
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Specific Cities/Areas You Serve</label>
            <div class="space-y-2">
                <textarea name="service_areas" rows="3"
                          class="border shadow-sm focus:ring-shadetree-blue focus:border-shadetree-blue block w-full sm:text-sm border-gray-300 rounded-md py-3 resize-none"
                          placeholder="e.g., Downtown, Westside, Springfield, Oak Valley..."
                ></textarea>
                <p class="text-xs text-gray-500">List the cities, neighborhoods, or areas you serve (optional)</p>
            </div>
        </div>

        <!-- Location Coordinates (hidden, will be auto-populated) -->
        <%= form.hidden_field :latitude %>
        <%= form.hidden_field :longitude %>

        <!-- Map Preview Placeholder -->
        <div class="bg-gray-100 border-2 border-dashed border-gray-300 rounded-lg p-6 text-center">
            <i data-feather="map" class="h-12 w-12 text-gray-400 mx-auto mb-2"></i>
            <p class="text-sm text-gray-600">Map preview will be available after setup</p>
            <p class="text-xs text-gray-500">We'll help you visualize your service area on a map</p>
        </div>

        <!-- Travel Information -->
        <div class="bg-green-50 border border-green-200 rounded-lg p-4" id="travel-info">
            <h4 class="text-sm font-medium text-green-900 mb-2">Travel & Service Information</h4>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-medium text-green-800 mb-1">Travel Fee</label>
                    <div class="relative">
                        <span class="absolute left-3 top-2 text-green-600">$</span>
                        <input type="number" name="travel_fee" step="0.01" min="0"
                               class="border pl-6 shadow-sm focus:ring-green-500 focus:border-green-500 block w-full text-sm border-green-300 rounded-md py-2"
                               placeholder="0.00">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-medium text-green-800 mb-1">Minimum Service Call</label>
                    <div class="relative">
                        <span class="absolute left-3 top-2 text-green-600">$</span>
                        <input type="number" name="minimum_service" step="0.01" min="0"
                               class="border pl-6 shadow-sm focus:ring-green-500 focus:border-green-500 block w-full text-sm border-green-300 rounded-md py-2"
                               placeholder="0.00">
                    </div>
                </div>
            </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="flex justify-between pt-4">
            <%= link_to "← Back to Hours", new_admin_business_onboarding_path(step: 'hours'),
                class: "text-gray-600 hover:text-gray-900 px-4 py-2 text-sm font-medium" %>
            <%= form.submit "Continue to Branding →", class: "bg-shadetree-blue text-white px-6 py-3 rounded-md text-sm font-medium hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-shadetree-blue" %>
        </div>
    <% end %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const locationRadios = document.querySelectorAll('input[name="location_type"]');
    const serviceAreaSection = document.getElementById('service-area-section');
    const travelInfo = document.getElementById('travel-info');

    locationRadios.forEach(radio => {
        radio.addEventListener('change', function() {
            if (this.value === 'fixed') {
                serviceAreaSection.style.display = 'none';
                travelInfo.style.display = 'none';
            } else {
                serviceAreaSection.style.display = 'block';
                travelInfo.style.display = 'block';
            }
        });
    });

    // Default to showing service area for mobile/both
    const checkedRadio = document.querySelector('input[name="location_type"]:checked');
    if (checkedRadio && checkedRadio.value !== 'fixed') {
        serviceAreaSection.style.display = 'block';
        travelInfo.style.display = 'block';
    } else {
        serviceAreaSection.style.display = 'none';
        travelInfo.style.display = 'none';
    }
});

function setRadius(miles) {
    document.getElementById('business_service_area_radius').value = miles;

    // Update button styles
    document.querySelectorAll('button[onclick^="setRadius"]').forEach(btn => {
        btn.className = 'px-3 py-1 text-xs border border-gray-300 rounded-full hover:bg-gray-50';
    });
    event.target.className = 'px-3 py-1 text-xs border border-gray-300 rounded-full hover:bg-gray-50 bg-blue-50 border-blue-300';
}

function enableAddressEdit() {
    const textarea = document.getElementById('business_address');
    textarea.readOnly = false;
    textarea.classList.remove('bg-gray-50');
    textarea.focus();
}
</script>

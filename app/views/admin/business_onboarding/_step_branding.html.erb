<!-- Step 4: Business Branding -->
<div class="space-y-6">
    <div class="text-center mb-6">
        <h3 class="text-2xl font-bold text-enterprise-navy">Business Branding</h3>
        <p class="text-sm text-enterprise-gray mt-2">
            Customize your business appearance for quotes, invoices, and customer interactions
        </p>
    </div>

    <%= form_with(model: [@business], url: admin_business_onboarding_index_path, local: true, html: { class: "space-y-6" }) do |form| %>
        <%= hidden_field_tag :step, 'branding' %>

        <!-- Logo Upload -->
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Business Logo</label>
            <div class="border-2 border-dashed border-gray-300 rounded-lg p-6 text-center hover:border-gray-400 transition-colors">
                <div id="logo-preview" class="mb-4" style="display: none;">
                    <img id="logo-image" src="" alt="Logo preview" class="mx-auto h-20 w-auto">
                </div>
                <div id="logo-placeholder">
                    <i data-feather="image" class="h-12 w-12 text-gray-400 mx-auto mb-2"></i>
                    <p class="text-sm text-gray-600">Upload your business logo</p>
                    <p class="text-xs text-gray-500">PNG, JPG up to 2MB</p>
                </div>
                <input type="file" id="logo-upload" accept="image/*" class="hidden">
                <button type="button" onclick="document.getElementById('logo-upload').click()"
                        class="mt-3 inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                    <i data-feather="upload" class="h-4 w-4 mr-2"></i>
                    Choose File
                </button>
            </div>
            <%= form.hidden_field :logo_url %>
        </div>

        <!-- Brand Color -->
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Brand Color</label>
            <p class="text-xs text-gray-500 mb-3">This color will be used in your quotes, invoices, and customer communications</p>

            <div class="flex items-center space-x-4">
                <div class="relative">
                    <%= form.color_field :brand_color, value: (@business.brand_color || '#059669'),
                        class: "h-12 w-12 border border-gray-300 rounded-md cursor-pointer",
                        onchange: "updateColorPreview(this.value)" %>
                </div>

                <div class="flex-1">
                    <%= form.text_field :brand_color, value: (@business.brand_color || '#059669'),
                        class: "border shadow-sm focus:ring-shadetree-blue focus:border-shadetree-blue block w-full sm:text-sm border-gray-300 rounded-md py-2 px-3",
                        placeholder: "#059669",
                        onchange: "updateColorPreview(this.value)" %>
                </div>
            </div>

            <!-- Color Presets -->
            <div class="mt-3">
                <p class="text-xs text-gray-500 mb-2">Quick color options:</p>
                <div class="flex space-x-2">
                    <% [
                        ['#059669', 'Shadetree Green'],
                        ['#1E40AF', 'Professional Blue'],
                        ['#DC2626', 'Bold Red'],
                        ['#D97706', 'Warm Orange'],
                        ['#7C3AED', 'Creative Purple'],
                        ['#0F172A', 'Classic Navy']
                    ].each do |color, name| %>
                        <button type="button" onclick="setColor('<%= color %>')"
                                class="w-8 h-8 rounded-full border-2 border-gray-300 hover:border-gray-400 transition-colors"
                                style="background-color: <%= color %>"
                                title="<%= name %>">
                        </button>
                    <% end %>
                </div>
            </div>
        </div>

        <!-- Brand Preview -->
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-6">
            <h4 class="text-sm font-medium text-gray-900 mb-4">Preview</h4>
            <div class="bg-white border border-gray-300 rounded-lg p-4 shadow-sm">
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center">
                        <div id="preview-logo" class="mr-3 hidden">
                            <img id="preview-logo-img" src="" alt="Logo" class="h-10 w-auto">
                        </div>
                        <div>
                            <h5 class="font-bold text-lg text-gray-900"><%= @business.name || 'Your Business Name' %></h5>
                            <p class="text-sm text-gray-600">Service Quote</p>
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-sm text-gray-600">Quote #1001</p>
                        <p class="text-sm text-gray-600"><%= Date.current.strftime('%B %d, %Y') %></p>
                    </div>
                </div>

                <div class="border-t pt-4">
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-gray-600">Sample Service</span>
                        <span class="text-sm text-gray-900">$250.00</span>
                    </div>
                    <div class="mt-4 pt-4 border-t">
                        <div class="flex justify-between items-center">
                            <span class="font-medium text-gray-900">Total</span>
                            <span id="preview-total" class="font-bold text-lg" style="color: #059669">$250.00</span>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-4 border-t">
                    <button type="button" id="preview-button"
                            class="w-full py-2 px-4 rounded-md text-white font-medium text-sm transition-colors"
                            style="background-color: #059669">
                        Accept Quote
                    </button>
                </div>
            </div>
        </div>

        <!-- Additional Branding Options -->
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
            <h4 class="text-sm font-medium text-blue-900 mb-3">
                <i data-feather="info" class="h-4 w-4 inline mr-1"></i>
                Coming Soon
            </h4>
            <p class="text-sm text-blue-800">
                After setup, you'll be able to customize email templates, quote layouts, and add custom fields to match your brand perfectly.
            </p>
        </div>

        <!-- Navigation Buttons -->
        <div class="flex justify-between pt-4">
            <%= link_to "← Back to Location", new_admin_business_onboarding_path(step: 'location'),
                class: "text-gray-600 hover:text-gray-900 px-4 py-2 text-sm font-medium" %>
            <%= form.submit "Complete Setup", class: "bg-shadetree-green text-white px-8 py-3 rounded-md text-sm font-medium hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-shadetree-green shadow-lg" %>
        </div>
    <% end %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const logoUpload = document.getElementById('logo-upload');
    const logoPreview = document.getElementById('logo-preview');
    const logoImage = document.getElementById('logo-image');
    const logoPlaceholder = document.getElementById('logo-placeholder');
    const previewLogo = document.getElementById('preview-logo');
    const previewLogoImg = document.getElementById('preview-logo-img');

    logoUpload.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                logoImage.src = e.target.result;
                previewLogoImg.src = e.target.result;
                logoPreview.style.display = 'block';
                logoPlaceholder.style.display = 'none';
                previewLogo.classList.remove('hidden');

                // In a real app, you'd upload to a server here
                document.getElementById('business_logo_url').value = e.target.result;
            };
            reader.readAsDataURL(file);
        }
    });

    // Initialize color preview
    updateColorPreview(document.getElementById('business_brand_color').value);
});

function updateColorPreview(color) {
    const colorField = document.getElementById('business_brand_color');
    const previewTotal = document.getElementById('preview-total');
    const previewButton = document.getElementById('preview-button');

    // Update both color inputs
    colorField.value = color;
    document.querySelector('input[type="color"]').value = color;

    // Update preview elements
    previewTotal.style.color = color;
    previewButton.style.backgroundColor = color;
}

function setColor(color) {
    updateColorPreview(color);
}
</script>

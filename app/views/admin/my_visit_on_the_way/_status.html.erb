<%# locals: (visit:, from:) -%>
<%# JOB-12: on My day and the visit's page, for someone going on a visit booked for today:
    "On my way", or once sent "On the way · about 11:15 am" with "Change time". The button opens
    the sheet as a dialog (the link works without JavaScript). With no email for the client, the
    sent time comes with tap-to-call and tap-to-text from the technician's own phone. %>
<% return unless visit.on_the_way_offered_to?(current_user) %>
<% sheet_id = "on-the-way-#{visit.uid}-#{from}" %>
<div class="flex flex-wrap items-center gap-2" data-controller="modal" id="on-the-way-<%= visit.uid %>">
  <% if visit.on_the_way? %>
    <p class="min-w-0 flex-1 text-sm font-semibold text-ink"><%= icon "truck", class: "mr-1 inline size-4 align-[-0.15em] text-muted" %>On the way · about <%= visit.on_the_way_time_label %></p>
    <%= link_to "Change time", new_admin_my_visit_on_the_way_path(visit, from:), class: "#{button_classes(:secondary, :sm)} min-h-11",
                data: { action: "modal#open" }, "aria-haspopup": "dialog" %>
  <% else %>
    <%= link_to new_admin_my_visit_on_the_way_path(visit, from:), class: "#{button_classes(:secondary)} h-auto min-h-12 #{"w-full" if from == "visit"} justify-center",
                data: { action: "modal#open" }, "aria-haspopup": "dialog" do %><%= icon "truck" %> On my way<% end %>
  <% end %>
  <% if visit.on_the_way? && visit.on_the_way_email.nil? && (phone = visit.job.client.primary_phone) %>
    <% digits = phone.value.gsub(/[^\d+]/, "") %>
    <% text = "Hi, it's #{current_user.first_name.presence || current_business.name}#{" from #{current_business.name}" if current_user.first_name.present?}. I'm on the way, arriving about #{visit.on_the_way_time_label}." %>
    <div class="grid w-full grid-cols-2 gap-2">
      <%= link_to "tel:#{digits}", class: "#{button_classes(:secondary)} h-auto min-h-11 justify-center" do %><%= icon "phone" %> Call<% end %>
      <%= link_to "sms:#{digits}?&body=#{ERB::Util.url_encode(text)}", class: "#{button_classes(:secondary)} h-auto min-h-11 justify-center" do %><%= icon "message-square" %> Text<% end %>
    </div>
  <% end %>
  <%= modal id: sheet_id, title: "On my way to #{visit.job.client.display_name}", description: visit.when_label, sheet: true do %>
    <%= render "admin/my_visit_on_the_way/sheet", visit:, from: %>
  <% end %>
</div>

<%# locals: (visit:) -%>
<% job = visit.job %>
<li id="my-visit-<%= visit.uid %>" class="flex-wrap gap-0 p-0">
  <%= link_to admin_my_visit_path(visit), class: "flex min-w-0 flex-1 items-start gap-3 px-4 py-3.5" do %>
    <span class="w-20 shrink-0 pt-0.5 text-sm font-semibold text-ink"><%= visit.time_label.delete_prefix("Arrive ") %><%= other_zone_label(visit) %></span>
    <span class="min-w-0 flex-1">
      <span class="block truncate font-semibold text-ink"><%= job.client.display_name %></span>
      <span class="block truncate text-sm2 text-muted"><%= job.property&.one_line || "No address on file" %></span>
      <span class="block truncate text-sm2 text-subtle"><%= job.title %> · about <%= visit.duration_label %></span>
      <%# ACC-09: who's going, you first %>
      <% crew = visit.assignees.sort_by { _1.id == current_user.id ? 0 : 1 } %>
      <% if crew.any? %>
        <span class="mt-1.5 flex items-center gap-1.5 text-sm2 text-muted"><span class="flex -space-x-1.5"><% crew.first(4).each do |user| %><%= user_avatar user, class: "ring-2 ring-surface" %><% end %></span>
          <span class="truncate"><%= (others = crew - [ current_user ]).any? ? "With #{others.map { _1.first_name.presence || _1.full_name }.to_sentence}" : "Just you" %></span></span>
      <% end %>
    </span>
    <% unless visit.status == "scheduled" %>
      <%= visit_status_badge(visit) %>
    <% end %>
    <%= icon "chevron-right", class: "mt-1 size-4 shrink-0 text-faint" %>
  <% end %>
  <% if visit.on_the_way_offered_to?(current_user) %><%# JOB-12 %>
    <div class="basis-full px-4 pb-3.5 pl-27"><%= render "admin/my_visit_on_the_way/status", visit:, from: "day" %></div>
  <% end %>
</li>

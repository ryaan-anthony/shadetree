<%# JOB-04: the signed-in member's visits. Large tap targets; one tap opens everything about a visit. %>
<% content_for :title, "My day" %>
<%# Today never carries the year, days coming up only outside this year (PLT-05); the zone is named once. %>
<%= page_header "My day", lede: safe_join([ friendly_date(current_business.today, year: false), " · Times in #{time_zone_label(current_business.time_zone)}" ]) %>

<div class="form-split space-y-4">
  <%# ACC-05: a technician's one-screen welcome. %>
  <% if Current.membership && !Current.membership.can?(:office) && Current.membership.welcome_dismissed_at.nil? %>
    <%= card title: "Welcome to #{current_business.name}" do %>
      <p class="text-sm text-body">You're on the team as <%= Current.membership.role_name.match?(/\A[AEIOU]/i) ? "an" : "a" %> <%= Current.membership.role_name.downcase %>. Visits you're going on show up here, with the client's address, how to get in and what to do. Tap one to start it.</p>
      <div class="mt-4 flex flex-wrap gap-2">
        <%# ACC-08: the short My day tour %>
        <button type="button" class="<%= button_classes(:primary, :sm) %>" data-tour-start><%= t("guidance.tour.offer.start_field") %></button>
        <%= button_to "Got it", admin_dismiss_welcome_path, method: :patch, class: button_classes(:secondary, :sm) %>
      </div>
    <% end %>
  <% end %>

  <% if @quote_drafts.present? %><%# QTE-07 %>
    <%= card title: "Your quotes", subtitle: "Drafts from requests you followed up, until they're sent.", flush: true, id: "my-quote-drafts" do %>
      <ul class="list">
        <% @quote_drafts.each do |quote| %>
          <li class="p-0"><%= link_to edit_admin_quote_path(quote), class: "flex min-w-0 flex-1 items-center gap-3 px-4 py-3.5" do %>
            <span class="min-w-0 flex-1"><span class="block truncate font-semibold text-ink"><%= quote.client.display_name %></span>
              <span class="block truncate text-sm2 text-muted"><%= quote.number %><%= " · #{quote.title}" if quote.title %></span></span>
            <%= icon "chevron-right", class: "size-4 shrink-0 text-faint" %>
          <% end %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <%= card title: "Today", flush: true, data: { tour: "today" } do %>
    <% if @today.empty? %>
      <p class="px-5 py-4 text-sm2 text-muted">Nothing booked for you today.</p>
    <% else %>
      <ul class="list"><%= render partial: "admin/my_day/item", collection: @today, as: :item %></ul>
    <% end %>
  <% end %>

  <% if @earlier.any? %>
    <%= card title: "Still open from earlier", subtitle: "Finish these, or tell the office. Done requests stay until they're quoted or passed back.", flush: true do %>
      <ul class="list">
        <%= render partial: "admin/my_day/item", collection: @earlier, as: :item %>
      </ul>
    <% end %>
  <% end %>

  <%= card title: "Coming up", subtitle: "The next #{MyDay::UPCOMING_DAYS} days.", flush: true, data: { tour: "coming_up" } do %>
    <% if @upcoming.empty? %>
      <p class="px-5 py-4 text-sm2 text-muted">Nothing else booked for you yet.</p>
    <% else %>
      <% @upcoming.each do |date, visits| %>
        <h3 class="table-head border-t border-line bg-sunken/60 px-4 py-1.5 first:border-t-0"><%= friendly_date(date) %></h3>
        <ul class="list"><%= render partial: "admin/my_day/item", collection: visits, as: :item %></ul>
      <% end %>
    <% end %>
  <% end %>
</div>

<%= page_header "Services & prices", lede: "What you sell, with default prices. Pick from these when building quotes and invoices." do %>
  <%= link_to "Add starter services", admin_catalog_presets_path, class: button_classes(:secondary), title: "Common services for your trade, ready to price" %>
  <%= link_to new_admin_catalog_item_path, class: button_classes do %><%= icon "plus" %> Add service<% end %>
<% end %>

<div class="mb-4 flex flex-wrap items-center gap-2">
  <%= form_with url: admin_catalog_items_path, method: :get, class: "flex min-w-0 flex-1 items-center gap-2", data: { turbo_frame: "_top" } do |f| %>
    <% if @showing_archived %><%= hidden_field_tag :archived, "1" %><% end %>
    <label class="sr-only" for="q">Search your services</label>
    <div class="relative min-w-0 flex-1 sm:max-w-sm">
      <%= icon "search", class: "pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-faint" %>
      <%= search_field_tag :q, @query, class: "input pl-9", placeholder: "Search by name or description" %>
    </div>
    <%= f.submit "Search", class: button_classes(:secondary), name: nil %>
  <% end %>
  <nav class="tabs border-0" aria-label="Services view">
    <%= link_to "Active", admin_catalog_items_path(q: @query.presence), class: "tab", "aria-current": ("page" unless @showing_archived) %>
    <%= link_to "Archived (#{@archived_count})", admin_catalog_items_path(archived: 1, q: @query.presence), class: "tab", "aria-current": ("page" if @showing_archived) %>
  </nav>
</div>

<% if @without_review_count.positive? || current_business.without_review_cap %><%# QTE-08: beside the services technicians send without review %>
  <%= form_with url: review_cap_admin_catalog_items_path, method: :patch, id: "review-cap", class: "card card-body mb-4 flex flex-wrap items-end gap-3" do %>
    <div class="min-w-0 flex-1 basis-60">
      <p class="font-semibold text-ink">Sent without review</p>
      <p class="text-sm2 text-muted"><%= pluralize(@without_review_count, "service") %> technicians can send without review. A quote over the cap, tax included, still comes to the office.</p>
    </div>
    <div class="field w-40">
      <label class="label" for="without_review_cap">Up to <span class="label-optional">(optional)</span></label>
      <div class="input-group"><span class="input-addon" aria-hidden="true"><%= Money.currency(current_business.currency_code).symbol %></span>
        <%= text_field_tag :without_review_cap, current_business.without_review_cap&.to_s, class: "input tabular", inputmode: "decimal", autocomplete: "off",
                           placeholder: "No cap", "aria-describedby": "review-cap-help" %></div>
    </div>
    <button type="submit" class="<%= button_classes(:secondary) %>">Save cap</button>
    <p class="help w-full" id="review-cap-help">Leave it blank for no cap.</p>
  <% end %>
<% end %>

<% if @items.empty? %>
  <div class="card">
    <% if @query.present? %>
      <%= empty_state title: "Nothing matches \"#{@query}\"", text: "Try a shorter word, or add it as a new item.", icon: "search" do %>
        <%= link_to "Clear search", admin_catalog_items_path(archived: (1 if @showing_archived)), class: button_classes(:secondary) %>
      <% end %>
    <% elsif @showing_archived %>
      <%= empty_state title: "No archived services", text: "Archived services are hidden from pickers but stay on old quotes and invoices.", icon: "archive" %>
    <% else %>
      <%= empty_state title: "No services yet", text: "Start with common services for your kind of business and fill in your prices, or add your own one at a time.", icon: "package" do %>
        <%= link_to admin_catalog_presets_path, class: button_classes do %><%= icon "zap" %> Add starter services<% end %>
        <%= link_to new_admin_catalog_item_path, class: button_classes(:secondary) do %><%= icon "plus" %> Add a service<% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="space-y-4">
    <% @groups.each do |category, items| %>
      <%= card title: category&.name || "Uncategorized", subtitle: pluralize(items.size, "item"), flush: true,
               actions: (link_to("Add here", new_admin_catalog_item_path(category: category&.uid), class: button_classes(:ghost, :sm), "aria-label": "Add here: #{category&.name || "Uncategorized"}") unless @showing_archived) do %>
        <ul class="list">
          <% items.each_with_index do |item, index| %>
            <li id="item-<%= item.uid %>" class="flex-wrap">
              <div class="min-w-0 flex-1">
                <p class="font-semibold text-ink">
                  <%= link_to item.name, edit_admin_catalog_item_path(item), class: "hover:underline" %>
                  <% unless item.taxable %><%= badge "Not taxed", dot: false %><% end %>
                  <% if item.send_without_review %><%= badge "Sent without review", tone: :success, dot: false %><% end %><%# QTE-08 %>
                </p>
                <p class="truncate text-sm2 text-muted"><%= [ item.description.presence, item.duration_label ].compact.join(" · ") %></p>
                <% if (overrides = @overrides[item.id]).present? %><%# CAT-08: prices at other locations, at a glance %>
                  <p class="mt-1 flex flex-wrap gap-1"><% overrides.each do |price| %><%= badge "#{price.location.name}: #{money(price.unit_price)}", tone: :info, dot: false %><% end %></p>
                <% end %>
              </div>
              <p class="w-36 text-right">
                <% if item.unit_price %>
                  <span class="money font-semibold text-ink"><%= money(item.unit_price) %></span> <span class="text-sm2 text-muted">/ <%= item.unit_label %></span>
                <% else %>
                  <span class="text-sm2 text-muted">Price on quote</span>
                <% end %>
              </p>
              <div class="flex items-center gap-1">
                <% if @showing_archived %>
                  <%= button_to "Restore", restore_admin_catalog_item_path(item), method: :patch, class: button_classes(:secondary, :sm) %>
                <% else %>
                  <% unless @query.present? %>
                    <%= button_to move_admin_catalog_item_path(item, direction: -1), method: :patch, class: button_classes(:ghost, :sm, :icon), disabled: index.zero?, "aria-label": "Move #{item.name} up" do %><%= icon "arrow-up" %><% end %>
                    <%= button_to move_admin_catalog_item_path(item, direction: 1), method: :patch, class: button_classes(:ghost, :sm, :icon), disabled: index == items.size - 1, "aria-label": "Move #{item.name} down" do %><%= icon "arrow-down" %><% end %>
                  <% end %>
                  <div class="relative" data-controller="menu" data-action="keydown->menu#keydown">
                    <button type="button" class="<%= button_classes(:ghost, :sm, :icon) %>" data-menu-target="button" data-action="menu#toggle" aria-haspopup="true" aria-expanded="false" aria-label="More actions for <%= item.name %>"><%= icon "more-horizontal" %></button>
                    <div class="menu right-0 top-full mt-1" data-menu-target="menu" hidden>
                      <%= link_to edit_admin_catalog_item_path(item), class: "menu-item" do %><%= icon "edit-2" %> Edit<% end %>
                      <%= link_to new_admin_catalog_item_path(duplicate_of: item.uid), class: "menu-item" do %><%= icon "copy" %> Duplicate<% end %>
                      <div class="menu-sep"></div>
                      <%= button_to archive_admin_catalog_item_path(item), method: :patch, class: "menu-item", form: { class: "contents" } do %><%= icon "archive" %> Archive<% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  </div>
<% end %>

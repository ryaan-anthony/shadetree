<%= page_header "Services & prices", lede: "What you sell, with default prices. Pick from these when building quotes and invoices." do %>
  <%= link_to "Add starter services", admin_catalog_presets_path, class: button_classes(:secondary), title: "Common services for your trade, ready to price" %>
  <%= link_to new_admin_catalog_item_path, class: button_classes do %><%= icon "plus" %> Add service<% end %>
<% end %>

<%# PLT-19: searches as you type, refreshing only the frame below; without JavaScript, Enter
    submits the GET form. The tabs sit in the frame, so they keep the current search. %>
<%= form_with url: admin_catalog_items_path, method: :get, id: "service-filters", class: "mb-4",
              data: { controller: "search-form", turbo_frame: "service_results", turbo_action: "replace" } do %>
  <% if @showing_archived %><%= hidden_field_tag :archived, "1" %><% end %>
  <div class="relative max-w-md">
    <label class="sr-only" for="q">Search your services</label>
    <%= icon "search", class: "pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-faint" %>
    <%= search_field_tag :q, @query, class: "input pl-9", placeholder: "Search by name or description", autocomplete: "off",
                         data: { action: "input->search-form#queue keydown.enter->search-form#submit:prevent" } %>
  </div>
<% end %>

<%= results_status "service_results" %>
<%= turbo_frame_tag "service_results", target: "_top" do %>
<%= tabs({ "active" => "Active", "archived" => "Archived" }, current: @showing_archived ? "archived" : "active", label: "Services view",
         counts: { "archived" => @archived_count }, keep: %w[active], class: "mb-4",
         href: ->(key) { admin_catalog_items_path(archived: (1 if key == "archived"), q: @query.presence) }) %>

<% if @without_review_count.positive? || current_business.without_review_cap %><%# QTE-08: beside the services technicians send without review %>
  <%= form_with url: review_cap_admin_catalog_items_path, method: :patch, id: "review-cap", class: "card card-body mb-4 flex flex-wrap items-end gap-3" do %>
    <div class="min-w-0 flex-1 basis-60">
      <p class="font-semibold text-ink">Quotes sent without review</p>
      <p class="text-sm2 text-muted" id="review-cap-help">Technicians can send a quote straight away when it's only your <%= pluralize(@without_review_count, "“No review needed” service") %>, at their prices. A quote over the cap, tax included, still comes to the office; leave it blank for no cap.</p>
    </div>
    <div class="field w-40">
      <label class="label" for="without_review_cap">Up to <span class="label-optional">(optional)</span></label>
      <div class="input-group"><span class="input-addon" aria-hidden="true"><%= Money.currency(current_business.currency_code).symbol %></span>
        <%= text_field_tag :without_review_cap, current_business.without_review_cap&.to_s, class: "input tabular", inputmode: "decimal", autocomplete: "off",
                           placeholder: "No cap", "aria-describedby": "review-cap-help" %></div>
    </div>
    <button type="submit" class="<%= button_classes(:secondary) %>">Save cap</button>
  <% end %>
<% end %>

<% if @items.empty? %>
  <div class="card">
    <% if @query.present? %>
      <%= empty_state title: "Nothing matches \"#{@query}\"", text: "Try a shorter word, or add it as a new item.", icon: "search" do %>
        <%= link_to "Clear search", admin_catalog_items_path(archived: (1 if @showing_archived)), class: button_classes(:secondary) %>
      <% end %>
    <% elsif @showing_archived %>
      <%= empty_state title: "No archived services", text: "Archived services are hidden from pickers but stay on old quotes and invoices.", icon: "archive" %>
    <% else %>
      <%= empty_state title: "No services yet", text: "Start with common services for your kind of business and fill in your prices, or add your own one at a time.", icon: "package" do %>
        <%# PLT-14: the page's own actions, rank and wording %>
        <%= link_to admin_catalog_presets_path, class: button_classes(:secondary) do %><%= icon "zap" %> Add starter services<% end %>
        <%= link_to new_admin_catalog_item_path, class: button_classes do %><%= icon "plus" %> Add service<% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p class="sr-only" data-results-summary><%= pluralize(@items.size, @showing_archived ? "archived service" : "service") %><%= " matching #{@query}" if @query.present? %></p>
  <div class="space-y-4">
    <% @groups.each do |category, items| %>
      <%= card title: category&.name || "Uncategorized", subtitle: pluralize(items.size, "item"), flush: true,
               actions: (link_to("Add here", new_admin_catalog_item_path(category: category&.uid), class: button_classes(:tertiary, :sm), "aria-label": "Add here: #{category&.name || "Uncategorized"}") unless @showing_archived) do %>
        <ul class="list">
          <% items.each_with_index do |item, index| %>
            <li id="item-<%= item.uid %>" class="flex-wrap">
              <div class="min-w-0 flex-1">
                <p class="font-semibold text-ink">
                  <%= link_to item.name, edit_admin_catalog_item_path(item), class: "hover:underline" %>
                  <% unless item.taxable %><%= badge "Not taxed", dot: false %><% end %>
                  <% if item.send_without_review %><%= badge "No review needed", tone: :success, dot: false %><% end %><%# QTE-08 %>
                </p>
                <p class="truncate text-sm2 text-muted"><%= [ item.description.presence, item.duration_label ].compact.join(" · ") %></p>
                <% if (overrides = @overrides[item.id]).present? %><%# CAT-08: prices at other locations, at a glance %>
                  <p class="mt-1 flex flex-wrap gap-1"><% overrides.each do |price| %><%= badge "#{price.location.name}: #{money(price.unit_price)}", tone: :info, dot: false %><% end %></p>
                <% end %>
              </div>
              <p class="w-36 text-right">
                <% if item.unit_price %>
                  <span class="money font-semibold text-ink"><%= money(item.unit_price) %></span> <span class="text-sm2 text-muted">/ <%= item.unit_label %></span>
                <% else %>
                  <span class="text-sm2 text-muted">Price on quote</span>
                <% end %>
              </p>
              <div class="flex items-center gap-1">
                <% if @showing_archived %>
                  <%= button_to "Restore", restore_admin_catalog_item_path(item), method: :patch, class: button_classes(:secondary, :sm), "aria-label": "Restore #{item.name}" %>
                <% else %>
                  <% unless @query.present? %>
                    <%= button_to move_admin_catalog_item_path(item, direction: -1), method: :patch, class: button_classes(:tertiary, :sm, :icon), disabled: index.zero?, "aria-label": "Move #{item.name} up" do %><%= icon "arrow-up" %><% end %>
                    <%= button_to move_admin_catalog_item_path(item, direction: 1), method: :patch, class: button_classes(:tertiary, :sm, :icon), disabled: index == items.size - 1, "aria-label": "Move #{item.name} down" do %><%= icon "arrow-down" %><% end %>
                  <% end %>
                  <%= menu label: "More actions for #{item.name}", size: :sm do %>
                    <%= link_to edit_admin_catalog_item_path(item), class: "menu-item", "aria-label": "Edit #{item.name}" do %><%= icon "edit-2" %> Edit<% end %>
                    <%= link_to new_admin_catalog_item_path(duplicate_of: item.uid), class: "menu-item", "aria-label": "Duplicate #{item.name}" do %><%= icon "copy" %> Duplicate<% end %>
                    <div class="menu-sep"></div>
                    <%= button_to archive_admin_catalog_item_path(item), method: :patch, class: "menu-item", form: { class: "contents" }, "aria-label": "Archive #{item.name}" do %><%= icon "archive" %> Archive<% end %>
                  <% end %>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  </div>
<% end %>
<% end %>

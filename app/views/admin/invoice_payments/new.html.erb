<%# PAY-05: record a payment received by cash, check, transfer or other means. %>
<% content_for :title, "Record a payment" %>
<% lede = @invoice.draft? ? "Paid on the spot? Recording it also marks invoice #{@invoice.number} as sent." : "#{money(@invoice.balance)} left to pay on invoice #{@invoice.number}, due #{l(@invoice.due_on)}." %>
<%= page_header "Record a payment", lede: do %>
  <%= link_to "Cancel", staff_invoice_path(@invoice), class: button_classes(:tertiary) %>
<% end %>
<div class="form-split">
<%# #289: what's owed, first (phones and screen readers get it before the form); beside it on wide screens. %>
<aside class="form-split-aside" aria-labelledby="payment-summary-h">
  <%= card id: "payment-invoice-summary" do %>
    <h2 class="card-title" id="payment-summary-h">What's owed</h2>
    <dl class="mt-3 space-y-2 text-sm">
      <div class="flex justify-between gap-2"><dt class="text-muted">Total</dt><dd class="money text-ink"><%= money(@invoice.total) %></dd></div>
      <% if @invoice.payments? %><div class="flex justify-between gap-2"><dt class="text-muted">Paid so far</dt><dd class="money text-ink"><%= money(@invoice.amount_paid) %></dd></div><% end %>
      <div class="flex justify-between gap-2 border-t border-line pt-2"><dt class="font-semibold text-ink">Left to pay</dt><dd class="money font-semibold text-ink"><%= money(@invoice.balance) %></dd></div>
      <% if @invoice.due_on %><div class="flex justify-between gap-2"><dt class="text-muted">Due</dt><dd class="text-ink"><%= local_date(@invoice.due_on) %></dd></div><% end %>
    </dl>
  <% end %>
</aside>
<%= form_with model: @payment, scope: :payment, url: admin_invoice_payments_path(@invoice), method: :post, class: "min-w-0" do |f| %>
  <%= card title: @invoice.client.display_name, subtitle: "Invoice #{@invoice.number}" do %><%# the amounts are beside it (#289) %>
    <%= render "fields", f:, payment: @payment %>
    <% if (email = @invoice.client.primary_email&.value) && current_user.can_send_to_clients? %>
      <label class="check mt-4">
        <%# ticked at first (owner, 2026-11-22), except for support viewing as them; after a mistake, as they left it %>
        <%= check_box_tag :send_receipt, "1", params.key?(:payment) ? params[:send_receipt] == "1" : impersonation.nil?, id: "send_receipt" %>
        <span><span class="font-medium text-ink">Email a receipt to <%= email %></span>
          <span class="check-hint">What was received and what's left to pay, with a link to the invoice.</span></span>
      </label>
    <% end %>
    <%= f.submit_button "Record payment", class: "mt-4 w-full sm:w-auto" %>
  <% end %>
<% end %>
</div>

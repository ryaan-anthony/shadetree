<% content_for :title, "Import clients" %>
<%= page_header @import.filename, lede: "#{pluralize(number_with_delimiter(@import.total_rows), "row")} · uploaded #{l(@import.created_at.in_time_zone)}" do %>
  <%= link_to "Clients", admin_clients_path, class: button_classes(:secondary) %>
<% end %>

<%# While it runs, the frame below reloads itself (poll_controller); when it's done, the page
    reloads once to show the summary. The status line is a live region that stays put. %>
<% if @import.running? || turbo_frame_request? %>
  <div aria-live="polite">
    <%= turbo_frame_tag "import-progress", src: (admin_client_import_path(@import) unless turbo_frame_request?), data: (@import.running? ? { controller: "poll" } : {}) do %>
      <% if @import.running? %>
        <%= card title: (@import.undoing? ? "Undoing…" : "Importing…") do %>
          <% unless @import.undoing? %>
            <progress class="h-2 w-full accent-canopy" max="<%= @import.total_rows %>" value="<%= @import.processed_rows %>" aria-label="Import progress"></progress>
            <p class="mt-2 text-sm text-subtle"><%= number_with_delimiter(@import.processed_rows) %> of <%= number_with_delimiter(@import.total_rows) %> rows. You can leave this page; we'll let you know when it's done.</p>
          <% else %>
            <p class="text-sm text-subtle">Removing the clients this import added.</p>
          <% end %>
        <% end %>
      <% else %>
        <span data-poll-done></span>
      <% end %>
    <% end %>
  </div>
<% else %>
  <%= card title: @import.undone? ? "Undone" : (@import.failed? ? "Stopped partway" : "Done"), id: "import-summary" do %>
    <% if @import.undone? %>
      <% kept = @import.clients.count %>
      <p class="text-sm text-subtle"><%= pluralize(@import.undone_count, "client") %> removed<%= ". #{pluralize(kept, "client")} kept because they already have quotes, requests, jobs or invoices" if kept.positive? %>.</p>
    <% else %>
      <% if @import.failed? %><p class="mb-3 text-sm text-danger">Something went wrong partway through. You can undo the clients added so far and try again.</p><% end %>
      <dl class="grid grid-cols-3 gap-3 text-center">
        <div class="rounded-control bg-sunken p-3"><dt class="text-sm2 text-muted">Added</dt><dd class="figure text-ink tabular"><%= number_with_delimiter(@import.created_count) %></dd></div>
        <div class="rounded-control bg-sunken p-3"><dt class="text-sm2 text-muted">Skipped</dt><dd class="figure text-ink tabular"><%= number_with_delimiter(@import.skipped_count) %></dd></div>
        <div class="rounded-control bg-sunken p-3"><dt class="text-sm2 text-muted">Couldn't add</dt><dd class="figure text-ink tabular"><%= number_with_delimiter(@import.failed_count) %></dd></div>
      </dl>
      <% if @import.problems.any? %>
        <p class="mt-4 text-sm text-subtle">The report lists every row not added and why<%= " (the first #{ClientImport::MAX_PROBLEMS})" if @import.skipped_count + @import.failed_count > ClientImport::MAX_PROBLEMS %>. Fix the ones that couldn't be added and upload it again; delete skipped rows first if you'll choose "Add them anyway".</p>
        <%= link_to "Download the report", report_admin_client_import_path(@import), class: "#{button_classes(:secondary)} mt-3" %>
      <% end %>
    <% end %>
  <% end %>

  <% if @import.problems.any? && !@import.undone? %>
    <%= card title: "Rows not added", class: "mt-4", flush: true do %>
      <ul class="list" id="import-problems">
        <% @import.problems.first(20).each do |problem| %>
          <li><span class="w-16 shrink-0 text-sm2 text-muted tabular">Line <%= problem["row"] %></span><span class="min-w-0 flex-1 text-sm"><%= problem["reason"].to_s.truncate(200) %></span></li>
        <% end %>
      </ul>
      <% if @import.problems.size > 20 %><p class="border-t border-line px-5 py-3 text-sm2 text-muted">And <%= @import.problems.size - 20 %> more in the report.</p><% end %>
    <% end %>
  <% end %>

  <% if @import.undoable? %>
    <%= card title: "Undo this import", class: "mt-4" do %>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-subtle">Removes the clients it added, unless they already have quotes, requests, jobs or invoices. Clients edited since are removed too, with their notes. Available until <%= local_date(@import.undo_until) %>.</p>
        <%= button_to "Undo import", undo_admin_client_import_path(@import), class: button_classes(:destructive),
                      form: { data: { turbo_confirm: "Remove the clients this import added (#{@import.clients.count}), including any notes added since?", turbo_confirm_button: "Undo import", turbo_confirm_variant: "destructive" } } %>
      </div>
    <% end %>
  <% end %>
<% end %>

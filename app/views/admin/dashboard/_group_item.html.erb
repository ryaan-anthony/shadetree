<%# locals: (key:, item:, today:) -%>
<%# INS-01: one record in an action group: what it is, who for, and what makes it urgent. %>
<% case key %>
<% when :new_requests %>
  <% title, path, meta = "Request #{item.reference}#{" · #{item.service_names.first}" if item.service_names.any?}", admin_service_request_path(item), "#{time_ago_in_words(item.created_at)} ago" %>
<% when :changes_requested, :awaiting_answer %>
  <% title, path = "#{item.number}#{" · #{item.title}" if item.title}", staff_quote_path(item) %>
  <% meta = key == :awaiting_answer && item.sent_at ? "Sent #{time_ago_in_words(item.sent_at)} ago" : money(item.total) %>
<% when :to_schedule, :to_invoice %>
  <% title, path, meta = "#{item.number} · #{item.title}", admin_job_path(item), money(item.total) %>
<% when :overdue %>
  <% title, path, meta = item.number, admin_invoice_path(item), "#{money(item.balance)}, #{pluralize((today - item.due_on).to_i, "day")} late" %>
<% end %>
<li>
  <div class="min-w-0 flex-1">
    <%= link_to title, path, class: "block truncate font-medium text-ink hover:underline" %>
    <span class="block truncate text-sm2 text-muted"><%= item.client.display_name %></span>
  </div>
  <span class="shrink-0 text-right text-sm2 <%= key == :overdue ? "font-medium text-danger" : "text-subtle" %>"><%= meta %></span>
</li>

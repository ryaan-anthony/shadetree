<%# locals: (dashboard:, my_day: nil) -%>
<%# #289: today on Home. Someone who does the field work themselves sees their own visits and
    request follow-ups (JOB-06), with "Your day" (My day, the phone-first view) one tap away;
    otherwise the team's day, by person. %>
<% zone = time_zone_label(current_business.time_zone) %>
<% if my_day && (my_day.today.any? || my_day.earlier.any?) %>
  <% mine = my_day.today %>
  <%# Other people's visits today, on the business's day as the team's card counts them. %>
  <% others = dashboard.visits_today_count - dashboard.visits_today_for(current_user).size %>
  <%# My day for people who have it; an office-only role (follow-ups, no My day) opens each one. %>
  <% field = can?(:field_work) %>
  <%= card title: "Your visits today", subtitle: "#{day_items_count(mine)} · times in #{zone}", id: "todays-visits", flush: true,
           actions: (link_to(admin_my_day_path, class: button_classes(:tertiary, :sm), id: "your-day-link") { safe_join([ "Your day", icon("arrow-right") ], " ") } if field) do %>
    <% if mine.empty? %>
      <p class="px-5 py-4 text-sm text-muted">Nothing booked for you today.</p>
    <% else %>
      <ul class="list"><%= render partial: "admin/dashboard/own_item", collection: mine, as: :item %></ul>
    <% end %>
    <% if my_day.earlier.any? %>
      <% if field %>
        <p class="border-t border-line px-5 py-3 text-sm2 text-muted" id="earlier-open"><%= link_to "#{day_items_count(my_day.earlier)} still open from earlier", admin_my_day_path, class: "font-medium text-ink underline-offset-2 hover:underline" %></p>
      <% else %>
        <p class="border-t border-line px-5 pt-3 text-sm2 font-medium text-ink" id="earlier-open"><%= day_items_count(my_day.earlier) %> still open from earlier</p>
        <ul class="list"><%= render partial: "admin/dashboard/own_item", collection: my_day.earlier, as: :item %></ul>
      <% end %>
    <% end %>
    <% if others.positive? && can?(:schedule) %>
      <p class="border-t border-line px-5 py-3 text-sm2 text-muted"><%= link_to "The team has #{pluralize(others, "other visit")} today", admin_schedule_path, class: "font-medium text-ink underline-offset-2 hover:underline" %></p>
    <% end %>
  <% end %>
<% else %>
  <%= card title: "Today's visits", subtitle: "#{pluralize(dashboard.visits_today_count, "visit")} · times in #{zone}", id: "todays-visits", flush: true,
           actions: safe_join([ (link_to("Schedule", admin_schedule_path, class: button_classes(:tertiary, :sm)) if can?(:schedule)),
                                (link_to(admin_my_day_path, class: button_classes(:tertiary, :sm), id: "your-day-link") { safe_join([ "Your day", icon("arrow-right") ], " ") } if can?(:field_work)) ].compact) do %>
    <% if dashboard.todays_visits.empty? %>
      <p class="px-5 py-4 text-sm text-muted">Nothing booked today.</p>
    <% else %>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3">
        <% dashboard.todays_visits.each do |person, visits| %>
          <section class="border-b border-line px-5 py-3 sm:border-r">
            <h3 class="table-head"><%= person&.full_name || "Not assigned" %></h3>
            <ul class="mt-1 space-y-1">
              <% visits.each do |visit| %>
                <li class="flex items-baseline justify-between gap-2 text-sm">
                  <%= link_to visit.job.client.display_name, admin_job_path(visit.job), class: "min-w-0 truncate text-ink hover:underline" %>
                  <span class="shrink-0 text-sm2 <%= visit.status == "completed" ? "text-success" : "text-muted" %>"><%= { "completed" => "Done", "in_progress" => "In progress" }.fetch(visit.status) { visit.time_label } %></span>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>

<%= page_header "Good #{day_period}, #{current_user.first_name.presence || "there"}",
                lede: "Here's where #{current_business.name} stands." %>

<div class="grid items-start gap-4 lg:grid-cols-[minmax(0,1fr)_20rem]">
  <% if can?(:business_settings) %>
  <%= card title: "Get your business ready", subtitle: "#{@setup_steps.count { _1[:done] }} of #{@setup_steps.size} done", flush: true do %>
    <ul class="list">
      <% @setup_steps.each do |step| %>
        <li>
          <span class="flex size-6 shrink-0 items-center justify-center rounded-full <%= step[:done] ? "bg-canopy text-white" : "border-2 border-slate-300" %>">
            <% if step[:done] %><%= icon "check", class: "size-3.5" %><% end %>
          </span>
          <div class="min-w-0 flex-1">
            <p class="font-semibold text-ink <%= "text-muted line-through decoration-slate-300" if step[:done] %>"><%= step[:title] %></p>
            <p class="text-sm2 text-muted"><%= step[:text] %></p>
          </div>
          <% unless step[:done] %>
            <%= link_to step[:action], step[:path], class: button_classes(:secondary, :sm) %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
  <% end %>

  <%= card title: "Quotes and jobs" do %>
    <%= empty_state title: "Nothing to follow up yet",
                    text: "Quotes, jobs and invoices you create will show up here with what needs your attention.",
                    icon: "inbox" %>
  <% end %>
</div>

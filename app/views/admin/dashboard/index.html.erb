<%# INS-01: what needs the office now, today's visits, and how the month is going. %>
<% dashboard = @dashboard %>
<%= page_header "Good #{day_period}, #{current_user.first_name.presence || "there"}",
                lede: "Here's where #{location_filter&.name || current_business.name} stands." do %>
  <%= render "admin/shared/location_filter", path: admin_root_path if can?(:office) %>
<% end %>

<%= render "tour_offer" if @tour_offer %><%# ACC-08 %>

<%# #289: a new business starts with the checklist, above the month's numbers. %>
<% if can?(:business_settings) && @checklist.visible? %>
  <div class="mb-4"><%= render "setup_checklist", checklist: @checklist %></div>
<% elsif can?(:business_settings) && @checklist.hidden_by_member? %>
  <div class="mb-4"><%= button_to "Show setup checklist", admin_show_setup_path, method: :patch, class: "btn-link text-sm2" %></div>
<% end %>

<% if can?(:office) %>
  <%= render "admin/usage/limit_notice", entitlements: dashboard.entitlements %>
  <%# How the month is going. %>
  <section class="mb-4" aria-labelledby="month-summary-h">
    <h2 id="month-summary-h" class="sr-only">How this <%= dashboard.entitlements.period.billing_cycle? ? "billing period" : "month" %> is going</h2>
    <dl class="grid grid-cols-1 gap-3 sm:grid-cols-3" id="month-summary">
      <div class="card card-body py-3"><dt class="text-sm2 text-muted">Quotes sent<%= " this #{dashboard.entitlements.period.billing_cycle? ? "billing period" : "month"}" unless dashboard.quote_limit %></dt><dd class="mt-1 text-lg font-semibold text-ink" id="quotes-sent-usage"><%= dashboard.quotes_sent_this_period %></dd>
        <% if (allowance = quote_allowance(dashboard.entitlements, used: dashboard.quotes_sent_this_period, count: false)) %><%# #289: what the limit is, in words %>
          <dd class="text-sm2 text-muted" id="quotes-sent-allowance"><%= allowance %> · resets <%= local_date(dashboard.entitlements.period.resets_on) %></dd>
        <% end %></div>
      <div class="card card-body py-3"><dt class="text-sm2 text-muted">Approval rate</dt><dd class="mt-1 text-lg font-semibold text-ink"><%= dashboard.approval_rate ? "#{dashboard.approval_rate}%" : "–" %></dd></div>
      <div class="card card-body min-w-0 py-3"><dt class="text-sm2 text-muted">Payments received</dt>
        <dd class="money mt-1 break-words text-lg font-semibold text-ink"><%= dashboard.payments_this_month.any? ? safe_join(dashboard.payments_this_month.map { money(_1) }, tag.br) : money(Money.zero(current_business.currency_code)) %></dd></div>
    </dl>
  </section>
<% end %>

<%# #289: one place to start: the checklist (above), then today, then money owed and what needs you. %>
<div class="space-y-4">
  <% if can?(:office) %>
    <%= render "today", dashboard:, own_day: @own_day, earlier_open: @earlier_open.to_i %>
    <%= render "money_owed", dashboard: %>
  <% end %>

  <% if !can?(:office) %>
    <%# Settings without office work (a custom role): nothing here is theirs to act on. %>
  <% elsif dashboard.groups.all?(&:empty?) && !@checklist.visible? %>
    <%= card do %>
      <%= empty_state title: "You're all caught up",
                      text: "Nothing needs you right now. New requests, quotes waiting on clients, jobs to book and overdue invoices will show up here.",
                      icon: "check-circle" do %>
        <%= link_to new_admin_quote_path, class: button_classes do %><%= icon "plus" %> New quote<% end %>
      <% end %>
    <% end %>
  <% else %>
    <div class="grid items-start gap-4 lg:grid-cols-2">
      <% dashboard.groups.reject(&:empty?).each do |group| %>
        <% path_name, options = group.path %>
        <%= card title: "#{group.title} (#{group.count})", id: "group-#{group.key}", flush: true,
                 actions: link_to(public_send(path_name, **options), class: button_classes(:ghost, :sm)) { safe_join([ (group.count > group.items.size ? "See all #{group.count}" : "See all"), tag.span(" #{group.title.downcase}", class: "sr-only") ]) } do %>
          <ul class="list">
            <% group.items.each do |item| %><%= render "group_item", key: group.key, item:, today: dashboard.today %><% end %>
          </ul>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

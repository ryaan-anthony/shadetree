<%# ACC-08: offered once on Home, after the business is created or (an existing business's Owner,
    its checklist unfinished) on their first visit: one click starts the tour, one skips it. %>
<section class="card card-body mb-4 flex flex-wrap items-center gap-x-4 gap-y-3" aria-labelledby="tour-offer-h" id="tour-offer" data-tour-offer>
  <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-canopy-50 text-canopy"><%= icon "map", class: "size-5" %></span>
  <div class="min-w-48 flex-1">
    <h2 id="tour-offer-h" class="section-title"><%= t("guidance.tour.offer.title") %></h2>
    <p class="text-sm2 text-muted"><%= t("guidance.tour.offer.text") %></p>
  </div>
  <div class="flex shrink-0 gap-2">
    <button type="button" class="<%= button_classes %>" data-tour-start><%= t("guidance.tour.offer.start") %></button>
    <% unless impersonation %><%# support can't answer the offer for them %>
      <%= button_to t("guidance.tour.offer.skip"), admin_tour_path, method: :patch, params: { event: "end", stop: GuidedTour::OFFER },
                    class: button_classes(:secondary), form: { class: "contents" } %>
    <% end %>
  </div>
</section>

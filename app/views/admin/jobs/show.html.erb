<%# JOB-01: everything about a job: its visits (JOB-02) and its invoices (PAY-01). %>
<% job = @job %>
<% totals = job.totals %>
<% split = QuoteWork.split?(current_business) %>
<% billable = split && WorkBilling.billable?(job) %><%# PAY-06: worked out once for the banner and the Invoices card %>
<%# PAY-08: what's been billed of the quote's work, read once: progress, the discount left. %>
<% ledger = (BillingLedger.new(quote: job.quote, job:) if split) %>
<% discount_left = ledger && job.quote&.approved? ? ledger.outstanding_cents : 0 %>
<% takes_whole = discount_left.positive? && billable && ledger.finishes?(WorkBilling.unbilled_lines(job)) %>
<%# JOB-09: "From Q-0004: 2 of 3 services" when a quote's work is split among jobs. %>
<% from_quote = if job.quote && split
                  safe_join([ " · from ", link_to(job.quote.number, admin_quote_path(job.quote), class: "font-medium text-ink hover:underline"),
                              ": #{job.claims.count} of #{pluralize(job.quote.line_items.size, "service")}" ])
                elsif job.quote
                  safe_join([ " · from ", link_to("quote #{job.quote.number}", admin_quote_path(job.quote), class: "font-medium text-ink hover:underline") ])
                end %>
<% content_for :title, "#{job.number} #{job.title}" %>
<%= page_header job.title, lede: safe_join([ "#{job.number} for ", link_to(job.client.display_name, admin_client_path(job.client), class: "font-medium text-ink hover:underline"),
                                              from_quote, location_badge(job) ].compact) do %>
  <% if job.open? %>
    <%= link_to edit_admin_job_path(job), class: button_classes(:secondary) do %><%= icon "edit-2" %> Edit<% end %>
    <%# PLT-14 (owner, 2026-11-22): with nothing booked, the next step is a visit; then Complete. %>
    <% unbooked = can?(:schedule) && job.visits.where.not(status: "cancelled").none? %>
    <% if unbooked %>
      <%= link_to new_admin_job_visit_path(job), class: button_classes(:primary) do %><%= icon "calendar" %> Schedule visit<% end %>
    <% end %>
    <% if split %>
      <%= render "admin/jobs/complete", job:, rank: unbooked ? :secondary : :primary %>
    <% else %>
      <%= button_to complete_admin_job_path(job), method: :patch, class: button_classes(unbooked ? :secondary : :primary),
                    form: { class: "contents", data: { turbo_confirm: ["Mark #{job.number} completed?", (" Visits not started yet are cancelled." if job.visits.scheduled.exists?)].join, turbo_confirm_button: "Complete job" } } do %><%= icon "check" %> Complete<% end %>
    <% end %>
    <div class="contents" data-controller="modal">
      <button type="button" class="<%= button_classes(:destructive) %>" data-action="modal#open" data-modal-target="return" aria-haspopup="dialog">Cancel job</button>
      <%= modal id: "job-cancel", title: "Cancel #{job.number}?", description: "It moves to Cancelled, with any open visits. You can reopen it later." do %>
        <%= form_with url: cancel_admin_job_path(job), method: :patch, class: "space-y-4" do %>
          <div class="field">
            <label class="label" for="reason">Reason <span class="label-optional">(optional)</span></label>
            <%= text_field_tag :reason, nil, class: "input", maxlength: 200, placeholder: "Client changed their mind" %>
          </div>
          <% if job.visits.scheduled.where(scheduled_on: current_business.today..).exists? %>
            <%= render "admin/visits/notify_client", job:, kind: "cancelled", id: "notify-client-job" %>
          <% end %>
          <div class="flex justify-end gap-2">
            <button type="button" class="<%= button_classes(:tertiary) %>" data-action="modal#close">Keep job</button>
            <%= submit_tag "Cancel job", class: button_classes(:destructive_solid), name: nil %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%= button_to reopen_admin_job_path(job), method: :patch, class: button_classes(:secondary), form: { class: "contents" } do %><%= icon "rotate-ccw" %> Reopen<% end %>
  <% end %>
<% end %>

<% if job.status == "completed" %>
  <div class="banner banner-success mb-4"><%= icon "check-circle" %>
    <%# PAY-06 (split jobs): ready while some of its lines aren't billed; before, until it has an invoice. %>
    <% uninvoiced = split ? billable : job.invoices.none? %>
    <p class="flex-1">Completed <%= local_time(job.completed_at) %><%= " by #{job.completed_by.full_name}" if job.completed_by %>.<%= " Ready to invoice." if uninvoiced %></p>
    <% if uninvoiced && split && discount_left.positive? %><%# PAY-08: how much of the quote's discount to apply %>
      <%= render "admin/invoices/create_with_discount", url: admin_job_invoices_path(job), label: "Create invoice", left: discount_left, unused: ledger.unused_discount_cents, currency: job.currency,
                                                        id: "job-banner-invoice", button_class: button_classes(:primary, :sm), whole: takes_whole %>
    <% elsif uninvoiced %>
      <%= button_to admin_job_invoices_path(job), class: button_classes(:primary, :sm), form: { class: "contents" } do %><%= icon "invoice" %> Create invoice<% end %>
    <% end %></div>
<% elsif job.status == "cancelled" %>
  <div class="banner banner-warning mb-4"><%= icon "x-circle" %>
    <p>Cancelled <%= local_time(job.cancelled_at) %><%= " by #{job.cancelled_by.full_name}" if job.cancelled_by %><%= job.cancel_reason ? ": “#{job.cancel_reason}”" : "." %></p></div>
<% end %>

<div class="grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,1fr)_20rem]">
  <div class="min-w-0 space-y-4">
    <%= card do %>
      <dl class="grid gap-4 text-sm sm:grid-cols-3">
        <div><dt class="text-sm2 text-muted">Status</dt><dd class="mt-1"><%= job_status_badge(job) %></dd></div>
        <div><dt class="text-sm2 text-muted">Created</dt><dd class="mt-1 text-ink"><%= local_date(job.created_at.in_time_zone(current_business.time_zone).to_date) %></dd></div>
        <div><dt class="text-sm2 text-muted">Value</dt><dd class="money mt-1 font-semibold text-ink"><%= money(totals.total) %></dd></div>
      </dl>
    <% end %>

    <%= render "admin/jobs/visits", job: %>

    <%# PAY-01: a job can be billed more than once (progress billing). PAY-06 (split jobs): it bills
        completed work once, so Create invoice is offered only while some of it is unbilled; its
        invoices include a quote's invoice that billed it with other jobs. %>
    <% invoices = job.invoices.order(:created_at, :id).to_a %>
    <% billed = invoices.reject(&:void?) %><%# #289: a second invoice is possible (progress billing), but never the obvious button %>
    <%# PAY-08: before it's done, part of it can be billed as progress (credited on its final invoice). %>
    <%# PAY-08: with some of the quote's discount left, each asks how much to apply now (owner, 2026-11-23). %>
    <% progress_blocked = split && job.open? && ledger&.progress_blocked? %><%# B11: nothing it could bill would leave room for the discount %>
    <% progress_ok = job.open? && !job.quote&.recurring? && !progress_blocked %>
    <% create = if split && discount_left.positive?
                  safe_join([ (render("admin/invoices/create_with_discount", url: admin_job_invoices_path(job, progress: 1), label: "Create progress invoice", left: discount_left, currency: job.currency,
                                      id: "job-progress-invoice", button_class: button_classes(:tertiary, :sm), confirm: "Bill part of #{job.number} before it's done. A progress invoice is credited when the work is billed.") if progress_ok),
                              (render("admin/invoices/create_with_discount", url: admin_job_invoices_path(job), label: "Create invoice", left: discount_left, unused: ledger.unused_discount_cents, currency: job.currency,
                                      id: "job-create-invoice", button_class: button_classes(:secondary, :sm), whole: takes_whole) if billable) ].compact, " ").presence
                elsif split
                  safe_join([ (button_to(admin_job_invoices_path(job, progress: 1), class: button_classes(:tertiary, :sm), id: "job-progress-invoice",
                                         form: { class: "contents", data: { turbo_confirm: "Bill part of #{job.number} before it's done? A progress invoice is credited when the work is billed.", turbo_confirm_button: "Create progress invoice" } }) { icon("plus") + " Create progress invoice" } if progress_ok),
                              (button_to(admin_job_invoices_path(job), class: button_classes(:secondary, :sm), form: { class: "contents" }) { icon("plus") + " Create invoice" } if billable) ].compact, " ").presence
                else
                  button_to(admin_job_invoices_path(job), class: button_classes(billed.any? ? :tertiary : :secondary, :sm),
                            form: { class: "contents", data: (billed.any? ? { turbo_confirm: "#{job.number} already has #{billed.map(&:number).to_sentence}. Create another invoice?", turbo_confirm_button: "Create another invoice" } : {}) }) { icon("plus") + (billed.any? ? " Create another invoice" : " Create invoice") }
                end %>
    <%= card title: "Invoices", id: "invoices", flush: true, actions: create do %>
      <%= render "admin/invoices/list", invoices:, empty: split ? "Not invoiced yet. Once it's completed, Create invoice bills what was done." : "Not invoiced yet. Create invoice copies this job's items, discount and taxes." %>
      <% if progress_blocked %><p class="border-t border-line px-5 py-3 text-sm2 text-muted" id="job-progress-blocked"><%= BillingLedger::PROGRESS_BLOCKED %></p><% end %>
      <%= render "admin/invoices/progress_summary", summary: ledger.summary(job:), currency: job.currency, id: "job-progress" if split %>
      <%= render "admin/invoices/unused_discount", ledger: (ledger if job.quote&.approved?), currency: job.currency, id: "job-discount-unused" %>
      <% job_payments = Payment.where(invoice_id: invoices.map(&:id)).includes(:invoice).chronological.to_a %>
      <% if job_payments.any? %><%# PAY-05: what's been paid on them; Stripe's reference is only on the invoice (PLT-18) %>
        <ul class="list border-t border-line" id="job-payments" aria-label="Payments">
          <% job_payments.each do |payment| %>
            <li class="text-sm2"><%= icon "dollar-sign", class: "size-4 text-faint" %>
              <span class="min-w-0 flex-1 break-words text-subtle"><%= payment.online? ? "Paid online, #{payment.method_detail || "card"}" : payment.method_label %> · <%= payment.invoice.number %> · <%= local_date(payment.received_on) %><%= " · #{payment.reference}" if payment.reference && payment.recorded? %><%= " · #{payment.adjustment_label}" if payment.adjustment_label %></span>
              <span class="money font-semibold text-ink"><%= money(payment.amount) %></span></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>

    <%= card title: "Work to do", subtitle: (job.quote ? "Copied from quote #{job.quote.number}." : nil), flush: true,
             actions: (safe_join([ (link_to(new_admin_job_work_path(job), class: button_classes(:secondary, :sm)) { icon("plus") + " Add to-do work" } if split && job.quote&.line_items&.any? { _1.to_do_quantity.positive? }),
                                   link_to("Edit items", edit_admin_job_path(job, items: 1, anchor: "job-items"), class: button_classes(:secondary, :sm)) ].compact, " ") if job.open?) do %>
      <% lines = job.line_items.to_a %>
      <% work = split ? job.work_by_person : {} %><%# JOB-09: "Marcus 4, Riley 2" %>
      <% if lines.empty? %>
        <p class="px-5 py-4 text-sm2 text-muted">No items yet. Add them to invoice from this job, or let the instructions say what it is.</p>
      <% else %>
        <div class="table-wrap">
          <table class="data-table" id="job-lines">
            <thead><tr><th scope="col">Item</th><th scope="col" class="text-right">Amount</th></tr></thead>
            <tbody>
              <% lines.zip(totals.lines).each do |line, priced| %>
                <tr>
                  <td><span class="font-medium text-ink"><%= line.name.presence || "Item" %></span><%= badge("Needs a price", tone: :warning, class: "ml-1") if line.price_pending %>
                    <% if line.description %><span class="sub whitespace-pre-line"><%= line.description %></span><% end %>
                    <span class="sub"><%= line_quantity(line) %></span>
                    <% if (people = work[line.id]).present? %><span class="sub">Logged: <%= people.map { |user, quantity| "#{user&.first_name.presence || user&.full_name || "Someone"} #{QuoteWork.number(quantity)}" }.join(", ") %></span><% end %></td>
                  <td class="money num"><%= money(priced.subtotal) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="border-t border-line px-5 py-3"><%= render "admin/quotes/totals", quote: job, totals: %></div>
      <% end %>
    <% end %>

    <% if split %><%= render "admin/jobs/work_log", job: %><% end %>

    <%= card title: "Instructions for the crew" do %>
      <% if job.instructions %>
        <p class="whitespace-pre-line text-sm text-ink" id="job-instructions"><%= job.instructions %></p>
      <% else %>
        <p class="text-sm2 text-muted">None yet. <%= link_to("Add instructions", edit_admin_job_path(job), class: "font-medium text-ink underline-offset-2 hover:underline") if job.open? %></p>
      <% end %>
    <% end %>

    <% files = job.attachments.includes(:blob).to_a %>
    <% if files.any? %>
      <%= card title: "Photos and files" do %>
        <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3" id="job-files">
          <% files.each do |file| %>
            <li class="min-w-0">
              <%= link_to rails_blob_path(file, disposition: "inline"), target: "_blank", rel: "noopener", class: "block text-sm2 text-ink hover:underline", "aria-label": file.filename.to_s do %>
                <% if file.image? %>
                  <%= image_tag rails_representation_path(file.variant(:web)), alt: file.filename.to_s, loading: "lazy", class: "aspect-[4/3] w-full rounded-control bg-sunken object-cover" %>
                <% else %>
                  <span class="flex aspect-[4/3] items-center justify-center rounded-control bg-sunken"><%= icon "file-text", class: "size-6 text-faint" %></span>
                <% end %>
                <span class="mt-1 block truncate" title="<%= file.filename %>"><%= attachment_name(file) %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  </div>

  <aside class="rail space-y-4">
    <%= card title: "Client and property" do %>
      <% client = job.client %>
      <p class="font-semibold text-ink"><%= link_to client.display_name, admin_client_path(client), class: "hover:underline" %></p>
      <% if (property = job.property) %>
        <p class="mt-1 break-words text-sm2 text-ink"><%= property.one_line %></p>
        <% if property.access_notes.present? %>
          <div class="mt-3 rounded-control bg-sunken p-3 text-sm2"><p class="font-semibold text-ink">Access notes</p><p class="mt-1 whitespace-pre-line text-subtle"><%= property.access_notes %></p></div>
        <% end %>
      <% else %>
        <p class="mt-1 text-sm2 text-muted">No property chosen.</p>
      <% end %>
      <ul class="mt-3 space-y-1 text-sm2">
        <% if (phone = client.primary_phone) %><li><%= phone_link(phone.value, class: "text-ink hover:underline") { icon("phone", class: "mr-1 inline size-4 text-faint") + phone_number(phone.value) } %></li><% end %>
        <% if (email = client.primary_email) %><li><%= mail_to email.value, class: "break-words text-ink hover:underline" do %><%= icon "mail", class: "mr-1 inline size-4 text-faint" %><%= email.value %><% end %></li><% end %>
      </ul>
    <% end %>

    <%= render "admin/jobs/client_emails", job: %>

    <% if job.internal_notes %>
      <%= card title: "Internal notes", subtitle: "Only your team sees these." do %>
        <p class="whitespace-pre-line text-sm2 text-ink"><%= job.internal_notes %></p>
      <% end %>
    <% end %>
    <%= render "admin/automations/record_runs", record: job %>
  </aside>
</div>

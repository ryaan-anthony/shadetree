<%# locals: (job:) -%>
<%# JOB-02: the job's visits, in date order, with what changed and who changed it. %>
<% visits = job.visits.includes(:assignees, events: :user, notes: :user, photos_attachments: :blob).in_order.to_a %>
<% can_schedule = can?(:schedule) %>
<%= card title: "Visits", flush: true, id: "visits",
         actions: (link_to(new_admin_job_visit_path(job), class: button_classes(:secondary, :sm)) { icon("plus") + " Schedule visit" } if can_schedule && job.open?) do %>
  <% if visits.empty? %>
    <p class="px-5 py-4 text-sm2 text-muted"><%= job.open? ? "Nothing booked yet. Schedule a visit to put this job on the calendar." : "No visits." %></p>
  <% else %>
    <ul class="list">
      <% visits.each do |visit| %>
        <li id="visit-<%= visit.uid %>" class="items-start <%= "bg-sunken/50" unless visit.open? %>">
          <div class="w-12 shrink-0 text-center">
            <p class="text-xs font-semibold uppercase text-muted"><%= visit.scheduled_on.strftime("%b") %></p>
            <p class="text-lg font-semibold leading-tight text-ink"><%= visit.scheduled_on.day %></p>
          </div>
          <div class="min-w-0 flex-1">
            <p class="font-medium text-ink"><%= visit.scheduled_on.strftime("%A") %>, <%= visit.time_label.sub(/\AArrive/, "arrive").sub("Anytime", "anytime") %>
              <% unless visit.status == "scheduled" %><%= badge visit.status_label, tone: { "in_progress" => :info, "completed" => :success, "cancelled" => :neutral }.fetch(visit.status) %><% end %></p>
            <p class="text-sm2 text-muted">About <%= visit.duration_label %> · <%= visit.assignees.any? ? visit.assignees.map(&:full_name).to_sentence : "Not assigned" %></p>
            <% if visit.instructions %><p class="mt-1 whitespace-pre-line text-sm2 text-subtle"><%= visit.instructions %></p><% end %>
            <% if visit.cancel_reason %><p class="mt-1 text-sm2 text-subtle">Cancelled: “<%= visit.cancel_reason %>”</p><% end %>
            <% if (photos = visit.photos.to_a).any? %>
              <ul class="mt-2 flex flex-wrap gap-1.5">
                <% photos.each.with_index(1) do |photo, number| %>
                  <li><%= link_to rails_representation_path(photo.variant(:web)), target: "_blank", rel: "noopener" do %>
                    <%= image_tag rails_representation_path(photo.variant(:thumb)), alt: "Photo #{number} of #{photos.size} from the #{visit.when_label} visit", loading: "lazy", class: "size-14 rounded-control bg-sunken object-cover" %><% end %></li>
                <% end %>
              </ul>
            <% end %>
            <% visit.notes.each do |note| %>
              <p class="mt-1 text-sm2"><span class="whitespace-pre-line text-ink">“<%= note.body %>”</span> <span class="text-muted">— <%= note.user&.full_name || "Someone" %>, <%= local_time(note.created_at) %></span></p>
            <% end %>
            <% if visit.events.size > 1 %>
              <details class="mt-1 text-sm2">
                <summary class="cursor-pointer text-muted">History</summary>
                <ol class="mt-1 space-y-0.5 text-subtle">
                  <% visit.events.each do |event| %>
                    <li><span class="text-ink"><%= visit_event_text(event) %></span>
                      <span class="block text-muted"><%= event.actor_label("Someone") %>, <%= local_time(event.occurred_at) %></span></li>
                  <% end %>
                </ol>
              </details>
            <% end %>
          </div>
          <% if can_schedule %>
            <div class="contents" data-controller="modal">
            <div class="relative" data-controller="menu" data-action="keydown->menu#keydown">
              <button type="button" class="<%= button_classes(:ghost, :sm, :icon) %>" data-menu-target="button" data-action="menu#toggle"
                      aria-haspopup="true" aria-expanded="false" aria-label="Actions for the visit on <%= visit.when_label %>"><%= icon "more-horizontal" %></button>
              <div class="menu right-0 top-full mt-1" data-menu-target="menu" hidden>
                <% if visit.open? %>
                  <%= link_to edit_admin_job_visit_path(job, visit), class: "menu-item" do %><%= icon "calendar" %> Reschedule or reassign<% end %>
                  <%= button_to complete_admin_job_visit_path(job, visit), method: :patch, class: "menu-item",
                                form: { class: "contents", data: { turbo_confirm: "Mark the visit on #{visit.when_label} completed?", turbo_confirm_button: "Mark completed" } } do %><%= icon "check" %> Mark completed<% end %>
                  <button type="button" class="menu-item" data-action="modal#open menu#close" aria-haspopup="dialog"><%= icon "x" %> Cancel visit</button>
                <% elsif visit.status == "cancelled" && job.open? %>
                  <%= button_to restore_admin_job_visit_path(job, visit), method: :patch, class: "menu-item", form: { class: "contents" } do %><%= icon "rotate-ccw" %> Restore<% end %>
                <% end %>
              </div>
            </div>
            <% if visit.open? %>
              <%= modal id: "visit-cancel-#{visit.uid}", title: "Cancel the visit on #{visit.when_label}?", description: "It stays in the job's history. You can restore it while the job is open." do %>
                <%= form_with url: cancel_admin_job_visit_path(job, visit), method: :patch, class: "space-y-4" do %>
                  <div class="field">
                    <label class="label" for="reason-<%= visit.uid %>">Reason <span class="label-optional">(optional)</span></label>
                    <%= text_field_tag :reason, nil, id: "reason-#{visit.uid}", class: "input", maxlength: 200, placeholder: "Rain" %>
                  </div>
                  <%= render "admin/visits/notify_client", job:, kind: "cancelled", id: "notify-client-#{visit.uid}" %>
                  <div class="flex justify-end gap-2">
                    <button type="button" class="<%= button_classes(:secondary) %>" data-action="modal#close">Keep visit</button>
                    <%= submit_tag "Cancel visit", class: button_classes(:danger), name: nil %>
                  </div>
                <% end %>
              <% end %>
            <% end %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>

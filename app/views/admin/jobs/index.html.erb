<%= page_header "Jobs", lede: "Work your clients have agreed to." do %>
  <%= render "admin/shared/location_filter", path: admin_jobs_path, keep: { filter: @filter } %>
  <%= link_to new_admin_job_path, class: button_classes do %><%= icon "plus" %> New job<% end %>
<% end %>

<%# Like the quote list: one filter form posted to #search (POST keeps client names out of URLs),
    its results replacing only the frame below; the tabs are its submit buttons. %>
<%= form_with url: search_admin_jobs_path, method: :post, id: "job-filters", class: "mb-4",
              data: { controller: "search-form tabs", turbo_frame: "job_results" } do %>
  <input type="hidden" name="filter" value="<%= @filter %>" data-tabs-target="field">
  <div class="relative max-w-md">
    <label class="sr-only" for="q">Search jobs</label>
    <%= icon "search", class: "pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-faint" %>
    <%= search_field_tag :q, @query, class: "input pl-9", placeholder: "Job number, title or client", autocomplete: "off",
                         data: { action: "input->search-form#queue keydown.enter->search-form#submit:prevent" } %>
  </div>
  <noscript><%= submit_tag "Search", class: button_classes(:secondary), name: nil %></noscript>
  <%= tabs Job::FILTERS, current: @filter, label: "Show jobs", counts: @counts, name: "filter", class: "mt-4", data: { tabs_target: "row" } %>
<% end %>

<%= results_status "job_results" %>
<%= render "results" %>

<% unless current_business.auto_create_jobs %>
  <p class="mt-4 text-sm2 text-muted">Approved quotes don't become jobs on their own. Make one from the quote's page, or turn this on in
    <%= link_to "Settings", edit_admin_business_path(tab: "documents"), class: "font-medium text-ink underline-offset-2 hover:underline" %>.</p>
<% end %>

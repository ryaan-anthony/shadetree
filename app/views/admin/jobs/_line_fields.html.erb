<%# locals: (f:, catalog:, currency:) -%>
<%# JOB-01: one line of work on the job form. A catalog item fills the row; everything stays editable. %>
<% line = f.object %>
<% row_id = "line-#{f.index}" %>
<fieldset class="nested-row rounded-control border border-line p-3" data-nested-fields-target="row" data-controller="line-fill" <%= "hidden" if line.marked_for_destruction? %>
          aria-labelledby="<%= row_id %>-legend">
  <legend class="sr-only" id="<%= row_id %>-legend"><%= line.name.presence || "New item" %></legend>
  <%= f.hidden_field :id if line.persisted? %>
  <%= f.hidden_field :_destroy, value: line.marked_for_destruction? ? "1" : "0", data: { nested_fields_target: "destroy" } %>
  <div class="flex items-start gap-2">
    <div class="grid min-w-0 flex-1 gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <% if catalog.any? %>
        <div class="field sm:col-span-2">
          <label class="label" for="<%= row_id %>-catalog">From your catalog <span class="label-optional">(optional)</span></label>
          <select id="<%= row_id %>-catalog" name="<%= f.object_name %>[catalog_item_uid]" class="select" data-action="line-fill#fill">
            <option value="">A custom item</option>
            <% catalog.each do |item| %>
              <option value="<%= item.uid %>" <%= "selected" if item.uid == line.catalog_item_uid %>
                      data-name="<%= item.name %>" data-description="<%= item.description %>" data-unit="<%= item.unit_label %>"
                      data-price="<%= item.unit_price&.to_s %>" data-taxable="<%= item.taxable %>"><%= item.name %></option>
            <% end %>
          </select>
        </div>
      <% end %>
      <div class="sm:col-span-2"><%= f.field :name, label: "Item", maxlength: 200, data: { line_fill_target: "name" } %></div>
      <div class="sm:col-span-2"><%= f.field :description, as: :textarea, optional: true, rows: 2, maxlength: 2_000, data: { line_fill_target: "description" } %></div>
      <div class="grid grid-cols-2 gap-3">
        <%= f.field :quantity, value: line.quantity_for_form, inputmode: "decimal", label: "Qty", data: { line_fill_target: "quantity" } %>
        <%= f.field :unit, optional: true, maxlength: 20, placeholder: "hour", data: { line_fill_target: "unit" } %>
      </div>
      <div><%= f.field :unit_price, as: :money, currency:, label: "Price each", value: line.unit_price_before_type_cast, placeholder: "0.00", data: { line_fill_target: "price" } %></div>
      <div class="sm:col-span-2 flex flex-wrap items-center gap-x-4 gap-y-1">
        <%= f.check :taxable, label: "Taxable", data: { line_fill_target: "taxable" } %>
        <% if line.discount_kind %><span class="text-sm2 text-muted">Keeps its <%= line.discount_kind == "percent" ? "#{line.discount_value}%" : money(line.discount_amount) %> discount from the quote.</span><% end %>
      </div>
    </div>
    <button type="button" class="<%= button_classes(:ghost, :sm, :icon) %> shrink-0" data-action="nested-fields#remove"
            aria-label="Remove <%= line.name.presence || "this item" %>"><%= icon "x" %></button>
  </div>
</fieldset>

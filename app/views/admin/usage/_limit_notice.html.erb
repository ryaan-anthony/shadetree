<%# locals: (entitlements: current_business.entitlements) -%>
<%# BIL-03: where the business stands on sending quotes this period: approaching the limit, at
    it (one more allowed), or over it. Owners get an upgrade link; others are told to ask. %>
<% state = entitlements.quote_sending %>
<% unless state == :ok %>
  <% used, limit, resets = entitlements.used(:quotes_sent), entitlements.limit(:quotes_sent), entitlements.period.resets_on %>
  <% plan = entitlements.plan.name %>
  <div class="banner <%= state == :approaching ? "banner-info" : "banner-warning" %> mb-4" role="note" id="quote-limit-notice">
    <%= icon(state == :approaching ? "info" : "alert-triangle") %>
    <p class="flex-1">
      <% case state %>
      <% when :approaching %>
        You've sent <%= used %> of the <%= limit %> quotes your <%= plan %> plan includes this period. It resets <%= local_date(resets) %>.
      <% when :at_limit %>
        You've sent all <%= limit %> quotes your <%= plan %> plan includes this period. You can send one more; after that, new quotes wait until <%= local_date(resets) %> or a bigger plan.
      <% else %>
        <% if limit.zero? %>Your <%= plan %> plan doesn't include sending quotes.<% else %>You've used this period's <%= limit %> quotes and your one extra. New quotes can be sent again on <%= local_date(resets) %>.<% end %> Drafts keep saving, and quotes already sent still work for your clients.
      <% end %>
      <% if Current.membership&.can?(:billing) %>
        <%= link_to "See plans", admin_plan_path, class: "font-semibold underline-offset-2 hover:underline" %>
      <% else %>
        Ask <%= current_business.owner.first_name.presence || "the owner" %> about a bigger plan.
      <% end %>
    </p>
  </div>
<% end %>

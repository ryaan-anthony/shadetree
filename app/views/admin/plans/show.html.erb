<%# BIL-01: the business's plan, its limits and features with what's used, and the other plans. %>
<% content_for :title, "Plan" %>
<%= render "admin/businesses/settings_header", current: "plan" %>
<% plan = @entitlements.plan %>

<div class="max-w-2xl">
  <%= card title: "You're on #{plan.name}", subtitle: plan.description, id: "current-plan" do %>
    <dl class="space-y-3 text-sm">
      <% Plan::LIMITS.each do |key, label| %>
        <% limit = @entitlements.limit(key) %>
        <div class="flex items-baseline justify-between gap-3" id="limit-<%= key %>">
          <dt class="text-subtle"><%= label %><% if key == "team_members" %><span class="block text-sm2 text-muted">Counting you and pending invitations</span><% end %></dt>
          <dd class="font-semibold text-ink"><%= limit ? "#{@entitlements.used(key)} of #{limit}" : "#{@entitlements.used(key)}, no limit" %></dd>
        </div>
      <% end %>
    </dl>
    <ul class="mt-4 space-y-1.5 border-t border-line pt-4 text-sm" aria-label="Features">
      <% Plan::FEATURES.each do |key, label| %>
        <% included = @entitlements.feature?(key) %>
        <li class="flex items-center gap-2 <%= included ? "text-ink" : "text-muted" %>">
          <%= icon(included ? "check" : "minus", class: "size-4 #{included ? "text-success" : "text-faint"}") %>
          <span><%= label %></span><span class="sr-only"><%= included ? "(included)" : "(not included)" %></span>
        </li>
      <% end %>
    </ul>
    <p class="mt-4 text-sm2 text-muted" id="usage-resets">Your quote count resets on <%= local_date(@entitlements.period.resets_on) %>.</p>
    <%= render "billing", subscription: @subscription, business: @business %>
  <% end %>
</div>

<% choosing = can?(:billing) %>
<% yearly = @plans.any? { plan_yearly?(_1) } %>
<div class="group/interval">
<div class="mb-3 mt-8 flex flex-wrap items-center justify-between gap-3">
  <h2 class="text-base font-semibold text-ink">Compare plans</h2>
  <% if choosing && yearly %>
    <% savings = @plans.filter_map { plan_annual_saving(_1) }.uniq %>
    <fieldset class="inline-flex rounded-control border border-line bg-sunken p-1 text-sm" id="interval-choice">
      <legend class="sr-only">Pay</legend>
      <label class="cursor-pointer rounded-[4px] px-3 py-1 font-medium text-subtle has-[:checked]:bg-surface has-[:checked]:text-ink has-[:checked]:shadow-card has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-canopy">
        <input type="radio" name="interval" value="monthly" class="sr-only" <%= "checked" unless @subscription&.live? && @subscription.yearly? %>> Monthly
      </label>
      <label class="cursor-pointer rounded-[4px] px-3 py-1 font-medium text-subtle has-[:checked]:bg-surface has-[:checked]:text-ink has-[:checked]:shadow-card has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-canopy">
        <input type="radio" name="interval" value="yearly" class="sr-only" id="interval-yearly" <%= "checked" if @subscription&.live? && @subscription.yearly? %>> Yearly<%= ", #{savings.first}" if savings.one? %>
      </label>
    </fieldset>
  <% end %>
</div>
<div class="overflow-x-auto rounded-card border border-line bg-surface" tabindex="0" role="region" aria-label="Compare plans">
  <table class="w-full min-w-[40rem] text-sm" id="compare-plans">
    <caption class="sr-only">Limits and features of each plan</caption>
    <thead>
      <tr class="border-b border-line text-left">
        <th scope="col" class="p-3 font-medium text-muted"><span class="sr-only">What's included</span></th>
        <% @plans.each do |option| %>
          <th scope="col" class="p-3 <%= "bg-sunken" if option == plan %>">
            <span class="block font-semibold text-ink"><%= option.name %><%= " (yours)" if option == plan %></span>
            <span class="block text-sm2 font-normal text-muted"><%= option.free? ? "No charge" : "#{money(option.monthly_price)}/month" %></span>
            <% unless option.free? || option.annual_price_cents.zero? %><span class="block text-xs font-normal text-muted">or <%= money(option.annual_price) %>/year</span><% end %>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% Plan::LIMITS.each do |key, label| %>
        <tr class="border-b border-line">
          <th scope="row" class="p-3 text-left font-normal text-subtle"><%= label %></th>
          <% @plans.each do |option| %><td class="p-3 text-ink <%= "bg-sunken" if option == plan %>"><%= option.limits[key] || "Unlimited" %></td><% end %>
        </tr>
      <% end %>
      <% Plan::FEATURES.each do |key, label| %>
        <tr class="border-b border-line last:border-b-0">
          <th scope="row" class="p-3 text-left font-normal text-subtle"><%= label %></th>
          <% @plans.each do |option| %>
            <td class="p-3 <%= "bg-sunken" if option == plan %>"><%= option.features[key] ? icon("check", label: "Included", class: "size-4 text-success") : icon("minus", label: "Not included", class: "size-4 text-faint") %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
    <% if choosing %>
      <tfoot>
        <tr class="border-t border-line" id="choose-plan">
          <th scope="row" class="p-3 text-left font-normal text-subtle"><span class="sr-only">Choose a plan</span></th>
          <% @plans.each do |option| %>
            <td class="p-3 align-top <%= "bg-sunken" if option == plan %>" id="choose-<%= option.key %>">
              <%= render "choose", option:, plan:, subscription: @subscription, interval: "monthly", yearly: %>
              <% if yearly %><%= render "choose", option:, plan:, subscription: @subscription, interval: "yearly", yearly: %><% end %>
            </td>
          <% end %>
        </tr>
      </tfoot>
    <% end %>
  </table>
</div>
<% if choosing %>
  <p class="mt-3 text-sm2 text-muted">You pay on Stripe's secure page; Shadetree never sees your card. Upgrades start straight away; a switch is prorated, and a cancelled plan runs to the end of what you've paid for, then you're on Free. Prices plus sales tax where it applies.</p>
<% end %>
</div>

<%# OPS-04: what a suspended business's members see instead of the app. %>
<% content_for :title, "Account suspended" %>
<div class="mx-auto max-w-xl py-10" id="business-suspended">
  <%= card do %>
    <%= empty_state title: "#{current_business.name} is suspended", icon: "lock",
                    text: "Nobody in this business can use Shadetree right now, and your clients see that its pages are unavailable. Your data is safe." do %>
      <%= mail_to ContactMailer.support_address, "Contact Shadetree support", class: button_classes, subject: "#{current_business.name} is suspended" %>
    <% end %>
  <% end %>
</div>

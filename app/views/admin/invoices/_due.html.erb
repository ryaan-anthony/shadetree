<%# locals: (invoice:) -%>
<%# Payment terms and the due date they give; "Custom date" lets the date be chosen. Re-rendered
    by each autosave, so changing the terms or the issue date shows the new due date. %>
<div id="invoice_due" class="grid gap-4 sm:grid-cols-2 [&>*]:min-w-0">
  <div class="field">
    <label class="label" for="invoice_payment_terms">Payment terms</label>
    <%= select_tag "invoice[payment_terms]", options_for_select(Invoice::TERM_LABELS.invert, invoice.payment_terms), id: "invoice_payment_terms", class: "select" %>
  </div>
  <div class="field">
    <% if invoice.payment_terms == "custom" %>
      <label class="label" for="invoice_due_on">Due</label>
      <%= date_field_tag "invoice[due_on]", invoice.due_on&.iso8601, id: "invoice_due_on", class: "input", min: invoice.issued_on&.iso8601 %>
      <% invoice.errors[:due_on].each do |message| %><p class="error-text mt-1.5"><%= icon "alert-circle" %>Due date <%= message %></p><% end %>
    <% else %>
      <p class="label">Due</p>
      <p class="py-2 text-sm font-semibold text-ink" id="invoice_due_on"><%= local_date(invoice.due_on) %></p>
    <% end %>
  </div>
</div>

<%# locals: (url:, label:, left:, currency:, id:, button_class: nil, menu: false, confirm: nil, whole: false, unused: 0) -%>
<%# PAY-08 (owner, 2026-11-23): billing part of a quote with a discount asks how much of it to apply
    now. $0 is "Apply later": what isn't used carries forward, and the last invoice takes the rest.
    The draft shows the range again, with any minimum the work left needs. %>
<% if whole %><%# it finishes the quote: it takes all that's left, nothing to ask %>
  <%= button_to url, class: button_class, id:, form: { class: "contents", data: { turbo_confirm: "#{"#{confirm} " if confirm}This invoice takes the whole #{money(Money.new(left, currency))} of the quote's discount left.", turbo_confirm_button: label } } do %><%= icon "invoice" %> <%= label %><% end %>
<% else %>
<div class="contents" data-controller="modal">
  <button type="button" class="<%= menu ? "menu-item" : button_class %>" id="<%= id %>" data-action="modal#open<%= " menu#close" if menu %>" data-modal-target="return" aria-haspopup="dialog"><%= icon(label.include?("progress") ? "plus" : "invoice") %> <%= label %></button>
  <%= modal id: "#{id}-dialog", title: label, description: confirm do %>
    <%= form_with url:, class: "space-y-4", data: { controller: "fill", fill_value_value: "all", fill_submit_value: true } do %>
      <div class="field">
        <label class="label" for="<%= id %>-discount">Quote discount: <%= money(Money.new(left, currency)) %> left. Apply now</label>
        <%# Empty with a 0.00 placeholder ($0: Apply later), focused when the dialog opens, and what's
            typed replaces what's there, so a click never leaves "50" typed before "0.00". %>
        <%= text_field_tag :discount, "", id: "#{id}-discount", inputmode: "decimal", placeholder: "0.00", autofocus: true, class: "input text-right tabular",
                           aria: { describedby: "#{id}-discount-hint" }, data: { fill_target: "field", action: "focus->fill#select" } %>
        <p class="help" id="<%= id %>-discount-hint">$0 applies it later. What isn't used carries forward, and the last invoice takes the rest; the draft shows any minimum the work left needs.<% if unused.positive? %> <%= money(Money.new(unused, currency)) %> isn't used: less work was done than quoted.<% end %></p>
      </div>
      <%# The Primary is the only submit button, so Enter sends the amount typed; Apply all fills
          the field with "all" and submits (the fill controller). Visual order matches tab order. %>
      <div class="flex flex-wrap justify-end gap-2">
        <button type="button" class="<%= button_classes(:tertiary) %>" data-action="modal#close">Cancel</button>
        <button type="button" class="<%= button_classes(:secondary) %>" data-action="fill#fill">Apply all</button>
        <%= button_tag label, name: nil, class: button_classes(:primary) %>
      </div>
    <% end %>
  <% end %>
</div>
<% end %>

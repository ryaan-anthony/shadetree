<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<% content_for :title, "Invoice #{@invoice.number}" %>
<% totals = @invoice.totals %>
<% lines = @invoice.current_line_items %>
<%# The quote builder's form, partials and script, for an invoice (scope "invoice"). %>
<div data-controller="quote-builder" data-quote-builder-scope-value="invoice"
     data-quote-builder-property-url-value="<%= property_options_admin_quotes_path(name: "invoice[property]") %>">
<% lede = @invoice.revising? ? "Revision #{@invoice.revision} for #{@invoice.client.display_name}. Changes save as you go." : "Draft for #{@invoice.client.display_name}. Changes save as you go." %>
<%= page_header "Invoice #{@invoice.number}", lede: do %>
  <%# A sent invoice being revised can still be voided instead of re-sent. %>
  <%= render "void", invoice: @invoice if @invoice.voidable? %>
  <%= link_to preview_admin_invoice_path(@invoice), class: button_classes(:secondary), target: "_blank", rel: "noopener",
              data: { action: "quote-builder#preview" } do %><%= icon "eye" %> Preview as client<% end %>
  <%= link_to new_admin_invoice_send_path(@invoice), class: button_classes(:primary),
              data: { action: "quote-builder#saveAndGo" } do %><%= icon "send" %> <%= @invoice.revising? ? "Send revision" : "Send" %><% end %>
  <span class="save-status" id="save_status" role="status" data-quote-builder-target="status">Saved</span>
  <div class="relative" data-controller="menu" data-action="keydown->menu#keydown">
    <button type="button" class="<%= button_classes(:ghost, :icon) %>" data-menu-target="button" data-action="menu#toggle"
            aria-haspopup="true" aria-expanded="false" aria-label="More actions"><%= icon "more-horizontal" %></button>
    <div class="menu right-0 top-full mt-1" data-menu-target="menu" hidden>
      <%= link_to pdf_admin_invoice_path(@invoice), class: "menu-item", data: { turbo: false, action: "quote-builder#download" } do %><%= icon "download" %> Download PDF<% end %>
      <% if @invoice.payable? %>
        <%= link_to new_admin_invoice_payment_path(@invoice), class: "menu-item", data: { action: "quote-builder#saveAndGo" } do %><%= icon "dollar-sign" %> Record a payment<% end %>
      <% end %>
      <% if @invoice.revising? %>
        <%= button_to discard_revision_admin_invoice_path(@invoice), class: "menu-item",
                      form: { class: "contents", data: { turbo_confirm: "Discard your changes to #{@invoice.number}? It goes back to what #{@invoice.client.display_name} was sent.", turbo_confirm_button: "Discard changes" } } do %>
          <%= icon "rotate-ccw" %> Discard changes
        <% end %>
      <% end %>
      <% if @invoice.deletable? %>
        <%= button_to admin_invoice_path(@invoice), method: :delete, class: "menu-item text-danger",
                      form: { class: "contents", data: { turbo_confirm: "Delete draft invoice #{@invoice.number}? This can't be undone.", turbo_confirm_button: "Delete draft" } } do %>
          <%= icon "trash" %> Delete draft
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<div id="builder_banner"></div>
<% if @invoice.revising? && (previous = @invoice.revisions.last) %>
  <div class="banner banner-info mb-4"><%= icon "edit-3" %>
    <p class="flex-1">Revising what was sent as revision <%= previous.number %> (<%= money(previous.total) %>). Until it's sent again, the client's link says it's being updated.</p>
  </div>
<% end %>

<%= form_with model: @invoice, url: admin_invoice_path(@invoice), method: :patch, id: "invoice-builder", multipart: true,
              class: "grid gap-4 lg:grid-cols-[minmax(0,1fr)_20rem]",
              data: { quote_builder_target: "form",
                      action: "submit->quote-builder#submit catalog-picker:pick->quote-builder#addFromCatalog client-picker:change->quote-builder#clientChanged input->quote-builder#changed change->quote-builder#changed" } do |f| %>
  <%= f.hidden_field :lock_version, id: "invoice_lock_version" %>
  <input type="hidden" name="invoice[lines_present]" value="1">

  <div class="min-w-0 space-y-4">
    <div id="builder_errors"><%= render "admin/quotes/errors", quote: @invoice %></div>

    <%= card do %>
      <div class="grid gap-4 sm:grid-cols-2 [&>*]:min-w-0">
        <% if @invoice.job || @invoice.quote %>
          <%# It bills that job or quote, so it stays with their client. %>
          <div class="field"><p class="label">Client</p><p class="text-sm font-semibold text-ink"><%= @invoice.client.display_name %></p>
            <%= render "source", invoice: @invoice %></div>
        <% else %>
          <%= render "admin/clients/picker", name: "invoice[client]", selected: @invoice.client %>
        <% end %>
        <%= turbo_frame_tag "quote_property", data: { quote_builder_target: "property" } do %>
          <%= render "admin/quotes/property_select", client: @invoice.client, selected: @invoice.property&.uid, name: "invoice[property]" %>
        <% end %>
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-[minmax(0,1fr)_11rem] [&>*]:min-w-0">
        <%= f.field :title, optional: true, placeholder: "Spring cleanup", maxlength: 120, help: "Shown at the top of the invoice." %>
        <%= f.field :issued_on, as: :date, label: "Issue date" %>
      </div>
      <div class="mt-4 empty:hidden"><%= render "admin/locations/field", f:, document: @invoice, help: "The client sees this location's contact details." %></div>
      <div id="location_reprice"><%= render "admin/locations/reprice", document: @invoice %></div>
      <div class="mt-4"><%= render "due", invoice: @invoice %></div>
    <% end %>

    <%= card title: "Items", flush: true do %>
      <div class="quote-lines" data-quote-builder-target="lines">
        <% lines.each_with_index do |line, index| %>
          <%= render "admin/quotes/line", line:, index:, subtotal: totals.lines[index]&.subtotal, scope: "invoice" %>
        <% end %>
      </div>
      <p class="px-5 py-6 text-center text-sm text-muted" data-quote-builder-target="empty" <%= "hidden" if lines.any? %>>
        No items yet. Add one from your catalog or type a custom line.
      </p>
      <div class="flex flex-wrap items-end gap-2 border-t border-line px-5 py-4">
        <div class="min-w-0 flex-1 basis-64"><%= render "admin/catalog_items/picker", label: "Add from catalog", location: @invoice.location %></div>
        <button type="button" class="<%= button_classes(:secondary) %>" data-action="quote-builder#addCustom"><%= icon "plus" %> Custom line</button>
      </div>
      <template data-quote-builder-target="template">
        <%= render "admin/quotes/line", line: InvoiceLineItem.new(invoice: @invoice, key: "NEW_KEY", quantity: 1, taxable: true), index: "NEW_INDEX", scope: "invoice" %>
      </template>
    <% end %>

    <%= card title: "Message and terms" do %>
      <div class="space-y-4">
        <%= f.field :message, as: :textarea, optional: true, rows: 3, label: "Message to client", placeholder: "Thanks for your business!" %>
        <%= f.field :terms, as: :textarea, optional: true, rows: 4, help: "Defaults from your document settings; edit for this invoice." %>
        <%= f.field :internal_notes, as: :textarea, optional: true, rows: 2, label: "Internal notes",
                    help: "Only your team sees these. Never shown to the client." %>
      </div>
    <% end %>

    <%= render "attachments", invoice: @invoice, f: %>
  </div>

  <aside class="space-y-4 lg:sticky lg:top-6 lg:self-start">
    <%= card title: "Totals" do %>
      <div class="space-y-3">
        <div class="flex items-end gap-2">
          <div class="w-28 shrink-0">
            <%= f.label :discount_kind, "Invoice discount", class: "label" %>
            <%= f.select :discount_kind, [ [ "None", "" ], [ "%", "percent" ], [ "Amount", "amount" ] ], {}, class: "select" %>
          </div>
          <div class="min-w-0 flex-1">
            <label class="sr-only" for="invoice_discount_value">Invoice discount value</label>
            <%= text_field_tag "invoice[discount_value]", @invoice.discount_value, id: "invoice_discount_value", inputmode: "decimal", class: "input text-right tabular", placeholder: "0" %>
          </div>
        </div>
        <%= render "admin/quotes/tax_rates", quote: @invoice, scope: "invoice" %>
        <div class="border-t border-line pt-3"><%= render "admin/quotes/totals", quote: @invoice, totals: %></div>
      </div>
    <% end %>
    <div class="flex flex-col gap-2">
      <%= f.submit_button "Save draft" %>
      <p class="text-center text-sm2 text-muted">This draft is saved as you go and can be finished later.</p>
    </div>
  </aside>
<% end %>
</div>
<% @invoice.saved_attachments.each do |file| %>
  <%= form_with url: admin_invoice_attachment_path(@invoice, file), method: :delete, id: "remove-attachment-#{file.id}", class: "hidden" do %><% end %>
<% end %>
<%# CAT-08: the re-price offer's form, outside the builder (its buttons use form=). %>
<%= form_with url: reprice_admin_invoice_path(@invoice), method: :patch, id: "location-reprice-form", class: "hidden", data: { turbo: false } do %><%= hidden_field_tag :lock_version, @invoice.lock_version, id: nil %><% end %>
<%= render "admin/clients/quick_create", button: false %>

<%# locals: (invoice:) -%>
<%# What the invoice bills: its job and quote, linked both ways (PAY-01). %>
<% if invoice.job || invoice.quote %>
  <p class="text-sm2 text-muted">For <%= safe_join([ (link_to("job #{invoice.job.number}", admin_job_path(invoice.job), class: "font-medium text-ink hover:underline", data: { turbo_frame: "_top" }) if invoice.job),
                                            (link_to("quote #{invoice.quote.number}", admin_quote_path(invoice.quote), class: "font-medium text-ink hover:underline", data: { turbo_frame: "_top" }) if invoice.quote) ].compact, " · ") %></p>
<% end %>

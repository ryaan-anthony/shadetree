<%# locals: (invoice:) -%>
<%# PAY-05: every payment on the invoice, online (PAY-04) and recorded, with who and when;
    recorded ones can be corrected. %>
<% payments = invoice.payments.includes(:recorded_by, :email_messages).to_a %>
<%= card title: "Payments", id: "invoice-payments", flush: true do %>
  <% if payments.any? %>
    <ul class="list">
      <% payments.each do |payment| %>
        <li id="payment-<%= payment.uid %>" class="items-start text-sm">
          <div class="min-w-0 flex-1">
            <p class="font-medium text-ink"><%= payment.online? ? (payment.method_detail || "Card") : payment.method_label %><%= " #{payment.reference}" if payment.reference && payment.recorded? %>
              <span class="font-normal text-muted">· <%= local_date(payment.received_on) %></span>
              <% if (adjustment = payment.adjustment) %><%= status_badge(:payment, adjustment, payment.adjustment_label) %><% end %></p>
            <p class="text-sm2 text-muted"><%= payment.online? ? "Paid online" : "Recorded" %><%= " by #{payment.recorded_by.full_name}" if payment.recorded_by %>, <%= local_time(payment.created_at) %></p>
            <% if payment.online? %><%# PAY-04: Stripe's reference, to find it in the Stripe dashboard (refunds, disputes); shown only here (PLT-18) %>
              <p class="break-words text-sm2 text-muted">Stripe reference: <%= payment.reference %><%= ", #{money(payment.refunded)} refunded" if payment.refunded_cents.positive? %></p>
            <% end %>
            <% if (receipt = payment.email_messages.max_by(&:created_at)) %>
              <p class="text-sm2 text-muted">Receipt to <%= receipt.to %>: <% if receipt.problem? %><%= danger_flag("not delivered (#{receipt.status_label.downcase_first})") %><% else %><%= receipt.status_label.downcase %><% end %></p>
            <% end %>
            <% if payment.note %><p class="mt-1 whitespace-pre-line text-sm2 text-subtle"><%= payment.note %></p><% end %>
          </div>
          <span class="money font-semibold text-ink"><%= money(payment.amount) %></span>
          <% if payment.recorded? && !invoice.void? %>
            <%= link_to edit_admin_invoice_payment_path(invoice, payment), class: button_classes(:tertiary, :sm), aria: { label: "Change the #{money(payment.amount)} payment" } do %><%= icon "edit-3" %><% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
  <%# PLT-20: the payments' total; the balance is the summary's, at the top of the page. %>
  <dl class="quote-totals border-t border-line px-5 py-3 text-sm" id="payments-total">
    <div class="font-semibold text-ink"><dt>Paid</dt><dd class="money"><%= money(invoice.amount_paid) %></dd></div>
  </dl>
<% end %>

<%# CLI-05: a note that couldn't be added, back with what was typed. %>
<% content_for :title, "Add a note" %>
<%= page_header "Add a note", lede: "On #{@client.display_name}'s timeline. Only your team sees it." do %>
  <%= link_to "Cancel", admin_client_path(@client), class: button_classes(:tertiary) %>
<% end %>
<%= form_with model: @note, scope: :client_note, url: admin_client_notes_path(@client), method: :post, class: "max-w-2xl" do |f| %>
  <%= card do %>
    <%= f.field :body, as: :textarea, label: "Note", rows: 5, maxlength: 5000 %>
    <%= f.submit_button "Add note", class: "mt-4 w-full sm:w-auto" %>
  <% end %>
<% end %>

<%= page_header @client.display_name, lede: @client.company_name do %>
  <% unless @client.erased? %><%= link_to edit_admin_client_path(@client), class: button_classes(:secondary) do %><%= icon "edit-2" %> Edit<% end %><% end %>
  <div class="relative" data-controller="menu" data-action="keydown->menu#keydown">
    <button type="button" class="<%= button_classes(:ghost, :icon) %>" data-menu-target="button" data-action="menu#toggle"
            aria-haspopup="true" aria-expanded="false" aria-label="More actions"><%= icon "more-horizontal" %></button>
    <div class="menu right-0 top-full mt-1" data-menu-target="menu" hidden>
      <% if @client.erased? %>
      <% elsif @client.archived? %>
        <%= button_to restore_admin_client_path(@client), method: :patch, class: "menu-item", form: { class: "contents" } do %><%= icon "archive" %> Restore<% end %>
      <% else %>
        <%= button_to archive_admin_client_path(@client), method: :patch, class: "menu-item", form: { class: "contents" } do %><%= icon "archive" %> Archive<% end %>
      <% end %>
      <% if can?(:export_data) && !@client.erased? %>
        <div class="menu-sep"></div>
        <%= link_to new_admin_client_erasure_path(@client), class: "menu-item text-danger" do %><%= icon "user-x" %> Erase their details…<% end %>
      <% end %>
      <% if @client.deletable? %>
        <div class="menu-sep"></div>
        <%= button_to admin_client_path(@client), method: :delete, class: "menu-item text-danger",
                      form: { class: "contents", data: { turbo_confirm: "Delete #{@client.display_name} and their properties? This can't be undone.", turbo_confirm_button: "Delete client" } } do %>
          <%= icon "trash" %> Delete
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<% if @client.erased? %>
  <div class="banner banner-info mb-4" role="status" id="erased-banner"><%= icon "user-x" %>
    <p>Their details were erased on <%= local_date(@client.erased_at.to_date) %>, at their request. Documents and payments are kept.</p></div>
<% elsif @client.archived? %>
  <div class="banner banner-warning mb-4" role="status"><%= icon "archive" %>
    <p>Archived on <%= local_date(@client.archived_at.to_date) %>. Hidden from pickers; history is kept.</p>
  </div>
<% end %>

<div class="grid gap-4 lg:grid-cols-[1fr_20rem]">
  <div class="space-y-4">
    <%= card title: "Properties", subtitle: (pluralize(@client.properties.size, "property", plural: "properties") if @client.properties.any?), flush: true do %>
      <% if @client.properties.empty? %>
        <%= empty_state title: "No properties yet", text: "Add the address where the work happens.", icon: "home" do %>
          <%= link_to "Add a property", edit_admin_client_path(@client), class: button_classes(:secondary, :sm) %>
        <% end %>
      <% else %>
        <ul class="list">
          <% @client.properties.each do |property| %>
            <li id="property-<%= property.uid %>" class="items-start">
              <%= icon "home", class: "mt-0.5 size-4 shrink-0 text-faint" %>
              <div class="min-w-0 flex-1">
                <p class="font-semibold text-ink"><%= property.label || property.address_line1 %>
                  <% if property.billing %><%= badge "Billing", tone: :info, dot: false %><% end %></p>
                <address class="text-sm2 not-italic text-muted"><%= safe_join(property.label ? property.address_lines : property.address_lines.drop(1), tag.br) %></address>
                <% if property.access_notes.present? %>
                  <p class="mt-1.5 rounded-md bg-sunken px-2.5 py-1.5 text-sm2 text-subtle"><span class="font-medium">Access:</span> <%= property.access_notes %></p>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>

    <% quotes = @client.quotes.order(created_at: :desc).limit(5) %>
    <% invoices = @client.invoices.order(created_at: :desc, id: :desc).limit(5) %>
    <% requests = @client.service_requests.recent.limit(5) %>
    <% jobs = @client.jobs.order(created_at: :desc, id: :desc).limit(5).to_a %>
    <%# CLI-05: each job's earliest open visit (one left open from a past day shows as overdue), in one query. %>
    <% next_visits = Visit.open.in_order.where(job_id: jobs.map(&:id)).includes(:business).group_by(&:job_id).transform_values(&:first) %>
    <%= card title: "Work", flush: true,
             actions: (unless @client.archived?
                         safe_join([ link_to(new_admin_invoice_path(client: @client.uid), class: button_classes(:ghost, :sm)) { icon("plus") + " New invoice" },
                                     link_to(new_admin_job_path(client: @client.uid), class: button_classes(:ghost, :sm)) { icon("plus") + " New job" },
                                     button_to(admin_quotes_path, params: { "quote[client]" => @client.uid }, class: button_classes(:secondary, :sm), form: { class: "contents" }) { icon("plus") + " New quote" } ], " ")
                       end) do %>
      <ul class="list">
        <% if requests.any? %>
          <% requests.each do |request| %>
            <li><%= icon "inbox", class: "size-4 text-faint" %>
              <%= link_to "Request #{request.reference}#{" · #{request.service_names.first}" if request.service_names.any?}", admin_service_request_path(request),
                          class: "min-w-0 flex-1 truncate font-medium text-ink hover:underline" %>
              <%= badge request.status_label %><span class="text-sm2 text-subtle"><%= local_time_ago(request.created_at) %></span></li>
          <% end %>
        <% else %>
          <li><%= icon "inbox", class: "size-4 text-faint" %><span class="flex-1 font-medium text-ink">Requests</span><span class="text-sm2 text-muted">None yet</span></li>
        <% end %>
        <% if quotes.any? %>
          <% quotes.each do |quote| %>
            <li><%= icon "quote", class: "size-4 text-faint" %>
              <%= link_to "#{quote.number}#{" · #{quote.title}" if quote.title}", staff_quote_path(quote), class: "min-w-0 flex-1 truncate font-medium text-ink hover:underline" %>
              <%= quote_status_badge(quote) %><span class="money text-sm2 text-subtle"><%= money(quote.total) %></span></li>
          <% end %>
        <% else %>
          <li><%= icon "quote", class: "size-4 text-faint" %><span class="flex-1 font-medium text-ink">Quotes</span><span class="text-sm2 text-muted">None yet</span></li>
        <% end %>
        <% if jobs.any? %>
          <% jobs.each do |job| %>
            <li><%= icon "job", class: "size-4 text-faint" %>
              <span class="min-w-0 flex-1">
                <%= link_to "#{job.number} · #{job.title}", admin_job_path(job), class: "block truncate font-medium text-ink hover:underline" %>
                <% if (visit = next_visits[job.id]) %>
                  <% overdue = visit.scheduled_on < current_business.today %>
                  <span class="block truncate text-sm2 <%= overdue ? "font-medium text-danger" : "text-muted" %>"><%= overdue ? "Overdue visit" : "Next visit" %> <%= visit.when_label %></span>
                <% end %>
              </span>
              <%= job_status_badge(job) %><span class="money text-sm2 text-subtle"><%= money(job.total) %></span></li>
          <% end %>
        <% else %>
          <li><%= icon "job", class: "size-4 text-faint" %><span class="flex-1 font-medium text-ink">Jobs</span><span class="text-sm2 text-muted">None yet</span></li>
        <% end %>
        <% if invoices.any? %>
          <% invoices.each do |invoice| %>
            <li><%= icon "invoice", class: "size-4 text-faint" %>
              <%= link_to "#{invoice.number}#{" · #{invoice.title}" if invoice.title}", staff_invoice_path(invoice), class: "min-w-0 flex-1 truncate font-medium text-ink hover:underline" %>
              <%= invoice_status_badge(invoice) %><span class="money text-sm2 text-subtle"><%= money(invoice.total) %></span></li>
          <% end %>
        <% else %>
          <li><%= icon "invoice", class: "size-4 text-faint" %><span class="flex-1 font-medium text-ink">Invoices</span><span class="text-sm2 text-muted">None yet</span></li>
        <% end %>
      </ul>
    <% end %>

    <%= render "timeline", client: @client, events: @timeline, more: @timeline_more %>
  </div>

  <div class="space-y-4">
    <% if @client.contact_methods.any? %>
    <%= card title: "Contact" do %>
      <ul class="space-y-2.5">
        <% @client.contact_methods.each do |method| %>
          <li class="flex items-center gap-2.5">
            <%= icon(method.email? ? "mail" : "phone", class: "size-4 shrink-0 text-faint") %>
            <%= link_to method.value, method.href, class: "min-w-0 truncate font-medium text-ink hover:underline" %>
            <% if method.label %><span class="text-sm2 text-muted"><%= method.label %></span><% end %>
          </li>
          <% if method.undeliverable? %>
            <li class="rounded-md bg-warning-50 px-3 py-2 text-sm2 text-subtle" id="undeliverable-<%= method.id %>">
              <p><span class="font-semibold text-ink"><%= method.value %></span> was refused by the mail server, so emails to it are
                paused. Fix the address, or if it's right, send to it again.</p>
              <%= button_to "Send to it again", mark_deliverable_admin_client_path(@client, contact_method_id: method.id), method: :patch,
                            class: "#{button_classes(:secondary, :sm)} mt-2" %>
            </li>
          <% end %>
        <% end %>
      </ul>
    <% end %>
    <% end %>

    <% emails = EmailMessage.where(to: @client.emails.map(&:normalized)).recent.limit(5) %>
    <% if emails.any? %>
      <%= card title: "Recent emails", flush: true do %>
        <ul class="list">
          <% emails.each do |email| %>
            <li class="items-start" id="email-<%= email.uid %>">
              <%= icon(email.problem? ? "alert-triangle" : "mail", class: "mt-0.5 size-4 shrink-0 #{email.problem? ? "text-warning" : "text-faint"}") %>
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-medium text-ink"><%= email.subject.presence || EmailCatalog.find(email.kind).name %></p>
                <p class="text-sm2 text-muted"><%= email.status_label %> · <%= local_time_ago(email.created_at) %></p>
              </div>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>

    <%= card title: "Balance" do %>
      <%# PAY-01: what's owed on invoices that are out (sent or partly paid), per currency. %>
      <% owed = @client.invoices.where(status: Invoice::OUTSTANDING).group(:currency).sum(Arel.sql("total_cents - amount_paid_cents")).transform_values(&:to_i).reject { |_, cents| cents <= 0 } %>
      <% if owed.any? %>
        <p class="money text-lg font-semibold text-ink"><%= safe_join(owed.map { |currency, cents| money(Money.new(cents, currency)) }, " + ") %></p>
        <p class="text-sm2 text-muted">Owed on invoices that are out.</p>
      <% else %>
        <p class="text-sm text-muted">Nothing owed.</p>
      <% end %>
      <%# CLI-05: everything they've paid, recorded or online. %>
      <% paid = Payment.where(invoice_id: @client.invoices.select(:id)).group(:currency).order(:currency).counted_sum %><%# PAY-04: less refunds and lost disputes %>
      <% if paid.any? %>
        <p class="mt-3 border-t border-line pt-3 text-sm2 text-muted" id="client-lifetime-paid">Paid in all: <span class="money font-semibold text-ink"><%= safe_join(paid.map { |currency, cents| money(Money.new(cents.to_i, currency)) }, " + ") %></span></p>
      <% end %>
    <% end %>

    <% if @client.tags.any? || @client.tax_exempt || @client.notes.present? %>
      <%= card title: "Details" do %>
        <% if @client.tags.any? || @client.tax_exempt %>
          <div class="flex flex-wrap gap-1.5">
            <% @client.tags.each do |tag| %><%= badge tag, dot: false %><% end %>
            <% if @client.tax_exempt %><%= badge "Tax exempt", tone: :warning, dot: false %><% end %>
          </div>
        <% end %>
        <% if @client.notes.present? %><p class="mt-3 whitespace-pre-line text-sm text-subtle"><%= @client.notes %></p><% end %>
      <% end %>
    <% end %>
  </div>
</div>

<%= page_header "Clients", lede: "Who you work for and where." do %>
  <%= link_to "Import", new_admin_client_import_path, class: button_classes(:secondary) %>
  <%= link_to new_admin_client_path, class: button_classes do %><%= icon "plus" %> Add client<% end %>
<% end %>

<%# The filters are one form, posted to #search (POST keeps search terms out of URLs); its
    results replace only the frame below. The Active/Archived tabs and the pagination are
    controls of this form too (form="client-filters"). %>
<%= form_with url: search_admin_clients_path, method: :post, id: "client-filters", class: "mb-4 flex flex-wrap items-end gap-2",
              data: { controller: "search-form", turbo_frame: "client_results" } do %>
  <div class="relative min-w-0 flex-1 basis-full sm:basis-64">
    <label class="sr-only" for="q">Search clients</label>
    <%= icon "search", class: "pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-faint" %>
    <%= search_field_tag :q, @query, class: "input pl-9", placeholder: "Name, phone, email or address", autocomplete: "off",
                         data: { action: "input->search-form#queue keydown.enter->search-form#submit:prevent" } %>
  </div>
  <% if @tag_options.any? %>
    <div class="field">
      <label class="label" for="tag">Tag</label>
      <%= select_tag :tag, options_for_select(@tag_options, @tag), include_blank: "All tags", class: "select",
                     data: { action: "search-form#submit" } %>
    </div>
  <% end %>
  <div class="field">
    <label class="label" for="sort">Sort by</label>
    <%= select_tag :sort, options_for_select(Client::SORTS.invert, @sort), class: "select", data: { action: "search-form#submit" } %>
  </div>
  <noscript><%= submit_tag "Search", class: button_classes(:secondary), name: nil %></noscript>
<% end %>

<%# Active/Archived is a radio pair of the filter form. PLT-19: shown once a client is archived
    (one option alone is no choice). It stays outside the results frame: a search result
    arriving while the tab is being pressed would replace it mid-click and lose the click. %>
<% if @any_archived %>
  <%= tabs({ "0" => [ "Active", { data: { action: "submit-form#submit" } } ], "1" => [ "Archived", { data: { action: "submit-form#submit" } } ] },
           current: @showing_archived ? "1" : "0", label: "Show", radio: { name: "archived", form: "client-filters" }, class: "mb-4",
           data: { controller: "submit-form" }) %>
<% end %>

<%# _results is its own frame (#client_results), on the page and as the search response; the
    pagination inside it re-renders with each result. %>
<%= results_status "client_results" %>
<%= render "results" %>

<%# locals: (client:, events:, more:) -%>
<%# CLI-05: everything that's happened with the client, newest first, a page at a time. %>
<%= card title: "Timeline", flush: true do %>
  <%= form_with url: admin_client_notes_path(client), scope: :client_note, class: "flex flex-col gap-2 border-b border-line px-5 py-3 sm:flex-row sm:items-start" do |f| %>
    <label class="sr-only" for="client_note_body">Add a note</label>
    <%= f.text_area :body, id: "client_note_body", rows: 1, maxlength: 5000, required: true, class: "textarea min-h-0 flex-1",
                    placeholder: "Add a note: a call, a promise, a gate code…" %>
    <%= f.submit "Add note", class: button_classes(:secondary) %>
  <% end %>
  <% if events.any? %>
    <ol class="list" id="client-timeline"><%= render "admin/clients/timeline_events", events:, client: %></ol>
    <%= render "admin/clients/timeline_more", client:, last: (events.last if more) %>
  <% else %>
    <p class="px-5 py-4 text-sm text-muted" id="client-timeline">Requests, quotes, visits, invoices and payments for <%= client.display_name %> will show here.</p>
  <% end %>
<% end %>

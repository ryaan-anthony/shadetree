<%# locals: (client:, events:, more:) -%>
<%# CLI-05: everything that's happened with the client, newest first, a page at a time. %>
<%= card title: "Timeline", flush: true do %>
  <% unless client.archived? %>
    <%= form_with url: admin_client_notes_path(client), scope: :client_note, class: "border-b border-line px-5 py-3" do |f| %>
      <%= f.field :body, as: :textarea, label: "Add a note", rows: 2, maxlength: 5000, required: true,
                  placeholder: "A call, a promise, a gate code… Only your team sees it." %>
      <div class="mt-2 flex justify-end"><%= f.submit "Add note", class: button_classes(:secondary, :sm) %></div>
    <% end %>
  <% end %>
  <% if events.any? %>
    <ol class="list" id="client-timeline"><%= render "admin/clients/timeline_events", events:, client: %></ol>
    <%= render "admin/clients/timeline_more", client:, last: (events.last if more) %>
  <% else %>
    <p class="px-5 py-4 text-sm text-muted" id="client-timeline"><% if client.erased? %>The timeline was removed with their details.<% else %>Requests, quotes, visits, invoices and payments for <%= client.display_name %> will show here.<% end %></p>
  <% end %>
<% end %>

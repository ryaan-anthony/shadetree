<%# CLI-04 / QTE-06: the request a quote came from, under the page header. While it's a draft, an
    address they typed that isn't one of the client's properties is shown for staff to add, until
    they add it. %>
<% if (from_request = quote.service_request) %>
  <p class="-mt-2 mb-4 text-sm2 text-muted"><%= icon "inbox", class: "mr-1 inline size-4 align-text-bottom text-faint" %>From <%= link_to_if can?(:office), "#{from_request.client.display_name}'s request of #{l(from_request.created_at.in_time_zone(current_business.time_zone).to_date)}", admin_service_request_path(from_request), class: "font-medium text-ink hover:underline" %>.
    <% if can?(:office) && quote.editable? && from_request.property.nil? && from_request.address_line && !from_request.property_matching_address %><%# QTE-07: office staff add addresses %>
      They asked about <span class="font-medium text-ink"><%= from_request.address_line %></span>, which isn't one of <%= link_to "#{quote.client.display_name}'s properties", edit_admin_client_path(quote.client), class: "underline-offset-2 hover:underline" %> yet.
    <% end %></p>
<% end %>

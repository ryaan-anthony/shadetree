<%= page_header "New quote", lede: "Who is it for? You'll add items next." %>
<%= form_with url: admin_quotes_path, method: :post, class: "max-w-xl space-y-4" do %>
  <%= hidden_field_tag :from, "setup", id: nil if from_setup? %>
  <%= card do %>
    <%= render "admin/clients/picker", name: "quote[client]", selected: @client %>
    <% @quote.errors[:client].each do |message| %><p class="error-text mt-1.5"><%= icon "alert-circle" %><%= message %></p><% end %>
  <% end %>
  <div class="flex items-center justify-end gap-2">
    <%= link_to "Cancel", admin_quotes_path, class: button_classes(:ghost) %>
    <%= submit_tag "Start quote", class: button_classes, name: nil %>
  </div>
<% end %>
<%= render "admin/clients/quick_create", button: false %>

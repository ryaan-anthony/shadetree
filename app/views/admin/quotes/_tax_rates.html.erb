<%# locals: (quote:) -%>
<%# The quote's tax rates: the business's active rates plus any the quote already has. Re-rendered
    when the client changes (exemption can reset them). %>
<div id="quote_tax_rates">
  <% rates = (TaxRate.active.ordered.map(&:to_pricing) + quote.tax_rate_list).uniq %>
  <% if rates.any? %>
    <fieldset>
      <legend class="label">Tax<%= " (client is tax exempt)" if quote.client.tax_exempt %></legend>
      <input type="hidden" name="quote[tax_rates][]" value="">
      <% rates.each do |rate| %>
        <label class="flex items-center gap-2 py-0.5 text-sm">
          <input type="checkbox" class="checkbox" name="quote[tax_rates][]" value="<%= tax_rate_key(rate) %>" <%= "checked" if quote.tax_rate_list.include?(rate) %>>
          <%= rate.name %> <span class="text-muted"><%= rate.percent.to_d.round(4).to_s("F").sub(/\.?0+\z/, "") %>%</span>
        </label>
      <% end %>
    </fieldset>
  <% end %>
</div>

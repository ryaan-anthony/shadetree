<%# locals: (quote:, scope: "quote") -%>
<%# A document's tax rates (a quote, or an invoice with scope "invoice"): the business's active
    rates plus any the document already has. Re-rendered when the client changes (exemption can
    reset them). %>
<div id="quote_tax_rates">
  <% rates = (TaxRate.active.ordered.map(&:to_pricing) + quote.tax_rate_list).uniq %>
  <% if rates.any? %>
    <fieldset>
      <legend class="label">Tax<%= " (client is tax exempt)" if quote.client.tax_exempt %></legend>
      <input type="hidden" name="<%= scope %>[tax_rates][]" value="">
      <% rates.each do |rate| %>
        <label class="flex items-center gap-2 py-0.5 text-sm">
          <input type="checkbox" class="checkbox" name="<%= scope %>[tax_rates][]" value="<%= tax_rate_key(rate) %>" <%= "checked" if quote.tax_rate_list.include?(rate) %>>
          <%= rate.name %> <span class="text-muted"><%= rate.percent.to_d.round(4).to_s("F").sub(/\.?0+\z/, "") %>%</span>
        </label>
      <% end %>
    </fieldset>
  <% else %>
    <%# #289: no rate at all, so the total has no tax; say so instead of a silent $0. %>
    <p class="text-sm2 text-muted" id="no-tax-rates">No sales tax on this <%= scope %>.
      <% if Current.membership&.can?(:business_settings) %>
        If you charge it, <%= link_to "add your tax rate", admin_tax_rates_path, class: "font-semibold text-ink underline-offset-2 hover:underline" %> in Settings.
      <% else %>
        If you charge it, ask an owner to add your tax rate in Settings.
      <% end %></p>
  <% end %>
</div>

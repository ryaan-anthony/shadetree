<%# QTE-06: a sent quote's page for staff. Drafts open in the builder instead. %>
<% quote = @quote %>
<% totals = quote.totals %>
<% split = QuoteWork.split?(current_business) %>
<% ledger = (BillingLedger.new(quote:) if split && quote.approved?) %><%# PAY-08: read once for the page %>
<% jobs = split ? quote.jobs.to_a : Array(quote.first_job) %>
<% content_for :title, "#{quote.number}#{" #{quote.title}" if quote.title}" %>
<%= page_header (quote.title || "Quote #{quote.number}"), lede: safe_join([ "#{quote.number} for ", link_to(quote.client.display_name, admin_client_path(quote.client), class: "font-medium text-ink hover:underline"), (" (#{quote.client.company_name})" if quote.client.company_name.present? && quote.client.company_name != quote.client.display_name), (", #{quote.property.one_line}" if quote.property), location_badge(quote) ].compact) do %>
  <%# PLT-14: the Primary is the next step: Create job, or Reopen job when its job was cancelled (interim
      until split jobs; owner, 2026-11-22), then Create invoice; links to them are Secondary.
      JOB-09 (split_jobs): Create job opens the picker while work is to do; the jobs are linked,
      several through the Jobs card. PAY-06's order below. %>
  <% job = jobs.first %>
  <% live_job = jobs.find { _1.status != "cancelled" } %>
  <% if jobs.many? %>
    <%= link_to "#jobs", class: button_classes(:secondary), id: "quote-jobs-link" do %><%= icon "job" %> Jobs (<%= jobs.size %>)<% end %>
  <% elsif job %>
    <%= link_to admin_job_path(job), class: button_classes(:secondary) do %><%= icon "job" %> Job <%= job.number %><% end %>
  <% end %>
  <%# #289: once it's billed, the invoice is the next step, not a second one (that's in the menu). %>
  <% billed = quote.approved? ? Invoice.where(quote_id: quote.id).or(Invoice.where(id: InvoiceJob.where(job_id: jobs.map(&:id)).select(:invoice_id))).where.not(status: "void").order(:created_at, :id).to_a : [] %>
  <% if split %>
    <%# PAY-06: Create invoice is the Primary while completed work is unbilled, else Create job while
        work is to do (Secondary when both), else neither. With no live job the quote is billed
        directly: a Secondary Create invoice beside Create job (owner, 2026-11-23). The interim
        Reopen job is gone. %>
    <% live = jobs.reject { _1.status == "cancelled" } %>
    <% to_do = quote.approved? && quote.line_items.any? { _1.to_do_quantity.positive? } %>
    <% unbilled = quote.approved? && WorkBilling.billable_job_ids(live).any? %><%# two queries for all the jobs %>
    <%# Hidden once every to-do line already has a direct bill that isn't void (it can't be billed again). %>
    <% direct = to_do && live.empty? && !quote.recurring? && WorkBilling.directly_billable_lines(quote).any? %>
    <% if to_do %>
      <%= link_to new_admin_quote_job_path(quote), class: button_classes(unbilled ? :secondary : :primary) do %><%= icon "job" %> Create job<% end %>
    <% end %>
    <% if billed.many? %>
      <%= link_to "#invoices", class: button_classes(:secondary), id: "quote-invoice-link" do %><%= icon "invoice" %> Invoices (<%= billed.size %>)<% end %>
    <% elsif billed.one? %>
      <%= link_to admin_invoice_path(billed.first), class: button_classes(:secondary), id: "quote-invoice-link" do %><%= icon "invoice" %> <%= billed.first.kind_label %> <%= billed.first.number %><% end %>
    <% end %>
    <% discount_left = ledger&.outstanding_cents.to_i %><%# PAY-08: asked when there's some %>
    <% if (unbilled || direct) && discount_left.positive? %>
      <% whole = ledger.finishes?(unbilled ? live.select { _1.status == "completed" }.flat_map { WorkBilling.unbilled_lines(_1) } : []) %>
      <%= render "admin/invoices/create_with_discount", url: admin_quote_invoices_path(quote), label: "Create invoice", left: discount_left, unused: ledger.unused_discount_cents, currency: quote.currency,
                                                        id: "quote-create-invoice", button_class: button_classes(unbilled ? :primary : :secondary), whole: %>
    <% elsif unbilled || direct %>
      <%= button_to admin_quote_invoices_path(quote), class: button_classes(unbilled ? :primary : :secondary), form: { class: "contents" } do %><%= icon "invoice" %> Create invoice<% end %>
    <% end %>
  <% else %>
    <% invoice_primary = quote.approved? && billed.empty? && live_job %>
    <% if quote.approved? && job && !live_job %>
      <%= button_to reopen_admin_job_path(job), method: :patch, class: button_classes(:primary), form: { class: "contents" } do %><%= icon "rotate-ccw" %> Reopen job<% end %>
    <% elsif quote.approved? && !job %>
      <%= button_to admin_quote_job_path(quote), class: button_classes(:primary), form: { class: "contents" } do %><%= icon "job" %> Create job<% end %>
    <% end %>
    <% if billed.size > 1 %><%# progress billing: the Invoices card lists them all %>
      <%= link_to "#invoices", class: button_classes(:secondary), id: "quote-invoice-link" do %><%= icon "invoice" %> Invoices (<%= billed.size %>)<% end %>
    <% elsif (latest_invoice = billed.last) %>
      <%= link_to admin_invoice_path(latest_invoice), class: button_classes(:secondary), id: "quote-invoice-link" do %><%= icon "invoice" %> <%= latest_invoice.kind_label %> <%= latest_invoice.number %><% end %>
    <% elsif quote.approved? %>
      <%= button_to admin_quote_invoices_path(quote), class: button_classes(invoice_primary ? :primary : :secondary), form: { class: "contents" } do %><%= icon "invoice" %> Create invoice<% end %>
    <% end %>
  <% end %>
  <% if quote.revisable? %>
    <%= button_to revise_admin_quote_path(quote), class: button_classes(:secondary),
                  form: { class: "contents", data: { turbo_confirm: "Until you send the new version, #{quote.client.display_name}'s link says the quote is being updated, and they can't answer it. Sending it again unchanged also restores it.", turbo_confirm_button: "Revise" } } do %><%= icon "edit-3" %> Revise<% end %>
  <% end %>
  <% if quote.sendable? || quote.copy_sendable? %>
    <%= link_to new_admin_quote_send_path(quote), class: button_classes(:secondary) do %><%= icon "send" %> Send again<% end %>
  <% end %>
  <%= link_to preview_admin_quote_path(quote), class: button_classes(:secondary), target: "_blank", rel: "noopener" do %><%= icon "eye" %> View as client<% end %>
  <div class="contents" data-controller="modal">
  <%= menu label: "More actions", button: { data: { modal_target: "return" } } do %>
    <%# PAY-08: before the work is done, part of it can be billed as progress (credited on the final invoice). %>
    <%# Not offered when nothing is left to bill as progress, or (B11) when the work left is needed
        for the quote's discount: the Invoices card says why, as the job page does. %>
    <% if split && quote.approved? && !quote.recurring? && (quote.line_items.any? { _1.to_do_quantity.positive? } || jobs.any?(&:open?)) && ledger&.progress_left? && !ledger.progress_blocked? %>
      <%= button_to admin_quote_invoices_path(quote, progress: 1), class: "menu-item", id: "quote-progress-invoice",
                    form: { class: "contents", data: { turbo_confirm: "Bill part of #{quote.number} before it's done? A progress invoice is credited when the work is billed.#{" The draft asks how much of the quote's discount to apply now." if discount_left.to_i.positive?}", turbo_confirm_button: "Create progress invoice" } } do %><%= icon "plus" %> Create progress invoice<% end %>
    <% end %>
    <% if billed.any? && !split %><%# PAY-06: with split jobs the header's Create invoice bills what's left %>
      <%= button_to admin_quote_invoices_path(quote), class: "menu-item",
                    form: { class: "contents", data: { turbo_confirm: "#{quote.number} already has #{billed.map(&:number).to_sentence}. Create another invoice?", turbo_confirm_button: "Create another invoice" } } do %><%= icon "plus" %> Create another invoice<% end %>
    <% end %>
    <%= link_to pdf_admin_quote_path(quote), class: "menu-item", data: { turbo: false } do %><%= icon "download" %> Download PDF<% end %>
    <%= button_to duplicate_admin_quote_path(quote), class: "menu-item", form: { class: "contents" } do %><%= icon "copy" %> Duplicate<% end %>
    <button type="button" class="menu-item" data-action="modal#open menu#close" aria-haspopup="dialog"><%= icon "users" %> Duplicate for another client</button>
    <% if quote.archived? %>
      <%= button_to unarchive_admin_quote_path(quote), method: :patch, class: "menu-item", form: { class: "contents" } do %><%= icon "rotate-ccw" %> Restore from archive<% end %>
    <% elsif quote.archivable? %>
      <%= button_to archive_admin_quote_path(quote), method: :patch, class: "menu-item", form: { class: "contents" } do %><%= icon "archive" %> Archive<% end %>
    <% end %>
  <% end %>
    <%# Duplicate for another client: the client picker in a dialog. %>
    <%= modal id: "duplicate-for", title: "Duplicate for another client", description: "A new draft with the same lines, for the client you choose." do %>
      <%= form_with url: duplicate_admin_quote_path(quote), class: "space-y-4" do %>
        <%= render "admin/clients/picker", name: "client", required: true %>
        <div class="flex justify-end gap-2">
          <button type="button" class="<%= button_classes(:tertiary) %>" data-action="modal#close">Cancel</button>
          <%= submit_tag "Make a copy", class: button_classes(:primary), name: nil %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>

<% if (undelivered = quote.undelivered_email) %>
  <%= render "admin/sends/delivery_warning", email: undelivered, document: quote, resend_path: new_admin_quote_send_path(quote), id: "quote-delivery-problem" %>
<% end %>
<% if quote.approved? && (copy = quote.latest_email)&.problem? && quote.approval && copy.created_at > quote.approval.created_at %>
  <%# #289: a copy of an approved quote that didn't arrive: worth a line, not the full warning %>
  <p class="-mt-2 mb-4 text-sm2 text-muted" id="quote-copy-undelivered"><%= danger_flag("Email not delivered.") %> The copy emailed to <%= copy.to %> wasn't delivered. <%= copy.problem_reason %>
    <%= link_to "Send it again", new_admin_quote_send_path(quote), class: "font-medium text-ink underline-offset-2 hover:underline" %></p>
<% end %>
<%= render "admin/quotes/from_request", quote: %>
<div class="grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,1fr)_20rem]">
  <div class="min-w-0 space-y-4">
    <%= card do %>
      <dl class="grid gap-4 text-sm sm:grid-cols-4" id="quote-summary">
        <div><dt class="text-sm2 text-muted">Status</dt><dd class="mt-1"><%= quote_status_badge(quote) %></dd></div>
        <div><dt class="text-sm2 text-muted">Sent</dt><dd class="mt-1 text-ink"><%= quote.sent_at ? local_date(quote.sent_at.in_time_zone(current_business.time_zone).to_date) : "Not sent" %></dd></div>
        <div>
          <dt class="text-sm2 text-muted">Valid until</dt>
          <dd class="mt-1 text-ink"><%= quote.expires_on ? local_date(quote.expires_on) : "No end date" %>
            <% if quote.expiry_extendable? %>
              <span data-controller="modal">
                <button type="button" class="text-action ml-1 text-sm2" data-action="modal#open" aria-haspopup="dialog">Change</button>
                <%= modal id: "quote-extend-expiry", title: "Change the valid-until date", description: "The client can approve until the end of this day. Their link stays the same." do %>
                  <%= form_with url: extend_expiry_admin_quote_path(quote), method: :patch, class: "space-y-4" do %>
                    <div class="field">
                      <label class="label" for="expires_on">Valid until</label>
                      <%= date_field_tag :expires_on, [ [ quote.expires_on, current_business.today ].compact.max + 14, current_business.today + Quote::MAX_VALIDITY ].min,
                                       min: current_business.today + 1, max: current_business.today + Quote::MAX_VALIDITY, class: "input", required: true %>
                    </div>
                    <div class="flex justify-end gap-2">
                      <button type="button" class="<%= button_classes(:tertiary) %>" data-action="modal#close">Cancel</button>
                      <%= submit_tag "Save date", class: button_classes(:primary), name: nil %>
                    </div>
                  <% end %>
                <% end %>
              </span>
            <% end %>
          </dd>
        </div>
        <div><dt class="text-sm2 text-muted">Total</dt><dd class="money mt-1 font-semibold text-ink"><%= money(totals.total) %></dd></div>
      </dl>
    <% end %>

    <% if split && quote.approved? && jobs.any? %><%= render "admin/quotes/jobs", quote:, jobs: %><% end %>
    <%= render "admin/quotes/responses", quote:, sends_by_revision: @sends_by_revision %>

    <%= card do %>
      <%# PLT-20: the document without its header; the page header and the summary above say the rest. %>
      <h2 class="sr-only">Quote</h2>
      <div class="quote-doc" id="quote-document"><%= render "client/quotes/document", quote:, totals:, heading: 2, header: false %></div>
      <% if (files = quote.saved_attachments).any? %>
        <section class="mt-5" aria-labelledby="quote-files-h">
          <h2 id="quote-files-h" class="card-title">Photos and files</h2>
          <ul class="mt-2 space-y-1.5 text-sm"><% files.each do |file| %>
            <li class="flex items-center gap-2"><%= icon(file.image? ? "image" : "file-text", class: "size-4 shrink-0 text-faint") %>
              <%= attachment_link file, class: "min-w-0 break-words font-medium text-ink hover:underline" %></li>
          <% end %></ul>
        </section>
      <% end %>
      <% if quote.internal_notes %>
        <div class="mt-5 rounded-control bg-sunken p-3 text-sm2">
          <p class="font-semibold text-ink">Internal notes</p>
          <p class="mt-1 whitespace-pre-line text-subtle"><%= quote.internal_notes %></p>
        </div>
      <% end %>
    <% end %>
  </div>

  <aside class="rail space-y-4">
    <% if quote.sends.any? %><%= render "admin/quotes/sent_panel", quote: %><% end %>
    <% if quote.revisions.any? %>
      <%# Each revision's sends, and whether each email arrived (QA #274). %>
      <% sends_by_revision = @sends_by_revision %>
      <%= card title: "Revisions" do %>
        <ul class="space-y-2.5 text-sm2" id="quote-revisions">
          <li id="quote-revision-<%= quote.revision %>">
            <span class="flex items-baseline justify-between gap-3">
              <span><span class="font-semibold text-ink">Rev <%= quote.revision %></span> <span class="text-muted"><%= quote.approved? ? "Approved version" : "Current" %></span></span>
              <span class="money text-ink"><%= money(quote.total) %></span>
            </span>
            <%= render "admin/quotes/revision_sends", sends: sends_by_revision[quote.revision] %>
          </li>
          <% quote.revisions.reverse_each do |revision| %>
            <li id="quote-revision-<%= revision.number %>">
              <span class="flex items-baseline justify-between gap-3">
                <span><%= link_to "Rev #{revision.number}", revision_admin_quote_path(quote, number: revision.number), class: "font-semibold text-ink hover:underline" %>
                  <span class="text-muted">superseded <%= local_date(revision.created_at.in_time_zone(current_business.time_zone).to_date) %></span></span>
                <span class="money text-subtle"><%= money(revision.total) %></span>
              </span>
              <%= render "admin/quotes/revision_sends", sends: sends_by_revision[revision.number] %>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
    <% if (invoices = quote.invoices.order(:created_at, :id).to_a).any? %>
      <%= card title: "Invoices", id: "invoices", flush: true do %><%= render "admin/invoices/list", invoices: %>
        <% if split && quote.approved? && !quote.recurring? && ledger.progress_blocked? %><p class="border-t border-line px-5 py-3 text-sm2 text-muted" id="quote-progress-blocked"><%= BillingLedger::PROGRESS_BLOCKED %></p><% end %>
        <%= render "admin/invoices/progress_summary", summary: ledger.summary, currency: quote.currency, id: "quote-progress" if split && quote.approved? %>
        <%= render "admin/invoices/unused_discount", ledger:, currency: quote.currency, id: "quote-discount-unused" %><% end %>
    <% end %>
    <%= card title: "Activity" do %>
      <ol class="space-y-3 text-sm2" id="quote-activity">
        <% @activity.each do |entry| %>
          <li class="flex gap-2.5">
            <%= icon entry.icon, class: "mt-0.5 size-4 shrink-0 text-faint" %>
            <div class="min-w-0">
              <p class="text-ink"><%= entry.title %></p>
              <% if entry.detail %><p class="mt-0.5 whitespace-pre-line text-subtle"><%= entry.detail %></p><% end %>
              <p class="text-muted"><% if entry.since %><%= local_time(entry.since) %> to <% end %><%= local_time(entry.at) %></p>
            </div>
          </li>
        <% end %>
      </ol>
    <% end %>
    <%= render "admin/automations/record_runs", record: quote %>
  </aside>
</div>

<%= render "admin/clients/quick_create", button: false %>

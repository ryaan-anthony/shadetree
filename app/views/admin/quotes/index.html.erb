<%= page_header "Quotes", lede: "Every quote and where it stands." do %>
  <%= render "admin/shared/location_filter", path: admin_quotes_path, keep: { filter: @filter } %>
  <%= link_to new_admin_quote_path, class: button_classes do %><%= icon "plus" %> New quote<% end %>
<% end %>

<%# One filter form, posted to #search (POST keeps client names out of URLs); its results
    replace only the frame below, and the pages inside the frame belong to this form. The tabs
    are its submit buttons and stay outside the frame, so focus stays on the tab you pressed;
    the hidden field carries the current tab into searches and pages (a pressed tab's own value
    comes after it and wins). Counts are for all quotes, whatever the search. %>
<%= form_with url: search_admin_quotes_path, method: :post, id: "quote-filters", class: "mb-4",
              data: { controller: "search-form tabs", turbo_frame: "quote_results" } do %>
  <input type="hidden" name="filter" value="<%= @filter %>" data-tabs-target="field">
  <div class="relative max-w-md">
    <label class="sr-only" for="q">Search quotes</label>
    <%= icon "search", class: "pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-faint" %>
    <%= search_field_tag :q, @query, class: "input pl-9", placeholder: "Quote number or client", autocomplete: "off",
                         data: { action: "input->search-form#queue keydown.enter->search-form#submit:prevent" } %>
  </div>
  <noscript><%= submit_tag "Search", class: button_classes(:secondary), name: nil %></noscript>
  <%= tabs Quote::FILTERS, current: @filter, label: "Show quotes", counts: @counts, name: "filter", class: "mt-4", data: { tabs_target: "row" } %>
<% end %>

<%# _results is its own frame (#quote_results), on the page and as the search response. %>
<%= render "results" %>

<%# locals: (quote:, sends_by_revision:) -%>
<%# Staff only (QTE-05): the client's answers with their evidence, and recording an approval
    the client gave another way. %>
<% responses = quote.responses.includes(:recorded_by).to_a %>
<% form = @approval_form || QuoteResponse.new(signer_name: quote.client.display_name) %>
<% if responses.any? || quote.staff_can_approve? %>
  <section class="card card-body" aria-labelledby="responses-h">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 id="responses-h" class="text-sm font-semibold text-ink">Client response</h2>
      <% if quote.staff_can_approve? %>
        <div data-controller="modal" data-modal-open-value="<%= @approval_form.present? %>">
          <button type="button" class="<%= button_classes(:secondary, :sm) %>" data-action="modal#open" aria-haspopup="dialog"><%= icon "check" %> Mark approved</button>
          <%= modal id: "quote-mark-approved", title: "Mark quote #{quote.number} approved",
                    description: "For an approval your client gave you another way. It's recorded with your name and this note." do %>
            <%= form_with model: form, scope: :quote_response,
                          url: admin_quote_approval_path(quote), class: "space-y-4" do |f| %>
              <%= f.field :signer_name, label: "Who approved", maxlength: 120, required: true %>
              <%= f.field :message, as: :textarea, label: "How they approved", rows: 3, maxlength: QuoteResponse::MESSAGE_MAX, required: true,
                          placeholder: "e.g. Approved on the phone on Tuesday" %>
              <div class="flex justify-end gap-2">
                <button type="button" class="<%= button_classes(:secondary) %>" data-action="modal#close">Cancel</button>
                <%= f.submit_button "Mark approved" %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
    <% if responses.any? %>
      <ul class="mt-3 space-y-3 text-sm2">
        <% responses.each do |response| %>
          <li id="response-<%= response.uid %>">
            <p class="text-ink">
              <span class="font-semibold"><%= response.label %></span><% if quote.revision > 1 %> <span class="text-muted">on revision <%= response.revision %></span><% end %>
              <%= local_time(response.created_at) %>
              <% if response.on_behalf? %>
                · recorded by <%= response.recorded_by&.full_name || "a former member" %><%= " for #{response.signer_name}" if response.signer_name %>
              <% elsif response.signer_name %>
                · signed by <%= response.signer_name %>
              <% end %>
            </p>
            <% if response.message %><p class="mt-1 whitespace-pre-line text-subtle"><%= response.message %></p><% end %>
            <% unless response.on_behalf? %>
              <%# The IP address stays in the record and the export as evidence, but isn't shown (QA #274, owner decision 2026-11-21). %>
              <p class="mt-1 text-muted">From <%= response.device || "an unknown device" %><%= ", asked for a copy at #{response.email}" if response.email %></p>
              <% emails = sends_by_revision.fetch(response.revision, []).filter_map(&:email_message) %>
              <% if emails.any? && emails.all?(&:problem?) %>
                <p class="mt-1 text-muted" id="response-<%= response.uid %>-undelivered">The email for this revision wasn't delivered; <%= response.signer_name || "the client" %> reached it from the quote's link.</p>
              <% end %>
            <% end %>
            <% if response.approved? %>
              <%# #289: the evidence stays (support and disputes need it), behind one word; a record that doesn't verify still says so up front. %>
              <% unless response.signature_valid? && response.snapshot_intact? %><p class="mt-1 font-medium text-danger">This approval record doesn't verify.</p><% end %>
              <details class="mt-1 text-muted"><summary class="cursor-pointer text-sm2">Reference</summary>
                <p class="mt-1 text-sm2">Approval <span class="font-mono"><%= response.reference %></span>. Quote this if you contact support.</p></details>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>

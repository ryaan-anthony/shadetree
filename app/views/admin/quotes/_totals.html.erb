<%# locals: (quote:, totals: quote.totals) -%>
<%# Totals from Pricing::DocumentTotals (PLT-08): line totals exclude tax; tax is per rate. %>
<%# PAY-08: an invoice's credits for progress billed earlier come off before tax (they're in the
    subtotal), and its share of the quote's fixed discount shows apart from its own discount. %>
<% credits = quote.respond_to?(:pre_tax_credits) ? quote.pre_tax_credits : [] %>
<% share = [ totals.share, totals.discount ].min %>
<dl class="quote-totals" id="quote_totals" aria-live="polite">
  <% credits.each do |credit| %>
    <div class="quote-totals-credit"><dt><%= credit.label %></dt><dd class="money">−<%= money(credit.amount) %></dd></div>
  <% end %>
  <div><dt>Subtotal</dt><dd class="money"><%= money(totals.subtotal) %></dd></div>
  <% if (own = totals.discount - share).positive? %>
    <div><dt>Discount</dt><dd class="money">−<%= money(own) %></dd></div>
  <% end %>
  <% if share.positive? %>
    <div><dt>Share of the quote's discount</dt><dd class="money">−<%= money(share) %></dd></div>
  <% end %>
  <% totals.taxes.each do |tax| %>
    <div><dt><%= tax.rate.name %> (<%= tax.rate.percent.to_d.round(4).to_s("F").sub(/\.?0+\z/, "") %>%)<%= " included" if totals.prices_include_tax? %></dt><dd class="money"><%= money(tax.amount) %></dd></div>
  <% end %>
  <div class="quote-totals-total"><dt>Total</dt><dd class="money"><%= money(totals.total) %></dd></div>
</dl>

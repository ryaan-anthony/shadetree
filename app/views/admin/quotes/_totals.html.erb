<%# locals: (quote:, totals: quote.totals, client: false) -%>
<%# Totals from Pricing::DocumentTotals (PLT-08): line totals exclude tax; tax is per rate. %>
<%# PAY-08: an invoice's credits for progress billed earlier (what that invoice charged, net of its
    discounts) come off after the discount and before tax, and its share of the quote's fixed
    discount shows apart from its own discount.
    Clients (client: true) see the totals before credits, then "Credit from INV-0004" with its tax:
    what they paid (owner, 2026-11-23). After a shortfall the last invoice adds back what was applied
    past the scaled discount: "Quote discount adjusted for work not done" (owner, 2026-11-24). %>
<% credits = quote.respond_to?(:pre_tax_credits) ? quote.pre_tax_credits : [] %>
<% client_credits = client && credits.any? ? quote.client_credits : [] %>
<% total = totals.total %>
<% totals = quote.totals(credits: false) if client_credits.any? %>
<% back = quote.respond_to?(:quote_discount_charge_back) ? quote.quote_discount_charge_back : Money.zero(quote.currency) %>
<% share = [ totals.share + back, totals.discount + back ].min %>
<dl class="quote-totals" id="quote_totals" aria-live="polite">
  <div><dt>Subtotal</dt><dd class="money"><%= money(totals.subtotal) %></dd></div>
  <% if (own = totals.discount - totals.share).positive? %>
    <div><dt>Discount</dt><dd class="money">−<%= money(own) %></dd></div>
  <% end %>
  <% if share.positive? %>
    <div><dt>Quote discount</dt><dd class="money">−<%= money(share) %></dd></div>
  <% end %>
  <% if back.positive? %>
    <div><dt>Quote discount adjusted for work not done</dt><dd class="money">+<%= money(back) %></dd></div>
  <% end %>
  <% if client_credits.empty? %>
    <% credits.group_by(&:label).each do |label, same| %>
      <div class="quote-totals-credit"><dt><%= label %></dt><dd class="money">−<%= money(Money.sum(same.map(&:amount), quote.currency)) %></dd></div>
    <% end %>
  <% end %>
  <% totals.taxes.each do |tax| %>
    <div><dt><%= tax.rate.name %> (<%= tax.rate.percent.to_d.round(4).to_s("F").sub(/\.?0+\z/, "") %>%)<%= " included" if totals.prices_include_tax? %></dt><dd class="money"><%= money(tax.amount) %></dd></div>
  <% end %>
  <% client_credits.each do |invoice, amount| %>
    <div class="quote-totals-credit"><dt>Credit from <%= invoice.number %></dt><dd class="money">−<%= money(amount) %></dd></div>
  <% end %>
  <div class="quote-totals-total"><dt>Total</dt><dd class="money"><%= money(total) %></dd></div>
</dl>

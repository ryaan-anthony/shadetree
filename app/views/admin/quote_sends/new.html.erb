<%= page_header "Send quote #{@quote.number}", lede: "To #{@quote.client.display_name}: #{money(@quote.totals.total)}#{", valid until #{l(@quote.expires_on)}" if @quote.expires_on}" do %>
  <%= render "admin/usage/quotes" if @quote.counts_toward_usage? %>
  <%= link_to "Back", staff_quote_path(@quote), class: button_classes(:ghost) %>
<% end %>

<% counts = @quote.counts_toward_usage? %>
<% blocked = counts && !current_business.entitlements.can_send_new_quote? %>
<%= render "admin/usage/limit_notice" if counts %>
<% unless current_user.can_send_to_clients? %>
  <div class="banner banner-warning mb-4" role="status"><%= icon "alert-triangle" %>
    <p class="flex-1">Confirm your email address before sending anything to clients. Check your inbox for the link.</p>
  </div>
<% end %>

<% if blocked %>
  <%# BIL-03: over the limit, the explanation (above) replaces the send options. %>
  <%= link_to "Back to the quote", staff_quote_path(@quote), class: button_classes(:secondary) %>
<% else %>
<div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_20rem]">
  <%= card title: "Email it", subtitle: "Your message, a button to the quote page, and the PDF attached. Replies come to you." do %>
    <%= form_with model: @form, scope: :quote_send, url: admin_quote_send_path(@quote), method: :post do |f| %>
  <%= hidden_field_tag :from, "setup", id: nil if from_setup? %>
      <% @form.errors[:base].each do |error| %>
        <p class="mb-3 text-sm2 font-medium text-danger" role="alert"><%= error %></p>
      <% end %>
      <%= f.field :to, as: :email, label: "To", required: true, autocomplete: "off",
                  help: ("#{@quote.client.display_name} has no email address yet." if @quote.client.primary_email.nil?) %>
      <%= f.field :cc, label: "CC", optional: true, help: "Up to #{QuoteSendForm::MAX_CC} addresses, separated by commas." %>
      <%= f.field :subject, required: true %>
      <%= f.field :message, as: :textarea, optional: true, rows: 8 %>
      <%= f.submit_button(@quote.draft? ? "Send quote" : "Send again", class: "mt-4 w-full sm:w-auto", disabled: !current_user.can_send_to_clients?) %>
    <% end %>
  <% end %>

  <div class="space-y-4">
    <%= card title: "Send the link yourself", subtitle: "Text or WhatsApp it from your phone. Getting the link marks the quote as sent." do %>
      <% if @link %>
        <div data-controller="clipboard" class="space-y-2">
          <input type="text" readonly value="<%= client_link_url(@link.token) %>" class="input text-sm2" aria-label="Link to the quote" data-clipboard-target="source">
          <button type="button" class="<%= button_classes(:secondary, extra: "w-full") %>" data-action="clipboard#copy" data-clipboard-target="button"><%= icon "link" %> Copy link</button>
        </div>
      <% else %>
        <%= button_to admin_quote_send_path(@quote), params: { channel: "link" }, class: button_classes(:secondary, extra: "w-full"),
                      disabled: !current_user.can_send_to_clients? do %><%= icon "link" %> Get the link<% end %>
        <% unless @quote.draft? || current_user.can_send_to_clients? %>
          <p class="mt-2 text-sm2 text-muted">Confirm your email address to see the link.</p>
        <% end %>
      <% end %>
    <% end %>

    <% if @quote.sends.any? %>
      <%= card title: "Sent so far" do %>
        <%= render "admin/sends/history", sends: @quote.sends %>
      <% end %>
    <% end %>
  </div>
</div>
<% end %>

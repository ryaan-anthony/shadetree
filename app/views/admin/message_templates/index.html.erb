<%= render "admin/businesses/settings_header", current: "messages" %>

<div class="space-y-4">
  <%# JOB-05: which visit emails go. Moved here from "Quotes, jobs & invoices" (owner, 2026-11-22). %>
  <%= form_with model: current_business, url: admin_business_path(tab: "messages"), method: :patch, id: "visit-emails-form" do |f| %>
    <%= card title: "Visit emails to clients", subtitle: "Sent to the client's email address, from your business, with a link to their visit." do %>
      <div class="space-y-3">
        <% hints = { "scheduled" => "When you book visits. Several booked together are one email.",
                     "changed" => "When you move a visit to another day or time.",
                     "cancelled" => "When you cancel a visit, or its job.",
                     "reminder" => "The day before, at #{Business::VISIT_REMINDER_HOUR} am your time, for visits still booked.",
                     "on_my_way" => "Off until you turn it on. Whoever's going taps On my way on their day: the client gets their arrival time by email and on their visit page." } %>
        <% Business::CLIENT_VISIT_EMAILS.each do |kind, label| %>
          <label class="flex items-start gap-2 text-sm" for="client-visit-email-<%= kind %>">
            <%= hidden_field_tag "business[client_visit_emails][#{kind}]", "0", id: nil %>
            <%= check_box_tag "business[client_visit_emails][#{kind}]", "1", current_business.client_visit_email?(kind), id: "client-visit-email-#{kind}", class: "checkbox mt-0.5" %>
            <span><span class="font-medium text-ink"><%= label %></span><span class="block text-sm2 text-muted"><%= hints.fetch(kind) %></span></span>
          </label>
        <% end %>
      </div>
      <p class="mt-3 text-sm2 text-muted">You can also skip the email for one change, from the visit form.</p>
      <%= f.submit_button "Save visit emails", class: "mt-4" %>
    <% end %>
  <% end %>

  <%# ACC-09: whether clients see who's coming (photo, first name, title and a phone). %>
  <%= form_with model: current_business, url: admin_business_path(tab: "team_profiles"), method: :patch, id: "team-profiles" do |f| %>
    <%= card title: "Team profiles", subtitle: "Who's coming to the client's door." do %>
      <%= f.check :show_team_profiles, label: "Show team profiles to clients",
                  hint: "Visit messages and pages can then show the people going: their photo, first name, title and work phone (or #{current_business.name}'s number). Never a last name, email or personal number." %>
      <p class="mt-3 text-sm2 text-muted">People add their photo and title from <span class="font-medium text-ink">Your profile</span> in the menu; you can edit anyone's from <%= link_to "Team", admin_team_path, class: "underline" %>.</p>
      <%= f.submit_button "Save team profiles", class: "mt-4" %>
    <% end %>
  <% end %>

  <% unless @editable %>
    <div class="banner banner-info"><%= icon "info" %>
      <p><span class="font-semibold">View only on <%= current_business.plan.name %>.</span> You can read every email below; changing them comes with <%= comes_with(:message_templates) %>. <%= link_to "See plans", admin_plan_path, class: "font-semibold underline" %><%= ". Messages you've already customized keep sending as they are." if @templates.any? %></p>
    </div>
  <% end %>
  <%= card title: "Emails to clients", subtitle: "Change the subject and opening words so they sound like you. Your logo, the summary, the button to their page and your contact details are always included.", flush: true do %>
    <ul class="list">
      <% MessageTemplate::DEFINITIONS.each_value do |definition| %>
        <% entry = EmailCatalog.find(definition.kind) %>
        <% template = @templates[definition.kind] %>
        <li id="message-<%= definition.kind %>">
          <div class="min-w-0 flex-1">
            <p class="font-semibold text-ink">
              <%= link_to entry.name, edit_admin_message_template_path(definition.kind), class: "hover:underline" %>
              <% if template %><%= badge "Customized", tone: :info, dot: false %><% end %>
            </p>
            <p class="text-sm2 text-muted"><%= definition.hint %></p>
          </div>
          <%= link_to (@editable ? "Edit" : "View"), edit_admin_message_template_path(definition.kind), class: button_classes(:secondary, :sm), "aria-label": "#{@editable ? "Edit" : "View"}: #{entry.name}" %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= card title: "Your own templates", subtitle: "Extra wording to start a quote or invoice email from: a follow-up, a seasonal offer, a thank-you.", flush: true,
           actions: (link_to(new_admin_custom_message_template_path, class: button_classes(:secondary, :sm)) { icon("plus") + " New template" } if @editable && @custom.any?) do %>
    <%# PLT-21: as on Taxes, the empty state's button until there's one, then the header's. %>
    <% if @custom.empty? %>
      <%= empty_state title: "No templates of your own yet", level: 3, icon: "mail",
                      text: (@editable ? "Templates you add here show up in the send form for quotes and invoices." : "Templates added here show up in the send form for quotes and invoices.") do %>
        <%= link_to(new_admin_custom_message_template_path, class: button_classes(:secondary)) { icon("plus") + " New template" } if @editable %>
      <% end %>
    <% else %>
      <ul class="list">
        <% @custom.each do |template| %>
          <li id="custom-template-<%= template.uid %>">
            <div class="min-w-0 flex-1">
              <p class="font-semibold text-ink"><%= link_to template.name, edit_admin_custom_message_template_path(template), class: "hover:underline" %></p>
              <p class="truncate text-sm2 text-muted"><%= template.subject %></p>
            </div>
            <%= link_to (@editable ? "Edit" : "View"), edit_admin_custom_message_template_path(template), class: button_classes(:secondary, :sm), "aria-label": "#{@editable ? "Edit" : "View"}: #{template.name}" %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>

<%= render "admin/businesses/settings_header", current: "messages" %>

<div class="max-w-3xl space-y-4">
  <% unless @editable %>
    <div class="banner banner-info" role="status"><%= icon "info" %>
      <p>Editing messages is part of a paid plan. <%= link_to "See plans", admin_plan_path, class: "font-semibold underline" %><%= ". Messages you've already customized keep sending as they are." if @templates.any? %></p>
    </div>
  <% end %>
  <%= card title: "Emails to clients", subtitle: "Change the subject and opening words so they sound like you. Your logo, the summary, the button to their page and your contact details are always included.", flush: true do %>
    <ul class="list">
      <% MessageTemplate::DEFINITIONS.each_value do |definition| %>
        <% entry = EmailCatalog.find(definition.kind) %>
        <% template = @templates[definition.kind] %>
        <li id="message-<%= definition.kind %>">
          <div class="min-w-0 flex-1">
            <p class="font-semibold text-ink">
              <%= link_to entry.name, edit_admin_message_template_path(definition.kind), class: "hover:underline" %>
              <% if template %><%= badge "Customized", tone: :info, dot: false %><% end %>
            </p>
            <p class="text-sm2 text-muted"><%= definition.hint %></p>
          </div>
          <%= link_to (@editable ? "Edit" : "View"), edit_admin_message_template_path(definition.kind), class: button_classes(:secondary, :sm) %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= card title: "Your own templates", subtitle: "Extra wording to start a quote or invoice email from: a follow-up, a seasonal offer, a thank-you.", flush: true,
           actions: (link_to(new_admin_custom_message_template_path, class: button_classes(:secondary, :sm)) { icon("plus") + " New template" } if @editable) do %>
    <% if @custom.empty? %>
      <p class="px-5 py-4 text-sm text-muted">None yet.<%= " Templates you add here show up in the send form for quotes and invoices." if @editable %></p>
    <% else %>
      <ul class="list">
        <% @custom.each do |template| %>
          <li id="custom-template-<%= template.uid %>">
            <div class="min-w-0 flex-1">
              <p class="font-semibold text-ink"><%= link_to template.name, edit_admin_custom_message_template_path(template), class: "hover:underline" %></p>
              <p class="truncate text-sm2 text-muted"><%= template.subject %></p>
            </div>
            <%= link_to (@editable ? "Edit" : "View"), edit_admin_custom_message_template_path(template), class: button_classes(:secondary, :sm) %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>

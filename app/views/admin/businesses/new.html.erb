<% first = current_business.nil? %>
<% content_for :title, first ? "Set up your business" : "Create a business" %>
<div class="mx-auto w-full max-w-lg py-4 sm:py-10">
  <%= page_header (first ? "Set up your business" : "Create another business"),
                  lede: (first ? "Two quick answers and you're in. Everything else can wait." : "You'll be its owner. Switch between businesses from the menu at the top of the sidebar.") %>

  <%= form_with model: @business, url: admin_business_path, method: :post, data: { controller: "browser-timezone" } do |f| %>
    <%= f.hidden_field :timezone, data: { browser_timezone_target: "field" } %>
    <%= card do %>
      <% @business.errors[:base].each do |message| %><p class="mb-4 text-sm2 font-medium text-danger" role="alert"><%= message %></p><% end %>
      <%= f.field :name, label: "Business name", autofocus: true, required: true,
                  placeholder: "e.g. Rivera Home Services", help: "Clients see this on quotes and invoices." %>
      <%= f.field :industry, as: :select, label: "What kind of work do you do?", required: true,
                  include_blank: "Choose one", choices: Industry.options,
                  help: "Used to suggest services and wording. You can change it later." %>
      <div class="mt-6 flex flex-wrap items-center justify-end gap-2">
        <% unless first %><%= link_to "Cancel", admin_root_path, class: button_classes(:tertiary) %><% end %>
        <%= f.submit_button(first ? "Create business" : "Create business and switch to it", size: :lg) %>
      </div>
    <% end %>
  <% end %>
</div>

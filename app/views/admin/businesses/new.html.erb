<% first = current_business.nil? %>
<% content_for :title, first ? "Set up your business" : "Create a business" %>
<div class="mx-auto w-full max-w-lg py-4 sm:py-10">
  <div class="mb-6">
    <h1 class="page-title"><%= first ? "Set up your business" : "Create another business" %></h1>
    <p class="page-lede">
      <%= first ? "Two quick answers and you're in. Everything else can wait." : "You'll be its owner. Switch between businesses from the menu at the top of the sidebar." %>
    </p>
  </div>

  <%= form_with model: @business, url: admin_business_path, method: :post do |f| %>
    <%= card do %>
      <%= f.field :name, label: "Business name", autofocus: true, required: true,
                  placeholder: "Oakline Lawn & Landscape", help: "Clients see this on quotes and invoices." %>
      <%= f.field :industry, as: :select, label: "What kind of work do you do?", required: true,
                  include_blank: "Choose one", choices: Business::INDUSTRIES.map { |key, name| [ name, key ] },
                  help: "Used to suggest services and wording. You can change it later." %>
      <div class="mt-6 flex flex-wrap items-center justify-end gap-2">
        <% unless first %><%= link_to "Cancel", admin_root_path, class: button_classes(:ghost) %><% end %>
        <%= f.submit_button(first ? "Create business" : "Create business and switch to it", class: "btn-lg") %>
      </div>
    <% end %>
  <% end %>
</div>

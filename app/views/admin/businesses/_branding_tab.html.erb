<div class="p-8 max-w-3xl">

  <!-- Section Header -->
  <div class="mb-8">
    <h2 class="text-lg font-semibold text-gray-900">Branding</h2>
    <p class="mt-1 text-sm text-gray-500">Customize your business look and feel</p>
  </div>

  <%= form_with(model: @business, url: admin_business_path(tab: 'branding'), method: :patch, local: true, class: "space-y-8") do |form| %>

    <!-- Error Messages -->
    <% if @business.errors.any? %>
      <div class="rounded-lg bg-red-50 border border-red-200 p-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-red-800">
              There <%= @business.errors.count == 1 ? 'was' : 'were' %> <%= pluralize(@business.errors.count, "error") %> with your submission
            </h3>
            <div class="mt-2 text-sm text-red-700">
              <ul class="list-disc pl-5 space-y-1">
                <% @business.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Form Fields -->
    <div class="space-y-6">

      <!-- Brand Color -->
      <div>
        <%= form.label :brand_color, "Brand Color", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <div class="flex items-center gap-4">
          <%= form.color_field :brand_color,
              value: @business.brand_color || '#059669',
              class: "h-12 w-24 border border-gray-300 rounded-lg cursor-pointer focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all",
              id: "color-picker" %>
          <div class="flex-1">
            <p class="text-sm text-gray-900">
              <span id="color-display" class="font-mono font-medium"><%= @business.brand_color || '#059669' %></span>
            </p>
            <p class="text-xs text-gray-500 mt-0.5">Used in your customer-facing materials</p>
          </div>
        </div>

        <!-- Color Presets -->
        <div class="mt-3">
          <p class="text-xs font-medium text-gray-700 mb-2">Quick presets:</p>
          <div class="flex gap-2">
            <button type="button" onclick="setColor('#059669')" class="w-8 h-8 rounded-md border border-gray-300 hover:border-gray-400 transition-all" style="background-color: #059669;" title="Emerald"></button>
            <button type="button" onclick="setColor('#0EA5E9')" class="w-8 h-8 rounded-md border border-gray-300 hover:border-gray-400 transition-all" style="background-color: #0EA5E9;" title="Blue"></button>
            <button type="button" onclick="setColor('#8B5CF6')" class="w-8 h-8 rounded-md border border-gray-300 hover:border-gray-400 transition-all" style="background-color: #8B5CF6;" title="Purple"></button>
            <button type="button" onclick="setColor('#F59E0B')" class="w-8 h-8 rounded-md border border-gray-300 hover:border-gray-400 transition-all" style="background-color: #F59E0B;" title="Amber"></button>
            <button type="button" onclick="setColor('#EF4444')" class="w-8 h-8 rounded-md border border-gray-300 hover:border-gray-400 transition-all" style="background-color: #EF4444;" title="Red"></button>
            <button type="button" onclick="setColor('#06B6D4')" class="w-8 h-8 rounded-md border border-gray-300 hover:border-gray-400 transition-all" style="background-color: #06B6D4;" title="Cyan"></button>
            <button type="button" onclick="setColor('#10B981')" class="w-8 h-8 rounded-md border border-gray-300 hover:border-gray-400 transition-all" style="background-color: #10B981;" title="Green"></button>
            <button type="button" onclick="setColor('#EC4899')" class="w-8 h-8 rounded-md border border-gray-300 hover:border-gray-400 transition-all" style="background-color: #EC4899;" title="Pink"></button>
          </div>
        </div>
      </div>

      <!-- Divider -->
      <div class="border-t border-gray-200"></div>

      <!-- Logo URL -->
      <div>
      <!-- Logo URL -->
      <div>
        <%= form.label :logo_url, "Business Logo", class: "block text-sm font-medium text-gray-700 mb-2" %>

        <% if @business.logo_url.present? %>
          <div class="mb-3 p-3 bg-gray-50 border border-gray-200 rounded-lg">
            <p class="text-xs font-medium text-gray-700 mb-2">Current logo:</p>
            <img src="<%= @business.logo_url %>" alt="Business Logo" class="h-16 w-auto rounded">
          </div>
        <% end %>

        <%= form.text_field :logo_url,
            class: "block w-full px-4 py-3 border border-gray-300 rounded-lg text-sm placeholder-gray-400 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all",
            placeholder: "https://example.com/logo.png" %>
        <p class="mt-1.5 text-xs text-gray-500">Enter the URL of your logo image (recommended: 400x400px)</p>
      </div>

      <!-- Divider -->
      <div class="border-t border-gray-200"></div>

      <!-- Preview -->
      <div>
        <h3 class="text-sm font-medium text-gray-900 mb-3">Preview</h3>
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-6">
          <div class="bg-white rounded-lg p-6 border-2 shadow-sm" id="brand-preview" style="border-color: <%= @business.brand_color || '#059669' %>;">
            <div class="text-center space-y-3">
              <% if @business.logo_url.present? %>
                <img src="<%= @business.logo_url %>" alt="Logo" class="h-12 w-auto mx-auto" id="preview-logo">
              <% else %>
                <div class="inline-flex items-center justify-center w-12 h-12 rounded-lg" id="preview-icon" style="background-color: <%= @business.brand_color || '#059669' %>;">
                  <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd" />
                  </svg>
                </div>
              <% end %>
              <h3 class="text-base font-semibold text-gray-900"><%= @business.name %></h3>
              <button type="button" id="preview-button" class="px-4 py-2 rounded-md text-white text-sm font-medium transition-all" style="background-color: <%= @business.brand_color || '#059669' %>;">
                Get a Quote
              </button>
            </div>
          </div>
          <p class="text-xs text-gray-500 mt-2 text-center">How your brand appears to customers</p>
        </div>
      </div>
    </div>

    <!-- Form Actions -->
    <div class="flex items-center justify-end gap-3 pt-6 border-t border-gray-200">
      <%= link_to "Cancel", edit_admin_business_path, class: "px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors" %>
      <button type="submit" class="inline-flex items-center px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium rounded-lg shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500">
        Save Branding
      </button>
    </div>
  <% end %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const colorPicker = document.getElementById('color-picker');
  const colorDisplay = document.getElementById('color-display');

  if (colorPicker && colorDisplay) {
    colorPicker.addEventListener('input', function() {
      colorDisplay.textContent = this.value.toUpperCase();
      updatePreview(this.value);
    });
  }
});

function setColor(color) {
  const colorPicker = document.getElementById('color-picker');
  const colorDisplay = document.getElementById('color-display');

  if (colorPicker) {
    colorPicker.value = color;
    colorDisplay.textContent = color.toUpperCase();
    updatePreview(color);
  }
}

function updatePreview(color) {
  // Update preview elements with new color
  const previewBorder = document.getElementById('brand-preview');
  const previewButton = document.getElementById('preview-button');
  const previewIcon = document.getElementById('preview-icon');

  if (previewBorder) previewBorder.style.borderColor = color;
  if (previewButton) previewButton.style.backgroundColor = color;
  if (previewIcon) previewIcon.style.backgroundColor = color;
}
</script>


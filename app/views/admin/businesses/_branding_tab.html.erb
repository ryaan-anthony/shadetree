<%# Logo and brand color, with a live preview of a client page (CAT-02). %>
<% branding = @business.branding %>
<%= form_with model: @business, url: admin_business_path(tab: "branding"), method: :patch,
              class: "grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]",
              data: { controller: "brand-preview", brand_preview_max_bytes_value: Business::LOGO_MAX_BYTES,
                      brand_preview_saved_logo_value: (url_for(branding.logo(:web)) if branding.logo?),
                      brand_preview_types_value: Business::LOGO_TYPES.join(","),
                      brand_preview_min_text_value: Branding::MIN_TEXT_CONTRAST, brand_preview_min_page_value: Branding::MIN_PAGE_CONTRAST } do |f| %>
  <%= hidden_field_tag :from, "setup", id: nil if from_setup? %>
  <div class="min-w-0 space-y-4">
    <% if @business.errors.any? %>
      <div class="banner banner-danger" role="alert"><%= icon "alert-circle" %>
        <p><%= @business.errors.count == 1 ? "One thing" : "#{@business.errors.count} things" %> to fix before saving. Each one is marked below.</p>
      </div>
    <% end %>

    <%= card title: "Logo", subtitle: "Shown on your quotes, invoices, emails and client pages." do %>
      <div class="flex flex-wrap items-center gap-4">
        <div class="flex h-20 w-48 items-center justify-center rounded-lg border border-dashed border-line bg-sunken p-2">
          <% if branding.logo? %>
            <%= image_tag branding.logo(:web), alt: "Your current logo", class: "max-h-full max-w-full object-contain", data: { brand_preview_target: "currentLogo" } %>
          <% else %>
            <span class="text-sm2 text-muted" data-brand-preview-target="currentLogo">No logo yet</span>
          <% end %>
        </div>
        <div class="min-w-0 flex-1 space-y-2">
          <div class="field">
            <%= f.label :logo, branding.logo? ? "Replace logo" : "Upload a logo", class: "label" %>
            <%= f.file_field :logo, accept: Business::LOGO_TYPES.join(","), class: "input py-1.5",
                             "aria-invalid": (@business.errors[:logo].any? || nil),
                             "aria-describedby": [ "logo-help", ("logo-error" if @business.errors[:logo].any?), "logo-check" ].compact.join(" "),
                             data: { brand_preview_target: "logoInput", action: "brand-preview#logoChosen" } %>
            <p class="help" id="logo-help">PNG, JPEG or WebP, up to <%= Business::LOGO_MAX_BYTES / 1.megabyte %> MB. A wide logo on a transparent background works best.</p>
            <% if @business.errors[:logo].any? %>
              <p class="error-text" id="logo-error"><%= icon "alert-circle" %>Logo <%= @business.errors[:logo].to_sentence %></p>
            <% end %>
            <p class="error-text empty:hidden" id="logo-check" role="status" data-brand-preview-target="logoError"></p>
          </div>
          <% if branding.logo? %>
            <%= f.check :remove_logo, label: "Remove logo", hint: "Your name and initials are used instead.",
                        data: { action: "brand-preview#render", brand_preview_target: "removeLogo" } %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= card title: "Brand color", subtitle: "Used for buttons, links and accents on everything clients see." do %>
      <fieldset>
        <legend class="label">Presets</legend>
        <div class="flex flex-wrap gap-2">
          <% Branding::PRESETS.each do |name, hex| %>
            <button type="button" class="<%= inline_style("background: #{hex}") %> size-9 rounded-full border-2 border-white shadow-[0_0_0_1px_var(--color-line)] outline-offset-2 aria-pressed:shadow-[0_0_0_2px_var(--color-ink)]"
                    title="<%= name %>" aria-label="<%= name %> (<%= hex %>)" aria-pressed="<%= branding.color == hex %>"
                    data-brand-preview-target="swatch" data-color="<%= hex %>" data-action="brand-preview#pick"></button>
          <% end %>
        </div>
      </fieldset>
      <div class="mt-4 flex items-end gap-3">
        <div class="field">
          <label class="label" for="brand_picker">Custom</label>
          <input type="color" id="brand_picker" value="<%= branding.color %>" class="h-10 w-14 cursor-pointer rounded-md border border-line bg-white p-1"
                 data-brand-preview-target="picker" data-action="input->brand-preview#picked">
        </div>
        <div class="w-36">
          <%= f.field :brand_color, label: "Hex", maxlength: 7, spellcheck: false, autocomplete: "off", class: "font-mono",
                      value: @business.brand_color.presence || branding.color, "aria-describedby": "brand-color-warnings",
                      data: { brand_preview_target: "hex", action: "input->brand-preview#typed" } %>
        </div>
      </div>
      <ul class="mt-3 space-y-1.5" id="brand-color-warnings" data-brand-preview-target="warnings" aria-live="polite">
        <% branding.contrast_warnings.each do |warning| %>
          <li class="flex items-start gap-2 text-sm2 text-warning"><%= icon "alert-triangle", class: "mt-0.5 size-4 shrink-0" %><%= warning %></li>
        <% end %>
      </ul>
    <% end %>

    <div class="flex items-center justify-end gap-2">
      <%= link_to "Cancel", edit_admin_business_path(tab: "branding"), class: button_classes(:ghost) %>
      <%= f.submit_button "Save branding" %>
    </div>
  </div>

  <aside class="lg:sticky lg:top-6 lg:self-start" aria-label="Preview">
    <p class="label">Preview</p>
    <div class="overflow-hidden rounded-xl border border-line bg-[#f4f5f7] shadow-sm <%= inline_style(branding.css_variables) %>" data-brand-preview-target="preview">
      <div class="flex h-14 items-center gap-2.5 border-b border-line bg-white px-4">
        <img alt="" class="client-logo-image h-8" data-brand-preview-target="previewLogo" <% if branding.logo? %>src="<%= url_for(branding.logo(:web)) %>"<% else %>hidden<% end %>>
        <span class="client-logo size-8 text-[0.8125rem]" data-brand-preview-target="previewMark" <%= "hidden" if branding.logo? %>><%= branding.initials %></span>
        <span class="truncate text-sm font-bold text-ink" data-brand-preview-target="previewName" <%= "hidden" if branding.logo? %>><%= branding.name %></span>
      </div>
      <div class="space-y-3 p-4">
        <div class="rounded-lg border border-line bg-white p-4">
          <%# QA #274: the same sample quote as the Features page (Q-0001, $580.00 of work plus two taxes), labelled as a sample. %>
          <p class="flex items-center justify-between gap-2 text-xs text-muted"><span>Quote Q-0001</span><span class="badge badge-plain">Sample</span></p>
          <p class="mt-0.5 font-semibold text-ink">Spring cleanup</p>
          <p class="mt-2 text-sm2 text-subtle">Total <span class="money font-semibold text-ink">$622.05</span></p>
          <button type="button" tabindex="-1" class="mt-3 w-full rounded-md px-3 py-2 text-sm font-semibold bg-brand text-brand-ink">Approve quote</button>
          <p class="mt-2 text-center text-sm2"><span class="font-medium text-brand underline">Ask a question</span></p>
        </div>
        <% if branding.show_powered_by? %><p class="text-center text-[0.6875rem] text-muted">Powered by <%= wordmark %></p><% end %>
      </div>
    </div>
    <p class="help mt-2">How clients see your quotes and invoices.</p>
    <%= inline_styles_tag %>
  </aside>
<% end %>

<%# Outside the branding form: a button_to inside it would nest forms. %>
<%= card title: "Client emails", subtitle: "Quotes and invoices go out as \"#{@business.name_was.presence || @business.name} via Shadetree\" with your branding. Replies go to #{@business.email.presence || "your business email"}.", class: "mt-6 lg:max-w-[calc(100%-23.5rem)]" do %>
  <div class="flex flex-wrap items-center gap-3">
    <%= button_to admin_test_email_path, class: button_classes(:secondary) do %><%= icon "mail" %> Send me a test email<% end %>
    <% if @business.email.blank? %>
      <p class="text-sm2 text-warning">Add your business email on the Business tab so client replies reach you.</p>
    <% end %>
  </div>
<% end %>

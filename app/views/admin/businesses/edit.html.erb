<div class="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
  <!-- Header -->
  <div class="mb-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 flex items-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-500 to-green-600 shadow-md mr-4">
            <i data-feather="building" class="h-6 w-6 text-white"></i>
          </div>
          Business Profile
        </h1>
        <p class="mt-2 text-lg text-gray-600">
          Manage your business information and details
        </p>
      </div>
      <%= link_to admin_root_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors" do %>
        <i data-feather="arrow-left" class="h-4 w-4 mr-2"></i>
        Back to Dashboard
      <% end %>
    </div>
  </div>

  <!-- Main Form Card -->
  <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
    <div class="bg-gradient-to-r from-emerald-500 to-green-600 h-2"></div>

    <div class="p-8">
      <%= form_with(model: @business, url: admin_business_path, method: :patch, local: true, class: "space-y-8") do |form| %>
        <!-- Error Messages -->
        <% if @business.errors.any? %>
          <div class="rounded-xl bg-red-50 border border-red-200 p-6 animate-shake">
            <div class="flex">
              <div class="flex-shrink-0">
                <i data-feather="alert-circle" class="h-6 w-6 text-red-600"></i>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-semibold text-red-800 mb-2">
                  <%= pluralize(@business.errors.count, "error") %> prevented your business from being saved
                </h3>
                <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
                  <% @business.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Basic Information Section -->
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-900">Basic Information</h3>
            <span class="text-sm text-gray-500">Core business details</span>
          </div>

          <div class="bg-gray-50 border-2 border-gray-200 rounded-xl p-6 space-y-6">
            <!-- Business Name -->
            <div class="space-y-2">
              <%= form.label :name, class: "block text-sm font-semibold text-gray-900" do %>
                Business Name <span class="text-red-500">*</span>
              <% end %>
              <div class="relative group">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                  <i data-feather="briefcase" class="h-5 w-5 text-gray-400 group-focus-within:text-emerald-500 transition-colors"></i>
                </div>
                <%= form.text_field :name,
                    class: "block w-full pl-12 pr-4 py-4 text-lg border-2 border-gray-200 rounded-xl placeholder-gray-400 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all duration-200 bg-white #{@business.errors[:name].any? ? 'border-red-300 focus:ring-red-500' : ''}",
                    placeholder: "e.g., Green Lawn Care Services" %>
              </div>
              <p class="text-xs text-gray-500 flex items-center">
                <i data-feather="info" class="h-3 w-3 mr-1"></i>
                This is how customers will see your business
              </p>
            </div>

            <!-- Industry -->
            <div class="space-y-2">
              <%= form.label :industry, class: "block text-sm font-semibold text-gray-900" do %>
                Industry <span class="text-gray-400 font-normal">(Optional)</span>
              <% end %>
              <div class="relative group">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                  <i data-feather="tag" class="h-5 w-5 text-gray-400 group-focus-within:text-emerald-500 transition-colors"></i>
                </div>
                <%= form.select :industry,
                    options_for_select(Business::INDUSTRIES.map { |k, v| [v, k] }, @business.industry),
                    { include_blank: "Select your industry" },
                    class: "block w-full pl-12 pr-10 py-4 text-lg border-2 border-gray-200 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all duration-200 appearance-none cursor-pointer bg-white" %>
                <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                  <i data-feather="chevron-down" class="h-5 w-5 text-gray-400"></i>
                </div>
              </div>
              <p class="text-xs text-gray-500 flex items-center">
                <i data-feather="info" class="h-3 w-3 mr-1"></i>
                Helps us customize features for your business type
              </p>
            </div>
          </div>
        </div>

        <!-- Contact Information Section -->
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-900">Contact Information</h3>
            <span class="text-sm text-gray-500">How customers reach you</span>
          </div>

          <div class="bg-gray-50 border-2 border-gray-200 rounded-xl p-6 space-y-6">
            <!-- Email -->
            <div class="space-y-2">
              <%= form.label :email, class: "block text-sm font-semibold text-gray-900" do %>
                Business Email <span class="text-gray-400 font-normal">(Optional)</span>
              <% end %>
              <div class="relative group">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                  <i data-feather="mail" class="h-5 w-5 text-gray-400 group-focus-within:text-emerald-500 transition-colors"></i>
                </div>
                <%= form.email_field :email,
                    class: "block w-full pl-12 pr-4 py-4 text-lg border-2 border-gray-200 rounded-xl placeholder-gray-400 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all duration-200 bg-white",
                    placeholder: "business@example.com" %>
              </div>
              <p class="text-xs text-gray-500 flex items-center">
                <i data-feather="info" class="h-3 w-3 mr-1"></i>
                Customers can use this to contact you
              </p>
            </div>

            <!-- Phone -->
            <div class="space-y-2">
              <%= form.label :phone, class: "block text-sm font-semibold text-gray-900" do %>
                Phone Number <span class="text-gray-400 font-normal">(Optional)</span>
              <% end %>
              <div class="relative group">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                  <i data-feather="phone" class="h-5 w-5 text-gray-400 group-focus-within:text-emerald-500 transition-colors"></i>
                </div>
                <%= form.telephone_field :phone,
                    class: "block w-full pl-12 pr-4 py-4 text-lg border-2 border-gray-200 rounded-xl placeholder-gray-400 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all duration-200 bg-white",
                    placeholder: "(555) 123-4567" %>
              </div>
              <p class="text-xs text-gray-500 flex items-center">
                <i data-feather="info" class="h-3 w-3 mr-1"></i>
                Primary contact number for your business
              </p>
            </div>

            <!-- Website -->
            <div class="space-y-2">
              <%= form.label :website, class: "block text-sm font-semibold text-gray-900" do %>
                Website <span class="text-gray-400 font-normal">(Optional)</span>
              <% end %>
              <div class="relative group">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                  <i data-feather="globe" class="h-5 w-5 text-gray-400 group-focus-within:text-emerald-500 transition-colors"></i>
                </div>
                <%= form.url_field :website,
                    class: "block w-full pl-12 pr-4 py-4 text-lg border-2 border-gray-200 rounded-xl placeholder-gray-400 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all duration-200 bg-white",
                    placeholder: "https://yourbusiness.com" %>
              </div>
              <p class="text-xs text-gray-500 flex items-center">
                <i data-feather="info" class="h-3 w-3 mr-1"></i>
                Link to your business website or social media
              </p>
            </div>
          </div>
        </div>

        <!-- Location Section -->
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-900">Location</h3>
            <span class="text-sm text-gray-500">Where you're based</span>
          </div>

          <div class="bg-gray-50 border-2 border-gray-200 rounded-xl p-6">
            <!-- Address -->
            <div class="space-y-2">
              <%= form.label :address, class: "block text-sm font-semibold text-gray-900" do %>
                Business Address <span class="text-gray-400 font-normal">(Optional)</span>
              <% end %>
              <div class="relative group">
                <div class="absolute top-4 left-4 pointer-events-none">
                  <i data-feather="map-pin" class="h-5 w-5 text-gray-400 group-focus-within:text-emerald-500 transition-colors"></i>
                </div>
                <%= form.text_area :address,
                    rows: 3,
                    class: "block w-full pl-12 pr-4 py-4 text-lg border-2 border-gray-200 rounded-xl placeholder-gray-400 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all duration-200 bg-white resize-none",
                    placeholder: "123 Main Street\nCity, State 12345" %>
              </div>
              <p class="text-xs text-gray-500 flex items-center">
                <i data-feather="info" class="h-3 w-3 mr-1"></i>
                Your physical business location or service area
              </p>
            </div>
          </div>
        </div>

        <!-- Description Section -->
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-900">About Your Business</h3>
            <span class="text-sm text-gray-500">Tell your story</span>
          </div>

          <div class="bg-gray-50 border-2 border-gray-200 rounded-xl p-6">
            <!-- Description -->
            <div class="space-y-2">
              <%= form.label :description, class: "block text-sm font-semibold text-gray-900" do %>
                Business Description <span class="text-gray-400 font-normal">(Optional)</span>
              <% end %>
              <div class="relative group">
                <div class="absolute top-4 left-4 pointer-events-none">
                  <i data-feather="edit-3" class="h-5 w-5 text-gray-400 group-focus-within:text-emerald-500 transition-colors"></i>
                </div>
                <%= form.text_area :description,
                    rows: 5,
                    class: "block w-full pl-12 pr-4 py-4 text-lg border-2 border-gray-200 rounded-xl placeholder-gray-400 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all duration-200 bg-white resize-none",
                    placeholder: "Tell customers about your business, services, and what makes you unique..." %>
              </div>
              <p class="text-xs text-gray-500 flex items-center">
                <i data-feather="info" class="h-3 w-3 mr-1"></i>
                This will be displayed on your public profile and quotes
              </p>
            </div>
          </div>
        </div>

        <!-- Pro Tips -->
        <div class="bg-blue-50 border-2 border-blue-200 rounded-xl p-6">
          <div class="flex items-start">
            <div class="flex-shrink-0">
              <i data-feather="lightbulb" class="h-6 w-6 text-blue-600"></i>
            </div>
            <div class="ml-4">
              <h4 class="text-lg font-semibold text-blue-900 mb-2">Profile Tips</h4>
              <ul class="text-blue-800 space-y-1 text-sm">
                <li>• Complete information builds trust with potential customers</li>
                <li>• A good description helps customers understand your services</li>
                <li>• Keep your contact information up to date</li>
                <li>• Add your website to drive more traffic to your online presence</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Submit Buttons -->
        <div class="flex justify-end space-x-4 pt-6 border-t border-gray-200">
          <%= link_to "Cancel", admin_root_path, class: "inline-flex items-center px-6 py-3 border-2 border-gray-300 rounded-xl shadow-sm text-base font-medium text-gray-700 bg-white hover:bg-gray-50 transition-all duration-200" %>
          <button type="submit" class="inline-flex items-center px-8 py-3 border border-transparent text-base font-semibold rounded-xl text-white bg-gradient-to-r from-emerald-600 to-green-600 hover:from-emerald-700 hover:to-green-700 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200">
            <i data-feather="save" class="h-5 w-5 mr-2"></i>
            Save Changes
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-10px); }
    75% { transform: translateX(10px); }
  }

  .animate-shake {
    animation: shake 0.5s ease-in-out;
  }
</style>


<% tab = params[:tab].presence_in(%w[hours branding]) || "profile" %>
<%= page_header "Settings", lede: "Your business details, hours and branding." %>

<nav class="tabs mb-5" aria-label="Settings">
  <%= link_to "Profile", edit_admin_business_path, class: "tab", "aria-current": ("page" if tab == "profile") %>
  <%= link_to "Hours", edit_admin_business_path(tab: "hours"), class: "tab", "aria-current": ("page" if tab == "hours") %>
  <%= link_to "Branding", edit_admin_business_path(tab: "branding"), class: "tab", "aria-current": ("page" if tab == "branding") %>
</nav>

<% case tab %>
<% when "hours" %>
  <div class="card overflow-hidden"><%= render "hours_tab" %></div>
<% when "branding" %>
  <div class="card overflow-hidden"><%= render "branding_tab" %></div>
<% else %>
  <%= form_with model: @business, url: admin_business_path, method: :patch, class: "max-w-3xl space-y-4" do |f| %>
    <% if @business.errors.any? %>
      <div class="banner banner-danger" role="alert">
        <%= icon "alert-circle" %>
        <p><%= pluralize(@business.errors.count, "problem") %> to fix before saving. Each one is marked below.</p>
      </div>
    <% end %>

    <%= card title: "Business profile", subtitle: "How your business appears to clients." do %>
      <%= f.field :name, label: "Business name", placeholder: "Oakline Lawn & Landscape" %>
      <%= f.field :industry, as: :select, optional: true, include_blank: "Choose an industry",
                  choices: Business::INDUSTRIES.map { |key, name| [ name, key ] } %>
      <%= f.field :description, as: :textarea, optional: true, rows: 4,
                  help: "A sentence or two about what you do. Shown on your public pages." %>
    <% end %>

    <%= card title: "Contact details", subtitle: "Shown on quotes and invoices." do %>
      <div class="grid gap-4 sm:grid-cols-2">
        <%= f.field :email, as: :email, label: "Business email", optional: true, placeholder: "office@example.com" %>
        <%= f.field :phone, as: :phone, label: "Phone", optional: true, placeholder: "(555) 123-4567" %>
      </div>
      <%= f.field :website, as: :url, optional: true, placeholder: "https://example.com" %>
      <%= f.field :address, as: :textarea, label: "Address", optional: true, rows: 3 %>
    <% end %>

    <div class="flex items-center justify-end gap-2">
      <%= link_to "Cancel", admin_root_path, class: button_classes(:ghost) %>
      <%= f.submit_button "Save changes" %>
    </div>
  <% end %>
<% end %>

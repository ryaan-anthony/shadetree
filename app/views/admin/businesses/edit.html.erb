<% tab = (@tab || params[:tab]).presence_in(Admin::BusinessesController::SETTINGS_TABS) || "business" %>
<% country = @business.country_entry || Country.find("US") %>
<%= render "settings_header", current: tab %>

<% if tab == "branding" %>
  <%= render "branding_tab" %>
<% else %>
  <%= form_with model: @business, url: admin_business_path(tab:), method: :patch, class: "max-w-3xl space-y-4" do |f| %>
  <%= hidden_field_tag :from, "setup", id: nil if from_setup? %>
    <% if @business.errors.any? %>
      <div class="banner banner-danger" role="alert">
        <%= icon "alert-circle" %>
        <p><%= @business.errors.count == 1 ? "One thing" : "#{@business.errors.count} things" %> to fix before saving. Each one is marked below.</p>
      </div>
    <% end %>

    <% if tab == "documents" %>
      <div class="banner banner-info" role="status"><%= icon "info" %>
        <p>These are starting points for <span class="font-semibold">new</span> quotes and invoices. Documents you've already created or sent keep what they had.</p>
      </div>

      <%= card title: "Quotes" do %>
        <div class="grid gap-4 sm:grid-cols-2">
          <%= f.field :quote_expiry_days, as: :number, label: "Days a quote stays valid", min: 1, max: 365,
                      help: "After that many days, the client can't approve it without asking you." %>
          <%= f.field :quote_number_prefix, label: "Quote number prefix", maxlength: 8, help: "Quotes are numbered #{@business.quote_number_prefix.presence || "Q"}-0001, -0002…" %>
        </div>
        <%= f.field :quote_terms, as: :textarea, label: "Quote terms", optional: true, rows: 5,
                    placeholder: "e.g. Prices include materials. 50% deposit to schedule.",
                    help: "Shown at the bottom of every new quote. You can edit it on each quote." %>
        <%= f.field :quote_approved_message, as: :textarea, label: "After a client approves", optional: true, rows: 2, maxlength: 500,
                    placeholder: @business.quote_next_steps,
                    help: "What happens next, shown on the confirmation and in the approval email. Leave blank for the text shown here." %>
      <% end %>

      <%= card title: "Jobs" do %>
        <%= f.check :auto_create_jobs, label: "Make a job when a quote is approved",
                    hint: "The job copies the quote's client, property, items, notes and files. When this is off, make the job from the quote's page." %>
        <div class="mt-4"><%= f.check :technicians_see_prices, label: "Technicians see prices",
                    hint: "On the visits they're sent to; otherwise they see what to do and how much, without prices. Technicians drafting a quote see the catalog prices." %></div>
      <% end %>

      <%= card title: "Visit emails to clients", subtitle: "Sent to the client's email address, from your business, with a link to their visit." do %>
        <div class="space-y-3">
          <% hints = { "scheduled" => "When you book visits. Several booked together are one email.",
                       "changed" => "When you move a visit to another day or time.",
                       "cancelled" => "When you cancel a visit, or its job.",
                       "reminder" => "The day before, at #{Business::VISIT_REMINDER_HOUR} am your time, for visits still booked." } %>
          <% Business::CLIENT_VISIT_EMAILS.each do |kind, label| %>
            <label class="flex items-start gap-2 text-sm" for="client-visit-email-<%= kind %>">
              <%= hidden_field_tag "business[client_visit_emails][#{kind}]", "0", id: nil %>
              <%= check_box_tag "business[client_visit_emails][#{kind}]", "1", @business.client_visit_email?(kind), id: "client-visit-email-#{kind}", class: "checkbox mt-0.5" %>
              <span><span class="font-medium text-ink"><%= label %></span><span class="block text-sm2 text-muted"><%= hints.fetch(kind) %></span></span>
            </label>
          <% end %>
        </div>
        <p class="mt-3 text-sm2 text-muted">You can also skip the email for one change, from the visit form.</p>
      <% end %>

      <%= card title: "Invoices" do %>
        <div class="grid gap-4 sm:grid-cols-2">
          <%= f.field :invoice_due_days, as: :number, label: "Days to pay, after it's issued", min: 0, max: 365,
                      help: "An invoice is issued when you send it. 0 means due on receipt." %>
          <%= f.field :invoice_number_prefix, label: "Invoice number prefix", maxlength: 8, help: "Invoices are numbered #{@business.invoice_number_prefix.presence || "INV"}-0001…" %>
        </div>
        <%= f.field :invoice_terms, as: :textarea, label: "Invoice terms", optional: true, rows: 5,
                    placeholder: "e.g. Thank you for your business. Late payments may incur a fee." %>
      <% end %>
    <% elsif tab == "request_form" %>
      <%= render "request_form_tab", f: %>
    <% else %>
      <%= card title: "Business profile", subtitle: "Shown on quotes, invoices and emails." do %>
        <%= f.field :name, label: "Business name", placeholder: "e.g. Rivera Home Services" %>
        <%= f.field :industry, as: :select, optional: true, include_blank: "Choose an industry", choices: Industry.options %>
        <%= f.field :description, as: :textarea, optional: true, rows: 3,
                    help: "A sentence or two about what you do. Shown on your public pages." %>
      <% end %>

      <%= card title: "Contact details" do %>
        <div class="grid gap-4 sm:grid-cols-2">
          <%= f.field :email, as: :email, label: "Business email", optional: true, placeholder: "office@example.com", autocomplete: "email" %>
          <%= f.field :phone, as: :phone, label: "Phone", optional: true, placeholder: "(555) 123-4567", autocomplete: "tel" %>
        </div>
        <%# A text input (not type=url) so "example.com" reaches the server, which adds https://. %>
        <%= f.field :website, optional: true, placeholder: "example.com", inputmode: "url", autocomplete: "url", spellcheck: false %>
      <% end %>

      <%= card title: "Address", subtitle: "Where clients and documents can reach you." do %>
        <%= f.field :address_line1, label: "Street address", optional: true, autocomplete: "address-line1" %>
        <%= f.field :address_line2, label: "Unit, suite or floor", optional: true, autocomplete: "address-line2" %>
        <div class="grid gap-4 sm:grid-cols-3">
          <%= f.field :city, optional: true, autocomplete: "address-level2" %>
          <%= f.field :region, label: country.region_label, optional: true, autocomplete: "address-level1" %>
          <%= f.field :postal_code, label: country.postal_label, optional: true, autocomplete: "postal-code" %>
        </div>
        <%= f.field :country, as: :select, choices: Country.options, autocomplete: "country" %>
        <%# CAT-07: nothing about locations until a second one exists, and the way in only on plans that include them %>
        <% if @business.multiple_locations? %>
          <p class="mt-3 text-sm2 text-muted">These are your main location's details. Other locations have their own, under <%= link_to "Locations", admin_locations_path, class: "font-medium text-ink underline-offset-2 hover:underline" %>.</p>
        <% elsif @business.entitlements.feature?(:locations) %>
          <p class="mt-3 text-sm2 text-muted">Work from more than one base? <%= link_to "Add a location", new_admin_location_path, class: "font-medium text-ink underline-offset-2 hover:underline" %></p>
        <% end %>
      <% end %>

      <%= card title: "Time zone and currency", subtitle: "Used for scheduling, due dates and every price." do %>
        <div class="grid gap-4 sm:grid-cols-2">
          <%= f.field :timezone, as: :select, label: "Time zone", include_blank: "Choose a time zone",
                      choices: grouped_options_for_select(time_zone_options(@business.timezone), time_zone_identifier(@business.timezone)) %>
          <%= f.field :currency, as: :select, choices: currency_options,
                      help: "Set once you start invoicing; changing it later doesn't convert old documents." %>
        </div>
      <% end %>
    <% end %>

    <div class="flex items-center justify-end gap-2">
      <%= link_to "Cancel", admin_root_path, class: button_classes(:ghost) %>
      <%= f.submit_button "Save changes" %>
    </div>
  <% end %>
<% end %>

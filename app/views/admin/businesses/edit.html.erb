<% content_for :page_title, "Business Settings" %>

<!-- Professional SaaS Settings Page -->
<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- Page Header - Clean & Minimal -->
    <div class="mb-6">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-semibold text-gray-900">Settings</h1>
          <p class="mt-1 text-sm text-gray-500">Manage your business information and preferences</p>
        </div>
        <%= link_to admin_root_path, class: "text-sm text-gray-600 hover:text-gray-900 font-medium transition-colors" do %>
          ← Back
        <% end %>
      </div>
    </div>

    <!-- Settings Container with Sidebar Navigation (like Stripe, Linear, Notion) -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
      <div class="flex">

        <!-- Sidebar Navigation -->
        <div class="w-64 border-r border-gray-200 bg-gray-50/50">
          <nav class="p-3 space-y-1" aria-label="Settings">
            <%= link_to edit_admin_business_path,
                class: "#{(params[:tab].blank? || params[:tab] == 'profile') ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-600 hover:bg-white/50 hover:text-gray-900'} group flex items-center px-3 py-2 text-sm font-medium rounded-md transition-all" do %>
              Profile
            <% end %>

            <%= link_to edit_admin_business_path(tab: 'hours'),
                class: "#{params[:tab] == 'hours' ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-600 hover:bg-white/50 hover:text-gray-900'} group flex items-center px-3 py-2 text-sm font-medium rounded-md transition-all" do %>
              Operating Hours
            <% end %>

            <%= link_to edit_admin_business_path(tab: 'branding'),
                class: "#{params[:tab] == 'branding' ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-600 hover:bg-white/50 hover:text-gray-900'} group flex items-center px-3 py-2 text-sm font-medium rounded-md transition-all" do %>
              Branding
            <% end %>

            <!-- Disabled Tabs -->
            <div class="opacity-50 cursor-not-allowed group flex items-center px-3 py-2 text-sm font-medium rounded-md text-gray-500">
              Notifications
              <span class="ml-auto text-xs bg-gray-200 text-gray-600 px-2 py-0.5 rounded">Soon</span>
            </div>

            <div class="opacity-50 cursor-not-allowed group flex items-center px-3 py-2 text-sm font-medium rounded-md text-gray-500">
              Payment Settings
              <span class="ml-auto text-xs bg-gray-200 text-gray-600 px-2 py-0.5 rounded">Soon</span>
            </div>
          </nav>
        </div>

        <!-- Main Content Area -->
        <div class="flex-1 min-w-0">
          <% if params[:tab] == 'hours' %>
            <%= render 'hours_tab' %>
          <% elsif params[:tab] == 'branding' %>
            <%= render 'branding_tab' %>
          <% else %>
            <!-- Profile Tab Content -->
            <div class="p-8 max-w-3xl">

              <!-- Section Header -->
              <div class="mb-8">
                <h2 class="text-lg font-semibold text-gray-900">Business Profile</h2>
                <p class="mt-1 text-sm text-gray-500">Basic information about your business</p>
              </div>

              <%= form_with(model: @business, url: admin_business_path, method: :patch, local: true, class: "space-y-8") do |form| %>

                <!-- Error Messages - Modern Alert -->
                <% if @business.errors.any? %>
                  <div class="rounded-lg bg-red-50 border border-red-200 p-4">
                    <div class="flex">
                      <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                        </svg>
                      </div>
                      <div class="ml-3">
                        <h3 class="text-sm font-medium text-red-800">
                          There <%= @business.errors.count == 1 ? 'was' : 'were' %> <%= pluralize(@business.errors.count, "error") %> with your submission
                        </h3>
                        <div class="mt-2 text-sm text-red-700">
                          <ul class="list-disc pl-5 space-y-1">
                            <% @business.errors.full_messages.each do |message| %>
                              <li><%= message %></li>
                            <% end %>
                          </ul>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>

                <!-- Form Fields - Clean & Spacious -->
                <div class="space-y-6">

                  <!-- Business Name -->
                  <div>
                    <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-2" do %>
                      Business Name <span class="text-red-500">*</span>
                    <% end %>
                    <%= form.text_field :name,
                        class: "block w-full px-4 py-3 border border-gray-300 rounded-lg text-sm placeholder-gray-400 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all #{@business.errors[:name].any? ? 'border-red-300 focus:ring-red-500' : ''}",
                        placeholder: "Enter your business name" %>
                    <p class="mt-1.5 text-xs text-gray-500">This is how your business will appear to customers</p>
                  </div>

                  <!-- Industry -->
                  <div>
                    <%= form.label :industry, class: "block text-sm font-medium text-gray-700 mb-2" do %>
                      Industry <span class="text-gray-400 text-xs font-normal">(Optional)</span>
                    <% end %>
                    <%= form.select :industry,
                        options_for_select(Business::INDUSTRIES.map { |k, v| [v, k] }, @business.industry),
                        { include_blank: "Select an industry" },
                        class: "block w-full px-4 py-3 border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all cursor-pointer" %>
                  </div>

                  <!-- Divider -->
                  <div class="border-t border-gray-200 pt-6">
                    <h3 class="text-sm font-medium text-gray-900 mb-4">Contact Information</h3>
                  </div>

                  <!-- Email -->
                  <div>
                    <%= form.label :email, "Business Email", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.email_field :email,
                        class: "block w-full px-4 py-3 border border-gray-300 rounded-lg text-sm placeholder-gray-400 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all",
                        placeholder: "business@example.com" %>
                  </div>

                  <!-- Phone -->
                  <div>
                    <%= form.label :phone, "Phone Number", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.telephone_field :phone,
                        class: "block w-full px-4 py-3 border border-gray-300 rounded-lg text-sm placeholder-gray-400 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all",
                        placeholder: "(555) 123-4567" %>
                  </div>

                  <!-- Website -->
                  <div>
                    <%= form.label :website, class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.url_field :website,
                        class: "block w-full px-4 py-3 border border-gray-300 rounded-lg text-sm placeholder-gray-400 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all",
                        placeholder: "https://yourbusiness.com" %>
                  </div>

                  <!-- Divider -->
                  <div class="border-t border-gray-200 pt-6">
                    <h3 class="text-sm font-medium text-gray-900 mb-4">Location</h3>
                  </div>

                  <!-- Address -->
                  <div>
                    <%= form.label :address, "Business Address", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.text_area :address,
                        rows: 3,
                        class: "block w-full px-4 py-3 border border-gray-300 rounded-lg text-sm placeholder-gray-400 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all resize-none",
                        placeholder: "123 Main Street&#10;City, State 12345" %>
                  </div>

                  <!-- Divider -->
                  <div class="border-t border-gray-200 pt-6">
                    <h3 class="text-sm font-medium text-gray-900 mb-4">About</h3>
                  </div>

                  <!-- Description -->
                  <div>
                    <%= form.label :description, "Business Description", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.text_area :description,
                        rows: 4,
                        class: "block w-full px-4 py-3 border border-gray-300 rounded-lg text-sm placeholder-gray-400 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all resize-none",
                        placeholder: "Tell customers about your business and what makes you unique..." %>
                    <p class="mt-1.5 text-xs text-gray-500">This will be displayed on your public profile</p>
                  </div>
                </div>

                <!-- Form Actions - Sticky Bottom Bar (like modern SaaS) -->
                <div class="flex items-center justify-end gap-3 pt-6 border-t border-gray-200">
                  <%= link_to "Cancel", admin_root_path, class: "px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors" %>
                  <button type="submit" class="inline-flex items-center px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium rounded-lg shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500">
                    Save Changes
                  </button>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>


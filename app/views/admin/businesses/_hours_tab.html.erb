<div class="p-8 max-w-3xl" data-controller="operating-hours">

  <!-- Section Header -->
  <div class="mb-8">
    <h2 class="text-lg font-semibold text-gray-900">Operating Hours</h2>
    <p class="mt-1 text-sm text-gray-500">Set your business hours and timezone</p>
  </div>

  <%= form_with(url: admin_business_path(tab: 'hours'), method: :patch, local: true, class: "space-y-8") do |form| %>

    <!-- Error Messages -->
    <% if @business.errors.any? %>
      <div class="rounded-lg bg-red-50 border border-red-200 p-4">
        <div class="flex">
          <div class="shrink-0">
            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-red-800">
              There <%= @business.errors.count == 1 ? 'was' : 'were' %> <%= pluralize(@business.errors.count, "error") %> with your submission
            </h3>
            <div class="mt-2 text-sm text-red-700">
              <ul class="list-disc pl-5 space-y-1">
                <% @business.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Form Fields -->
    <div class="space-y-6">

      <!-- Timezone -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">
          Time Zone <span class="text-red-500">*</span>
        </label>
        <select name="timezone" class="block w-full px-4 py-3 border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-hidden focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all cursor-pointer">
          <option value="America/New_York" <%= 'selected' if @business.timezone == 'America/New_York' %>>Eastern Time (EST/EDT)</option>
          <option value="America/Chicago" <%= 'selected' if @business.timezone == 'America/Chicago' %>>Central Time (CST/CDT)</option>
          <option value="America/Denver" <%= 'selected' if @business.timezone == 'America/Denver' %>>Mountain Time (MST/MDT)</option>
          <option value="America/Los_Angeles" <%= 'selected' if @business.timezone == 'America/Los_Angeles' %>>Pacific Time (PST/PDT)</option>
          <option value="America/Phoenix" <%= 'selected' if @business.timezone == 'America/Phoenix' %>>Arizona Time (MST)</option>
          <option value="America/Anchorage" <%= 'selected' if @business.timezone == 'America/Anchorage' %>>Alaska Time (AKST/AKDT)</option>
          <option value="Pacific/Honolulu" <%= 'selected' if @business.timezone == 'Pacific/Honolulu' %>>Hawaii Time (HST)</option>
        </select>
        <p class="mt-1.5 text-xs text-gray-500">All appointments and quotes will use this timezone</p>
      </div>

      <!-- Divider -->
      <div class="border-t border-gray-200 pt-6">
        <h3 class="text-sm font-medium text-gray-900 mb-4">Weekly Schedule</h3>
      </div>

      <!-- Schedule Entries -->
      <div class="border border-gray-200 rounded-lg overflow-hidden divide-y divide-gray-200">
        <% %w[Monday Tuesday Wednesday Thursday Friday Saturday Sunday].each_with_index do |day, index| %>
          <div class="flex items-center p-4 bg-white hover:bg-gray-50 transition-colors">
              <!-- Day Toggle -->
              <div class="flex items-center min-w-[140px]">
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" name="<%= day.downcase %>_enabled" value="1" class="sr-only peer day-toggle" <%= 'checked' if index < 5 %>>
                  <div class="w-11 h-6 bg-gray-300 peer-focus:outline-hidden peer-focus:ring-4 peer-focus:ring-emerald-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
                  <span class="ml-3 font-medium text-gray-900"><%= day %></span>
                </label>
              </div>

              <!-- Time Selection -->
              <div class="flex items-center space-x-4 ml-auto">
                <div class="flex items-center space-x-2">
                  <select name="<%= day.downcase %>_start" class="border-2 border-gray-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 time-select">
                    <% (6..11).each do |hour| %>
                      <option value="<%= hour %>:00" <%= 'selected' if hour == 9 %>><%= hour %>:00 AM</option>
                      <option value="<%= hour %>:30"><%= hour %>:30 AM</option>
                    <% end %>
                    <option value="12:00">12:00 PM</option>
                    <option value="12:30">12:30 PM</option>
                    <% (1..11).each do |hour| %>
                      <option value="<%= hour + 12 %>:00"><%= hour %>:00 PM</option>
                      <option value="<%= hour + 12 %>:30"><%= hour %>:30 PM</option>
                    <% end %>
                  </select>

                  <span class="text-gray-500 font-medium">to</span>

                  <select name="<%= day.downcase %>_end" class="border-2 border-gray-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 time-select">
                    <% (6..11).each do |hour| %>
                      <option value="<%= hour %>:00"><%= hour %>:00 AM</option>
                      <option value="<%= hour %>:30"><%= hour %>:30 AM</option>
                    <% end %>
                    <option value="12:00">12:00 PM</option>
                    <option value="12:30">12:30 PM</option>
                    <% (1..11).each do |hour| %>
                      <option value="<%= hour + 12 %>:00" <%= 'selected' if hour == 5 %>><%= hour %>:00 PM</option>
                      <option value="<%= hour + 12 %>:30"><%= hour %>:30 PM</option>
                    <% end %>
                  </select>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Schedule Summary - Cleaner Design -->
      <div class="bg-emerald-50 border border-emerald-200 rounded-lg p-4">
        <h4 class="text-sm font-medium text-emerald-900 mb-3">Schedule Summary</h4>
        <div id="schedule-summary" class="space-y-1.5 text-xs">
          <div class="flex justify-between text-emerald-800"><span>Monday:</span><span class="font-medium">9:00 AM - 5:00 PM</span></div>
          <div class="flex justify-between text-emerald-800"><span>Tuesday:</span><span class="font-medium">9:00 AM - 5:00 PM</span></div>
          <div class="flex justify-between text-emerald-800"><span>Wednesday:</span><span class="font-medium">9:00 AM - 5:00 PM</span></div>
          <div class="flex justify-between text-emerald-800"><span>Thursday:</span><span class="font-medium">9:00 AM - 5:00 PM</span></div>
          <div class="flex justify-between text-emerald-800"><span>Friday:</span><span class="font-medium">9:00 AM - 5:00 PM</span></div>
          <div class="flex justify-between text-gray-500"><span>Saturday:</span><span>Closed</span></div>
          <div class="flex justify-between text-gray-500"><span>Sunday:</span><span>Closed</span></div>
        </div>
      </div>
    </div>

    <!-- Form Actions -->
    <div class="flex items-center justify-end gap-3 pt-6 border-t border-gray-200">
      <%= link_to "Cancel", edit_admin_business_path, class: "px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors" %>
      <button type="submit" class="inline-flex items-center px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium rounded-lg shadow-xs transition-all focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500">
        Save Hours
      </button>
    </div>
  <% end %>
</div>


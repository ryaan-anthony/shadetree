<%# locals: (current:) -%>
<%# The settings page header and navigation, shared by every settings page. #289: four groups
    (SettingsHelper#settings_groups), then the pages in the current one; every page keeps its URL. %>
<% business = current_business %>
<%= page_header "Settings", lede: "How #{business.name_was.presence || business.name} appears to clients, and the defaults new quotes and invoices start from." %>

<% groups = settings_groups(current) %>
<% group, pages = groups.find { |_, list| list.any? { _1.key == current } } || groups.first %>
<nav class="mb-5" aria-label="Settings" id="settings-nav">
  <div class="tabs" data-controller="tabs">
    <% groups.each do |name, list| %>
      <%# The group is the page when it has just one (no pills below to say so). %>
      <%= link_to name, list.first.path, class: "tab", "aria-current": (name == group ? (list.size == 1 ? "page" : "true") : nil) %>
    <% end %>
  </div>
  <% if pages.size > 1 %>
    <ul class="mt-3 flex flex-wrap gap-2" aria-label="<%= group %>">
      <% pages.each do |page| %>
        <li><%= link_to page.label, page.path, class: "inline-flex items-center rounded-full border px-3 py-1 text-sm2 #{page.key == current ? "border-canopy bg-canopy/10 font-semibold text-ink" : "border-line text-subtle hover:text-ink"}",
                        "aria-current": ("page" if page.key == current) %></li>
      <% end %>
    </ul>
  <% end %>
</nav>

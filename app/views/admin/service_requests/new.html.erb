<%= page_header "Log a request", lede: "For work that came in by phone, email or in person." %>

<div class="form-split">
<%= form_with model: @request, scope: :service_request, url: admin_service_requests_path, class: "min-w-0 space-y-4",
              data: { controller: "property-loader", property_loader_url_value: property_options_admin_quotes_path,
                      property_loader_name_value: "service_request[property]", action: "client-picker:change->property-loader#load" } do |f| %>
  <%= card do %>
    <div class="space-y-4">
      <% if @request.errors[:client].any? %>
        <p class="error-text" role="alert"><%= icon "alert-circle" %><%= @request.errors[:client].first %></p>
      <% end %>
      <%= render "admin/clients/picker", name: "service_request[client]", selected: @request.client %>
      <%= turbo_frame_tag "quote_property", data: { property_loader_target: "frame" } do %>
        <%= render "admin/quotes/property_select", client: @request.client, selected: @request.property&.uid, name: "service_request[property]" %>
      <% end %>

      <fieldset>
        <legend class="label">How did they reach you?</legend>
        <div class="flex flex-wrap gap-x-5 gap-y-2">
          <% (ServiceRequest::SOURCES - [ "form" ]).each do |source| %>
            <label class="check"><%= f.radio_button :source, source %><span class="text-ink"><%= ServiceRequest::SOURCE_LABELS.fetch(source) %></span></label>
          <% end %>
        </div>
      </fieldset>

      <% services = CatalogItem.active.ordered.to_a # staff can log any service, not just the form's %>
      <% if services.any? %>
        <fieldset>
          <legend class="label">Services <span class="label-optional">(optional)</span></legend>
          <div class="grid gap-2 sm:grid-cols-2">
            <% chosen = @request.services.map { _1["catalog_item_id"] } %>
            <% services.each do |item| %>
              <label class="check"><%= check_box_tag "service_request[service_ids][]", item.uid, chosen.include?(item.id), id: "service_#{item.uid}" %>
                <span class="text-ink"><%= item.name %></span></label>
            <% end %>
          </div>
        </fieldset>
      <% end %>

      <% description_error = @request.errors.full_messages_for(:description).first %>
      <div class="field">
        <label class="label" for="service_request_description">What they need</label>
        <%= f.text_area :description, rows: 4, maxlength: 5_000, class: "textarea", "aria-invalid": ("true" if description_error),
                        placeholder: example_request_note %>
        <% if description_error %><p class="error-text"><%= icon "alert-circle" %><%= description_error %></p><% end %>
      </div>
      <%= f.field :timing, label: "When", optional: true, maxlength: 120, placeholder: "e.g. Next week, mornings" %>
      <%= render "admin/locations/field", f:, document: @request %>

    </div>
  <% end %>
  <%# CLI-07: who follows it up, if anyone yet. %>
  <%= render "admin/request_follow_ups/warnings", action: "log" %>
  <%= card title: "Follow-up", subtitle: "Optional. Give it to someone for a site visit or a call." do %>
    <%= fields model: @follow_up, scope: :request_follow_up do |ff| %>
      <%= render "admin/request_follow_ups/fields", f: ff, follow_up: @follow_up, optional: true %>
    <% end %>
  <% end %>
  <div class="flex justify-end gap-2">
    <%= link_to "Cancel", admin_service_requests_path, class: button_classes(:tertiary) %>
    <%= f.submit_button "Log request#{" anyway" if @warnings.present?}" %>
  </div>
<% end %>
<%# #289: what happens next, beside the form on wide screens (after it on phones: it's guidance, not data) %>
<aside class="form-split-aside" aria-labelledby="request-next-h">
  <%= card id: "request-next-steps" do %>
    <h2 class="card-title" id="request-next-h">What happens next</h2>
    <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm2 text-subtle">
      <li>It goes to Requests, where your team can see it and follow it up.</li>
      <li>When you're ready, Create quote fills in the client, the address and the services.</li>
      <li>Nothing is sent to the client until you send the quote.</li>
    </ol>
  <% end %>
</aside>
</div>
<%= render "admin/clients/quick_create", button: false %>

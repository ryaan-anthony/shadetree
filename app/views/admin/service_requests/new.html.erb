<%= page_header "Log a request", lede: "For work that came in by phone, email or in person." %>

<%= form_with model: @request, scope: :service_request, url: admin_service_requests_path, class: "max-w-2xl space-y-4" do |f| %>
  <%= card do %>
    <div class="space-y-4">
      <% if @request.errors[:client].any? %>
        <p class="error-text" role="alert"><%= icon "alert-circle" %><%= @request.errors[:client].first %></p>
      <% end %>
      <%= render "admin/clients/picker", name: "service_request[client]", selected: @request.client %>

      <fieldset>
        <legend class="label">How did they reach you?</legend>
        <div class="flex flex-wrap gap-x-5 gap-y-2">
          <% (ServiceRequest::SOURCES - [ "form" ]).each do |source| %>
            <label class="check"><%= f.radio_button :source, source %><span class="text-ink"><%= ServiceRequest::SOURCE_LABELS.fetch(source) %></span></label>
          <% end %>
        </div>
      </fieldset>

      <% services = RequestSubmission.offered_services.to_a %>
      <% if services.any? %>
        <fieldset>
          <legend class="label">Services <span class="label-optional">(optional)</span></legend>
          <div class="grid gap-2 sm:grid-cols-2">
            <% chosen = @request.services.map { _1["catalog_item_id"] } %>
            <% services.each do |item| %>
              <label class="check"><%= check_box_tag "service_request[service_ids][]", item.uid, chosen.include?(item.id), id: "service_#{item.uid}" %>
                <span class="text-ink"><%= item.name %></span></label>
            <% end %>
          </div>
        </fieldset>
      <% end %>

      <% description_error = @request.errors.full_messages_for(:description).first %>
      <div class="field">
        <label class="label" for="service_request_description">What they need</label>
        <%= f.text_area :description, rows: 4, maxlength: 5_000, class: "textarea", "aria-invalid": ("true" if description_error),
                        placeholder: "e.g. Called about weekly mowing from May. Corner lot, side gate." %>
        <% if description_error %><p class="error-text"><%= icon "alert-circle" %><%= description_error %></p><% end %>
      </div>
      <%= f.field :timing, label: "When", optional: true, maxlength: 120, placeholder: "e.g. Before Memorial Day" %>
      <p class="text-sm2 text-muted">The quote uses the client's address; you can change it there.</p>
    </div>
  <% end %>
  <div class="flex justify-end gap-2">
    <%= link_to "Cancel", admin_service_requests_path, class: button_classes(:ghost) %>
    <%= f.submit_button "Log request" %>
  </div>
<% end %>
<%= render "admin/clients/quick_create", button: false %>

<%= page_header "Requests", lede: "New work from your request form and phone calls." do %>
  <%= render "admin/shared/location_filter", path: admin_service_requests_path, keep: { status: @status, assignee: @assignee } %>
  <%# CLI-07: who's following them up. %>
  <%= form_with url: admin_service_requests_path, method: :get, class: "w-full sm:w-56", data: { turbo_action: "advance" } do %>
    <%= hidden_field_tag :status, @status, id: nil %>
    <label class="sr-only" for="assignee-filter">Assigned to</label>
    <%= select_tag :assignee, options_for_select([ [ "Assigned to anyone", "" ], [ "Assigned to me", "mine" ], [ "Not assigned", "unassigned" ] ] +
                                                 @assignee_choices.map { [ "Assigned to #{_1.full_name}", _1.id ] }, @assignee),
                   id: "assignee-filter", class: "select", data: { controller: "submit-form", action: "change->submit-form#submit" } %>
    <noscript><%= submit_tag "Show", class: button_classes(:secondary, :sm), name: nil %></noscript>
  <% end %>
  <% if current_business.request_form_enabled? %>
    <span data-controller="clipboard">
      <input type="hidden" value="<%= public_request_url(current_business.handle) %>" data-clipboard-target="source">
      <button type="button" class="<%= button_classes(:secondary) %>" data-action="clipboard#copy" data-clipboard-target="button"><%= icon "link" %> Copy form link</button>
    </span>
  <% end %>
  <%= link_to new_admin_service_request_path, class: button_classes do %><%= icon "plus" %> Log a request<% end %>
<% end %>

<%# PLT-19 (owner, 2026-11-23): searches as you type, like the other lists. One filter form posted
    to #search (POST keeps client names out of URLs), carrying the status tab and the assignee;
    its results replace only the frame below. %>
<%= form_with url: search_admin_service_requests_path, method: :post, id: "request-filters", class: "mb-4",
              data: { controller: "search-form", turbo_frame: "request_results" } do %>
  <%= hidden_field_tag :status, @status, id: nil %>
  <%= hidden_field_tag :assignee, @assignee, id: nil %>
  <div class="relative max-w-md">
    <label class="sr-only" for="q">Search requests</label>
    <%= icon "search", class: "pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-faint" %>
    <%= search_field_tag :q, @query, class: "input pl-9", placeholder: "Client or what they asked for", autocomplete: "off",
                         data: { action: "input->search-form#queue keydown.enter->search-form#submit:prevent" } %>
  </div>
<% end %>

<%= tabs ServiceRequest::LABELS, current: @status, label: "Requests by status", counts: ServiceRequest::STATUSES.index_with { @counts[_1].to_i },
         href: ->(status) { admin_service_requests_path(status:, assignee: @assignee) }, class: "mb-4" %>

<%= results_status "request_results" %>
<%= render "results" %>

<%= page_header "Requests", lede: "New work from your request form and phone calls." do %>
  <% if current_business.request_form_enabled? %>
    <span data-controller="clipboard">
      <input type="hidden" value="<%= public_request_url(current_business.handle) %>" data-clipboard-target="source">
      <button type="button" class="<%= button_classes(:secondary) %>" data-action="clipboard#copy" data-clipboard-target="button"><%= icon "link" %> Copy form link</button>
    </span>
  <% end %>
  <%= link_to new_admin_service_request_path, class: button_classes do %><%= icon "plus" %> Log a request<% end %>
<% end %>

<nav class="tabs mb-4" aria-label="Requests by status" data-controller="tabs">
  <% ServiceRequest::STATUSES.each do |status| %>
    <%= link_to admin_service_requests_path(status:), class: "tab", "aria-current": ("page" if status == @status) do %>
      <%= ServiceRequest::LABELS.fetch(status) %> <span class="tabular text-sm2 font-normal text-muted"><%= @counts[status].to_i %></span>
    <% end %>
  <% end %>
</nav>

<% if @requests.empty? %>
  <div class="card">
    <% if @status == "new" %>
      <%= empty_state title: "You're all caught up", text: current_business.request_form_enabled? ? "New requests from your form and the ones you log show up here." : "Turn on your request form in Settings to take requests online, or log one from a call.", icon: "inbox" do %>
        <%= link_to new_admin_service_request_path, class: button_classes(:secondary) do %><%= icon "plus" %> Log a request<% end %>
      <% end %>
    <% else %>
      <%= empty_state title: "Nothing here", text: "No requests are #{ServiceRequest::LABELS.fetch(@status).downcase} right now.", icon: "inbox" %>
    <% end %>
  </div>
<% else %>
  <%= card flush: true do %>
    <ul class="list">
      <% @requests.each do |request| %>
        <li id="request-<%= request.uid %>" class="p-0">
          <%# No hover prefetch: opening a request records who saw it. %>
          <%= link_to admin_service_request_path(request), class: "block min-w-0 flex-1 px-4 py-3", data: { turbo_prefetch: false } do %>
            <span class="flex items-baseline justify-between gap-3">
              <span class="min-w-0 truncate font-semibold text-ink">
                <% unless @seen_by_me.include?(request.id) %><span class="mr-1 inline-block size-2 rounded-full bg-canopy align-middle" title="Not opened by you"></span><span class="sr-only">Not opened by you. </span><% end %><%= request.client.display_name %>
              </span>
              <span class="shrink-0 text-sm2 text-muted"><%= local_time_ago(request.created_at) %></span>
            </span>
            <% if request.service_names.any? %><span class="mt-0.5 block truncate text-sm2 text-ink"><%= request.service_names.join(", ") %></span><% end %>
            <% if request.description %><span class="mt-0.5 block truncate text-sm2 text-subtle"><%= truncate(request.description, length: 160) %></span><% end %>
            <span class="mt-1 block truncate text-sm2 text-muted">
              <%= safe_join([ request.source == "form" ? request.source_label : "#{request.source_label}#{", logged by #{request.created_by.full_name}" if request.created_by}",
                              (pluralize(request.photos.size, "photo") if request.photos.attached?),
                              (request.property&.one_line || request.address_line) ].compact, " · ") %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
  <% if @total_pages > 1 %><div class="mt-4"><%= pagination page: @page, per_page: Admin::ServiceRequestsController::PER_PAGE, total_count: @total_count %></div><% end %>
<% end %>

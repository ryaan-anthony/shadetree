<% content_for :title, @ticket.subject %>
<p class="text-sm2"><%= link_to "← Help", admin_support_tickets_path, class: "text-muted hover:underline" %></p>
<div class="mt-1 flex flex-wrap items-center gap-2"><h1 class="page-title break-words"><%= @ticket.subject %></h1><%= render "status", ticket: @ticket %></div>
<p class="page-lede"><%= @ticket.category_label %> · <%= @ticket.reference %> · opened <%= local_time(@ticket.created_at) %></p>
<% if @ticket.status == "waiting" %><div class="banner banner-info mt-3" role="status"><p>We've replied and are waiting to hear from you.</p></div><% end %>
<%= card flush: true, class: "mt-4 max-w-3xl" do %>
  <ul class="list" id="messages"><%= render partial: "message", collection: @ticket.visible_messages, as: :message %></ul>
<% end %>
<%= card title: (@ticket.status == "resolved" ? "Reply to reopen" : "Reply"), class: "mt-4 max-w-3xl" do %>
  <%= form_with model: @reply, url: reply_admin_support_ticket_path(@ticket), multipart: true do |f| %>
    <% if @reply.errors.any? %><div class="banner banner-warning mb-3" role="alert"><p><%= @reply.errors.full_messages.to_sentence %></p></div><% end %>
    <%= f.text_area :body, rows: 4, class: "textarea", required: true, maxlength: 20_000, "aria-label": "Your reply" %>
    <div class="field mt-2">
      <%= f.label :files, class: "label" do %>Screenshots <span class="font-normal text-muted">(optional, up to <%= SupportMessage::MAX_FILES %>)</span><% end %>
      <%= f.file_field :files, multiple: true, accept: "image/png,image/jpeg,image/webp", class: "input" %>
    </div>
    <%= f.submit_button "Send reply", class: "mt-3" %>
  <% end %>
<% end %>

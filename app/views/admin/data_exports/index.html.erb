<% content_for :title, "Your data" %>
<%= render "admin/businesses/settings_header", current: "data" %>
<div class="grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,1fr)_20rem]">
  <%= card title: "Download as spreadsheets", subtitle: "Your data is yours: download any of it, any time, on any plan. Each file opens in Excel, Numbers or Google Sheets.", flush: true do %>
    <ul class="list" id="export-tables">
      <% DataExport::TABLES.each_value do |table| %>
        <li id="export-<%= table.key %>" class="items-start">
          <div class="min-w-0 flex-1">
            <p class="font-medium text-ink"><%= table.label %></p>
            <p class="text-sm2 text-muted"><%= table.description %></p>
            <details class="mt-1 text-sm2 text-muted">
              <summary class="cursor-pointer" aria-label="Columns: <%= table.label %>">Columns</summary>
              <p class="mt-1"><%= table.columns.map(&:header).join(", ") %></p>
            </details>
          </div>
          <%= link_to "Download CSV", download_admin_data_exports_path(table.key), class: button_classes(:secondary, :sm), data: { turbo: false }, "aria-label": "Download CSV: #{table.label}" %>
        </li>
      <% end %>
    </ul>
  <% end %>
  <div class="space-y-4">
    <%= card title: "Everything in one download", id: "full-export" do %>
      <p class="text-sm2 text-subtle">A zip of all the spreadsheets, every quote and invoice as a PDF, and every file and photo. It's made in the background; we'll tell you when it's ready, and the link lasts <%= DataExport::LINK_LASTS.in_days.to_i %> days.</p>
      <% if @full&.building? %>
        <p class="mt-3 text-sm font-medium text-ink" role="status">Being put together… started <%= time_ago_in_words(@full.created_at) %> ago. Reload this page later, or wait for our email.</p>
      <% elsif @full&.downloadable? %>
        <% parts = @full.parts %>
        <% parts.each_with_index do |part, index| %>
          <%= link_to (parts.one? ? "Download the zip" : "Download part #{index + 1} of #{parts.size}"), admin_data_export_path(@full, part: index + 1),
                      class: "#{button_classes(index.zero? ? :primary : :secondary)} mt-3 w-full", data: { turbo: false } %>
        <% end %>
        <p class="mt-2 text-sm2 text-muted">Made <%= local_time(@full.updated_at) %>; available until <%= local_date(@full.expires_at) %>.</p>
      <% elsif @full&.failed? %>
        <p class="mt-3 text-sm text-danger" role="alert" id="full-export-failed">The last one couldn't be made: <%= @full.failure_reason || "something went wrong." %></p>
      <% end %>
      <% unless @full&.building? %>
        <%= button_to (@full&.downloadable? ? "Make a new one" : "Export everything"), admin_data_exports_path, class: "#{button_classes(@full&.downloadable? ? :tertiary : :primary)} mt-3 w-full",
                      form: (@full&.downloadable? ? { data: { turbo_confirm: "Make a new export? We'll let you know when it's ready.", turbo_confirm_button: "Make a new one" } } : {}) %>
      <% end %>
    <% end %>
    <%= card title: "About these files" do %>
      <ul class="list-disc space-y-1 pl-5 text-sm2 text-subtle">
        <li>Money is a plain number in the document's currency, like 1240.00.</li>
        <li>Dates are YYYY-MM-DD; times are in <%= current_business.time_zone.name %>.</li>
        <li>Columns stay the same over time (new ones are added at the end), so a spreadsheet you build on them keeps working.</li>
        <li>Spreadsheet apps drop leading zeros from postal codes like 02134. Import that column as text to keep them.</li>
      </ul>
    <% end %>
    <%= card title: "Data log", subtitle: "Exports, downloads and erased clients.", flush: true do %>
      <% if @exports.any? %>
        <ul class="list" id="export-log">
          <% @exports.each do |export| %>
            <li><div class="min-w-0 flex-1"><p class="text-sm text-ink"><%= export.label %></p>
              <p class="break-all text-sm2 text-muted"><%= export.requested_by&.full_name || export.requested_by_email %> · <%= local_time(export.created_at) %><%= " · #{pluralize(number_with_delimiter(export.rows_count), "row")}" if export.rows_count && export.kind != "full" %></p></div></li>
          <% end %>
        </ul>
      <% else %>
        <p class="px-5 py-4 text-sm text-muted">None yet. Every download is listed here.</p>
      <% end %>
    <% end %>
  </div>
</div>

<% content_for :title, @rule.name %>
<%= page_header @rule.name, lede: (@rule.enabled? ? "On." : "Off: nothing runs until you turn it on.") do %>
  <%= link_to admin_automations_path, class: button_classes(:ghost) do %><%= icon "arrow-left" %> Automations<% end %>
<% end %>
<%= render "form", rule: @rule, url: admin_automation_path(@rule), method: :patch %>
<div class="mt-8 max-w-2xl border-t border-line pt-5">
  <p class="text-sm text-muted">Deleting it stops anything still waiting. What it already did stays in the activity list.</p>
  <%= button_to "Delete automation", admin_automation_path(@rule), method: :delete, class: button_classes(:danger, :sm) + " mt-2",
                form: { data: { turbo_confirm: "Delete “#{@rule.name}”? Anything still waiting won't run." } } %>
</div>

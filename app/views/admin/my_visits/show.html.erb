<%# JOB-04: one visit for the person going: when, where, how to get in, who to call, what to do. %>
<% visit = @visit %>
<% job = @job %>
<% client = job.client %>
<% property = job.property %>
<% content_for :title, client.display_name %>
<%= page_header client.display_name, lede: "#{visit.when_label} · about #{visit.duration_label}" do %>
  <%= link_to admin_my_day_path, class: button_classes(:ghost) do %><%= icon "arrow-left" %> My day<% end %>
<% end %>

<div class="max-w-2xl space-y-4">
  <%# The one thing to do next, big enough to hit with a gloved thumb. %>
  <div id="visit-action">
    <% case visit.status %>
    <% when "scheduled" %>
      <%= button_to start_admin_my_visit_path(visit), method: :patch, class: "#{button_classes(:primary)} w-full justify-center py-3.5 text-base" do %><%= icon "play" %> Start visit<% end %>
    <% when "in_progress" %>
      <%= button_to complete_admin_my_visit_path(visit), method: :patch, class: "#{button_classes(:primary)} w-full justify-center py-3.5 text-base",
                    form: { data: { turbo_confirm: "Mark this visit completed?", turbo_confirm_button: "Complete visit" } } do %><%= icon "check" %> Complete visit<% end %>
      <p class="mt-2 text-center text-sm2 text-muted">Started <%= local_time(visit.started_at) %></p>
    <% when "completed" %>
      <div class="banner banner-success"><%= icon "check-circle" %><p>Completed <%= local_time(visit.completed_at) %>.</p></div>
      <% if visit.reopenable? %>
        <%= button_to "Reopen it", reopen_admin_my_visit_path(visit), method: :patch, class: "btn-link mt-2 text-sm2", form: { data: { turbo_confirm: "Reopen this visit?", turbo_confirm_button: "Reopen" } } %>
      <% end %>
    <% else %>
      <div class="banner banner-warning"><%= icon "x-circle" %><p>This visit was cancelled<%= ": “#{visit.cancel_reason}”" if visit.cancel_reason %>.</p></div>
    <% end %>
  </div>

  <%= card do %>
    <% if property %>
      <p class="font-semibold text-ink"><%= property.one_line %></p>
      <%= link_to "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode(property.one_line)}", class: "#{button_classes(:secondary)} mt-3", target: "_blank", rel: "noopener" do %><%= icon "navigation" %> Directions<% end %>
      <% if property.access_notes.present? %>
        <div class="mt-4 rounded-control bg-warning-50 p-3 text-sm"><p class="font-semibold text-ink">Getting in</p><p class="mt-1 whitespace-pre-line text-body"><%= property.access_notes %></p></div>
      <% end %>
    <% else %>
      <p class="text-sm2 text-muted">No address on this job. Ask the office where to go.</p>
    <% end %>
    <% phone = client.primary_phone %>
    <% if phone %>
      <% digits = phone.value.gsub(/[^\d+]/, "") %>
      <div class="mt-4 grid grid-cols-2 gap-2">
        <%= link_to "tel:#{digits}", class: "#{button_classes(:secondary)} justify-center" do %><%= icon "phone" %> Call<% end %>
        <%= link_to "sms:#{digits}", class: "#{button_classes(:secondary)} justify-center" do %><%= icon "message-square" %> Text<% end %>
      </div>
    <% end %>
  <% end %>

  <% if job.instructions || visit.instructions %>
    <%= card title: "What to know" do %>
      <% if job.instructions %><p class="whitespace-pre-line text-sm text-ink"><%= job.instructions %></p><% end %>
      <% if visit.instructions %><p class="<%= "mt-3 border-t border-line pt-3" if job.instructions %> whitespace-pre-line text-sm text-ink"><span class="font-semibold">This visit:</span> <%= visit.instructions %></p><% end %>
    <% end %>
  <% end %>

  <% lines = job.line_items.to_a %>
  <% if lines.any? %>
    <%= card title: "The work", subtitle: job.title, flush: true do %>
      <% prices = current_business.technicians_see_prices || can?(:office) %>
      <ul class="list" id="visit-work">
        <% lines.each do |line| %>
          <li class="items-start">
            <div class="min-w-0 flex-1">
              <p class="font-medium text-ink"><%= line.name %></p>
              <% if line.description %><p class="whitespace-pre-line text-sm2 text-muted"><%= line.description %></p><% end %>
            </div>
            <span class="whitespace-nowrap text-sm text-ink"><%= line.quantity_label %></span>
            <% if prices %><span class="money whitespace-nowrap text-sm text-subtle"><%= money(line.unit_price) %></span><% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <%= card title: "Notes", flush: true, id: "notes" do %>
    <% if visit.notes.any? %>
      <ul class="list">
        <% visit.notes.each do |note| %>
          <li class="block"><p class="whitespace-pre-line text-sm text-ink"><%= note.body %></p>
            <p class="mt-0.5 text-sm2 text-muted"><%= note.user&.full_name || "Someone" %>, <%= local_time(note.created_at) %></p></li>
        <% end %>
      </ul>
    <% end %>
    <%= form_with model: @note, url: admin_my_visit_notes_path(visit), class: "border-t border-line p-4 first:border-t-0" do |f| %>
      <%= f.field :body, as: :textarea, label: "Add a note", rows: 2, maxlength: 2_000, placeholder: "Side gate was locked; came back at 2." %>
      <div class="mt-2 flex justify-end"><%= f.submit_button "Add note", variant: :secondary %></div>
    <% end %>
  <% end %>

  <% others = visit.assignees.reject { _1.id == current_user.id } %>
  <% if others.any? %>
    <p class="text-sm2 text-muted">Also going: <%= others.map(&:full_name).to_sentence %></p>
  <% end %>
</div>

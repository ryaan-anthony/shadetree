<%# JOB-06: a request the signed-in member is following up: when, where, who to call, what was asked for, and Done; then the quote or pass it back. %>
<% request_record = @request %>
<% follow_up = @follow_up %>
<% client = request_record.client %>
<% content_for :title, client.display_name %>
<%= page_header client.display_name, lede: "#{follow_up.kind_label} for a request · #{follow_up.when_label} · about #{follow_up.duration_label}" do %>
  <%= link_to admin_my_day_path, class: button_classes(:ghost) do %><%= icon "arrow-left" %> My day<% end %>
<% end %>

<div class="max-w-2xl space-y-4">
  <%# The one thing to do next, big enough to hit with a gloved thumb. %>
  <div id="follow-up-action">
    <% if follow_up.done? %>
      <% to = follow_up.pass_back_to %>
      <% next_step = if can?(:office) then to ? "Create the quote, or pass it back with what you found." : "Create the quote, or reassign it."
                     else to ? "Pass it back with what you found." : "Ask the office to reassign it."
                     end %>
      <div class="banner banner-success"><%= icon "check-circle" %><p>Done <%= local_time(follow_up.done_at) %>. <%= next_step %></p></div>
      <div class="mt-3 grid gap-2 sm:grid-cols-2">
        <% if can?(:office) %>
          <%= button_to quote_admin_service_request_path(request_record), class: "#{button_classes(:primary)} h-auto min-h-12 w-full justify-center", form: { class: "contents" } do %><%= icon "file-plus" %> Create quote<% end %>
        <% end %>
        <% if to %>
          <div class="contents" data-controller="modal">
            <button type="button" class="<%= button_classes(:secondary) %> h-auto min-h-12 w-full justify-center" data-action="modal#open" aria-haspopup="dialog"><%= icon "corner-up-left" %> Pass back to <%= to.full_name %></button>
            <%= modal id: "pass-back", title: "Pass this back to #{to.full_name}?", description: "It goes on their day for today. Say what you found, so they can quote it." do %>
              <%= form_with url: pass_back_admin_my_request_path(request_record), method: :patch, class: "space-y-4" do %>
                <div class="field">
                  <label class="label" for="pass-back-note">What you found <span class="label-optional">(optional)</span></label>
                  <%= text_area_tag :note, nil, id: "pass-back-note", rows: 4, maxlength: 5_000, class: "textarea", placeholder: "About 40 m of fence; two posts rotten. Gate is fine." %>
                </div>
                <div class="flex justify-end gap-2">
                  <button type="button" class="<%= button_classes(:secondary) %>" data-action="modal#close">Not yet</button>
                  <%= submit_tag "Pass it back", class: button_classes, name: nil %>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= button_to done_admin_my_request_path(request_record), method: :patch, class: "#{button_classes(:primary)} h-auto min-h-14 w-full justify-center text-base",
                    form: { data: { turbo_confirm: "Mark this #{follow_up.kind_label.downcase} done?", turbo_confirm_button: "Mark done" } } do %><%= icon "check" %> Mark <%= follow_up.kind_label.downcase %> done<% end %>
    <% end %>
    <% if can?(:office) %>
      <p class="mt-2 text-center text-sm2"><%= link_to "Move or reassign", edit_admin_service_request_follow_up_path(request_record), class: "text-muted underline" %></p>
    <% end %>
  </div>

  <%= card do %>
    <% address = request_record.property&.one_line || request_record.address_line %>
    <% if address %>
      <p class="font-semibold text-ink"><%= address %></p>
      <%= link_to "https://www.google.com/maps/dir/?api=1&destination=#{ERB::Util.url_encode(address)}", class: "#{button_classes(:secondary)} mt-3 h-auto min-h-11", target: "_blank", rel: "noopener" do %><%= icon "navigation" %> Directions<% end %>
      <% if request_record.property&.access_notes.present? %>
        <div class="mt-4 rounded-control bg-warning-50 p-3 text-sm"><p class="font-semibold text-ink">Getting in</p><p class="mt-1 whitespace-pre-line text-body"><%= request_record.property.access_notes %></p></div>
      <% end %>
    <% else %>
      <p class="text-sm2 text-muted">No address on this request. Call to ask where to go.</p>
    <% end %>
    <% phone = request_record.contact_phone || client.primary_phone&.value %>
    <% if phone %>
      <p class="mt-4 text-sm2 text-muted"><%= [ request_record.contact_name, phone_number(phone) ].compact.join(" · ") %></p>
      <% if (tel = phone_href(phone)) %><%# nothing to dial in "555-0100 or 555-0199": shown, not linked %>
        <div class="mt-1 grid grid-cols-2 gap-2">
          <%= link_to tel, class: "#{button_classes(:secondary)} h-auto min-h-11 justify-center" do %><%= icon "phone" %> Call<% end %>
          <%= link_to tel.sub("tel:", "sms:"), class: "#{button_classes(:secondary)} h-auto min-h-11 justify-center" do %><%= icon "message-square" %> Text<% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <%= card title: "What they asked for", id: "request" do %>
    <% if request_record.service_names.any? %><p class="font-medium text-ink"><%= request_record.service_names.join(", ") %></p><% end %>
    <% if request_record.description %><p class="mt-1 whitespace-pre-line text-sm text-body"><%= request_record.description %></p><% end %>
    <% if request_record.timing %><p class="mt-2 text-sm2 text-muted">When: <%= request_record.timing %></p><% end %>
    <% if follow_up.instructions %>
      <p class="mt-3 border-t border-line pt-3 whitespace-pre-line text-sm text-ink"><span class="font-semibold">For you:</span> <%= follow_up.instructions %></p>
    <% end %>
    <% if request_record.photos.attached? %>
      <ul class="mt-3 grid grid-cols-3 gap-2">
        <% request_record.photos.each.with_index(1) do |photo, number| %>
          <li><%= link_to rails_blob_path(photo, disposition: "inline"), target: "_blank", rel: "noopener" do %>
            <%= image_tag rails_representation_path(photo.variant(:web)), alt: "Photo #{number} from #{client.display_name}", loading: "lazy", class: "aspect-square w-full rounded-control bg-sunken object-cover" %><% end %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>

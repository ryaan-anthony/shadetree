<%# CAT-06: weekly hours and closures. Scheduling shades the time outside them and warns about visits then. %>
<%= render "admin/businesses/settings_header", current: "hours" %>
<% hours = @place.hours %>
<% problems = @place.errors.full_messages_for(:weekly_hours) %>
<% problem_days = problems.any? ? hours.problems_by_day : {} %>
<% zone = @place.time_zone %>

<div class="max-w-3xl space-y-4">
  <% if @business.multiple_locations? %><%# CAT-07: each location has its own hours and closures %>
    <nav class="flex flex-wrap gap-2" aria-label="Location">
      <% @business.active_locations.then { @location && !_1.include?(@location) ? _1 + [ @location ] : _1 }.each do |location| %>
        <% current = location.primary? ? @location.nil? : location == @location %>
        <%= link_to location.name, admin_hours_path(location: (location unless location.primary?)), class: button_classes(current ? :secondary : :ghost, :sm), "aria-current": ("page" if current) %>
      <% end %>
    </nav>
  <% end %>
  <% unless @place.weekly_hours_was || problems.any? %>
    <div class="banner banner-info"><%= icon "clock" %>
      <p>Your hours aren't set yet. Once they are, the schedule shades the times you're closed and warns you about visits booked then.</p></div>
  <% end %>

  <%= card title: "Weekly hours", subtitle: "Times are in #{time_zone_label(zone)}. One opening and one closing time per day; close at 12:00 AM to stay open until midnight.",
           actions: button_to("Use weekdays 8–5", hours_path, method: :patch, params: { preset: "weekdays" }, class: button_classes(:secondary, :sm),
                              form: { data: ({ turbo_confirm: "Replace your hours with Monday to Friday, 8 am to 5 pm?", turbo_confirm_button: "Replace" } if @place.weekly_hours_was) }) do %>
    <%= form_with url: hours_path, method: :patch, id: "weekly-hours" do %>
      <% if problems.any? %>
        <div class="banner banner-danger mb-4" role="alert"><%= icon "alert-circle" %>
          <div><p>Not saved yet. Fix <%= problems.size == 1 ? "this" : "these" %> and save again:</p>
            <ul class="mt-1 list-disc pl-5"><% problems.each do |problem| %><li><%= problem %></li><% end %></ul></div>
        </div>
      <% end %>
      <ul class="divide-y divide-line-2">
        <% WeeklyHours::DAYS.each do |wday| %>
          <% name = Date::DAYNAMES[wday] %>
          <% opens, closes = hours.for(wday) %>
          <% open = hours.open?(wday) %>
          <% invalid = problem_days.key?(wday) || nil %>
          <li><div class="group flex min-h-14 flex-wrap items-center gap-x-4 gap-y-2 py-2" role="group" aria-label="<%= name %>">
            <label class="check w-32 items-center">
              <%# Named "Monday: open", the visible word first: ticked means open that day. %>
              <%= check_box_tag "hours[#{wday}][open]", "1", open, id: "hours_#{wday}_open", "aria-label": "#{name}: open" %>
              <span class="font-medium text-ink"><%= name %></span>
            </label>
            <div class="hidden flex-wrap items-center gap-2 group-has-checked:flex">
              <label class="sr-only" for="hours_<%= wday %>_opens"><%= name %> opening time</label>
              <%= time_field_tag "hours[#{wday}][opens]", open ? opens : "08:00", id: "hours_#{wday}_opens", class: "input w-32", step: 300, "aria-invalid": invalid %>
              <span class="text-sm2 text-muted">to</span>
              <label class="sr-only" for="hours_<%= wday %>_closes"><%= name %> closing time</label>
              <%= time_field_tag "hours[#{wday}][closes]", open ? closes : "17:00", id: "hours_#{wday}_closes", class: "input w-32", step: 300, "aria-invalid": invalid %>
            </div>
            <span class="text-sm2 text-muted group-has-checked:hidden">Closed</span>
          </div></li>
        <% end %>
      </ul>
      <div class="mt-4 flex justify-end"><%= submit_tag "Save hours", class: button_classes(:primary), name: nil %></div>
    <% end %>
  <% end %>

  <%= card title: "Closures", subtitle: "Holidays, vacation and half days. The schedule warns about visits booked then.", flush: true,
           actions: link_to(new_admin_closure_path(location: @location), class: button_classes(:secondary, :sm)) { icon("plus") + " Add closure" } do %>
    <% if @closures.empty? %>
      <%= empty_state title: "No closures coming up", text: "Add the holidays and days off you know about, like Thanksgiving or a week's vacation.", level: 3, icon: "calendar" %>
    <% else %>
      <ul class="list"><%= render partial: "admin/closures/closure", collection: @closures %></ul>
    <% end %>
  <% end %>

  <% if @past_closures.any? %>
    <details class="card">
      <summary class="cursor-pointer px-5 py-3 text-sm font-medium text-ink">Past closures</summary>
      <ul class="list border-t border-line"><%= render partial: "admin/closures/closure", collection: @past_closures %></ul>
    </details>
  <% end %>
</div>

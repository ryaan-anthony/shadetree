<%# locals: (job:, kind:, id:) -%>
<%# JOB-05: "don't notify client" for one change. Shown when the client has an email and the
    business sends this kind of visit email; unticked, they're not emailed about this change. %>
<% email = job.client.primary_email %>
<% if email && current_business.client_visit_email?(kind) && !current_user.can_send_to_clients? %>
  <p class="text-sm2 text-muted">Confirm your email address to email <%= job.client.display_name %> about visits. Check your inbox for the link.</p>
<% elsif email && current_business.client_visit_email?(kind) %>
  <label class="flex items-start gap-2 text-sm text-ink" for="<%= id %>">
    <%= hidden_field_tag :notify_client, "0", id: nil %>
    <%= check_box_tag :notify_client, "1", params[:notify_client] != "0", id:, class: "checkbox mt-0.5" %>
    <span>Email <%= job.client.display_name %> about this <span class="block text-sm2 text-muted">To <%= email.value %>, a few minutes after your last change.</span></span>
  </label>
<% end %>

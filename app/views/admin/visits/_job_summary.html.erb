<%# locals: (job:, visit: nil) -%>
<%# #289: the job being booked, first in the page (beside the visit form on wide screens). %>
<aside class="form-split-aside" aria-labelledby="visit-job-summary-h">
  <%= card id: "visit-job-summary" do %>
    <h2 class="card-title" id="visit-job-summary-h">The job</h2>
    <p class="card-subtitle"><%= job.number %> · <%= job.title %></p>
    <div class="mt-3 space-y-3 text-sm">
      <p class="text-ink"><span class="font-medium"><%= job.client.display_name %></span>
        <% if job.property %><br><span class="text-subtle"><%= job.property.one_line %></span><% end %></p>
      <% if (phone = job.client.primary_phone) %><p><%= phone_link(phone.value, class: "text-ink hover:underline") %></p><% end %>
      <% lines = job.line_items.first(7) %>
      <% if lines.any? %>
        <ul class="space-y-1 border-t border-line pt-3">
          <% lines.first(6).each do |line| %>
            <li class="flex justify-between gap-2"><span class="min-w-0 truncate text-ink"><%= line.name %></span><span class="shrink-0 text-subtle tabular">× <%= line.quantity.to_d.to_s("F").sub(/\.0\z/, "") %></span></li>
          <% end %>
          <% if lines.size > 6 %><li class="text-sm2 text-muted">and <%= job.line_items.count - 6 %> more</li><% end %>
        </ul>
      <% end %>
      <% if job.instructions.present? %>
        <div class="border-t border-line pt-3"><p class="text-sm2 font-semibold text-ink">Instructions</p><p class="mt-1 whitespace-pre-line text-subtle"><%= job.instructions %></p></div>
      <% end %>
      <% booked = job.visits.open.where.not(id: visit&.id).count %>
      <p class="border-t border-line pt-3 text-sm2 text-muted"><%= booked.zero? ? (visit&.persisted? ? "No other visits booked." : "No visits booked yet.") : "#{pluralize(booked, visit&.persisted? ? "other visit" : "visit")} booked." %></p>
    </div>
  <% end %>
</aside>

<%# locals: (document:, noun:, edit_path:, confirm_path:) -%>
<%# #289: before a $0.00 quote or invoice goes out. A zero total waits for "Send it at $0.00"
    (ZeroTotalGuard); lines without a price are named either way. %>
<% unpriced = unpriced_lines %>
<% names = unpriced.map { _1.name.presence || "A custom line" }.uniq %>
<% if zero_total? && !zero_total_confirmed? %>
  <div class="banner banner-warning mb-4" role="alert" id="zero-total-warning"><%= icon "alert-triangle" %>
    <div class="min-w-0 flex-1">
      <p class="font-semibold">This <%= noun %> comes to <%= money(document.totals.total) %></p>
      <p class="mt-1"><%= names.any? ? "No price yet on #{names.to_sentence}." : "None of its lines has a price yet." %> Your client would see <%= money(document.totals.total) %>.</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <%= link_to "Add prices", edit_path, class: button_classes(:primary, :sm) %>
        <%= link_to "Send it at #{money(document.totals.total)}", confirm_path, class: button_classes(:secondary, :sm) %>
      </div>
    </div>
  </div>
<% elsif names.any? && document.draft? %>
  <div class="banner banner-info mb-4" role="note" id="unpriced-lines"><%= icon "info" %>
    <p class="flex-1">No price on <%= names.to_sentence %>, so <%= names.one? ? "it shows" : "they show" %> as <%= money(Money.zero(document.currency)) %>.
      <%= link_to "Add #{names.one? ? "a price" : "prices"}", edit_path, class: "font-semibold underline-offset-2 hover:underline" %></p>
  </div>
<% end %>

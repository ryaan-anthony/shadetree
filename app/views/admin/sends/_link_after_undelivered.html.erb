<%# locals: (document:) -%>
<%# QA #274: the latest email didn't arrive, but staff copied the link since to send it
    themselves, so instead of the warning there's only this note. %>
<% if (link = document.link_sent_after_undelivered) %>
  <p class="mt-3 text-sm2 text-muted" id="<%= document.model_name.element %>-link-after-undelivered">
    The email to <span class="break-words"><%= document.latest_email.to %></span> wasn't delivered; the link was copied <%= local_time(link.created_at) %> to send yourself.
  </p>
<% end %>

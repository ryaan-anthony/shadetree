<%# OPS-06: the help articles in the app, by category, searched as you type. %>
<%= page_header "Help articles", lede: "Step-by-step guides to every part of Shadetree, with pictures of each screen." do %>
  <%= link_to new_admin_support_ticket_path(from: request.path), class: button_classes(:secondary) do %><%= icon "message-square" %> Ask Shadetree<% end %>
<% end %>
<%= form_with url: admin_help_articles_path, method: :get, id: "help-search", html: { role: "search" }, class: "mb-4",
              data: { controller: "search-form", turbo_frame: "help_results", turbo_action: "replace" } do %>
  <div class="relative max-w-md">
    <label class="sr-only" for="help-q">Search help articles</label>
    <%= icon "search", class: "pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-faint" %>
    <%= search_field_tag :q, @query, id: "help-q", class: "input pl-9", placeholder: "e.g. take tax off one invoice", autocomplete: "off",
                         data: { action: "input->search-form#queue keydown.enter->search-form#submit:prevent" } %>
  </div>
<% end %>
<%= results_status "help_results" %>
<%= turbo_frame_tag "help_results", target: "_top" do %>
  <% if @query.present? %>
    <%= card do %><%= render "shared/help/results", results: @results, query: @query %><% end %>
  <% else %>
    <div class="grid gap-4 md:grid-cols-2" id="help-categories">
      <% HelpCentre::CATEGORIES.each do |key, name| %>
        <% articles = help_library.in_category(key) %>
        <% next if articles.empty? %>
        <%= card title: name, subtitle: HelpCentre::CATEGORY_SUMMARIES.fetch(key), flush: true, id: "help-category-#{key}" do %>
          <ul class="list">
            <% articles.each do |article| %>
              <li><%= link_to article.title, admin_help_article_path(article.slug), class: "font-medium text-ink hover:underline" %></li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>

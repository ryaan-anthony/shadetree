<div class="relative flex-1 flex flex-col max-w-xs w-full bg-white">
    <div class="absolute top-0 right-0 -mr-12 pt-2">
        <button id="close-sidebar" class="ml-1 flex items-center justify-center h-10 w-10 rounded-full focus:outline-none focus:ring-2 focus:ring-inset focus:ring-white">
            <i data-feather="x" class="h-6 w-6 text-white"></i>
        </button>
    </div>

    <!-- Mobile Navigation Content -->
    <div class="flex-1 h-0 pt-5 pb-4 overflow-y-auto">
        <div class="flex-shrink-0 flex items-center px-4">
            <h1 class="text-xl font-bold text-gray-900">
                <span class="text-shadetree-green">Shade</span>tree
            </h1>
            <span class="ml-2 text-xs bg-shadetree-green bg-opacity-10 text-shadetree-green px-2 py-1 rounded-full">Admin</span>
        </div>

        <!-- Business Selector -->
        <div class="mt-6 px-4">
            <label class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">Business</label>
            <div class="relative">
                <select id="mobile-business-selector" class="block w-full pl-3 pr-10 py-2.5 text-sm border border-gray-300 rounded-lg bg-white hover:border-gray-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-colors appearance-none cursor-pointer">
                    <% if current_user.businesses.any? %>
                        <% current_user.businesses.each do |business| %>
                            <option value="<%= business.id %>" <%= 'selected' if business == current_business %>><%= business.name %></option>
                        <% end %>
                        <option value="new" class="font-medium">+ Create New Business</option>
                    <% else %>
                        <option>Setting up business...</option>
                    <% end %>
                </select>
                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                    <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </div>
            </div>
        </div>

        <script>
        document.addEventListener('DOMContentLoaded', function() {
            const mobileSelector = document.getElementById('mobile-business-selector');
            if (!mobileSelector) {
                console.warn('Mobile business selector not found');
                return;
            }

            console.log('Mobile business selector initialized');

            // Ensure the correct option is selected on page load
            const selectedOption = mobileSelector.querySelector('option[selected]');
            if (selectedOption) {
                mobileSelector.value = selectedOption.value;
                console.log('Set mobile selector to:', selectedOption.value, selectedOption.text);
            }

            mobileSelector.addEventListener('change', function(e) {
                const value = e.target.value;
                console.log('Mobile business selector changed to:', value);

                if (value === 'new') {
                    console.log('Navigating to new business page');
                    window.location.href = '/admin/business/new';
                } else if (value && value !== 'Setting up business...') {
                    // Switch to selected business
                    console.log('Switching to business ID:', value);
                    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

                    if (!csrfToken) {
                        console.error('CSRF token not found');
                        alert('Security token missing. Please refresh the page.');
                        return;
                    }

                    // Show loading state
                    mobileSelector.disabled = true;

                    fetch('/admin/business/switch', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': csrfToken
                        },
                        body: JSON.stringify({ business_id: value })
                    })
                    .then(response => {
                        console.log('Switch response status:', response.status);
                        return response.json();
                    })
                    .then(data => {
                        console.log('Switch response data:', data);
                        if (data.success) {
                            console.log('Successfully switched to:', data.business.name);
                            // Reload page to show new business context
                            window.location.reload();
                        } else {
                            console.error('Failed to switch business:', data.error);
                            alert('Failed to switch business: ' + (data.error || 'Unknown error'));
                            mobileSelector.disabled = false;
                            // Reset selector to previous value
                            if (selectedOption) {
                                mobileSelector.value = selectedOption.value;
                            }
                        }
                    })
                    .catch(error => {
                        console.error('Error switching business:', error);
                        alert('An error occurred while switching businesses. Please try again.');
                        mobileSelector.disabled = false;
                        // Reset selector to previous value
                        if (selectedOption) {
                            mobileSelector.value = selectedOption.value;
                        }
                    });
                }
            });
        });
        </script>

        <!-- Mobile Navigation Menu -->
        <nav class="mt-5 px-2 space-y-1">
            <!-- Dashboard -->
            <%= link_to admin_dashboard_index_path, class: "#{current_page?(admin_dashboard_index_path) ? 'bg-shadetree-green bg-opacity-10 text-shadetree-green' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} group flex items-center px-2 py-2 text-base font-medium rounded-md" do %>
                <i data-feather="home" class="<%= current_page?(admin_dashboard_index_path) ? 'text-shadetree-green' : 'text-gray-400 group-hover:text-gray-500' %> mr-4 h-6 w-6"></i>
                Dashboard
            <% end %>

            <!-- Business Settings -->
            <%= link_to edit_admin_business_path, class: "text-gray-600 hover:bg-gray-50 hover:text-gray-900 group flex items-center px-2 py-2 text-base font-medium rounded-md" do %>
                <i data-feather="settings" class="text-gray-400 group-hover:text-gray-500 mr-4 h-6 w-6"></i>
                Business Settings
            <% end %>

            <!-- Staff Management -->
            <div class="space-y-1">
                <button class="text-gray-600 hover:bg-gray-50 hover:text-gray-900 group flex items-center w-full px-2 py-2 text-left text-base font-medium rounded-md">
                    <i data-feather="users" class="text-gray-400 group-hover:text-gray-500 mr-4 h-6 w-6"></i>
                    <span class="flex-1">Staff Management</span>
                    <i data-feather="chevron-down" class="ml-3 h-5 w-5 text-gray-400 group-hover:text-gray-500"></i>
                </button>
                <div class="ml-10 space-y-1">
                    <a href="#" class="text-gray-600 hover:text-gray-900 block px-3 py-2 text-sm font-medium rounded-md">Team Overview</a>
                    <a href="#" class="text-gray-600 hover:text-gray-900 block px-3 py-2 text-sm font-medium rounded-md">Roles & Permissions</a>
                    <a href="#" class="text-gray-600 hover:text-gray-900 block px-3 py-2 text-sm font-medium rounded-md">Availability</a>
                    <a href="#" class="text-gray-600 hover:text-gray-900 block px-3 py-2 text-sm font-medium rounded-md">Activity Tracking</a>
                </div>
            </div>

            <!-- Services & Pricing -->
            <div class="space-y-1">
                <button class="text-gray-600 hover:bg-gray-50 hover:text-gray-900 group flex items-center w-full px-2 py-2 text-left text-base font-medium rounded-md">
                    <i data-feather="settings" class="text-gray-400 group-hover:text-gray-500 mr-4 h-6 w-6"></i>
                    <span class="flex-1">Services & Pricing</span>
                    <i data-feather="chevron-down" class="ml-3 h-5 w-5 text-gray-400 group-hover:text-gray-500"></i>
                </button>
                <div class="ml-10 space-y-1">
                    <a href="#" class="text-gray-600 hover:text-gray-900 block px-3 py-2 text-sm font-medium rounded-md">Service Catalog</a>
                    <a href="#" class="text-gray-600 hover:text-gray-900 block px-3 py-2 text-sm font-medium rounded-md">Categories</a>
                    <a href="#" class="text-gray-600 hover:text-gray-900 block px-3 py-2 text-sm font-medium rounded-md">Pricing Rules</a>
                </div>
            </div>

            <!-- Quote Templates -->
            <a href="#" class="text-gray-600 hover:bg-gray-50 hover:text-gray-900 group flex items-center px-2 py-2 text-base font-medium rounded-md">
                <i data-feather="file-text" class="text-gray-400 group-hover:text-gray-500 mr-4 h-6 w-6"></i>
                Quote Templates
            </a>

            <!-- Reports -->
            <a href="#" class="text-gray-600 hover:bg-gray-50 hover:text-gray-900 group flex items-center px-2 py-2 text-base font-medium rounded-md">
                <i data-feather="bar-chart-2" class="text-gray-400 group-hover:text-gray-500 mr-4 h-6 w-6"></i>
                Reports
            </a>
        </nav>
    </div>
</div>

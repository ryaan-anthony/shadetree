<div class="hidden md:flex md:w-64 md:flex-col md:fixed md:inset-y-0">
    <div class="flex flex-col flex-grow bg-white border-r border-gray-200 pt-5 pb-4 overflow-y-auto">
        <!-- Logo -->
        <div class="flex items-center flex-shrink-0 px-4">
            <h1 class="text-xl font-bold text-gray-900">
                <span class="text-shadetree-green">Shade</span>tree
            </h1>
            <span class="ml-2 text-xs bg-shadetree-green bg-opacity-10 text-shadetree-green px-2 py-1 rounded-full">Admin</span>
        </div>

        <!-- Business Selector -->
        <div class="mt-6 px-4">
            <label class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">Business</label>
            <div class="relative">
                <select id="business-selector" class="block w-full pl-3 pr-10 py-2.5 text-sm border border-gray-300 rounded-lg bg-white hover:border-gray-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-colors appearance-none cursor-pointer">
                    <% if current_user.businesses.any? %>
                        <% current_user.businesses.each do |business| %>
                            <option value="<%= business.id %>" <%= 'selected' if business == current_business %>><%= business.name %></option>
                        <% end %>
                        <option value="new" class="font-medium">+ Create New Business</option>
                    <% else %>
                        <option>Setting up business...</option>
                    <% end %>
                </select>
                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                    <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </div>
            </div>
        </div>

        <script>
        document.addEventListener('DOMContentLoaded', function() {
            const selector = document.getElementById('business-selector');
            if (!selector) {
                console.warn('Business selector not found');
                return;
            }

            console.log('Business selector initialized');

            // Ensure the correct option is selected on page load
            const selectedOption = selector.querySelector('option[selected]');
            if (selectedOption) {
                selector.value = selectedOption.value;
                console.log('Set selector to:', selectedOption.value, selectedOption.text);
            }

            selector.addEventListener('change', function(e) {
                const value = e.target.value;
                console.log('Business selector changed to:', value);

                if (value === 'new') {
                    console.log('Navigating to new business page');
                    window.location.href = '/admin/business/new';
                } else if (value && value !== 'Setting up business...') {
                    // Switch to selected business
                    console.log('Switching to business ID:', value);
                    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

                    if (!csrfToken) {
                        console.error('CSRF token not found');
                        alert('Security token missing. Please refresh the page.');
                        return;
                    }

                    // Show loading state
                    selector.disabled = true;

                    fetch('/admin/business/switch', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': csrfToken
                        },
                        body: JSON.stringify({ business_id: value })
                    })
                    .then(response => {
                        console.log('Switch response status:', response.status);
                        return response.json();
                    })
                    .then(data => {
                        console.log('Switch response data:', data);
                        if (data.success) {
                            console.log('Successfully switched to:', data.business.name);
                            // Reload page to show new business context
                            window.location.reload();
                        } else {
                            console.error('Failed to switch business:', data.error);
                            alert('Failed to switch business: ' + (data.error || 'Unknown error'));
                            selector.disabled = false;
                            // Reset selector to previous value
                            if (selectedOption) {
                                selector.value = selectedOption.value;
                            }
                        }
                    })
                    .catch(error => {
                        console.error('Error switching business:', error);
                        alert('An error occurred while switching businesses. Please try again.');
                        selector.disabled = false;
                        // Reset selector to previous value
                        if (selectedOption) {
                            selector.value = selectedOption.value;
                        }
                    });
                }
            });
        });
        </script>

        <!-- Navigation Menu -->
        <nav class="mt-8 flex-1 px-2 space-y-1">
            <!-- Dashboard -->
            <%= link_to admin_dashboard_index_path, class: "#{current_page?(admin_dashboard_index_path) ? 'bg-shadetree-green bg-opacity-10 text-shadetree-green' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} group flex items-center px-2 py-2 text-sm font-medium rounded-md" do %>
                <i data-feather="home" class="<%= current_page?(admin_dashboard_index_path) ? 'text-shadetree-green' : 'text-gray-400 group-hover:text-gray-500' %> mr-3 h-5 w-5"></i>
                Dashboard
            <% end %>

            <!-- Business Settings -->
            <%= link_to edit_admin_business_path, class: "#{current_page?(edit_admin_business_path) ? 'bg-shadetree-green bg-opacity-10 text-shadetree-green' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} group flex items-center px-2 py-2 text-sm font-medium rounded-md" do %>
                <i data-feather="settings" class="<%= current_page?(edit_admin_business_path) ? 'text-shadetree-green' : 'text-gray-400 group-hover:text-gray-500' %> mr-3 h-5 w-5"></i>
                Business Settings
            <% end %>

            <!-- Staff Management -->
            <div class="space-y-1">
                <div class="text-gray-600 hover:bg-gray-50 hover:text-gray-900 group flex items-center px-2 py-2 text-sm font-medium rounded-md cursor-pointer" onclick="toggleSubmenu('staff-management')">
                    <i data-feather="users" class="text-gray-400 group-hover:text-gray-500 mr-3 h-5 w-5"></i>
                    <span class="flex-1">Staff Management</span>
                    <i data-feather="chevron-right" id="staff-management-icon" class="ml-auto h-4 w-4 text-gray-400 group-hover:text-gray-500 transition-transform"></i>
                </div>
                <div id="staff-management-menu" class="ml-8 space-y-1 hidden">
                    <a href="#" class="text-gray-600 hover:text-gray-900 block px-3 py-1 text-sm rounded-md">Team Overview</a>
                    <a href="#" class="text-gray-600 hover:text-gray-900 block px-3 py-1 text-sm rounded-md">Roles & Permissions</a>
                    <a href="#" class="text-gray-600 hover:text-gray-900 block px-3 py-1 text-sm rounded-md">Availability</a>
                    <a href="#" class="text-gray-600 hover:text-gray-900 block px-3 py-1 text-sm rounded-md">Activity Tracking</a>
                </div>
            </div>

            <!-- Services & Pricing -->
            <div class="space-y-1">
                <div class="text-gray-600 hover:bg-gray-50 hover:text-gray-900 group flex items-center px-2 py-2 text-sm font-medium rounded-md cursor-pointer" onclick="toggleSubmenu('services-pricing')">
                    <i data-feather="settings" class="text-gray-400 group-hover:text-gray-500 mr-3 h-5 w-5"></i>
                    <span class="flex-1">Services & Pricing</span>
                    <i data-feather="chevron-right" id="services-pricing-icon" class="ml-auto h-4 w-4 text-gray-400 group-hover:text-gray-500 transition-transform"></i>
                </div>
                <div id="services-pricing-menu" class="ml-8 space-y-1 hidden">
                    <a href="#" class="text-gray-600 hover:text-gray-900 block px-3 py-1 text-sm rounded-md">Service Catalog</a>
                    <a href="#" class="text-gray-600 hover:text-gray-900 block px-3 py-1 text-sm rounded-md">Categories</a>
                    <a href="#" class="text-gray-600 hover:text-gray-900 block px-3 py-1 text-sm rounded-md">Pricing Rules</a>
                </div>
            </div>

            <!-- Quote Templates -->
            <a href="#" class="text-gray-600 hover:bg-gray-50 hover:text-gray-900 group flex items-center px-2 py-2 text-sm font-medium rounded-md">
                <i data-feather="file-text" class="text-gray-400 group-hover:text-gray-500 mr-3 h-5 w-5"></i>
                Quote Templates
            </a>

            <!-- Reports -->
            <a href="#" class="text-gray-600 hover:bg-gray-50 hover:text-gray-900 group flex items-center px-2 py-2 text-sm font-medium rounded-md">
                <i data-feather="bar-chart-2" class="text-gray-400 group-hover:text-gray-500 mr-3 h-5 w-5"></i>
                Reports
            </a>
        </nav>

        <!-- Bottom Section -->
        <div class="flex-shrink-0 flex border-t border-gray-200 p-4">
            <div class="flex-shrink-0 w-full group block">
                <div class="flex items-center">
                    <div class="ml-3">
                        <p class="text-sm font-medium text-gray-700 group-hover:text-gray-900">
                            <%= current_user&.email || "Admin User" %>
                        </p>
                        <div class="flex items-center text-xs text-gray-500 group-hover:text-gray-700">
                            <%= link_to "Settings", "#", class: "hover:underline" %>
                            <span class="mx-2">•</span>
                            <%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete }, class: "hover:underline" %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function toggleSubmenu(menuId) {
    const menu = document.getElementById(menuId + '-menu');
    const icon = document.getElementById(menuId + '-icon');

    // Check if elements exist before trying to access them
    if (!menu || !icon) {
        console.warn('Menu or icon not found for:', menuId);
        return;
    }

    if (menu.classList.contains('hidden')) {
        menu.classList.remove('hidden');
        icon.style.transform = 'rotate(90deg)';
    } else {
        menu.classList.add('hidden');
        icon.style.transform = 'rotate(0deg)';
    }
}
</script>

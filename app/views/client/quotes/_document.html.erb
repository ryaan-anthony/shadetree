<%# locals: (quote:, totals: quote.totals, pdf: false, heading: 1) -%>
<%# The quote as a document: header, lines, totals, terms. Shared by the client page (QTE-03)
    and the PDF (QTE-02, ADR 0010), so the two never drift. Never shows internal notes.
    heading: the title's level; the client page and PDF own the page (1), the staff quote page
    shows it under its own H1 (2). %>
<% business = quote.business %>
<header class="quote-doc-head">
  <div class="min-w-0">
    <p class="quote-doc-kicker">Quote <%= quote.number %></p>
    <%= content_tag "h#{heading}", quote.title || "Quote for #{quote.client.display_name}", class: "quote-doc-title" %>
  </div>
  <dl class="quote-doc-meta">
    <div><dt>Prepared for</dt><dd><%= quote.client.display_name %><% if quote.client.company_name %><br><%= quote.client.company_name %><% end %></dd></div>
    <% if quote.property %><div><dt>Property</dt><dd><%= safe_join(quote.property.address_lines, tag.br) %></dd></div><% end %>
    <%# When it went out (QTE-04); a draft shows when it was prepared. %>
    <% if quote.sent_at %>
      <div><dt>Sent on</dt><dd><%= local_date(quote.sent_at.in_time_zone(business.time_zone).to_date) %></dd></div>
    <% else %>
      <div><dt>Prepared on</dt><dd><%= local_date(quote.created_at.in_time_zone(business.time_zone).to_date) %></dd></div>
    <% end %>
    <% if quote.expires_on %><div><dt>Valid until</dt><dd><%= local_date(quote.expires_on) %></dd></div><% end %>
    <%# The PDF's status comes from the status alone (so a stored file stays the same); the page also shows expiry. %>
    <div><dt>Status</dt><dd><%= pdf ? quote.state_label : quote.client_state_label %></dd></div>
  </dl>
</header>

<% if quote.message %>
  <p class="quote-doc-message"><%= quote.message %></p>
<% end %>

<%= render "client/documents/lines", document: quote, totals: %>

<% if quote.terms %>
  <section class="quote-doc-terms">
    <%= content_tag "h#{heading + 1}", "Terms" %>
    <p><%= quote.terms %></p>
  </section>
<% end %>

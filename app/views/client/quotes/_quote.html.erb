<%# locals: (document:, client_link: nil, preview: false) -%>
<%# A staff preview of a link still uses staff routes: the public ones refuse drafts and
    inactive links, and the preview mustn't act as the client. %>
<% client_link = nil if preview %>
<%# The client's quote page (QTE-03), rendered from a client link (PLT-12) or as the staff
    preview. Status first, then the document, attachments, and the action area where the client
    approves, declines or asks for changes (QTE-05). %>
<% quote = document %>
<% state = quote.client_state %>
<% totals = quote.totals %>
<% if state == :revising && !preview %>
  <%# QTE-06: a new revision is being prepared; its unfinished edits are never shown. %>
  <div class="client-card p-6 text-center sm:p-8" role="status">
    <span class="empty-icon"><%= icon "edit-3" %></span>
    <h1 class="text-lg font-bold text-ink"><%= @business.name %> is updating this quote</h1>
    <p class="mx-auto mt-2 max-w-sm text-sm text-subtle">Quote <%= quote.number %><%= ", #{quote.title}," if quote.title %> is being revised. You'll get the new version soon, at this same link.</p>
    <%= render "client_links/business_contact" %>
  </div>
<% else %>

<% if state == :approved %>
  <% approval = quote.approval %>
  <div class="banner banner-success mb-4" role="status"><%= icon "check-circle" %>
    <div class="flex-1">
      <p class="font-semibold"><%= approval&.signer_name ? "Thanks, #{approval.signer_name}. You're all set." : "This quote is approved." %></p>
      <p class="mt-1"><%= @business.quote_next_steps %></p>
      <% if approval %>
        <p class="mt-1 text-sm2">Approved <%= local_time(approval.created_at, zone: @business.time_zone) %><%= " by #{approval.signer_name}" if approval.signer_name %>.</p>
      <% end %>
    </div>
  </div>
<% elsif state == :declined %>
  <div class="banner banner-info mb-4" role="status"><%= icon "info" %><p>You declined this quote. Questions? Contact <%= @business.name %> below.</p></div>
<% elsif state == :changes_requested %>
  <div class="banner banner-info mb-4" role="status"><%= icon "message-square" %><p>You asked for changes. <%= @business.name %> will send an updated quote.</p></div>
<% elsif state == :expired %>
  <div class="banner banner-warning mb-4" role="status"><%= icon "clock" %>
    <div class="flex-1">
      <p>This quote expired on <%= local_date(quote.expires_on) %>, so it can't be approved as is.</p>
      <% if quote.update_requested_at %>
        <p class="mt-1 font-medium">You asked for an updated quote. <%= @business.name %> has been told.</p>
      <% elsif client_link %>
        <%= button_to "Ask for an updated quote", request_quote_update_path(client_link.token), class: "#{button_classes(:secondary, :sm)} mt-2" %>
      <% end %>
    </div>
  </div>
<% end %>

<article class="client-card quote-doc p-5 sm:p-8">
  <%= render "client/quotes/document", quote:, totals: %>
</article>

<% photos, files = quote.attachments_attachments.includes(:blob).select { _1.blob.persisted? }.partition(&:image?) %>
<%# Through the link (so revoking it cuts off the files); staff preview uses plain blob URLs. %>
<% file_url = ->(file, size = nil) { client_link ? client_quote_file_path(client_link.token, file, size:) : (size ? rails_representation_path(file.variant(:web)) : rails_blob_path(file, disposition: "inline")) } %>
<% if photos.any? || files.any? %>
  <section class="client-card mt-4 p-5 sm:p-6" aria-labelledby="attachments-h">
    <h2 id="attachments-h" class="text-sm font-semibold text-ink">Photos and files</h2>
    <% if photos.any? %>
      <ul class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
        <% photos.each do |photo| %>
          <li><%= link_to file_url.(photo), target: "_blank", rel: "noopener" do %>
            <%= image_tag file_url.(photo, "web"), alt: photo.filename.base.tr("_-", "  "), loading: "lazy", decoding: "async",
                          class: "aspect-[4/3] w-full rounded-lg border border-line object-cover" %>
          <% end %></li>
        <% end %>
      </ul>
    <% end %>
    <% if files.any? %>
      <ul class="mt-3 space-y-1.5">
        <% files.each do |file| %>
          <li><%= link_to file_url.(file), class: "flex items-center gap-2 text-sm font-medium text-ink hover:underline", target: "_blank", rel: "noopener" do %>
            <%= icon "file-text", class: "size-4 text-faint" %><%= file.filename %><% end %></li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>

<section class="client-card mt-4 p-5 text-center sm:p-6" id="quote-actions" aria-labelledby="actions-h">
  <h2 id="actions-h" class="text-base font-semibold text-ink">
    <% if state == :awaiting %>Total <span class="money"><%= money(totals.total) %></span>
    <% elsif state == :approved %>Approved
    <% elsif state == :expired %>This quote has expired
    <% else %>Questions about this quote?
    <% end %>
  </h2>
  <% if state == :awaiting && quote.expires_on %>
    <p class="mt-1 text-sm2 text-muted">Valid until <%= local_date(quote.expires_on) %></p>
  <% end %>
  <% if state == :awaiting %>
    <%= render "client/quotes/respond", quote:, totals:, client_link: %>
  <% end %>
  <p class="mt-3">
    <%= link_to (client_link ? client_quote_pdf_path(client_link.token) : pdf_admin_quote_path(quote)), class: "inline-flex items-center gap-1.5 text-sm2 font-medium text-ink underline-offset-2 hover:underline", data: { turbo: false } do %>
      <%= icon "download", class: "size-4" %> <%= state == :approved ? "Download approved PDF" : "Download PDF" %>
    <% end %>
  </p>
  <%= render "client_links/business_contact" %>
</section>
<% end %>

<%# locals: (title:, lede:, actions:) %>
<%# PLT-15: the one page header: an H1, one line under it, and the actions on the right (below on phones). %>
<div class="page-head">
  <div class="page-head-title break-words">
    <h1 class="page-title"><%= title %></h1>
    <% if lede %><p class="page-lede"><%= lede %></p><% end %>
  </div>
  <% if actions %><div class="page-head-actions"><%= actions %></div><% end %>
</div>

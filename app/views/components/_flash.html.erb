<%# locals: (messages:) %>
<%# flash[:undo] ({ "path", "params" }) puts an Undo button on the notice (JOB-03's calendar moves). %>
<%# Errors are role="alert" (announced as they appear); the rest are role="status". A Turbo visit
    swaps the whole body, and a live region that arrives with its text isn't read out, so each
    status toast also copies its text into #announcer, which stays on the page between visits. %>
<% undo = messages.delete("undo") %>
<div id="announcer" class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-turbo-permanent></div>
<div class="toast-stack" id="flash">
  <% messages.each do |key, message| %>
    <% tone = flash_tone(key) %>
    <% with_undo = undo.is_a?(Hash) && tone == :success %>
    <div class="toast <%= "toast-danger" if tone == :danger %>" role="<%= tone == :danger ? "alert" : "status" %>"
         data-controller="dismiss<%= " announce" unless tone == :danger %>" data-dismiss-after-value="<%= tone == :danger || with_undo ? 0 : 6000 %>">
      <%= icon tone %>
      <span data-announce-target="text"><%= message %></span>
      <% if with_undo %>
        <%= button_to "Undo", undo["path"], method: :patch, params: undo["params"], class: "font-semibold underline underline-offset-2", form: { class: "contents" } %>
      <% end %>
      <button type="button" data-action="dismiss#close" aria-label="Dismiss"><%= icon "x" %></button>
    </div>
  <% end %>
</div>

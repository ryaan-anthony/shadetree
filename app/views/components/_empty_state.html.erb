<%# locals: (title:, text:, icon:, actions:) %>
<div class="empty">
  <span class="empty-icon"><%= icon icon %></span>
  <h3 class="empty-title"><%= title %></h3>
  <% if text %><p class="empty-text"><%= text %></p><% end %>
  <% if actions %><div class="flex flex-wrap justify-center gap-2"><%= actions %></div><% end %>
</div>

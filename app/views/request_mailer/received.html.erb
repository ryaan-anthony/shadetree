<% if @intro %>
<%= render "client_mailer/intro", text: @intro %>
<% else %>
<p style="margin:0 0 12px;font-size:18px;font-weight:700;color:#0f172a;">Thanks for your request</p>
<p style="margin:0 0 16px;"><%= @business.name %> has it and will be in touch soon.</p>
<% end %>
<% if @request.service_names.any? || @request.timing %>
  <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="margin:0 0 16px;border:1px solid #e2e8f0;border-radius:8px;">
    <tr><td style="padding:14px 16px;font-size:14px;">
      <% if @request.service_names.any? %><p style="margin:0;"><span style="color:#64748b;">Services:</span> <%= @request.service_names.join(", ") %></p><% end %>
      <% if @request.timing %><p style="margin:4px 0 0;"><span style="color:#64748b;">Timing:</span> <%= @request.timing %></p><% end %>
    </td></tr>
  </table>
<% end %>
<p style="margin:0;font-size:13px;color:#64748b;">Didn't send a request? You can ignore this email.</p>

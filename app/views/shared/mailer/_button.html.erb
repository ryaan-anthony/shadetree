<%# locals: (label:, url:) %>
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:24px 0;">
  <tr>
    <td style="border-radius:8px;background:#047857;">
      <a href="<%= url %>" style="display:inline-block;padding:12px 20px;font-weight:600;font-size:15px;color:#ffffff;text-decoration:none;border-radius:8px;"><%= label %></a>
    </td>
  </tr>
</table>
<p style="font-size:13px;color:#64748b;">Or paste this link into your browser:<br><a href="<%= url %>" style="color:#047857;word-break:break-all;"><%= url %></a></p>

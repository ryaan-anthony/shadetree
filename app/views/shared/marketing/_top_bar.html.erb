<!-- Top Bar with Language and Login -->
<div class="bg-gray-100 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center py-2">
            <!-- Language Selection -->
            <div class="flex items-center space-x-2">
                <%= icon "globe", class: "h-4 w-4 text-gray-500" %>
                <select class="text-sm text-gray-600 bg-transparent border-none focus:ring-0 focus:outline-hidden cursor-pointer">
                    <option value="en">English</option>
                    <option value="es">Español</option>
                </select>
            </div>

            <!-- Login Button -->
            <div>
                <%= link_to new_user_session_path, class: "text-sm text-gray-600 hover:text-enterprise-navy font-medium flex items-center" do %>
                    <%= icon "log-in", class: "h-4 w-4 mr-1" %>
                    Login
                <% end %>
            </div>
        </div>
    </div>
</div>

<%# MKT-01: one navigation for the public site. On small screens the links fold into a menu (no script needed). %>
<% links = [ [ "How it works", root_path(anchor: "how-it-works") ], [ "Features", features_path ], [ "Pricing", pricing_path ], [ "About", about_path ] ] %>
<header class="sticky top-0 z-40 border-b border-line bg-surface/95 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-6xl items-center gap-8 px-5 sm:px-8" aria-label="Main">
    <%= brand_logo(href: root_path, "aria-label": "Shadetree home") %>
    <ul class="hidden items-center gap-7 md:flex">
      <% links.each do |label, path| %>
        <li><%= link_to label, path, class: "text-sm font-medium #{current_page?(path) ? "text-ink" : "text-subtle hover:text-ink"}", "aria-current": ("page" if current_page?(path)) %></li>
      <% end %>
    </ul>
    <div class="ml-auto flex items-center gap-3">
      <%= link_to "Sign in", new_user_session_path, class: "hidden text-sm font-medium text-subtle hover:text-ink sm:inline" %>
      <%= link_to "Start free", new_user_registration_path, class: button_classes(:primary) %>
      <details class="relative md:hidden">
        <summary class="<%= button_classes(:tertiary, :icon) %> list-none" aria-label="Menu"><%= icon "menu" %></summary>
        <ul class="absolute right-0 top-full mt-2 w-56 rounded-card border border-line bg-surface p-2 shadow-pop">
          <% (links + [ [ "Sign in", new_user_session_path ] ]).each do |label, path| %>
            <li><%= link_to label, path, class: "block rounded-control px-3 py-2.5 text-[0.9375rem] font-medium text-ink hover:bg-sunken" %></li>
          <% end %>
        </ul>
      </details>
    </div>
  </nav>
</header>

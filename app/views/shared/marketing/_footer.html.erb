<%# MKT-01: the public footer. Legal pages are MKT-03's. %>
<footer class="bg-side text-side-text">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr]">
      <div>
        <%= link_to root_path, class: "logo logo-light" do %><span class="logo-mark"><%= logo_mark %></span><span>Shadetree</span><% end %>
        <p class="mt-4 max-w-xs text-sm">Quotes, scheduling and payments for small service businesses.</p>
      </div>
      <% { "Product" => [ [ "How it works", root_path(anchor: "how-it-works") ], [ "Features", root_path(anchor: "features") ], [ "Pricing", pricing_path ], [ "Sign in", new_user_session_path ] ],
           "Company" => [ [ "About", about_path ], [ "Contact", contact_path ] ],
           "Legal" => [ [ "Terms", terms_path ], [ "Privacy", privacy_path ] ] }.each do |heading, items| %>
        <div>
          <h2 class="text-sm font-semibold text-white"><%= heading %></h2>
          <ul class="mt-4 space-y-3 text-sm" <%= "id=legal-links" if heading == "Legal" %>>
            <% items.each do |label, path| %><li><%= link_to label, path, class: "hover:text-white" %></li><% end %>
          </ul>
        </div>
      <% end %>
    </div>
    <div class="mt-12 flex flex-col gap-2 border-t border-side-line pt-6 text-sm2 sm:flex-row sm:justify-between">
      <p>© <%= Date.current.year %> Shadetree</p>
      <p>Made for the people who keep neighborhoods running.</p>
    </div>
  </div>
</footer>

<!-- Footer -->
<footer class="bg-gray-900 text-white py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Company Info -->
      <div class="lg:col-span-2">
        <div class="text-2xl font-bold mb-4">
          <span class="text-shadetree-green">Shade</span><span class="text-white">tree</span>
        </div>
        <p class="text-gray-400 text-sm mb-6 max-w-md">
          The complete service business management platform. Streamline your workflow from quote to payment across multiple locations.
        </p>
        <div class="flex space-x-4">
          <div class="bg-gray-800 p-2 rounded">
            <i data-feather="file-text" class="w-4 h-4 text-shadetree-blue"></i>
          </div>
          <div class="bg-gray-800 p-2 rounded">
            <i data-feather="calendar" class="w-4 h-4 text-shadetree-green"></i>
          </div>
          <div class="bg-gray-800 p-2 rounded">
            <i data-feather="credit-card" class="w-4 h-4 text-shadetree-yellow"></i>
          </div>
        </div>
      </div>

      <!-- Solutions -->
      <div>
        <h4 class="text-sm font-semibold text-white mb-4">Solutions</h4>
        <ul class="space-y-3 text-sm text-gray-400">
          <li><%= link_to "Quote Management", "#", class: "hover:text-white" %></li>
          <li><%= link_to "Appointment Scheduling", "#", class: "hover:text-white" %></li>
          <li><%= link_to "Payment Processing", "#", class: "hover:text-white" %></li>
          <li><%= link_to "Team Management", "#", class: "hover:text-white" %></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="text-sm font-semibold text-white mb-4">Company</h4>
        <ul class="space-y-3 text-sm text-gray-400">
          <li><%= link_to "About", "#", class: "hover:text-white" %></li>
          <li><%= link_to "Contact", "#", class: "hover:text-white" %></li>
          <li><%= link_to "Careers", "#", class: "hover:text-white" %></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 mt-12 pt-8">
      <div class="text-center">
        <div class="text-gray-400 text-sm">
          &copy; <%= Date.current.year %> Shadetree. All rights reserved.
        </div>
      </div>
    </div>
  </div>
</footer>

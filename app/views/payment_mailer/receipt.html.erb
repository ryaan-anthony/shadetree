<% if @intro %>
<%= render "client_mailer/intro", text: @intro %>
<% else %>
<p style="margin:0 0 16px;">Thank you. We've received your payment.</p>
<% end %>
<table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="margin:0 0 20px;border:1px solid #e2e8f0;border-radius:8px;">
  <tr><td style="padding:14px 16px;">
    <p style="margin:0;font-size:13px;color:#64748b;">Invoice <%= @invoice.number %><%= " · #{@invoice.title}" if @invoice.title %></p>
    <p style="margin:6px 0 0;font-size:22px;font-weight:700;color:#0f172a;"><%= money(@payment.amount) %></p>
    <p style="margin:4px 0 0;font-size:13px;color:#64748b;"><%= @payment.method_label %><%= " #{@payment.reference}" if @payment.reference %>, received <%= local_date(@payment.received_on) %></p>
    <p style="margin:10px 0 0;font-size:14px;font-weight:600;color:#0f172a;">
      <%= @balance.zero? ? "Paid in full" : "#{money(@balance)} left to pay" %>
    </p>
  </td></tr>
</table>
<table role="presentation" cellpadding="0" cellspacing="0"><tr><td style="border-radius:8px;background:<%= @branding.color %>;">
  <a href="<%= client_link_url(@link.token) %>" style="display:inline-block;padding:12px 20px;font-weight:600;font-size:15px;color:<%= @branding.ink %>;text-decoration:none;">View invoice</a>
</td></tr></table>

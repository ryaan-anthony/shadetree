<% content_for :title, "About Us" %>

<!-- Hero Section -->
<section class="bg-linear-to-b from-slate-50 to-white py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="mb-8">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-shadetree-green">
                <%= icon "heart", class: "mr-2 h-4 w-4" %>
                Built by small business owners, for small business owners
            </span>
        </div>

        <h1 class="text-4xl lg:text-5xl font-bold text-enterprise-navy mb-6 leading-tight">
            We're on a mission to simplify
            <span class="text-shadetree-blue">service business operations</span>
        </h1>

        <p class="text-xl text-enterprise-gray mb-12 max-w-3xl mx-auto">
            Shadetree was born from the frustration of managing a growing service business with disconnected tools,
            endless paperwork, and missed opportunities. We believe running a service business should be simple,
            profitable, and stress-free.
        </p>
    </div>
</section>

<!-- Our Story Section -->
<section class="pb-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div>
                <h2 class="text-3xl font-bold text-enterprise-navy mb-6">
                    From chaos to clarity
                </h2>
                <div class="space-y-6 text-enterprise-gray">
                    <p>
                        It started with a simple problem: our founder was running a landscaping business and spending
                        more time managing quotes, schedules, and payments than actually serving customers. Sound familiar?
                    </p>
                    <p>
                        After trying many complex, expensive tools that promised everything but delivered confusion,
                        we decided to build something different. Something designed specifically for service businesses
                        that need to quote it, book it, and get paid—without the headaches.
                    </p>
                </div>
            </div>
            <div class="relative">
                <img src="<%= asset_path('about-hero.png') %>" alt="Shadetree Team" class="w-full h-auto rounded-lg shadow-lg" />
            </div>
        </div>
    </div>
</section>

<!-- Our Values Section -->
<section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
            <h2 class="text-3xl font-bold text-enterprise-navy mb-4">
                What drives us every day
            </h2>
            <p class="text-xl text-enterprise-gray max-w-3xl mx-auto">
                Our values aren't just words on a wall—they guide every decision we make and every feature we build.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Simplicity -->
            <div class="bg-white rounded-lg p-8 shadow-lg border border-gray-200 text-center">
                <div class="mb-6">
                    <div class="mx-auto h-16 w-16 bg-shadetree-blue rounded-full flex items-center justify-center">
                        <%= icon "minimize", class: "h-8 w-8 text-white" %>
                    </div>
                </div>
                <h3 class="text-xl font-bold text-enterprise-navy mb-4">Simplicity First</h3>
                <p class="text-enterprise-gray">
                  We designed every part of this platform with you in mind—clear, intuitive, and focused on what actually helps you get the job done.
                </p>
            </div>

            <!-- Reliability -->
            <div class="bg-white rounded-lg p-8 shadow-lg border border-gray-200 text-center">
                <div class="mb-6">
                    <div class="mx-auto h-16 w-16 bg-shadetree-green rounded-full flex items-center justify-center">
                        <%= icon "bar-chart", class: "h-8 w-8 text-white" %>
                    </div>
                </div>
                <h3 class="text-xl font-bold text-enterprise-navy mb-4">Rock-Solid Reliability</h3>
                <p class="text-enterprise-gray">
                    Your business depends on our platform, so we've built it to be bulletproof. 99.9% uptime,
                    enterprise-grade security, and backups that actually work.
                </p>
            </div>

            <!-- Customer Success -->
            <div class="bg-white rounded-lg p-8 shadow-lg border border-gray-200 text-center">
                <div class="mb-6">
                    <div class="mx-auto h-16 w-16 bg-shadetree-purple rounded-full flex items-center justify-center">
                        <%= icon "users", class: "h-8 w-8 text-white" %>
                    </div>
                </div>
                <h3 class="text-xl font-bold text-enterprise-navy mb-4">Your Success is Our Success</h3>
                <p class="text-enterprise-gray">
                    We don't just sell software—we partner with you to grow your business. Our support team consists
                    of real people who understand service businesses.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Team Section -->
<section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
            <h2 class="text-3xl font-bold text-enterprise-navy mb-4">
                Meet the team behind <span class="text-shadetree-green">Shade</span>tree
            </h2>
            <p class="text-xl text-enterprise-gray max-w-3xl mx-auto">
                We're a passionate group of entrepreneurs, developers, and service industry veterans
                working to make your business life easier.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Team Member 1 -->
            <div class="text-center">
                <div class="mb-4">
                    <div class="mx-auto h-24 w-24 bg-linear-to-br from-shadetree-blue to-shadetree-green rounded-full flex items-center justify-center">
                        <%= icon "user", class: "h-12 w-12 text-white" %>
                    </div>
                </div>
                <h3 class="text-lg font-bold text-enterprise-navy">Dave</h3>
                <p class="text-shadetree-blue font-medium mb-2">Founder</p>
                <p class="text-sm text-enterprise-gray">
                    Former landscaping business owner who built Shadetree to solve his own operational nightmares.
                </p>
            </div>

            <!-- Team Member 2 -->
            <div class="text-center">
                <div class="mb-4">
                    <div class="mx-auto h-24 w-24 bg-linear-to-br from-shadetree-green to-shadetree-blue rounded-full flex items-center justify-center">
                        <%= icon "code", class: "h-12 w-12 text-white" %>
                    </div>
                </div>
                <h3 class="text-lg font-bold text-enterprise-navy">Raj</h3>
                <p class="text-shadetree-blue font-medium mb-2">Head of Engineering</p>
                <p class="text-sm text-enterprise-gray">
                  With 15+ years of experience in e-commerce and cybersecurity, I’ve helped businesses of all sizes—from local shops to global brands—grow and operate more securely.
                </p>
            </div>

            <!-- Team Member 3 -->
            <div class="text-center">
                <div class="mb-4">
                    <div class="mx-auto h-24 w-24 bg-linear-to-br from-shadetree-purple to-shadetree-green rounded-full flex items-center justify-center">
                        <%= icon "heart", class: "h-12 w-12 text-white" %>
                    </div>
                </div>
                <h3 class="text-lg font-bold text-enterprise-navy">Sarah</h3>
                <p class="text-shadetree-blue font-medium mb-2">Head of Customer Success</p>
                <p class="text-sm text-enterprise-gray">
                    Dedicated to ensuring every Shadetree customer achieves their business goals.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-20 bg-enterprise-navy">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-white mb-6">
            Ready to simplify your service business?
        </h2>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <%= link_to new_user_registration_path, class: "bg-shadetree-green text-white px-8 py-4 text-lg font-medium rounded-md hover:bg-green-700 shadow-lg" do %>
                Start Free Trial
            <% end %>
            <%= link_to contact_path, class: "border-2 border-white text-white px-8 py-4 text-lg font-medium rounded-md hover:bg-white hover:text-enterprise-navy" do %>
                Talk to Our Team
            <% end %>
        </div>

        <p class="text-blue-200 text-sm mt-6">
            No credit card required • 14-day free trial • Cancel anytime
        </p>
    </div>
</section>

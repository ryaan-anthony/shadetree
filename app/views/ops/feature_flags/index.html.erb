<%# OPS-04: release flags (PLT-11), declared in config/feature_flags.yml. %>
<% content_for :title, "Release flags" %>
<%= page_header "Release flags", lede: "Turn unfinished work on for some businesses, a share of them, or everyone. Changes take up to 30 seconds to reach every server." %>
<% if @flags.empty? %>
  <%= card(class: "mt-4") { empty_state(title: "No flags declared", text: "Flags are declared in config/feature_flags.yml.", icon: "flag") } %>
<% end %>
<div class="mt-4 space-y-4" id="flags">
  <% @flags.each do |definition, flag| %>
    <%= card title: definition.name, subtitle: definition.description, id: "flag-#{definition.name}" do %>
      <p class="text-sm2 text-muted">Now: <strong class="text-ink"><%= { "off" => "Off", "on" => "On for everyone", "percentage" => "#{flag.percentage}% of businesses", "businesses" => "#{pluralize(flag.business_ids.size, "business")}" }.fetch(flag.state) %></strong>
        <%= " · changed by #{flag.changed_by}" if flag.changed_by %><%= " · owner #{definition.owner}" if definition.owner %><%= " · remove by #{definition.remove_by}" if definition.remove_by %></p>
      <%= form_with url: ops_feature_flag_path(definition.name), method: :patch, class: "mt-3 grid gap-3 sm:grid-cols-4 sm:items-end", data: { turbo_confirm: "Change #{definition.name}?" } do %>
        <div class="field"><label class="label" for="<%= definition.name %>_state">Setting</label>
          <%= select_tag :state, options_for_select([ [ "Off", "off" ], [ "On for everyone", "on" ], [ "A percentage", "percentage" ], [ "Some businesses", "businesses" ] ], flag.state), class: "select", id: "#{definition.name}_state" %></div>
        <div class="field"><label class="label" for="<%= definition.name %>_percentage">Percentage</label><%= number_field_tag :percentage, flag.percentage, min: 0, max: 100, class: "input", id: "#{definition.name}_percentage" %></div>
        <div class="field"><label class="label" for="<%= definition.name %>_businesses">Business IDs</label><%= text_field_tag :businesses, Business.where(id: flag.business_ids).pluck(:uid).join(", "), class: "input", id: "#{definition.name}_businesses" %></div>
        <%= submit_tag "Save", class: button_classes(:secondary), name: nil %>
      <% end %>
    <% end %>
  <% end %>
</div>

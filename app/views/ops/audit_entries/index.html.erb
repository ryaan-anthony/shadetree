<% content_for :title, "Audit log" %>
<h1 class="page-title">Audit log</h1>
<p class="page-lede">Every operator action, newest first. Entries can't be changed or deleted.</p>
<%= form_with url: ops_audit_entries_path, method: :get, class: "mt-4 grid gap-3 sm:grid-cols-5 sm:items-end" do %>
  <div class="field"><label class="label" for="operator">Operator</label><%= select_tag :operator, options_for_select(@operators, params[:operator]), include_blank: "Anyone", class: "select", id: "operator" %></div>
  <div class="field"><label class="label" for="action_name">Action</label><%= select_tag :action_name, options_for_select(@actions.map { [ AuditEntry::ACTIONS.fetch(_1, _1), _1 ] }, params[:action_name]), include_blank: "Any", class: "select", id: "action_name" %></div>
  <div class="field"><label class="label" for="business">Business ID</label><%= text_field_tag :business, params[:business], class: "input", id: "business", placeholder: "uid" %></div>
  <div class="field"><label class="label" for="from">From</label><%= date_field_tag :from, params[:from], class: "input", id: "from" %></div>
  <div class="field"><label class="label" for="to">To</label><%= date_field_tag :to, params[:to], class: "input", id: "to" %></div>
  <div class="sm:col-span-5 flex gap-2"><%= submit_tag "Filter", class: button_classes(:secondary), name: nil %><%= link_to "Clear", ops_audit_entries_path, class: button_classes(:ghost) %></div>
<% end %>
<%= card flush: true, class: "mt-4" do %>
  <% if @entries.any? %>
    <ul class="list" id="audit-entries"><%= render partial: "entry", collection: @entries, as: :entry %></ul>
  <% else %>
    <p class="px-5 py-4 text-sm text-muted">No entries match.</p>
  <% end %>
<% end %>
<div class="mt-3 flex gap-2">
  <% if @page > 1 %><%= link_to "Newer", ops_audit_entries_path(request.query_parameters.merge(page: @page - 1)), class: button_classes(:ghost, :sm) %><% end %>
  <% if @more %><%= link_to "Older", ops_audit_entries_path(request.query_parameters.merge(page: @page + 1)), class: button_classes(:ghost, :sm) %><% end %>
</div>

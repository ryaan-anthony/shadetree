<%# locals: (note:) -%>
<li class="items-start text-sm" id="note-<%= note.id %>">
  <div class="min-w-0 flex-1">
    <p class="whitespace-pre-line break-words text-ink"><%= note.body %></p>
    <p class="mt-1 break-words text-sm2 text-muted"><%= note.author.nil? || note.author.deleted? ? "A former operator" : note.author.email %> · <%= local_time(note.created_at) %><%= " · edited" if note.updated_at > note.created_at + 1.second %></p>
  </div>
  <% if note.written_by?(current_user) %>
    <div class="flex shrink-0 gap-1">
      <%= link_to "Edit", edit_ops_business_note_path(note.business, note), class: button_classes(:tertiary, :sm) %>
      <%= button_to "Delete", ops_business_note_path(note.business, note), method: :delete, class: button_classes(:destructive, :sm),
                    form: { data: { turbo_confirm: "Delete this note?", turbo_confirm_button: "Delete" } } %>
    </div>
  <% end %>
</li>

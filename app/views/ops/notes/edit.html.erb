<% content_for :title, "Edit note" %>
<%= page_header "Edit note" do %>
  <%= link_to ops_business_path(@business, anchor: "notes"), class: button_classes(:tertiary) do %><%= icon "arrow-left" %> <%= @business.name %><% end %>
<% end %>
<%= card class: "mt-4 form-split" do %>
  <%= form_with model: @note, url: ops_business_note_path(@business, @note), method: :patch do |f| %>
    <%= f.field :body, as: :textarea, label: "Note", rows: 5, maxlength: 5000 %>
    <div class="mt-3 flex gap-2"><%= f.submit_button "Save note" %><%= link_to "Cancel", ops_business_path(@business, anchor: "notes"), class: button_classes(:tertiary) %></div>
  <% end %>
<% end %>

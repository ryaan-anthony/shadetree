<%# OPS-04 / BIL-05: comp a plan, change the trial, apply a Stripe coupon. Each needs a reason. %>
<%= card title: "Plan, trial and coupon", subtitle: "Each needs a reason and a recent code, and is audited.", id: "billing-actions" do %>
  <dl class="mb-4 space-y-1 text-sm">
    <div class="flex justify-between gap-3"><dt class="text-subtle">Billing status</dt><dd class="text-ink" id="billing-status"><%= business.billing_status.humanize %></dd></div>
    <div class="flex justify-between gap-3"><dt class="text-subtle">Comp</dt><dd class="text-right text-ink" id="comp"><%= business.comp_plan ? "#{business.comp_plan.name}, #{business.comp_ends_at ? "until #{local_date(business.comp_ends_at)}" : "no end date"}" : "None" %></dd></div>
    <div class="flex justify-between gap-3"><dt class="text-subtle">Trial</dt><dd class="text-right text-ink" id="trial"><%= business.trial_ends_at ? "#{business.trial_plan&.name}, #{business.trial_ends_at.future? ? "ends" : "ended"} #{local_date(business.trial_ends_at)}" : "None" %></dd></div>
  </dl>
  <% if subscription&.live? %>
    <p class="border-t border-line pt-4 text-sm2 text-subtle" id="comp-refused">No comp while there's a live Stripe subscription: the plan follows what Stripe charges. To give the plan away, apply a 100%-off coupon below, or cancel the subscription in Stripe.</p>
  <% else %>
    <%= form_with url: ops_business_billing_comp_path(business), class: "space-y-2 border-t border-line pt-4", data: { turbo_confirm: "Comp #{business.name}? Stripe billing isn't changed." } do %>
      <div class="grid gap-2 sm:grid-cols-2">
        <div class="field"><label class="label" for="comp_plan">Comp a plan</label><%= select_tag :plan, options_for_select(Plan.order(:position).reject(&:free?).map { [ _1.name, _1.key ] }, business.comp_plan&.key), class: "select", id: "comp_plan", required: true %></div>
        <div class="field"><label class="label" for="comp_ends_on">Until (optional)</label><%= date_field_tag :ends_on, business.comp_ends_at&.to_date, class: "input", id: "comp_ends_on" %></div>
      </div>
      <div class="field"><label class="label" for="comp_reason">Reason</label><%= text_field_tag :reason, nil, class: "input", id: "comp_reason", required: true, maxlength: 500, placeholder: "e.g. Beta user, comped for a year" %></div>
      <%= submit_tag "Save comp", class: button_classes(:secondary, :sm), name: nil %>
    <% end %>
  <% end %>
  <% if business.comp_plan %>
    <%= form_with url: ops_business_billing_comp_path(business), class: "mt-3 flex flex-wrap items-end gap-2", data: { turbo_confirm: "Remove #{business.name}'s comp?", turbo_confirm_variant: "destructive" } do %>
      <%= hidden_field_tag :remove_comp, "1", id: nil %>
      <div class="field min-w-0 flex-1"><label class="label" for="uncomp_reason">Reason for removing the comp</label><%= text_field_tag :reason, nil, class: "input", id: "uncomp_reason", required: true, maxlength: 500 %></div>
      <%= submit_tag "Remove comp", class: button_classes(:secondary, :sm), name: nil %>
    <% end %>
  <% end %>
  <%= form_with url: ops_business_billing_trial_path(business), class: "mt-4 space-y-2 border-t border-line pt-4", data: { turbo_confirm: "Change #{business.name}'s trial?" } do %>
    <div class="field"><label class="label" for="trial_ends_on">Trial ends on</label><%= date_field_tag :ends_on, business.trial_ends_at&.to_date, class: "input", id: "trial_ends_on", required: true %></div>
    <div class="field"><label class="label" for="trial_reason">Reason</label><%= text_field_tag :reason, nil, class: "input", id: "trial_reason", required: true, maxlength: 500, placeholder: "e.g. Asked for another week to try automations" %></div>
    <%= submit_tag "Save trial", class: button_classes(:secondary, :sm), name: nil %>
  <% end %>
  <% if subscription&.live? %>
    <%= form_with url: ops_business_billing_coupon_path(business), class: "mt-4 space-y-2 border-t border-line pt-4", data: { turbo_confirm: "Apply this coupon to #{business.name}'s Stripe subscription? It replaces any discount it has." } do %>
      <div class="field"><label class="label" for="coupon">Stripe coupon or promotion code id</label><%= text_field_tag :coupon, nil, class: "input", id: "coupon", required: true, maxlength: 100, autocomplete: "off" %></div>
      <div class="field"><label class="label" for="coupon_reason">Reason</label><%= text_field_tag :reason, nil, class: "input", id: "coupon_reason", required: true, maxlength: 500 %></div>
      <%= submit_tag "Apply coupon", class: button_classes(:secondary, :sm), name: nil %>
    <% end %>
  <% else %>
    <p class="mt-4 border-t border-line pt-4 text-sm2 text-muted">Coupons apply to a subscription; this business has none.</p>
  <% end %>
<% end %>

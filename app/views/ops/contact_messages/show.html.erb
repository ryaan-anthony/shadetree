<% content_for :title, "Message from #{@message.name}" %>
<p><%= link_to "← Contact messages", ops_contact_messages_path(tab: @message.spam? ? "spam" : (@message.handled_at ? "handled" : "open")), class: "text-sm2 text-muted hover:underline" %></p>
<h1 class="page-title mt-2 break-words">Message from <%= @message.name %></h1>
<div class="mt-6 grid items-start gap-4 lg:grid-cols-[minmax(0,1fr)_20rem]">
  <%= card do %>
    <div class="mb-3 flex flex-wrap gap-2" id="message-status">
      <% if @message.spam? %>
        <%= badge "Spam: #{@message.spam_reason}", tone: :warning %>
      <% elsif @message.handled_at %>
        <%= badge "Handled", tone: :success %>
      <% else %>
        <%= badge "Open", tone: :info %>
      <% end %>
    </div>
    <dl class="grid gap-x-6 gap-y-3 text-sm sm:grid-cols-[8rem_1fr]">
      <% [ [ "Email", mail_to(@message.email, class: "break-all hover:underline") ],
           [ "Business", @message.business_name ],
           [ "Industry", (@message.industry_name if @message.industry) ],
           [ "Received", local_time(@message.created_at) ],
           [ "Handled", local_time(@message.handled_at) ] ].each do |label, value| %>
        <% next if value.blank? %>
        <dt class="text-muted"><%= label %></dt><dd class="min-w-0 text-ink"><%= value %></dd>
      <% end %>
    </dl>
    <h2 class="mt-5 text-sm font-semibold text-ink">Message</h2>
    <div class="mt-2 break-words text-sm text-body" id="message-body"><%= simple_format(h(@message.body), {}, sanitize: false) %></div>
  <% end %>
  <div class="space-y-4">
    <%= card title: "Actions" do %>
      <div class="grid gap-2">
        <%= mail_to @message.email, "Reply by email", class: "#{button_classes} w-full" unless @message.spam? %>
        <%= button_to @message.handled_at ? "Mark open again" : "Mark handled", ops_contact_message_path(@message), method: :patch,
                      params: { handled: @message.handled_at ? "0" : "1" }, class: "#{button_classes(:secondary)} w-full" %>
        <%= button_to "Delete message", ops_contact_message_path(@message), method: :delete, class: "#{button_classes(:danger)} w-full",
                      form: { data: { turbo_confirm: "Delete this message? This can't be undone.", turbo_confirm_button: "Delete" } } %>
      </div>
    <% end %>
    <%= card title: "Asked to be forgotten?" do %>
      <p class="text-sm text-subtle">Delete every message from <span class="break-words"><%= @message.email %></span> (<%= pluralize(@from_sender, "message") %>). The audit log records how many, not who.</p>
      <%= button_to "Delete everything from this address", erase_ops_contact_message_path(@message), method: :delete, class: "#{button_classes(:danger)} mt-3 w-full", id: "erase-sender",
                    form: { data: { turbo_confirm: "Delete all #{pluralize(@from_sender, "message")} from #{@message.email}? This can't be undone.", turbo_confirm_button: "Delete all" } } %>
    <% end %>
  </div>
</div>

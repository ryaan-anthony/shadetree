<% content_for :title, "Contact messages" %>
<%= page_header "Contact messages", lede: "What people send through the website's contact form, newest first. Spam is kept 30 days for checking; nobody was emailed about it." %>
<nav class="tabs mt-4" aria-label="Show messages">
  <% Ops::ContactMessagesController::TABS.each do |tab, label| %>
    <%= link_to ops_contact_messages_path(tab:), class: "tab", "aria-current": ("page" if tab == @tab) do %>
      <%= label %> <span class="tabular text-sm2 font-normal text-muted"><%= @counts[tab] %></span>
    <% end %>
  <% end %>
</nav>
<%= card flush: true, class: "mt-4" do %>
  <% if @messages.any? %>
    <ul class="list" id="contact-messages">
      <% @messages.each do |message| %>
        <li id="contact-message-<%= message.uid %>">
          <%= link_to ops_contact_message_path(message), class: "block min-w-0 flex-1 hover:text-ink" do %>
            <p class="break-words font-medium text-ink"><%= message.name %><span class="font-normal text-muted"> · <%= message.email %></span></p>
            <p class="truncate text-sm2 text-subtle"><%= message.body.squish.truncate(140) %></p>
            <p class="text-sm2 text-muted"><%= local_time(message.created_at) %><%= " · #{message.business_name}" if message.business_name %></p>
          <% end %>
          <% if message.spam? %><%= badge message.spam_reason.capitalize, tone: :warning %><% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="px-5 py-4 text-sm text-muted"><%= { "open" => "No open messages. You're all caught up.", "handled" => "No handled messages yet.", "spam" => "No spam." }.fetch(@tab) %></p>
  <% end %>
<% end %>
<div class="mt-3 flex gap-2">
  <% if @page > 1 %><%= link_to "Newer", ops_contact_messages_path(tab: @tab, page: @page - 1), class: button_classes(:tertiary, :sm) %><% end %>
  <% if @more %><%= link_to "Older", ops_contact_messages_path(tab: @tab, page: @page + 1), class: button_classes(:tertiary, :sm) %><% end %>
</div>

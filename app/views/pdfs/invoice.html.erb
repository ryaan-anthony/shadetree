<%# The invoice PDF (PAY-02, QTE-02's approach): the business's letterhead, then the same
    document the client page shows (client/invoices/_document). %>
<% content_for :title, "Invoice #{@invoice.number}" %>
<%= render "pdfs/letterhead", business: @business %>

<article class="quote-doc">
  <%= render "client/invoices/document", invoice: @invoice, pdf: true %>
</article>

<% if @invoice.outstanding? %>
  <p class="pdf-online">To see this invoice online, open it from the email <%= @business.name %> sent you.</p>
<% end %>

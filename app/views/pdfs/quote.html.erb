<%# The quote PDF (QTE-02): the business's letterhead, then the same document the client page
    shows (client/quotes/_document), so the two never drift. %>
<% content_for :title, "Quote #{@quote.number}" %>
<% branding = Branding.new(@business) %>
<header class="pdf-letterhead">
  <div class="min-w-0">
    <% if branding.logo? %>
      <img src="<%= PdfDocument.data_url(branding.logo(:pdf)) %>" alt="<%= branding.name %>" class="pdf-logo">
    <% else %>
      <p class="pdf-business-name"><%= branding.name %></p>
    <% end %>
  </div>
  <address class="pdf-contact">
    <% if branding.logo? %><span class="font-semibold text-ink"><%= branding.name %></span><br><% end %>
    <% @business.address_lines.each do |line| %><%= line %><br><% end %>
    <%= safe_join([ @business.phone, @business.email ].compact_blank, tag.br) %>
  </address>
</header>

<article class="quote-doc">
  <%= render "client/quotes/document", quote: @quote, pdf: true %>
</article>

<%# QTE-05: who approved and when; from the approval record, so the file shows it as signed. %>
<% if @quote.approved? && (approval = @quote.approval) %>
  <section class="pdf-approval">
    <p class="pdf-approval-title">Approved</p>
    <p>Signed by <strong><%= approval.signer_name %></strong> on <%= l(approval.created_at.in_time_zone(@business.time_zone), format: :long) %><%= ", recorded by #{approval.recorded_by.full_name}" if approval.recorded_by %>.</p>
  </section>
<% end %>

<% if @quote.status == "sent" %>
  <p class="pdf-online">To approve this quote or ask a question, open it from the email <%= @business.name %> sent you.</p>
<% end %>


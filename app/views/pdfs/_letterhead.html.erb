<%# locals: (business:, contact: business) -%>
<%# The business's letterhead at the top of a PDF (quotes QTE-02, invoices PAY-02). %>
<% branding = Branding.new(business) %>
<header class="pdf-letterhead">
  <div class="min-w-0">
    <% if branding.logo? %>
      <img src="<%= PdfDocument.data_url(branding.logo(:pdf)) %>" alt="<%= branding.name %>" class="pdf-logo">
    <% else %>
      <p class="pdf-business-name"><%= branding.name %></p>
    <% end %>
  </div>
  <address class="pdf-contact">
    <% if branding.logo? %><span class="font-semibold text-ink"><%= branding.name %></span><br><% end %>
    <% if contact.contact_label %><span class="font-medium text-ink"><%= contact.contact_label %></span><br><% end %><%# CAT-07 %>
    <% contact.address_lines.each do |line| %><%= line %><br><% end %>
    <%= safe_join([ phone_number(contact.contact_phone, business:), contact.contact_email ].compact_blank, tag.br) %>
  </address>
</header>

<% content_for :title, "Sign In to Your Account" %>

<!-- Login Section -->
<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">

        <!-- Header -->
        <div class="text-center">
            <div class="mx-auto h-16 w-16 bg-shadetree-green rounded-full flex items-center justify-center mb-6">
                <i data-feather="log-in" class="h-8 w-8 text-white"></i>
            </div>
            <h2 class="text-3xl font-bold text-enterprise-navy">
                Welcome back
            </h2>
            <p class="mt-2 text-sm text-enterprise-gray">
                Sign in to your Shadetree account to manage your service business
            </p>
        </div>

        <!-- Login Form -->
        <div class="bg-white py-8 px-6 shadow-lg rounded-lg border border-gray-200">
            <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |form| %>

                <!-- Email Field -->
                <div>
                    <%= form.label :email, "Email address", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i data-feather="mail" class="h-5 w-5 text-gray-400"></i>
                        </div>
                        <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true,
                            class: "border pl-10 shadow-sm focus:ring-shadetree-blue focus:border-shadetree-blue block w-full sm:text-sm border-gray-300 rounded-md py-3",
                            placeholder: "Enter your email address" %>
                    </div>
                </div>

                <!-- Password Field -->
                <div>
                    <%= form.label :password, "Password", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i data-feather="lock" class="h-5 w-5 text-gray-400"></i>
                        </div>
                        <%= form.password_field :password, autocomplete: "current-password", required: true,
                            class: "border pl-10 shadow-sm focus:ring-shadetree-blue focus:border-shadetree-blue block w-full sm:text-sm border-gray-300 rounded-md py-3",
                            placeholder: "Enter your password" %>
                    </div>
                </div>

                <!-- Remember Me & Forgot Password -->
                <div class="flex items-center justify-between">
                    <% if devise_mapping.rememberable? %>
                        <div class="flex items-center">
                            <%= form.check_box :remember_me, class: "h-4 w-4 text-shadetree-blue focus:ring-shadetree-blue border-gray-300 rounded" %>
                            <%= form.label :remember_me, "Remember me", class: "ml-2 block text-sm text-gray-700" %>
                        </div>
                    <% end %>

                    <div class="text-sm">
                        <%= link_to "Forgot password?", new_password_path(resource_name), class: "font-medium text-shadetree-blue hover:text-blue-800" %>
                    </div>
                </div>

                <!-- Sign In Button -->
                <div>
                    <%= form.submit "Sign in to your account", class: "group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-shadetree-blue hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-shadetree-blue shadow-lg" %>
                </div>
            <% end %>

            <!-- Divider -->
            <div class="mt-6">
                <div class="relative">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-gray-300"></div>
                    </div>
                    <div class="relative flex justify-center text-sm">
                        <span class="px-2 bg-white text-gray-500">Or continue with</span>
                    </div>
                </div>

                <!-- Social Login Options -->
                <div class="mt-6 grid grid-cols-2 gap-3">
                    <button
                        type="button"
                        class="w-full inline-flex justify-center py-3 px-4 border border-gray-300 rounded-md shadow-sm bg-white text-sm font-medium text-gray-500 hover:bg-gray-50"
                    >
                        <svg class="h-5 w-5" viewBox="0 0 24 24">
                            <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                            <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                        </svg>
                        <span class="ml-2">Google</span>
                    </button>

                    <button
                        type="button"
                        class="w-full inline-flex justify-center py-3 px-4 border border-gray-300 rounded-md shadow-sm bg-white text-sm font-medium text-gray-500 hover:bg-gray-50"
                    >
                        <i data-feather="smartphone" class="h-5 w-5"></i>
                        <span class="ml-2">Phone</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Sign Up Prompt -->
        <div class="text-center">
            <p class="text-sm text-gray-600">
                Don't have an account yet?
                <%= link_to "Start your free trial", new_user_registration_path, class: "font-medium text-shadetree-blue hover:text-blue-800" %>
            </p>
        </div>
    </div>
</div>

<!-- Initialize Feather Icons -->
<script>
    feather.replace();
</script>

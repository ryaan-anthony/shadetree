<%= render layout: "devise/shared/card", locals: {
      title: "Sign in to Shadetree",
      footer: safe_join([ "New here? ", link_to("Create an account", new_registration_path(resource_name), class: "font-semibold text-canopy hover:underline") ]) } do %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <%= f.field :email, as: :email, autofocus: true, autocomplete: "email", required: true %>
    <div class="field">
      <div class="mb-1.5 flex items-baseline justify-between">
        <%= f.label :password, class: "label mb-0" %>
        <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-sm2 font-semibold text-canopy hover:underline" %>
      </div>
      <%= f.password_field :password, autocomplete: "current-password", required: true, class: "input" %>
    </div>
    <% if devise_mapping.rememberable? %>
      <div class="field"><%= f.check :remember_me, label: "Keep me signed in", hint: "On this device for 4 weeks." %></div>
    <% end %>
    <%= f.submit_button "Sign in", class: "mt-5 w-full btn-lg" %>
  <% end %>
  <p class="mt-4 text-center text-sm2 text-muted">
    Locked out? <%= link_to "Get an unlock link", new_unlock_path(resource_name), class: "font-medium text-subtle underline" %>
  </p>
<% end %>

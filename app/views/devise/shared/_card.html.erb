<%# Wraps every auth screen. locals: (title:, lede: nil, footer: nil) %>
<% content_for :title, title %>
<div class="mx-auto w-full max-w-[27rem] px-4 py-10 sm:py-16">
  <div class="mb-6 text-center">
    <h1 class="text-2xl font-bold tracking-tight text-ink"><%= title %></h1>
    <% if local_assigns[:lede] %><p class="mt-2 text-sm text-muted"><%= lede %></p><% end %>
  </div>
  <div class="card card-body p-6 sm:p-7">
    <%= yield %>
  </div>
  <% if local_assigns[:footer] %><div class="mt-5 text-center text-sm text-subtle"><%= footer %></div><% end %>
</div>

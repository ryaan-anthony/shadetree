<% if resource.errors.any? %>
  <div class="banner banner-danger mb-5" role="alert" data-turbo-temporary>
    <%= icon "alert-circle" %>
    <p><%= resource.errors.count == 1 ? "One thing to fix" : "#{resource.errors.count} things to fix" %> before continuing. Each one is marked below.</p>
  </div>
<% end %>

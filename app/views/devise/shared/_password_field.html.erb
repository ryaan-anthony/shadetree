<%# A new-password field with strength guidance. locals: (form:, field: :password, label: "Password") %>
<div class="field" data-controller="password-strength">
  <%= form.field local_assigns.fetch(:field, :password), as: :password, label: local_assigns.fetch(:label, "Password"), autocomplete: "new-password",
                 minlength: Devise.password_length.min,
                 help: "At least #{Devise.password_length.min} characters. A few unrelated words work well.",
                 data: { password_strength_target: "input", action: "input->password-strength#update" } %>
  <div class="mt-2 flex items-center gap-2" aria-live="polite">
    <div class="flex h-1.5 flex-1 gap-1" aria-hidden="true">
      <% 4.times do %><span class="flex-1 rounded-full bg-slate-200" data-password-strength-target="bar"></span><% end %>
    </div>
    <span class="w-24 text-right text-xs font-medium text-muted" data-password-strength-target="label"></span>
  </div>
</div>

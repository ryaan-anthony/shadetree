<p class="space-x-3">
  <% if controller_name != "sessions" %><%= link_to "Sign in", new_session_path(resource_name), class: "font-semibold text-canopy hover:underline" %><% end %>
  <% if devise_mapping.registerable? && !controller_name.in?(%w[registrations]) %><%= link_to "Create an account", new_registration_path(resource_name), class: "font-semibold text-canopy hover:underline" %><% end %>
</p>

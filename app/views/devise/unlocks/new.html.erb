<%= render layout: "devise/shared/card", locals: {
      title: "Unlock your account",
      lede: "After too many sign-in attempts we lock the account for an hour. Get a link to unlock it now.",
      footer: render("devise/shared/links") } do %>
  <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "devise/shared/token_error", resource: resource, field: :unlock_token, what: "unlock" %>
    <%= f.field :email, as: :email, autofocus: true, autocomplete: "email", required: true %>
    <%= f.submit_button "Send unlock link", size: :lg, class: "mt-5 w-full" %>
  <% end %>
<% end %>

<%= render layout: "devise/shared/card", locals: {
      title: "Reset your password",
      lede: "Enter your email and we'll send you a link to choose a new one.",
      footer: render("devise/shared/links") } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= f.field :email, as: :email, autofocus: true, autocomplete: "email", required: true %>
    <%= f.submit_button "Send reset link", size: :lg, class: "mt-5 w-full" %>
  <% end %>
<% end %>

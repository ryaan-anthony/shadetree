<%= render layout: "devise/shared/card", locals: { title: "Choose a new password" } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }, data: { turbo: false }) do |f| %><%# signs in: see sessions/new (PLT-13) %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>
    <% if resource.errors[:reset_password_token].any? %>
      <div class="banner banner-danger mb-5" role="alert"><%= icon "alert-circle" %>
        <p>This reset link has expired or was already used. <%= link_to "Request a new one", new_password_path(resource_name), class: "font-semibold underline" %>.</p>
      </div>
    <% end %>
    <%= render "devise/shared/password_field", form: f, label: "New password" %>
    <%= f.field :password_confirmation, as: :password, label: "Confirm new password", autocomplete: "new-password" %>
    <%= f.submit_button "Save password and sign in", size: :lg, class: "mt-5 w-full" %>
  <% end %>
<% end %>

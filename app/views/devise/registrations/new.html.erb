<%= render layout: "devise/shared/card", locals: {
      title: "Create your account",
      lede: "Free to start. No card needed.",
      footer: safe_join([ "Already have an account? ", link_to("Sign in", new_session_path(resource_name), class: "font-semibold text-canopy hover:underline") ]) } do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="grid gap-4 sm:grid-cols-2">
      <%= f.field :first_name, autocomplete: "given-name", autofocus: true, required: true %>
      <%= f.field :last_name, autocomplete: "family-name", optional: true %>
    </div>
    <%= f.field :email, as: :email, autocomplete: "email", label: "Work email" %>
    <%= render "devise/shared/password_field", form: f %>
    <div class="field">
      <%= f.check :terms_of_service, required: true,
                  label: safe_join([ "I agree to the ", link_to("terms", terms_path, class: "underline", target: "_blank"), " and ", link_to("privacy policy", privacy_path, class: "underline", target: "_blank") ]) %>
      <% if resource.errors[:terms_of_service].any? %>
        <p class="error-text"><%= icon "alert-circle" %><%= resource.errors.full_messages_for(:terms_of_service).to_sentence %></p>
      <% end %>
    </div>
    <%= f.submit_button "Create account", class: "mt-5 w-full btn-lg" %>
  <% end %>
<% end %>

<% content_for :title, "Your account" %>
<div class="mx-auto w-full max-w-2xl px-4 py-10">
  <div class="mb-6 flex items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-ink">Your account</h1>
      <p class="mt-1 text-sm text-muted">Your sign-in details. Business settings live in each business.</p>
    </div>
    <%= link_to "Back to Shadetree", admin_root_path, class: button_classes(:secondary) %>
  </div>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= card title: "Profile" do %>
      <div class="grid gap-4 sm:grid-cols-2">
        <%= f.field :first_name, autocomplete: "given-name" %>
        <%= f.field :last_name, autocomplete: "family-name", optional: true %>
      </div>
      <%= f.field :email, as: :email, autocomplete: "email",
                  help: (resource.pending_reconfirmation? ? "Waiting for you to confirm #{resource.unconfirmed_email}." : "Changing it sends a confirmation link to the new address.") %>
    <% end %>
    <%= card title: "Password", subtitle: "Leave blank to keep your current password." do %>
      <%= render "devise/shared/password_field", form: f, label: "New password" %>
      <%= f.field :password_confirmation, as: :password, label: "Confirm new password", autocomplete: "new-password", optional: true %>
    <% end %>
    <%= card do %>
      <%= f.field :current_password, as: :password, autocomplete: "current-password", required: true,
                  help: "Needed to save any change here." %>
      <div class="mt-5 flex justify-end"><%= f.submit_button "Save changes" %></div>
    <% end %>
  <% end %>

  <% if current_user.has_business? %>
    <%= card title: "Email notifications", class: "mt-4" do %>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-subtle">Which team emails you get is set for each business you're in.</p>
        <%= link_to "Choose emails", settings_admin_notifications_path, class: button_classes(:secondary) %>
      </div>
    <% end %>
  <% end %>

  <% if current_user.has_business? %><%# ACC-08 %>
    <%= card title: t("guidance.tips.setting_title"), class: "mt-4", id: "tips-setting" do %>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-subtle"><%= current_user.tips_off? ? t("guidance.tips.setting_off") : t("guidance.tips.setting_on") %></p>
        <%= button_to (current_user.tips_off? ? t("guidance.tips.turn_on") : t("guidance.tips.turn_off")), admin_tips_preference_path,
                      method: :patch, params: { off: !current_user.tips_off? }, class: button_classes(:secondary) %>
      </div>
    <% end %>
  <% end %>

  <% unless impersonation %><%# OPS-03: support doesn't see the member's browsers and addresses %>
  <% browser_sessions = current_user.user_sessions.listed.to_a.sort_by { _1 == current_user_session ? 0 : 1 } %>
  <%= card title: "Where you're signed in", subtitle: "Lost a phone or used a shared computer? Sign it out here.", flush: true, class: "mt-4" do %>
    <ul class="list" id="browser-sessions">
      <% browser_sessions.each do |browser_session| %>
        <% this = browser_session == current_user_session %>
        <li id="browser-session-<%= browser_session.id %>">
          <div class="min-w-0 flex-1">
            <p class="font-medium text-ink"><%= browser_session.device_label %><% if this %> <span class="badge badge-success ml-1">This browser</span><% end %></p>
            <p class="text-sm2 text-muted">
              <%= this ? "Active now" : "Last active #{time_ago_in_words(browser_session.last_active_at)} ago" %>
              <% if browser_session.ip_address %>· <%= browser_session.ip_address %><% end %> · signed in <%= local_date(browser_session.created_at) %>
            </p>
          </div>
          <% unless this %>
            <%= button_to "Sign out", user_browser_session_path(browser_session), method: :delete, class: button_classes(:ghost, :sm),
                          form: { class: "contents", data: { turbo_confirm: "Sign out #{browser_session.device_label}? “Keep me signed in” will also stop working on your other browsers, including this one.", turbo_confirm_button: "Sign out" } } %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% if browser_sessions.size > 2 %>
      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line px-5 py-4 sm:flex-nowrap">
        <p class="text-sm text-subtle">Sign out everywhere except this browser. Changing your password does this too.</p>
        <%= button_to "Sign out of all other browsers", sign_out_everywhere_path, class: button_classes(:secondary, extra: "shrink-0"),
                      form: { class: "shrink-0", data: { turbo_confirm: "Sign out of every other browser?", turbo_confirm_button: "Sign out others" } } %>
      </div>
    <% end %>
  <% end %>
  <% end %>

  <% blocking = current_user.businesses_blocking_deletion %>
  <%= card title: "Delete your account", class: "mt-4", id: "delete-account" do %>
    <% if blocking.any? %>
      <p class="text-sm text-subtle">You're the only Owner of <%= to_sentence(blocking.map(&:name)) %>, which other people or records depend on, so your account can't be deleted yet.</p>
      <p class="mt-2 text-sm text-subtle">Make another member an Owner on the business's Team page (invite someone first if it's just you), then come back. To close a business instead, <%= link_to "contact Shadetree", contact_path, class: "font-medium text-canopy hover:underline" %>.</p>
    <% else %>
      <ul class="list-disc space-y-1 pl-5 text-sm text-subtle">
        <li>Your name, email and password are removed, and you're signed out everywhere.</li>
        <li>You leave every business you're in. What you did there (quotes, visits, notes) stays with the business, shown as "Former member".</li>
        <% if current_user.business_users.active.owners.any? %><li>A business only you own, with nothing in it yet, is closed, along with its contact details and any invitations not yet accepted.</li><% end %>
        <li>This can't be undone. We'll email <%= current_user.email %> to confirm.</li>
      </ul>
      <%= form_with url: user_registration_path, method: :delete, class: "mt-4 flex flex-wrap items-end gap-3",
                    data: { turbo_confirm: "Delete your Shadetree account? This can't be undone.", turbo_confirm_button: "Delete account" } do %>
        <div class="field min-w-56 flex-1">
          <label class="label" for="delete_current_password">Your password</label>
          <%= password_field_tag :current_password, nil, id: "delete_current_password", class: "input", autocomplete: "current-password", required: true %>
        </div>
        <%= submit_tag "Delete my account", class: button_classes(:danger), name: nil %>
      <% end %>
    <% end %>
  <% end %>
</div>

<p style="margin:0 0 12px;font-size:18px;font-weight:700;color:#0f172a;">Reset your password</p>
<p style="margin:0;">Someone asked to reset the password for <strong><%= @resource.email %></strong>. If that was you, choose a new one:</p>
<%= render "shared/mailer/button", label: "Choose a new password", url: edit_password_url(@resource, reset_password_token: @token) %>
<p style="margin:0;font-size:13px;color:#64748b;">This link works for <%= Devise.reset_password_within.inspect %>. If you didn't ask, your password stays the same.</p>

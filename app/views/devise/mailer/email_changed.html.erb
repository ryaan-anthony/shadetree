<p style="margin:0 0 12px;font-size:18px;font-weight:700;color:#0f172a;">Your sign-in email is changing</p>
<% if @resource.try(:unconfirmed_email?) %>
  <p style="margin:0;">Your Shadetree account email is being changed to <strong><%= @resource.unconfirmed_email %></strong>.</p>
<% else %>
  <p style="margin:0;">Your Shadetree account email is now <strong><%= @resource.email %></strong>.</p>
<% end %>
<p style="margin:12px 0 0;">If you didn't make this change, reply to this email straight away.</p>

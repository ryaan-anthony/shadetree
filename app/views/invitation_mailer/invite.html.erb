<p style="margin:0 0 12px;font-size:18px;font-weight:700;color:#0f172a;">Join <%= @business.name %></p>
<p style="margin:0;"><%= @inviter&.full_name || @business.name %> invited you to <strong><%= @business.name %></strong> on Shadetree as <%= @invitation.role == "admin" ? "an" : "a" %> <strong><%= @invitation.role.humanize.downcase %></strong>.</p>
<%= render "shared/mailer/button", label: "Accept invitation", url: @url %>
<p style="margin:0;font-size:13px;color:#64748b;">This invitation expires on <%= l(@invitation.expires_at.to_date, format: :long) %>. If you weren't expecting it, you can ignore this email.</p>

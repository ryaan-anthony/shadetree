<%= render layout: "devise/shared/card", locals: {
      title: "Check your email",
      footer: safe_join([ "Wrong address? ", link_to("Start again", new_user_registration_path, class: "font-semibold text-canopy hover:underline") ]) } do %>
  <div class="text-center">
    <span class="empty-icon bg-canopy-50 text-canopy"><%= icon "mail" %></span>
    <p class="text-sm text-subtle">
      <% if @email.present? %>
        We sent a confirmation link to <span class="font-semibold text-ink"><%= @email %></span>.
      <% else %>
        We sent you a confirmation link.
      <% end %>
      The link works for 3 days.
    </p>
  </div>
  <%= form_with url: resend_users_confirmation_path, method: :post, class: "mt-6" do |f| %>
    <% if current_user %>
      <%= f.submit_button "Resend link", variant: :secondary, class: "w-full" %>
    <% else %>
      <%= f.field :email, as: :email, value: @email, label: "Didn't get it? Resend to", autocomplete: "email", required: true %>
      <%= f.submit_button "Resend link", variant: :secondary, class: "mt-4 w-full" %>
    <% end %>
  <% end %>
<% end %>

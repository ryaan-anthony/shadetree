<%# OPS-01: the operator console's own layout: plainly marked as Shadetree's, not a business's. %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/head" %>
    <meta name="robots" content="noindex, nofollow">
    <%# Hovering a link mustn't open the page: opening a business is audited (OPS-02). %>
    <meta name="turbo-prefetch" content="false">
  </head>
  <body class="bg-canvas text-sm text-body">
    <%# The skip link is the first tab stop, before the support banner; z-[200] keeps it above that sticky banner. %>
    <a href="#main" class="btn btn-secondary sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[200]">Skip to content</a>
    <%= render "layouts/impersonation_banner" %>
    <header class="border-b border-slate-800 bg-slate-900 text-white">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
        <p class="font-semibold">Shadetree operator console</p>
        <% if current_operator&.two_factor? && ops_session["ops_verified_at"] && ops_session["ops_verified_for"] == [ current_operator.id, current_operator.otp_enabled_at.to_i ] %>
          <nav aria-label="Console" class="flex flex-wrap gap-x-4 gap-y-1 whitespace-nowrap text-sm2">
            <%= link_to "Home", ops_root_path, class: "hover:underline", "aria-current": ("page" if controller_name == "dashboard") %>
            <%= link_to "Businesses", ops_businesses_path, class: "hover:underline", "aria-current": ("page" if controller_name == "businesses") %>
            <% waiting_on_us = Tenancy.across_businesses(reason: "operator support inbox count (OPS-05)") { SupportTicket.where(status: "open").count } %>
            <%= link_to ops_tickets_path, class: "hover:underline", "aria-current": ("page" if controller_name == "tickets"), id: "nav-support" do %>Support<% if waiting_on_us.positive? %> <span class="rounded-full bg-white/20 px-1.5 text-xs" aria-label="<%= waiting_on_us %> open"><%= waiting_on_us %></span><% end %><% end %>
            <%= link_to "People", ops_users_path, class: "hover:underline", "aria-current": ("page" if controller_name == "users") %>
            <%= link_to "Plans", ops_plans_path, class: "hover:underline", "aria-current": ("page" if controller_name == "plans") %>
            <%= link_to "Presets", ops_presets_path, class: "hover:underline", "aria-current": ("page" if controller_name == "presets") %>
            <%= link_to "Flags", ops_feature_flags_path, class: "hover:underline", "aria-current": ("page" if controller_name == "feature_flags") %>
            <%= link_to "Operators", ops_operators_path, class: "hover:underline", "aria-current": ("page" if controller_name == "operators") %>
            <%= link_to "Messages", ops_contact_messages_path, class: "hover:underline", "aria-current": ("page" if controller_name == "contact_messages") %>
            <%= link_to "Audit log", ops_audit_entries_path, class: "hover:underline", "aria-current": ("page" if controller_name == "audit_entries") %>
          </nav>
        <% end %>
        <p class="ml-auto text-sm2 text-slate-300"><%= current_user&.email %> · <%= link_to "Back to the app", admin_root_path, class: "underline-offset-2 hover:underline" %></p>
      </div>
    </header>
    <main id="main" class="mx-auto max-w-6xl px-4 py-6">
      <%# Alerts announce themselves; notices are read through #announcer, kept across Turbo visits. %>
      <div id="announcer" class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-turbo-permanent></div>
      <% flash.each do |type, message| %>
        <% alert = type.to_s == "alert" %>
        <div class="banner <%= alert ? "banner-warning" : "banner-success" %> mb-4" <%= tag.attributes(role: ("alert" if alert), data: { controller: ("announce" unless alert) }) %> data-turbo-temporary><p><%= message %></p></div>
      <% end %>
      <%= yield %>
    </main>
    <footer class="mx-auto max-w-6xl border-t border-line px-4 py-4 text-xs text-muted">
      <p>Shadetree operator console · <%= link_to "Terms", terms_path, class: "underline-offset-2 hover:underline" %> · <%= link_to "Privacy", privacy_path, class: "underline-offset-2 hover:underline" %> · <%= link_to "Legal", legal_path, class: "underline-offset-2 hover:underline" %></p>
    </footer>
  </body>
</html>

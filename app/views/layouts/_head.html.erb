<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= safe_join([ content_for(:title).presence, "Shadetree" ].compact.uniq, " · ") %></title>
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#0b1221">
<%= csrf_meta_tags %>
<%= csp_meta_tag %>
<%# PLT-13: the nonce changes when the session does (signing in or out). Turbo can't move a page's
    nonced <style> blocks into a document with the old policy, so a changed nonce means a full load. %>
<meta name="csp-nonce-check" content="<%= Digest::SHA256.hexdigest(content_security_policy_nonce.to_s)[0, 16] %>" data-turbo-track="reload">
<link rel="icon" href="/icon.png" type="image/png">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="apple-mobile-web-app-title" content="Shadetree">
<%= preload_link_tag "public-sans-latin-wght-normal.woff2", as: "font", type: "font/woff2", crossorigin: "anonymous" %>
<%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
<%= javascript_importmap_tags %>
<%= yield :head %>

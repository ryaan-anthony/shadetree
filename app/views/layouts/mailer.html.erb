<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
  </head>
  <body style="margin:0;padding:0;background:#f6f7f9;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1e293b;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f7f9;">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;">
            <tr>
              <td style="padding:0 4px 16px;font-size:18px;font-weight:800;letter-spacing:-0.02em;color:#0f172a;">
                <span style="color:#059669;">Shade</span>tree
              </td>
            </tr>
            <tr>
              <td style="background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;padding:28px;font-size:15px;line-height:1.6;">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 4px;font-size:12px;line-height:1.5;color:#64748b;">
                You're getting this because of activity on your Shadetree account.
                If it wasn't you, you can ignore this email.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>

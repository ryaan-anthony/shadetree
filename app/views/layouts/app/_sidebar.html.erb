<%# A plain container, not <aside>: it holds the app's own navigation, not complementary content.
    Its foot (you, sign out, legal links) is the page's footer landmark. %>
<div id="app-sidebar" class="side" data-drawer-target="panel">
  <div class="side-top">
    <% if current_business %>
      <%# The kit menu (PLT-19) with its own trigger: the business you're in. %>
      <div class="relative" data-controller="menu" data-action="keydown->menu#keydown focusout->menu#focusout">
        <button type="button" class="biz-switch" data-menu-target="button" data-action="menu#toggle"
                aria-expanded="false" aria-controls="business-menu">
          <%= business_mark(current_business) %>
          <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-semibold leading-tight"><%= current_business.name %></span>
            <span class="block text-sm2 text-side-text"><%= current_role_label %></span>
          </span>
          <%= icon "selector", class: "size-4 text-side-text" %>
        </button>
        <div class="menu left-0 right-0 top-full mt-1 w-auto" id="business-menu" data-menu-target="menu" hidden>
          <p class="menu-label">Switch business</p>
          <% current_user.businesses.order(:name).with_attached_logo.each do |business| %>
            <%= button_to switch_admin_business_path, params: { business: business.uid }, class: "menu-item",
                          "aria-current": (business == current_business).to_s, form: { class: "contents" } do %>
              <%= business_mark(business, class: "size-6 rounded-md text-sm2") %>
              <span class="flex-1 truncate"><%= business.name %></span>
              <% if business == current_business %><%= icon "check", class: "size-4 text-canopy" %><% end %>
            <% end %>
          <% end %>
          <div class="menu-sep"></div>
          <%= link_to new_admin_business_path, class: "menu-item" do %><%= icon "plus" %> Create a business<% end %>
        </div>
      </div>
    <% else %>
      <%= brand_logo(on: :dark, href: root_path, class: "px-2 py-1.5") %>
    <% end %>
  </div>

  <nav class="side-nav" aria-label="Primary">
    <% if current_business %>
      <% if can?(:office) || can?(:business_settings) %>
        <%= side_link "Home", admin_root_path, icon: "home", active: (controller_name == "dashboard" || (:section if can?(:office) && controller_name.in?(%w[my_day my_visits my_requests]))), tour: "home" %>
      <% end %>
      <%# #289: one place to start: office members reach My day from Home ("Your day"); people who only do field work land on it. %>
      <% if can?(:field_work) && !can?(:office) %>
        <%= side_link "My day", admin_my_day_path, icon: "sun", active: controller_name.in?(%w[my_day my_visits my_requests]), tour: "my_day" %>
      <% end %>
      <% if can?(:office) %>
        <%= side_link "Requests", admin_service_requests_path, icon: "inbox", active: controller_name.in?(%w[service_requests service_request_notes]), tour: "requests",
                      count: ServiceRequest.where(status: "new").count %>
        <%= side_link "Clients", admin_clients_path, icon: "users", active: controller_name == "clients" %>
        <%= side_link "Quotes", admin_quotes_path, icon: "quote", active: controller_name.in?(%w[quotes quote_attachments]), tour: "quotes" %>
        <%= side_link "Jobs", admin_jobs_path, icon: "job", active: controller_name.in?(%w[jobs quote_jobs]) %>
        <%= side_link "Invoices", admin_invoices_path, icon: "invoice", active: controller_name.in?(%w[invoices job_invoices quote_invoices invoice_attachments]), tour: "invoices" %>
      <% end %>
      <% if can?(:schedule) %>
        <%= side_link "Schedule", admin_schedule_path, icon: "calendar", active: controller_name == "schedule", tour: "schedule" %>
      <% end %>
      <% if can?(:business_settings) || can?(:manage_team) %>
        <p class="side-group">Business</p>
      <% end %>
      <% if can?(:manage_team) %>
        <%= side_link "Team", admin_team_path, icon: "users", active: controller_name.in?(%w[team invitations members]) %>
      <% end %>
      <% if can?(:business_settings) %>
        <%= side_link "Services & prices", admin_catalog_items_path, icon: "package", active: controller_name == "catalog_items" %>
        <%= side_link "Settings", edit_admin_business_path, icon: "settings", active: settings_page?, tour: "settings" %><%# #289: every settings page %>
      <% end %>
    <% else %>
      <%= side_link "Set up your business", new_admin_business_path, icon: "briefcase", active: true %>
    <% end %>
  </nav>

  <% if current_business && !current_business.suspended? && (can?(:office) || can?(:business_settings)) %><%= render "layouts/app/quota_meter" %><% end %><%# BIL-06: not on a suspended business's refusal page %>
  <footer class="side-foot">
    <div class="flex items-center gap-2.5 px-1 text-sm2 text-side-bright">
      <%= Current.membership ? member_avatar(Current.membership) : avatar(current_user.full_name.presence || current_user.email) %>
      <%= link_to edit_user_registration_path, class: "min-w-0 flex-1 rounded-md hover:text-white", title: "Your account" do %>
        <p class="truncate font-medium"><%= current_user.full_name.presence || current_user.email %></p>
        <p class="truncate text-sm2 text-side-text"><%= current_user.email %></p>
      <% end %>
      <%= button_to destroy_user_session_path, method: :delete, class: button_classes(:tertiary, :sm, :icon, extra: "text-side-text hover:bg-side-2 hover:text-white"), form: { class: "contents", data: { turbo: false, controller: "forget-tour", action: "submit->forget-tour#clear" } }, "aria-label": "Sign out", title: "Sign out" do %>
        <%= icon "log-out" %>
      <% end %>
    </div>
    <% if Current.membership %><%# ACC-09 %>
      <%= link_to edit_admin_profile_path, class: "mt-2 flex items-center gap-1.5 rounded-md px-1 text-sm2 text-side-text hover:text-white" do %><%= icon "user", class: "size-3.5" %> Your profile in <%= current_business.name %><% end %>
    <% end %>
    <p class="mt-2 px-1 text-sm2 text-side-text"><%= link_to "Terms", terms_path, class: "hover:text-white" %> · <%= link_to "Privacy", privacy_path, class: "hover:text-white" %> · <%= link_to "Legal", legal_path, class: "hover:text-white" %></p>
  </footer>
</div>

<%# Staff app: sidebar on desktop, drawer on phones, business switcher, flash toasts. %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/head" %>
    <meta name="robots" content="noindex"><%# signed-in pages are never indexed (MKT-04) %>
    <%# JOB-04: the staff app installs to the home screen (the crew opens straight to My day); client and marketing pages don't offer it. %>
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
  </head>
  <body class="bg-canvas text-sm text-body">
    <%# The skip link is the first tab stop, before the support banner; z-[200] keeps it above that sticky banner. %>
    <a href="#main" class="<%= button_classes(:secondary, extra: "sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[200]") %>">Skip to content</a>
    <%= render "layouts/impersonation_banner" %>
    <div class="shell" data-controller="drawer" data-action="keydown->drawer#closeOnEscape">
      <div class="side-scrim" data-drawer-target="scrim" data-action="click->drawer#close" hidden></div>
      <%= render "layouts/app/sidebar" %>

      <div class="flex min-w-0 flex-col">
        <header class="topbar">
          <button type="button" class="<%= button_classes(:tertiary, :icon) %> min-[960px]:hidden"
                  data-drawer-target="toggle" data-action="drawer#open" aria-controls="app-sidebar" aria-expanded="false" aria-label="Open navigation">
            <%= icon "menu", class: "size-5" %>
          </button>
          <%# PLT-15: global controls only. The page's title is its H1, never repeated here (owner, 2026-11-22). %>
          <div class="ml-auto flex items-center gap-1.5">
            <% if current_business && current_user %>
              <%# OPS-05: the Help menu: ask Shadetree, from whatever page this is. %>
              <%= menu label: "Help", icon_name: "help-circle", icon_class: "size-5", button: { id: "help-menu", data: { tour: "help" } } do %>
                <%= link_to new_admin_support_ticket_path(from: request.path), class: "menu-item" do %><%= icon "message-square" %> Ask Shadetree for help<% end %>
                <%= link_to admin_support_tickets_path, class: "menu-item" do %><%= icon "life-buoy" %> Your questions<% end %>
                <% if (help_tour = GuidedTour.for(Current.membership)) %><%# ACC-08 %>
                  <%= link_to (help_tour.page == :field ? admin_my_day_path(tour: "start") : admin_root_path(tour: "start")), class: "menu-item" do %><%= icon "map" %> <%= t("guidance.tour.again") %><% end %>
                <% end %>
                <% if tips_for_me? %>
                  <%= button_to admin_tips_path, method: :delete, class: "menu-item w-full", form: { class: "contents" } do %><%= icon "zap" %> <%= t("guidance.tips.again") %><% end %>
                <% end %>
              <% end %>
              <%# NTF-02: the notification center, with this member's unread count in this business. %>
              <% unread = Notification.for_user(current_user).unread.count %>
              <%= link_to admin_notifications_path, class: "#{button_classes(:tertiary, :icon)} relative", "aria-label": (unread.positive? ? "Notifications, #{unread} unread" : "Notifications"),
                          "aria-current": ("page" if controller_name == "notifications" && action_name == "index") do %>
                <%= icon "bell", class: "size-5" %>
                <% if unread.positive? %><span class="notify-count" aria-hidden="true"><%= unread > 99 ? "99+" : unread %></span><% end %>
              <% end %>
            <% end %>
          </div>
        </header>

        <main id="main" class="content">
          <%= render "layouts/app/confirm_email_banner" if current_user && !current_user.confirmed? %>
          <%= render "layouts/app/billing_banner" if Current.membership&.can?(:billing) && current_business %>
          <% if (tip = first_time_tip_here) %><%= render "layouts/app/tip", tip: %><% end %><%# ACC-08 %>
          <%= yield %>
        </main>
      </div>
    </div>
    <% if (tour = guided_tour_here) %><%= render "layouts/app/tour", tour: %><% end %><%# ACC-08 %>
    <%= flash_toasts %>
    <%= render "components/confirm_dialog" %>
    <%= inline_styles_tag %>
  </body>
</html>

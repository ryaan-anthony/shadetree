<%# Staff app: sidebar on desktop, drawer on phones, business switcher, flash toasts. %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/head" %>
    <meta name="robots" content="noindex"><%# signed-in pages are never indexed (MKT-04) %>
    <%# JOB-04: the staff app installs to the home screen (the crew opens straight to My day); client and marketing pages don't offer it. %>
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
  </head>
  <body class="bg-canvas text-sm text-body">
    <%= render "layouts/impersonation_banner" %>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[200] btn btn-secondary">Skip to content</a>
    <div class="shell" data-controller="drawer" data-action="keydown->drawer#closeOnEscape">
      <div class="side-scrim" data-drawer-target="scrim" data-action="click->drawer#close" hidden></div>
      <%= render "layouts/app/sidebar" %>

      <div class="flex min-w-0 flex-col">
        <header class="topbar">
          <button type="button" class="<%= button_classes(:ghost, :icon) %> min-[960px]:hidden"
                  data-drawer-target="toggle" data-action="drawer#open" aria-controls="app-sidebar" aria-expanded="false" aria-label="Open navigation">
            <%= icon "menu", class: "size-5" %>
          </button>
          <p class="min-w-0 truncate text-sm font-semibold text-ink"><%= content_for(:title) %></p>
          <div class="ml-auto flex items-center gap-1.5"><%= yield :topbar_actions %>
            <% if current_business && current_user %>
              <%# NTF-02: the notification center, with this member's unread count in this business. %>
              <% unread = Notification.for_user(current_user).unread.count %>
              <%= link_to admin_notifications_path, class: "#{button_classes(:ghost, :icon)} relative", "aria-label": (unread.positive? ? "Notifications, #{unread} unread" : "Notifications"),
                          "aria-current": ("page" if controller_name == "notifications" && action_name == "index") do %>
                <%= icon "bell", class: "size-5" %>
                <% if unread.positive? %><span class="notify-count" aria-hidden="true"><%= unread > 99 ? "99+" : unread %></span><% end %>
              <% end %>
            <% end %>
          </div>
        </header>

        <main id="main" class="content">
          <%= render "layouts/app/confirm_email_banner" if current_user && !current_user.confirmed? %>
          <%= yield %>
        </main>
      </div>
    </div>
    <%= flash_toasts %>
    <%= render "components/confirm_dialog" %>
    <%= inline_styles_tag %>
  </body>
</html>

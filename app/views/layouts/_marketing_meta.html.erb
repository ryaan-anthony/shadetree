<%# MKT-04: description, canonical address, link previews and indexing for public pages. %>
<% title = [ content_for(:title).presence, SeoHelper::SITE ].compact.uniq.join(" · ") %>
<meta name="description" content="<%= meta_description %>">
<link rel="canonical" href="<%= canonical_url %>">
<% unless meta_index? %><meta name="robots" content="noindex"><% end %>
<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= SeoHelper::SITE %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= meta_description %>">
<meta property="og:url" content="<%= canonical_url %>">
<meta property="og:image" content="<%= share_image_url %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%= meta_description %>">
<meta name="twitter:image" content="<%= share_image_url %>">

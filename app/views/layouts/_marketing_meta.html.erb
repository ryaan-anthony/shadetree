<%# MKT-04: description, canonical address, link previews and indexing for public pages. %>
<% title = page_title %>
<meta name="description" content="<%= meta_description %>">
<% if meta_index? %><link rel="canonical" href="<%= canonical_url %>"><% else %><meta name="robots" content="noindex"><% end %>
<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= SeoHelper::SITE %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= meta_description %>">
<% if meta_index? %><meta property="og:url" content="<%= canonical_url %>"><% end %>
<meta property="og:image" content="<%= share_image_url %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%= meta_description %>">
<meta name="twitter:image" content="<%= share_image_url %>">

<%# Client-facing pages (quotes, invoices, booking): the business's brand, no staff chrome.
    Controllers set @business; everything brand-related comes from Branding (CAT-02). %>
<% branding = Branding.new(@business) %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <% content_for(:title, @business&.name) unless content_for?(:title) %>
    <%= render "layouts/head" %>
    <%# MKT-04: client pages are never indexed; a request page is when its business opts in. %>
    <% if content_for?(:indexable) %><link rel="canonical" href="<%= public_base_url %><%= public_request_path(@business.handle) %>"><% else %><meta name="robots" content="noindex"><% end %>
    <%= inline_style_rule("body.client", branding.css_variables) %>
  </head>
  <body class="client">
    <%= render "layouts/impersonation_banner" %>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 btn btn-secondary">Skip to content</a>
    <header class="client-head">
      <div class="client-wrap flex h-[4.25rem] items-center gap-3">
        <% if branding.logo? %>
          <%# The logo's size is set up front, so the header doesn't wait on it (QA #274: it showed as 0 × 40 while the
              resized copy was still being made); its alt text is the business's name. %>
          <% width, height = branding.logo_dimensions(:web) %>
          <%= image_tag branding.logo(:web), alt: branding.name, class: "client-logo-image", width:, height: %>
        <% else %>
          <span class="client-logo" aria-hidden="true"><%= branding.initials %></span>
        <% end %>
        <div class="min-w-0">
          <% unless branding.logo? %><p class="truncate font-bold text-ink"><%= branding.name %></p><% end %>
          <% contact = @contact || @business %><%# CAT-07: the location the client deals with %>
          <% if contact&.contact_label %><p class="truncate text-sm2 font-medium text-subtle"><%= contact.contact_label %></p><% end %>
          <% if contact&.contact_phone.present? %>
            <p class="text-sm2 text-muted"><%= phone_link contact.contact_phone, class: "hover:text-ink" %></p>
          <% end %>
        </div>
      </div>
    </header>
    <main id="main" class="client-wrap py-6">
      <%= yield %>
    </main>
    <footer class="client-powered flex-wrap gap-x-4">
      <% if branding.show_powered_by? %>
        <%= link_to root_url, class: "inline-flex items-center gap-1.5 text-[0.8125rem] text-subtle", target: "_blank", rel: "noopener" do %>
          <span class="logo-mark size-4 rounded-sm [&_svg]:size-3"><%= logo_mark %></span>
          <span>Powered by <%= wordmark(size: :small) %></span>
        <% end %>
      <% end %>
      <%# MKT-03: how the client's details are handled, shown even without "Powered by". %>
      <%= link_to "Privacy (Shadetree)", privacy_url(anchor: "clients"), class: "text-[0.8125rem] text-subtle underline-offset-2 hover:underline", target: "_blank", rel: "noopener" %>
    </footer>
    <%= flash_toasts %>
    <%= render "components/confirm_dialog" %>
    <%= inline_styles_tag %>
  </body>
</html>

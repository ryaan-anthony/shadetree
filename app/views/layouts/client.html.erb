<%# Client-facing pages (quotes, invoices, booking): the business's brand, no staff chrome.
    Controllers set @business; everything brand-related comes from Branding (CAT-02). %>
<% branding = Branding.new(@business) %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <% content_for(:title, @business&.name) unless content_for?(:title) %>
    <%= render "layouts/head" %>
    <%# MKT-04: client pages are never indexed; a request page is when its business opts in. %>
    <% if content_for?(:indexable) %><link rel="canonical" href="<%= public_base_url %><%= public_request_path(@business.handle) %>"><% else %><meta name="robots" content="noindex"><% end %>
    <%= inline_style_rule("body.client", branding.css_variables) %>
  </head>
  <body class="client">
    <header class="client-head">
      <div class="client-wrap flex h-[4.25rem] items-center gap-3">
        <% if branding.logo? %>
          <%= image_tag branding.logo(:web), alt: branding.name, class: "client-logo-image" %>
        <% else %>
          <span class="client-logo" aria-hidden="true"><%= branding.initials %></span>
        <% end %>
        <div class="min-w-0">
          <p class="truncate font-bold text-ink <%= "sr-only" if branding.logo? %>"><%= branding.name %></p>
          <% if @business&.phone.present? %>
            <p class="text-sm2 text-muted"><%= link_to @business.phone, "tel:#{@business.phone}", class: "hover:text-ink" %></p>
          <% end %>
        </div>
      </div>
    </header>
    <main id="main" class="client-wrap py-6">
      <%= yield %>
    </main>
    <footer class="client-powered flex-wrap gap-x-4">
      <% if branding.show_powered_by? %>
        <%= link_to root_url, class: "logo text-[0.8125rem] text-subtle", target: "_blank", rel: "noopener" do %>
          <span class="logo-mark size-4 rounded-sm [&_svg]:size-3"><%= logo_mark %></span>
          <span>Powered by Shadetree</span>
        <% end %>
      <% end %>
      <%# MKT-03: how the client's details are handled, shown even without "Powered by". %>
      <%= link_to "Privacy", privacy_url, class: "text-[0.8125rem] text-subtle underline-offset-2 hover:underline", target: "_blank", rel: "noopener" %>
    </footer>
    <%= flash_toasts %>
    <%= render "components/confirm_dialog" %>
    <%= inline_styles_tag %>
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <% content_for(:title, "Quotes, scheduling and payments for small service crews") unless content_for?(:title) %>
    <%= render "layouts/head" %>
    <%= render "layouts/marketing_meta" %>
    <% if Analytics.script_url %><script defer data-domain="<%= Analytics.domain %>" src="<%= Analytics.script_url %>"></script><% end %><%# MKT-04 %>
  </head>
  <body class="bg-surface text-body">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 btn btn-secondary">Skip to content</a>
    <%= render "shared/marketing/navigation" %>
    <main id="main">
      <%= yield %>
    </main>
    <%= render "shared/marketing/footer" %>
    <%= flash_toasts %>
    <%= render "components/confirm_dialog" %>
  </body>
</html>

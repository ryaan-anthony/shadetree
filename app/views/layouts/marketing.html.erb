<!DOCTYPE html>
<html lang="en">
  <head>
    <% content_for(:title, "Quotes, scheduling and payments for small service crews") unless content_for?(:title) %>
    <%= render "layouts/head" %>
    <%= render "layouts/marketing_meta" %>
    <%= tag.script(defer: true, src: Analytics.script_url, data: { domain: Analytics.domain }) if Analytics.script_url && content_for?(:analytics) %><%# MKT-04 %>
  </head>
  <body class="bg-surface text-body">
    <a href="#main" class="<%= button_classes(:secondary, extra: "sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[200]") %>">Skip to content</a><%# first, above the banner %>
    <%= render "layouts/impersonation_banner" %>
    <%= render "shared/marketing/navigation" %>
    <main id="main">
      <%= yield %>
    </main>
    <%= render "shared/marketing/footer" %>
    <%= flash_toasts %>
    <%= render "components/confirm_dialog" %>
    <%= inline_styles_tag %>
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <% content_for(:title, "Job & quote software for the rest of us") unless content_for?(:title) %>
    <%= render "layouts/head" %>
  </head>
  <body class="bg-gray-50">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 btn btn-secondary">Skip to content</a>
    <%= render "shared/marketing/top_bar" %>
    <%= render "shared/marketing/navigation" %>
    <main id="main">
      <%= yield %>
    </main>
    <%= render "shared/marketing/footer" %>
    <%= flash_toasts %>
    <%= render "components/confirm_dialog" %>
  </body>
</html>

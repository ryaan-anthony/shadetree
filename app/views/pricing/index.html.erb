<% content_for :title, "Pricing" %>
<% content_for :head, tag.meta(name: "description", content: "Free to start, with the whole workflow. Paid plans by how many quotes you send each month. No contracts, no setup fees.") %>
<% yearly = @plans.any? { plan_annual_saving(_1) } %>

<%# MKT-01: every price, limit and feature here comes from the plans (BIL-01). The monthly/yearly
    switch is two radio buttons and CSS, so it works without script. %>
<div class="group/billing">
  <section class="mx-auto max-w-6xl px-5 pb-10 pt-14 text-center sm:px-8 sm:pt-20">
    <h1 class="text-4xl font-extrabold tracking-[-0.04em] text-ink sm:text-6xl">Free until it’s paying for itself.</h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-subtle">Every plan has the whole workflow, from request to payment. Paid plans are about how many quotes you send each month and how many people are on your team.</p>
    <% if yearly %>
      <fieldset class="mx-auto mt-8 inline-flex rounded-control border border-line bg-sunken p-1 text-sm">
        <legend class="sr-only">Billing</legend>
        <label class="cursor-pointer rounded-[4px] px-3.5 py-1.5 font-medium text-subtle has-[:checked]:bg-surface has-[:checked]:text-ink has-[:checked]:shadow-card has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-canopy">
          <input type="radio" name="billing" value="monthly" class="sr-only" checked> Monthly
        </label>
        <label class="cursor-pointer rounded-[4px] px-3.5 py-1.5 font-medium text-subtle has-[:checked]:bg-surface has-[:checked]:text-ink has-[:checked]:shadow-card has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-canopy">
          <input type="radio" name="billing" value="yearly" class="sr-only" id="billing-yearly"> Yearly<%= ", #{plan_annual_saving(@plans.find { plan_annual_saving(_1) })}" %>
        </label>
      </fieldset>
    <% end %>
  </section>

  <section class="mx-auto max-w-6xl px-5 sm:px-8" aria-label="Plans">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-<%= [ @plans.size, 4 ].min %>">
      <% @plans.each_with_index do |plan, index| %>
        <% previous = index.positive? ? @plans[index - 1] : nil %>
        <li class="flex flex-col rounded-card border border-line bg-surface p-6" id="plan-<%= plan.key %>">
          <h2 class="text-lg font-bold text-ink"><%= plan.name %></h2>
          <% if plan.description.present? %><p class="mt-1 min-h-10 text-sm2 text-muted"><%= plan.description %></p><% end %>
          <p class="mt-6 flex items-baseline gap-1.5">
            <% if plan.free? %>
              <span class="text-5xl font-extrabold tracking-tight text-ink">$0</span><span class="text-sm text-muted">forever</span>
            <% else %>
              <span class="text-5xl font-extrabold tracking-tight text-ink group-has-[#billing-yearly:checked]/billing:hidden"><%= plan_price(plan.monthly_price) %></span>
              <span class="hidden text-5xl font-extrabold tracking-tight text-ink group-has-[#billing-yearly:checked]/billing:inline"><%= plan_annual_monthly(plan) %></span>
              <span class="text-sm text-muted">/ month</span>
            <% end %>
          </p>
          <% unless plan.free? %>
            <p class="mt-1 text-sm2 text-muted">
              <span class="group-has-[#billing-yearly:checked]/billing:hidden">billed monthly</span>
              <span class="hidden group-has-[#billing-yearly:checked]/billing:inline"><%= plan_price(plan.annual_price) %> billed yearly</span>
            </p>
          <% end %>
          <p class="mt-5 rounded-control bg-sunken px-3.5 py-2.5 text-sm font-semibold text-ink"><%= plan_quota(plan) %></p>
          <ul class="mt-5 flex-1 space-y-2.5 text-sm text-subtle">
            <li class="flex gap-2.5"><%= icon "check", class: "mt-0.5 size-4 shrink-0 text-canopy" %><%= plan_team(plan) %></li>
            <% if previous %><li class="flex gap-2.5"><%= icon "check", class: "mt-0.5 size-4 shrink-0 text-canopy" %>Everything in <%= previous.name %></li><% end %>
            <% plan_new_features(plan, previous).each do |label, coming_soon| %>
              <li class="flex gap-2.5"><%= icon "check", class: "mt-0.5 size-4 shrink-0 text-canopy" %>
                <span><%= label %><% if coming_soon %> <span class="badge badge-plain ml-1 align-middle">Coming soon</span><% end %></span></li>
            <% end %>
            <% if index.zero? && !plan.features["remove_powered_by"] %>
              <li class="flex gap-2.5"><%= icon "info", class: "mt-0.5 size-4 shrink-0 text-faint" %>Shows “Powered by Shadetree” on client pages and emails</li>
            <% end %>
          </ul>
          <%= link_to "Start free", new_user_registration_path, class: "#{button_classes(index.zero? ? :primary : :secondary)} mt-6 w-full" %>
        </li>
      <% end %>
    </ul>
    <p class="mt-4 text-center text-sm2 text-muted">Every account starts on Free. Move to a paid plan from Settings when you need more. Prices in US dollars.</p>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-14 sm:px-8" aria-labelledby="every-plan">
    <div class="grid gap-6 rounded-card border border-line bg-canvas p-6 sm:p-8 lg:grid-cols-[14rem_1fr]">
      <div>
        <h2 id="every-plan" class="text-lg font-bold text-ink">Included on every plan</h2>
        <p class="mt-1 text-sm2 text-muted">Free included.</p>
      </div>
      <ul class="grid gap-x-8 gap-y-2.5 text-sm text-subtle sm:grid-cols-2 lg:grid-cols-3">
        <% [ "Unlimited clients", "Your own request page", "Online approval with a signature", "Scheduling and calendar",
             "Technicians’ phone view", "Invoices and recorded payments", "PDFs with your logo", "Starter services for your industry",
             "Export all your data", "Email support" ].each do |item| %>
          <li class="flex gap-2.5"><%= icon "check", class: "mt-0.5 size-4 shrink-0 text-canopy" %><%= item %></li>
        <% end %>
      </ul>
    </div>
  </section>
</div>

<section class="mx-auto max-w-3xl px-5 py-20 sm:px-8" aria-labelledby="faq">
  <h2 id="faq" class="text-center text-3xl font-extrabold tracking-[-0.035em] text-ink sm:text-4xl">Questions, answered</h2>
  <% free = @plans.find(&:free?) %>
  <div class="mt-10 divide-y divide-line border-y border-line">
    <% [
         [ "What counts as a quote?",
           "A quote counts once, the first time you send it, by email or by copying its link. Drafts, revisions and sending it again don’t count. Jobs, invoices and requests never count." ],
         [ "What happens when I reach my limit?",
           "We let you know as you get close. At the limit you can still create and edit drafts, but sending a new quote waits until your count resets on the 1st of the month, or until you move to a bigger plan. Quotes you’ve already sent keep working: clients can still open and approve them, and your request page keeps taking requests." ],
         [ "Do you charge per person?",
           "No. Each plan includes a number of team members#{" (#{plan_team(free).downcase} on #{free.name})" if free}. If you move to a plan with fewer, nobody is removed; you just can’t invite more until there’s room." ],
         [ "Can I cancel any time?",
           "Yes. There’s no contract and no setup fee. You can move back to Free whenever you like, and nothing is deleted: anything over the Free plan’s limits becomes read-only." ],
         [ "Can I take my data with me?",
           "Yes, on every plan. Download your clients, quotes, jobs, invoices and payments as spreadsheets, or everything at once with your PDFs and photos." ]
       ].each_with_index do |(question, answer), index| %>
      <details class="group py-1" <%= "open" if index.zero? %>>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-semibold text-ink">
          <%= question %><%= icon "plus", class: "size-4 shrink-0 text-muted transition-transform group-open:rotate-45" %>
        </summary>
        <p class="pb-5 text-[0.9375rem] leading-relaxed text-subtle"><%= answer %></p>
      </details>
    <% end %>
  </div>
  <p class="mt-8 text-center text-sm text-subtle">Something else? <%= link_to "Ask us", contact_path, class: "font-semibold text-canopy hover:underline" %>.</p>
</section>

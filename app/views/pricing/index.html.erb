<!-- Pricing Toggle JavaScript -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const toggle = document.getElementById('billing-toggle');
        const toggleSwitch = document.getElementById('toggle-switch');
        const monthlyLabel = document.getElementById('monthly-label');
        const annualLabel = document.getElementById('annual-label');

        const soloPriceEl = document.getElementById('solo-price');
        const crewPriceEl = document.getElementById('crew-price');
        const fleetPriceEl = document.getElementById('fleet-price');

        const soloSavingsEl = document.getElementById('solo-annual-savings');
        const crewSavingsEl = document.getElementById('crew-annual-savings');
        const fleetSavingsEl = document.getElementById('fleet-annual-savings');

        const monthlyPrices = {
            solo: '$9.99',
            crew: '$39.99',
            fleet: '$79.99'
        };

        const annualPrices = {
            solo: '$7.99',  // 20% off $9.99
            crew: '$31.99', // 20% off $39.99
            fleet: '$63.99' // 20% off $79.99
        };

        let isAnnual = false;

        toggle.addEventListener('click', function() {
            isAnnual = !isAnnual;

            if (isAnnual) {
                // Switch to annual
                toggleSwitch.classList.remove('translate-x-1');
                toggleSwitch.classList.add('translate-x-6');
                toggle.classList.remove('bg-gray-200');
                toggle.classList.add('bg-shadetree-blue');

                monthlyLabel.classList.remove('text-gray-900');
                monthlyLabel.classList.add('text-gray-500');
                annualLabel.classList.remove('text-gray-900');
                annualLabel.classList.add('text-gray-900');

                // Update prices
                soloPriceEl.textContent = annualPrices.solo;
                crewPriceEl.textContent = annualPrices.crew;
                fleetPriceEl.textContent = annualPrices.fleet;

                // Show savings
                soloSavingsEl.classList.remove('hidden');
                crewSavingsEl.classList.remove('hidden');
                fleetSavingsEl.classList.remove('hidden');

            } else {
                // Switch to monthly
                toggleSwitch.classList.remove('translate-x-6');
                toggleSwitch.classList.add('translate-x-1');
                toggle.classList.remove('bg-shadetree-blue');
                toggle.classList.add('bg-gray-200');

                monthlyLabel.classList.remove('text-gray-500');
                monthlyLabel.classList.add('text-gray-900');
                annualLabel.classList.remove('text-gray-900');
                annualLabel.classList.add('text-gray-500');

                // Update prices
                soloPriceEl.textContent = monthlyPrices.solo;
                crewPriceEl.textContent = monthlyPrices.crew;
                fleetPriceEl.textContent = monthlyPrices.fleet;

                // Hide savings
                soloSavingsEl.classList.add('hidden');
                crewSavingsEl.classList.add('hidden');
                fleetSavingsEl.classList.add('hidden');
            }
        });
    });
</script>

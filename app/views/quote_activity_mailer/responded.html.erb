<p style="margin:0 0 12px;font-size:18px;font-weight:700;color:#0f172a;"><%= QuoteActivityMailer.subject_for(@response, @who) %></p>
<p style="margin:0 0 12px;">Quote <%= @quote.number %><%= " · #{@quote.title}" if @quote.title %> for <%= @quote.client.display_name %>, <%= money(@total) %>.</p>
<% if @response.approved? %>
  <p style="margin:0 0 12px;">Signed by <strong><%= @response.signer_name %></strong> on <%= l(@response.created_at.in_time_zone(@business.time_zone), format: :long) %>.</p>
<% end %>
<% if @response.message %>
  <p style="margin:0 0 4px;font-size:13px;color:#64748b;"><%= { "declined" => "Reason", "changes_requested" => "What they'd like changed" }.fetch(@response.kind, "Note") %></p>
  <div style="margin:0 0 12px;padding:10px 12px;border-left:3px solid #e2e8f0;"><%= simple_format(h(@response.message), style: "margin:0 0 8px;") %></div>
<% end %>
<%= render "shared/mailer/button", label: "Open quote", url: @url %>

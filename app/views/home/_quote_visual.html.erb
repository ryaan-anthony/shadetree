<div class="rounded-[18px] bg-gradient-to-br from-sunken to-line-2 p-6 sm:p-10" aria-hidden="true">
  <div class="mx-auto max-w-sm rounded-card border border-line bg-surface shadow-raised">
    <div class="flex items-center gap-3 border-b border-line p-4">
      <span class="flex size-8 items-center justify-center rounded-control bg-warning text-xs font-bold text-white">OL</span>
      <span class="font-semibold text-ink">Oakline Lawn & Landscape</span>
    </div>
    <div class="p-4">
      <p class="text-xs text-muted">Quote Q-1041</p>
      <p class="font-bold text-ink">Spring cleanup</p>
      <ul class="mt-3 space-y-1.5 text-sm">
        <% [ [ "Spring cleanup", "$385.00" ], [ "Mulch install", "$468.00" ], [ "Bed edging", "$202.50" ] ].each do |name, price| %>
          <li class="flex justify-between"><span class="text-subtle"><%= name %></span><span class="money"><%= price %></span></li>
        <% end %>
      </ul>
      <p class="mt-4 flex items-baseline justify-between border-t border-line pt-3"><span class="text-sm text-muted">Total</span><span class="text-xl font-extrabold text-ink">$1,132.02</span></p>
      <span class="mt-4 flex h-10 items-center justify-center rounded-control bg-warning text-sm font-semibold text-white">Approve quote</span>
      <span class="mt-2 block text-center text-xs text-muted">Request changes</span>
    </div>
  </div>
</div>

<!-- Enterprise Hero Section -->
<section class="relative bg-gradient-to-b from-slate-50 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <!-- Hero Content -->
            <div>
                <div class="mb-6">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-shadetree-green">
                        <i data-feather="zap" class="mr-2 h-4 w-4"></i>
                        Booked and paid in under 60 seconds
                    </span>
                </div>

                <h1 class="text-4xl lg:text-5xl font-bold text-enterprise-navy mb-6 leading-tight">
                    Streamline Your
                    <span class="text-shadetree-blue">Service Business</span>
                </h1>

                <p class="text-xl text-enterprise-gray mb-8 leading-relaxed">
                    Quote it, book it, get paid. Simple service business software that helps you win more jobs and get paid faster.
                </p>

                <!-- Primary CTAs -->
                <div class="flex flex-col sm:flex-row gap-4 mb-10">
                    <%= link_to new_user_registration_path, class: "bg-shadetree-green text-white px-8 py-4 text-lg font-medium rounded-md hover:bg-green-700 shadow-lg text-center" do %>
                        Start Free Trial
                    <% end %>
                    <%= link_to "#demo", class: "border-2 border-enterprise-gray text-enterprise-gray px-8 py-4 text-lg font-medium rounded-md hover:bg-gray-50 text-center" do %>
                        Watch 2-Min Demo
                    <% end %>
                </div>
            </div>

            <!-- Service Management Dashboard Mockup -->
            <div class="relative">
                <div class="bg-white rounded-lg shadow-2xl border border-gray-200 overflow-hidden">
                    <!-- Dashboard Header -->
                    <div class="bg-enterprise-navy px-6 py-4">

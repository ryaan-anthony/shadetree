                            </div>
                            <div class="flex items-center space-x-2">
                                <div class="w-2 h-2 bg-green-400 rounded-full"></div>
                                <span class="text-green-400 text-sm">Live</span>
                            </div>
                        </div>
                    </div>

                    <!-- Dashboard Content -->
                    <div class="p-6 space-y-6">
                        <!-- Key Metrics Row -->
                        <div class="grid grid-cols-2 gap-4">
                            <div class="bg-gradient-to-r from-blue-50 to-blue-100 p-4 rounded-lg border-l-4 border-shadetree-blue">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <div class="text-sm text-gray-600">Active Quotes</div>
                                        <div class="text-2xl font-bold text-enterprise-navy">47</div>
                                        <div class="text-xs text-shadetree-blue">↗ +18% this week</div>
                                    </div>
                                    <i data-feather="file-text" class="w-8 h-8 text-shadetree-blue"></i>
                                </div>
                            </div>
                            <div class="bg-gradient-to-r from-green-50 to-green-100 p-4 rounded-lg border-l-4 border-shadetree-green">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <div class="text-sm text-gray-600">Scheduled Jobs</div>
                                        <div class="text-2xl font-bold text-enterprise-navy">36</div>
                                        <div class="text-xs text-shadetree-green">↗ 95% capacity</div>
                                    </div>
                                    <i data-feather="check-circle" class="w-8 h-8 text-shadetree-green"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Workflow Status -->
                        <div class="space-y-3">
                            <div class="flex justify-between items-center">
                                <span class="text-sm font-medium text-gray-700">Today's Workflow Status</span>
                                <span class="text-xs text-gray-500">Real-time updates</span>
                            </div>
                            <div class="space-y-2">
                                <div class="flex items-center space-x-3">
                                    <div class="w-20 text-xs text-gray-500">Quotes Sent</div>
                                    <div class="flex-1 h-3 bg-gray-200 rounded">
                                        <div class="h-3 bg-shadetree-blue rounded w-4/5"></div>
                                    </div>
                                    <div class="text-xs text-gray-600">23</div>
                                </div>
                                <div class="flex items-center space-x-3">
                                    <div class="w-20 text-xs text-gray-500">Approved</div>
                                    <div class="flex-1 h-3 bg-gray-200 rounded">
                                        <div class="h-3 bg-shadetree-green rounded w-2/3"></div>
                                    </div>
                                    <div class="text-xs text-gray-600">12</div>
                                </div>
                                <div class="flex items-center space-x-3">
                                    <div class="w-20 text-xs text-gray-500">Scheduled</div>
                                    <div class="flex-1 h-3 bg-gray-200 rounded">
                                        <div class="h-3 bg-shadetree-purple rounded w-full"></div>
                                    </div>
                                    <div class="text-xs text-gray-600">12</div>
                                </div>
                            </div>
                        </div>

                        <!-- Team Performance -->
                        <div class="flex items-center justify-between pt-4 border-t border-gray-200">
                            <div class="flex items-center space-x-4 text-xs text-gray-500">
                                <span>Team Members: 19</span>
                                <span>•</span>
                                <span>Locations: 3</span>
                            </div>
                            <div class="flex items-center space-x-1">
                                <div class="w-2 h-2 bg-green-400 rounded-full"></div>
                                <span class="text-xs text-gray-500">All systems operational</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


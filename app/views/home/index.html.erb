<% content_for :title, "Shadetree: quotes, scheduling and payments for small service crews" %>
<% content_for :head, tag.meta(name: "description", content: "Send professional quotes, get them approved online, schedule the work and get paid. Free to start, no card needed.") %>

<%# Hero: the core loop, said three times as short as possible, beside the product doing it. %>
<section class="overflow-hidden border-b border-line bg-[radial-gradient(ellipse_at_top_right,var(--color-canopy-50),transparent_60%)]">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-14 sm:px-8 lg:grid-cols-[1fr_1.05fr] lg:py-20">
    <div>
      <h1 class="text-[2.75rem] font-extrabold leading-[1.02] tracking-[-0.045em] text-ink sm:text-6xl lg:text-7xl">
        <% [ "Quote it.", "Book it.", "Get paid." ].each_with_index do |line, index| %>
          <span class="relative block pl-11 sm:pl-12">
            <span class="absolute left-0 top-1/2 size-5 -translate-y-1/2 rounded-full border-[3px] <%= index.zero? ? "border-canopy-100 bg-canopy" : "border-line bg-surface" %>" aria-hidden="true"></span>
            <% if index < 2 %><span class="absolute left-[0.5625rem] top-[calc(50%+0.75rem)] h-[calc(100%-1.5rem)] w-0.5 <%= index.zero? ? "bg-canopy" : "bg-line" %>" aria-hidden="true"></span><% end %>
            <%= line %>
          </span>
        <% end %>
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-relaxed text-subtle">Shadetree helps small service crews send professional quotes, get them approved online, schedule the work and get paid. Run it all from your phone.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <%= link_to "Start free", new_user_registration_path, class: button_classes(:primary, :lg) %>
        <%= link_to root_path(anchor: "how-it-works"), class: button_classes(:secondary, :lg) do %><%= icon "arrow-down" %> See how it works<% end %>
      </div>
      <p class="mt-4 text-sm text-muted">Free plan with the whole workflow. No card needed.</p>
    </div>
    <%= render "home/hero_visual" %>
  </div>
</section>

<section class="border-b border-line" aria-label="Who it's for">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-7 gap-y-2 px-5 py-6 text-[0.9375rem] sm:px-8">
    <span class="text-muted">Made for</span>
    <% Industry.all.reject { _1.key == "other" }.each do |industry| %><span class="font-medium text-subtle"><%= industry.name %></span><% end %>
    <span class="text-subtle">and other crews of 1 to 10</span>
  </div>
</section>

<section id="how-it-works" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
    <h2 class="max-w-3xl text-3xl font-extrabold tracking-[-0.035em] text-ink sm:text-[2.5rem] sm:leading-[1.1]">From “can you give me a price?” to paid, in one place.</h2>
    <p class="mt-4 max-w-2xl text-lg text-subtle">No more quotes in text threads, approvals lost in voicemail, or invoices written up on Sunday night.</p>
    <ol class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <% [
           [ "A request comes in", "Share your request page. New clients pick services, describe the job and add photos.",
             [ "Rosa Delgado", badge("New", tone: :info, dot: false), "Weekly mowing, hedge trimming" ] ],
           [ "Send a quote in minutes", "Pick from your services, adjust, send. Your client approves from their phone with a typed signature.",
             [ "Q-1041", badge("Approved", tone: :success), "Signed by Hannah Brooks, 9:14 AM" ] ],
           [ "Schedule the crew", "Put the job on the calendar. Your crew sees their day on their phone, and clients get a confirmation.",
             [ "Tue, Nov 17", tag.span("8–10 AM", class: "text-sm2 text-muted"), "Marcus and Leo" ] ],
           [ "Get paid", "Invoice in one tap when the work is done, and record cash, check or card payments as they come in.",
             [ "INV-2210", badge("Paid", tone: :success), "$760.00, card" ] ]
         ].each_with_index do |(title, text, (name, status, detail)), index| %>
        <li class="relative">
          <div class="flex items-center gap-3" aria-hidden="true">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full border-2 border-canopy text-sm font-bold text-canopy"><%= index + 1 %></span>
            <span class="hidden h-0.5 flex-1 lg:block <%= index < 3 ? "bg-canopy" : "bg-gradient-to-r from-canopy-100 to-transparent" %>"></span>
          </div>
          <h3 class="mt-5 text-lg font-bold text-ink"><%= title %></h3>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-subtle"><%= text %></p>
          <div class="mt-5 rounded-card border border-line bg-surface p-3.5 shadow-card" aria-hidden="true">
            <div class="flex items-center justify-between gap-2"><span class="text-sm font-semibold text-ink"><%= name %></span><%= status %></div>
            <p class="mt-1 text-sm2 text-muted"><%= detail %></p>
          </div>
        </li>
      <% end %>
    </ol>
  </div>
</section>

<section id="features" class="scroll-mt-16 border-y border-line bg-canvas">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-20 sm:px-8 lg:grid-cols-2">
    <div>
      <h2 class="text-3xl font-extrabold tracking-[-0.035em] text-ink sm:text-[2.5rem] sm:leading-[1.1]">Quotes that look like you’re the big company in town.</h2>
      <p class="mt-4 text-lg leading-relaxed text-subtle">Your logo, your colors, your words. Clients open a clean page on their phone and approve it in one tap. No account, no app to download.</p>
      <%= render "home/checks", items: [ "Start from your own services and prices, change anything per job",
                                         "See the moment a client opens a quote",
                                         "Clients ask for changes right on the quote; revise and resend in seconds" ] %>
    </div>
    <%= render "home/quote_visual" %>
  </div>
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-20 sm:px-8 lg:grid-cols-2">
    <div class="lg:order-2">
      <h2 class="text-3xl font-extrabold tracking-[-0.035em] text-ink sm:text-[2.5rem] sm:leading-[1.1]">Your crew always knows where to be.</h2>
      <p class="mt-4 text-lg leading-relaxed text-subtle">Technicians get one simple screen: today’s visits, the address, the gate code and the client’s number. They mark the work done and add photos from the job.</p>
      <%= render "home/checks", items: [ "Arrival windows, not just exact times",
                                         "Clients get a confirmation and a reminder the day before",
                                         "Technicians see only what they need. Prices stay private unless you choose otherwise" ] %>
    </div>
    <%= render "home/day_visual" %>
  </div>
</section>

<% if @plans.any? %>
  <section aria-labelledby="pricing-teaser">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
      <h2 id="pricing-teaser" class="text-3xl font-extrabold tracking-[-0.035em] text-ink sm:text-[2.5rem] sm:leading-[1.1]">Start free. Move up as you send more quotes.</h2>
      <p class="mt-4 max-w-2xl text-lg text-subtle">Every plan has the whole workflow: requests, quotes, scheduling, invoices and payments. No setup fees, no contracts.</p>
      <ul class="mt-10 grid overflow-hidden rounded-card border border-line sm:grid-cols-2 lg:grid-cols-<%= [ @plans.size, 4 ].min %>">
        <% @plans.each do |plan| %>
          <li class="border-line p-6 [&:not(:first-child)]:border-t sm:[&:nth-child(2)]:border-t-0 sm:[&:nth-child(even)]:border-l lg:[&:not(:first-child)]:border-l lg:[&:not(:first-child)]:border-t-0">
            <p class="font-semibold text-ink"><%= plan.name %></p>
            <p class="mt-2 text-4xl font-extrabold tracking-tight text-ink"><%= plan_price(plan.monthly_price) %><span class="text-sm font-medium text-muted"><%= "/month" unless plan.free? %></span></p>
            <p class="mt-2 text-sm2 text-muted"><%= plan_quota(plan) %></p>
          </li>
        <% end %>
      </ul>
      <%= link_to "Compare plans", pricing_path, class: "#{button_classes(:secondary)} mt-6" %>
    </div>
  </section>
<% end %>

<section class="bg-side text-side-text" aria-labelledby="promises">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
    <h2 id="promises" class="max-w-2xl text-3xl font-extrabold tracking-[-0.035em] text-white sm:text-[2.5rem] sm:leading-[1.1]">Built for small businesses, and fair to them.</h2>
    <dl class="mt-12 grid gap-8 border-t border-side-line pt-8 md:grid-cols-3">
      <% [ [ "Your data is yours", "Export your clients, quotes and invoices any time, on any plan, Free included." ],
           [ "Clients never need an account", "Every quote, visit and invoice opens from a secure link. Nothing to download, no password to forget." ],
           [ "No surprise lockouts", "Hit a limit and we’ll tell you. Quotes you’ve already sent keep working, and clients can still approve them." ] ].each do |title, text| %>
        <div><dt class="font-bold text-white"><%= title %></dt><dd class="mt-2 text-[0.9375rem] leading-relaxed"><%= text %></dd></div>
      <% end %>
    </dl>
  </div>
  <div class="border-t border-side-line">
    <div class="mx-auto max-w-6xl px-5 py-16 text-center sm:px-8">
      <h2 class="text-3xl font-extrabold tracking-[-0.035em] text-white sm:text-4xl">Send your first quote today.</h2>
      <%= form_with url: new_user_registration_path, method: :get, class: "mx-auto mt-7 flex max-w-md flex-col gap-3 sm:flex-row" do %>
        <label for="cta-email" class="sr-only">Your email</label>
        <%= email_field_tag :email, nil, id: "cta-email", placeholder: "you@yourbusiness.com", autocomplete: "email",
                            class: "input h-11 flex-1 border-side-line bg-side-2 text-white placeholder:text-side-label" %>
        <button type="submit" class="<%= button_classes(:primary, :lg) %>">Start free</button>
      <% end %>
      <p class="mt-3 text-sm2">Free plan, no card needed.</p>
    </div>
  </div>
</section>

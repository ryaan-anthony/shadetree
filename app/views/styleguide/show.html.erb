<% content_for :title, "Style guide" %>
<div class="mx-auto max-w-5xl px-4 py-8 text-sm sm:px-6">
  <header class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <span class="logo"><span class="logo-mark"><%= logo_mark %></span><span>Shadetree</span></span>
      <h1 class="mt-4 text-2xl font-bold tracking-tight text-ink">UI kit</h1>
      <p class="mt-1 max-w-prose text-muted">Every building block and state. Tokens live in
        <code>app/assets/tailwind/theme.css</code>, classes in <code>components.css</code>, markup in
        <code>app/views/components</code> and <code>ComponentsHelper</code>.</p>
    </div>
    <nav class="flex flex-wrap gap-x-4 gap-y-1 text-sm2 font-medium" aria-label="Sections">
      <% %w[Colors Type Buttons Forms Badges Cards Tables Dialogs Feedback Navigation Icons Layouts].each do |name| %>
        <a class="text-canopy hover:underline" href="#<%= name.downcase %>"><%= name %></a>
      <% end %>
    </nav>
  </header>

  <div class="space-y-10">
    <section id="colors" aria-labelledby="colors-h">
      <h2 id="colors-h" class="mb-3 text-base font-bold text-ink">Colors</h2>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6">
        <% [ %w[ink #0f172a], %w[body #1e293b], %w[subtle #475569], %w[muted #64748b], %w[faint #94a3b8], %w[line #e2e8f0],
             %w[canvas #f6f7f9], %w[canopy #047857], %w[canopy-50 #ecfdf5], %w[leaf #34d399], %w[side #0b1221], %w[success #047857],
             %w[info #1d4ed8], %w[warning #b45309], %w[danger #b91c1c], %w[violet #6d28d9] ].each do |name, hex| %>
          <div class="card overflow-hidden">
            <div class="h-12 border-b border-line" style="background: var(--color-<%= name %>)"></div>
            <div class="px-2.5 py-2"><p class="font-semibold text-ink"><%= name %></p><p class="text-xs text-muted tabular"><%= hex %></p></div>
          </div>
        <% end %>
      </div>
      <p class="mt-2 text-sm2 text-muted"><code>faint</code> is for placeholders and borders only; it fails AA as text.</p>
    </section>

    <section id="type" aria-labelledby="type-h">
      <h2 id="type-h" class="mb-3 text-base font-bold text-ink">Type</h2>
      <%= card do %>
        <p class="text-2xl font-bold tracking-tight text-ink">Page title, 22px bold</p>
        <p class="mt-2 text-[0.9375rem] font-semibold text-ink">Card title, 15px semibold</p>
        <p class="mt-2 text-sm">Body, 14px. Public Sans, self-hosted. Numbers use <span class="tabular font-semibold">tabular figures: $1,250.00</span>.</p>
        <p class="mt-2 text-sm2 text-muted">Secondary, 13px muted.</p>
      <% end %>
    </section>

    <section id="buttons" aria-labelledby="buttons-h">
      <h2 id="buttons-h" class="mb-3 text-base font-bold text-ink">Buttons</h2>
      <%= card do %>
        <div class="flex flex-wrap items-center gap-2">
          <button class="<%= button_classes(:primary) %>"><%= icon "plus" %> New quote</button>
          <button class="<%= button_classes(:secondary) %>">Secondary</button>
          <button class="<%= button_classes(:danger) %>"><%= icon "trash" %> Delete</button>
          <button class="<%= button_classes(:danger_solid) %>">Delete client</button>
          <button class="<%= button_classes(:ghost) %>">Ghost</button>
          <button class="<%= button_classes(:link) %>">Link button</button>
          <button class="<%= button_classes(:primary) %>" disabled>Disabled</button>
        </div>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <button class="<%= button_classes(:primary, :sm) %>">Small</button>
          <button class="<%= button_classes(:primary, :lg) %>">Large</button>
          <button class="<%= button_classes(:secondary, :icon) %>" aria-label="More actions"><%= icon "more-horizontal" %></button>
        </div>
      <% end %>
    </section>

    <section id="forms" aria-labelledby="forms-h">
      <h2 id="forms-h" class="mb-3 text-base font-bold text-ink">Forms</h2>
      <div class="grid gap-4 lg:grid-cols-2">
        <%= card title: "Fields", subtitle: "f.field with label, help and every input type" do %>
          <%= form_with model: @valid, url: "#", method: :post do |f| %>
            <%= f.field :name, label: "Client name" %>
            <%= f.field :email, as: :email, help: "Quotes and invoices are sent here." %>
            <%= f.field :timezone, as: :select, choices: [ [ "Eastern", "America/New_York" ], [ "Central", "America/Chicago" ], [ "Pacific", "America/Los_Angeles" ] ] %>
            <div class="grid gap-4 sm:grid-cols-2">
              <%= f.field :visit_on, as: :date, label: "Visit date" %>
              <%= f.field :starts_at, as: :time, label: "Start time" %>
            </div>
            <%= f.field :price, as: :money, label: "Price", help: "Before tax." %>
            <%= f.field :notes, as: :textarea, optional: true, placeholder: "Gate code, pets, parking…" %>
            <div class="field"><%= f.check :reminders, label: "Send visit reminders", hint: "A text the day before each visit." %></div>
          <% end %>
        <% end %>
        <%= card title: "Errors", subtitle: "Invalid fields after submit" do %>
          <%= form_with model: @invalid, url: "#", method: :post do |f| %>
            <div class="banner banner-danger mb-4" role="alert"><%= icon "alert-circle" %><p>2 problems to fix before saving.</p></div>
            <%= f.field :name, label: "Client name" %>
            <%= f.field :email, as: :email %>
            <%= f.field :notes, as: :text, label: "Disabled", optional: true, disabled: true, value: "Not editable" %>
            <div class="mt-4 flex justify-end gap-2">
              <button type="button" class="<%= button_classes(:ghost) %>">Cancel</button>
              <%= f.submit_button "Save client" %>
            </div>
          <% end %>
        <% end %>
      </div>
    </section>

    <section id="badges" aria-labelledby="badges-h">
      <h2 id="badges-h" class="mb-3 text-base font-bold text-ink">Badges and status pills</h2>
      <%= card do %>
        <div class="flex flex-wrap gap-2">
          <%= badge "Draft" %>
          <%= badge "Sent", tone: :info %>
          <%= badge "Approved", tone: :success %>
          <%= badge "Due soon", tone: :warning %>
          <%= badge "Overdue", tone: :danger %>
          <%= badge "Scheduled", tone: :violet %>
          <%= badge "Owner", tone: :dark, dot: false %>
          <%= badge "No dot", dot: false %>
        </div>
      <% end %>
    </section>

    <section id="cards" aria-labelledby="cards-h">
      <h2 id="cards-h" class="mb-3 text-base font-bold text-ink">Cards</h2>
      <div class="grid gap-4 md:grid-cols-2">
        <%= card title: "Card with actions", subtitle: "Optional subtitle",
                 actions: link_to("Edit", "#", class: button_classes(:secondary, :sm)),
                 footer: tag.p("Footer for secondary actions or totals.", class: "text-sm2 text-muted") do %>
          <dl class="grid grid-cols-[7rem_1fr] gap-x-3 gap-y-2">
            <dt class="text-muted">Client</dt><dd class="text-ink">Maria Lopez</dd>
            <dt class="text-muted">Total</dt><dd class="money font-semibold text-ink">$1,250.00</dd>
          </dl>
        <% end %>
        <%= card do %>
          <p>A plain card: <code>card { … }</code>.</p>
        <% end %>
      </div>
    </section>

    <section id="tables" aria-labelledby="tables-h">
      <h2 id="tables-h" class="mb-3 text-base font-bold text-ink">Tables, lists and empty states</h2>
      <%= card title: "Recent quotes", flush: true,
               footer: pagination(page: 2, per_page: 3, total_count: 8) do %>
        <div class="table-wrap">
          <table class="data-table data-table-stack">
            <thead><tr><th scope="col">Client</th><th scope="col">Status</th><th scope="col" class="num">Total</th></tr></thead>
            <tbody>
              <tr><td class="primary">Maria Lopez<span class="sub">Spring cleanup</span></td><td><%= badge "Approved", tone: :success %></td><td class="num money">$1,250.00</td></tr>
              <tr><td class="primary">Dev Patel<span class="sub">Weekly mowing</span></td><td><%= badge "Sent", tone: :info %></td><td class="num money">$85.00</td></tr>
              <tr><td class="primary">Hannah Cho<span class="sub">Hedge trim</span></td><td><%= badge "Draft" %></td><td class="num money">$340.00</td></tr>
            </tbody>
          </table>
        </div>
      <% end %>
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        <%= card flush: true do %>
          <ul class="list">
            <li><%= avatar "Maria Lopez" %><div class="min-w-0 flex-1"><p class="font-semibold text-ink">Maria Lopez</p><p class="text-sm2 text-muted">12 Oak St</p></div><%= icon "chevron-right", class: "size-4 text-faint" %></li>
            <li><%= avatar "Dev Patel" %><div class="min-w-0 flex-1"><p class="font-semibold text-ink">Dev Patel</p><p class="text-sm2 text-muted">40 Elm Ave</p></div><%= icon "chevron-right", class: "size-4 text-faint" %></li>
          </ul>
        <% end %>
        <%= card do %>
          <%= empty_state title: "No clients yet", text: "Add your first client to send them a quote.", icon: "users" do %>
            <a href="#" class="<%= button_classes(:primary) %>"><%= icon "plus" %> Add client</a>
          <% end %>
        <% end %>
      </div>
    </section>

    <section id="dialogs" aria-labelledby="dialogs-h">
      <h2 id="dialogs-h" class="mb-3 text-base font-bold text-ink">Modal and confirm</h2>
      <%= card do %>
        <div class="flex flex-wrap gap-2" data-controller="modal">
          <button type="button" class="<%= button_classes(:secondary) %>" data-action="modal#open">Open modal</button>
          <%= modal id: "sample-modal", title: "Reschedule visit", description: "Maria will get a text with the new time.",
                    footer: safe_join([ tag.button("Cancel", type: "button", class: button_classes(:secondary), data: { action: "modal#close" }),
                                        tag.button("Reschedule", type: "button", class: button_classes(:primary), data: { action: "modal#close" }) ]) do %>
            <div class="grid gap-4 sm:grid-cols-2">
              <div class="field"><label class="label" for="sg-date">Date</label><input id="sg-date" type="date" class="input"></div>
              <div class="field"><label class="label" for="sg-time">Time</label><input id="sg-time" type="time" class="input"></div>
            </div>
          <% end %>
          <%= link_to "Delete client", styleguide_path, class: button_classes(:danger),
                      data: { turbo_method: :get, turbo_confirm: "Delete Maria Lopez? Her quotes and invoices stay in your records.", turbo_confirm_button: "Delete client" } %>
        </div>
      <% end %>
    </section>

    <section id="feedback" aria-labelledby="feedback-h">
      <h2 id="feedback-h" class="mb-3 text-base font-bold text-ink">Banners and toasts</h2>
      <div class="space-y-2">
        <div class="banner banner-info"><%= icon "info" %><p>Online payments turn on once Stripe is connected.</p></div>
        <div class="banner banner-success"><%= icon "success" %><p>Maria approved the quote.</p></div>
        <div class="banner banner-warning"><%= icon "warning" %><p>Invoice #1042 is due in 2 days.</p></div>
        <div class="banner banner-danger"><%= icon "danger" %><p>The card was declined. Ask the client for another card.</p></div>
      </div>
      <p class="mt-3"><%= link_to "Show a toast", styleguide_path(toast: 1, anchor: "feedback"), class: button_classes(:secondary) %>
        <span class="ml-2 text-sm2 text-muted">Flash messages render as toasts; errors stay until dismissed.</span></p>
    </section>

    <section id="navigation" aria-labelledby="navigation-h">
      <h2 id="navigation-h" class="mb-3 text-base font-bold text-ink">Tabs, menus and the flow rail</h2>
      <%= card do %>
        <nav class="tabs" aria-label="Example tabs">
          <a class="tab" href="#navigation" aria-current="page">Details</a>
          <a class="tab" href="#navigation">Visits</a>
          <a class="tab" href="#navigation">Invoices</a>
        </nav>
        <div class="relative mt-4 inline-block" data-controller="menu" data-action="keydown->menu#keydown">
          <button type="button" class="<%= button_classes(:secondary) %>" data-menu-target="button" data-action="menu#toggle" aria-haspopup="true" aria-expanded="false">
            Actions <%= icon "chevron-down" %>
          </button>
          <div class="menu left-0 top-full mt-1" data-menu-target="menu" hidden>
            <a href="#navigation" class="menu-item"><%= icon "edit-2" %> Edit</a>
            <a href="#navigation" class="menu-item"><%= icon "copy" %> Duplicate</a>
            <div class="menu-sep"></div>
            <a href="#navigation" class="menu-item text-danger"><%= icon "trash" %> Delete</a>
          </div>
        </div>
        <div class="mt-6 overflow-x-auto pb-1">
          <ol class="flow" aria-label="Job progress">
            <li class="is-done"><span class="flow-node"><%= icon "check" %></span>Quoted</li>
            <li class="is-done"><span class="flow-node"><%= icon "check" %></span>Approved</li>
            <li class="is-current" aria-current="step"><span class="flow-node"></span>Scheduled</li>
            <li><span class="flow-node"></span>Done</li>
            <li><span class="flow-node"></span>Invoiced</li>
            <li><span class="flow-node"></span>Paid</li>
          </ol>
        </div>
      <% end %>
    </section>

    <section id="icons" aria-labelledby="icons-h">
      <h2 id="icons-h" class="mb-3 text-base font-bold text-ink">Icons</h2>
      <%= card do %>
        <p class="mb-3 text-sm2 text-muted">Feather icons rendered inline by <code>icon("name")</code>; decorative unless given <code>label:</code>.</p>
        <div class="grid grid-cols-3 gap-2 sm:grid-cols-6">
          <% %w[home inbox schedule clients quote job invoice money settings bell search plus check x phone mail map-pin clock camera send trash edit-2 alert-circle log-out].each do |name| %>
            <div class="flex flex-col items-center gap-1.5 rounded-md p-2 text-subtle"><%= icon name, class: "size-5" %><span class="text-xs text-muted"><%= name %></span></div>
          <% end %>
        </div>
      <% end %>
    </section>

    <section id="layouts" aria-labelledby="layouts-h">
      <h2 id="layouts-h" class="mb-3 text-base font-bold text-ink">Layouts</h2>
      <%= card do %>
        <ul class="list -mx-[1.125rem] -my-3">
          <li><div class="flex-1"><p class="font-semibold text-ink">Marketing</p><p class="text-sm2 text-muted">Public pages and sign-in.</p></div><%= link_to "Open", root_path, class: button_classes(:secondary, :sm) %></li>
          <li><div class="flex-1"><p class="font-semibold text-ink">Staff app</p><p class="text-sm2 text-muted">Sidebar on desktop, drawer on phones, business switcher. Sign in to see it.</p></div><%= link_to "Open", admin_root_path, class: button_classes(:secondary, :sm) %></li>
          <li><div class="flex-1"><p class="font-semibold text-ink">Client-facing</p><p class="text-sm2 text-muted">Branded with the business's logo and colour.</p></div>
            <%= link_to "Rust", styleguide_client_path(brand: "#9a3412"), class: button_classes(:secondary, :sm) %>
            <%= link_to "Yellow", styleguide_client_path(brand: "#facc15"), class: button_classes(:secondary, :sm) %></li>
        </ul>
      <% end %>
    </section>
  </div>
</div>

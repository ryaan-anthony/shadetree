<%# How to reach the business: the document's location when it has several (CAT-07). %>
<% contact = @contact || @business %>
<% hours = contact.hours.summary %>
<% if contact.contact_phone.present? || contact.contact_email.present? %>
  <div class="mt-5 flex flex-wrap justify-center gap-2">
    <% if contact.contact_phone.present? %>
      <%= link_to "tel:#{contact.contact_phone}", class: button_classes(:secondary) do %><%= icon "phone" %> Call <%= contact.contact_phone %><% end %>
    <% end %>
    <% if contact.contact_email.present? %>
      <%= mail_to contact.contact_email, class: button_classes(:secondary) do %><%= icon "mail" %> Email us<% end %>
    <% end %>
  </div>
<% end %>
<% if hours.any? %>
  <%# CAT-06: the weekly hours, so clients know when they'll reach someone. %>
  <p class="mt-3 text-center text-sm2 text-muted"><span class="sr-only">Hours: </span><%= icon "clock", class: "mr-1 inline size-3.5 align-text-bottom" %><%= hours.join(" · ") %></p>
<% end %>

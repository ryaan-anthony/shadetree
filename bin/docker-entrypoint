#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# If running the server (Puma with its config, as the image does, or rails server), create or
# migrate the databases first.
if [ "$*" == "bundle exec puma -C config/puma.rb" ] || [ "$*" == "./bin/rails server" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"

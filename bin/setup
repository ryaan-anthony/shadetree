#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

# Sets up or updates a development environment. Idempotent: run it any time.
#   bin/setup                 install, prepare the database, load demo data, start the server
#   bin/setup --skip-server   same, without starting the server
#   bin/setup --reset         also drop and recreate the database first
FileUtils.chdir APP_ROOT do
  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  puts "\n== Building CSS =="
  system! "bin/rails tailwindcss:build"

  puts "\n== Preparing database =="
  system! "bin/rails db:drop" if ARGV.include?("--reset")
  system("bin/rails db:prepare") || abort(<<~MSG)

    Couldn't prepare the database. Is PostgreSQL running and reachable? Start it locally, or point
    DATABASE_URL (or PGHOST/PGUSER/PGPASSWORD) at a server you can use. See README.md.
  MSG

  puts "\n== Loading demo data =="
  system! "bin/rails db:seed"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end

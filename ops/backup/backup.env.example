# ~/.config/shadetree-<environment>/backup.env on the environment's VM (mode 0600), read by
# docker.sh. The Deploy workflow writes it on every deploy from the environment's variables; this
# file only shows the format. Literal NAME=value lines (no quotes, no expansion). No secret:
# docker.sh reads the database host, user and password from the app container when it runs.
DB_NETWORK=postgres_default
BACKUP_DIR=/var/backups/shadetree-production
BACKUP_PG_IMAGE=postgres:17
# Optional:
# BACKUP_ALLOW_LOCAL=true
# BACKUP_RETENTION_DAYS=30        (staging: 7)
# BACKUP_KEEP_MONTHLY=true        (staging: false)
# BACKUP_DRILL_PGHOST=postgres-drill   another PostgreSQL on DB_NETWORK for the drill's scratch databases
# BACKUP_MIN_FREE_MB=1024
